--- Whether the code runs on the client.
declare CLIENT: boolean
--- Whether the code runs on the server.
declare SERVER: boolean
--- Whether the code runs in the main menu state.
declare MENU_DLL: boolean

--- Fire a `USE_ON` signal every tick as long as the player holds their use key and aims at the target.
declare CONTINUOUS_USE: number
--- Fires a `USE_ON` signal when starting to use an entity, and a `USE_OFF` signal when letting go. **WARNING**: There is no guarantee to receive both ON and OFF signals. A signal will only be sent when pushing or letting go of the use key while actually aiming at the entity, so an ON signal might not be followed by an OFF signal if the player is aiming somewhere else when releasing the key, and similarly, an OFF signal may not be preceded by an ON signal if the player started aiming at the entity only after pressing the key. Therefore, this method of input is unreliable and should not be used.
declare ONOFF_USE: number
--- Like a wheel turning.
declare DIRECTIONAL_USE: number
--- Fire a `USE_ON` signal only once when player presses their use key while aiming at the target.
declare SIMPLE_USE: number
declare ACT_INVALID: number
declare ACT_RESET: number
declare ACT_IDLE: number
declare ACT_TRANSITION: number
declare ACT_COVER: number
declare ACT_COVER_MED: number
declare ACT_COVER_LOW: number
declare ACT_WALK: number
declare ACT_WALK_AIM: number
declare ACT_WALK_CROUCH: number
declare ACT_WALK_CROUCH_AIM: number
declare ACT_RUN: number
declare ACT_RUN_AIM: number
declare ACT_RUN_CROUCH: number
declare ACT_RUN_CROUCH_AIM: number
declare ACT_RUN_PROTECTED: number
declare ACT_SCRIPT_CUSTOM_MOVE: number
declare ACT_RANGE_ATTACK1: number
