declare NORTH_WEST: number
--- North East Corner
declare NORTH_EAST: number
--- South East Corner
declare SOUTH_EAST: number
--- South West Corner
declare SOUTH_WEST: number
--- Represents all corners, only applicable to certain functions, such as `CNavArea:PlaceOnGround`.
declare NUM_CORNERS: number
--- North from given `CNavArea`
declare NORTH: number
--- East from given `CNavArea`
declare EAST: number
--- South from given `CNavArea`
declare SOUTH: number
--- West from given `CNavArea`
declare WEST: number
