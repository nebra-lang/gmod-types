    @side(client)
    function SetChecked(checked: boolean): nil
    --- Sets whether the `DMenuOption` is a checkbox option or a normal button option.
    --- Enables automatic `DMenuOption:GetChecked` toggling with left/right clicks.
    --- @param checkable Whether the menu option should allow the player to toggle itself.
    @side(client)
    function SetIsCheckable(checkable: boolean): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used to set the `DMenu` for this option.
    --- @param pnl The DMenu for this option.
    @side(client)
    function SetMenu(pnl: Panel): nil
    --- Sets whether this `DMenuOption` should act like a radio button.
    --- Checking a radio button automatically unchecks all adjacent radio buttons.
    --- @param checked `true` to set as a radio button.
    @side(client)
    function SetRadio(checked: boolean): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally by `DMenuOption:AddSubMenu` to create the submenu arrow and assign the created submenu to be opened when this option is hovered.
    --- @param menu The sub DMenu this option belongs to.
    @side(client)
    function SetSubMenu(menu: Panel): nil
    --- Toggles the checked state of `DMenuOption`. Does not respect `DMenuOption:GetIsCheckable`.
    @side(client)
    function ToggleCheck(): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- An internal panel used by `DMenu`.
--- It acts as a menu option that can be checked.
--- It automatically sets and reads the given console variable.
--- It can be right clicked to toggle without closing the `DMenu`.
--- Use `DMenu:AddCVar` instead.
declare class DMenuOptionCVar extends DMenuOption
    --- Returns the `console variable` used by the `DMenuOptionCVar`.
    --- @return string The ConVars used
    @side(client)
    function GetConVar(): string
    --- Returns the value of the `console variable` when the `DMenuOptionCVar` is not checked.
    --- @return string The value
    @side(client)
    function GetValueOff(): string
    --- Return the value of the `console variable` when the `DMenuOptionCVar` is checked.
    --- @return string The value
    @side(client)
    function GetValueOn(): string
    --- Sets the `console variable` to be used by `DMenuOptionCVar`.
    --- @param cvar The ConVars name to set
    @side(client)
    override function SetConVar(cvar: string): nil
    --- Sets the value of the `console variable` when the `DMenuOptionCVar` is not checked.
    --- @param value The value
    @side(client)
    function SetValueOff(value: string): nil
    --- Sets the value of the `console variable` when the `DMenuOptionCVar` is checked.
    --- @param value The value
    @side(client)
    function SetValueOn(value: string): nil
end

--- A base panel for things like `DModelSelect`.
--- Basically, a list of panels that can be selected.
--- Selected panel can be retrieved and has visual indication of being selected.
declare class DPanelSelect extends DPanelList
end

--- A vertical list of models.
declare class DModelSelect extends DPanelSelect
    --- Sets the height of the panel **in the amount of 64px spawnicons**.
    --- Overrides `Panel:SetHeight`.
    --- @param num Basically how many rows of 64x64 px spawnicons should fit in this DModelSelect
    @side(client)
    override function SetHeight(num: number | nil): nil
    --- Called to set the list of models within the panel element.
    --- @param models Each key is a model path, the value is a kay-value table where they key is a convar name and value is the value to set to that convar.
    --- @param convar ConVar to set when a model from this list is selected.
    --- @param dontSort Do not sort the list. (by the `Model` member)
    --- @param dontCallListConVars If set, only the `convar` from the 2nd argument will be set, not individual convars from the models list.
    @side(client)
    function SetModelList(models: { [any]: any }, convar: string, dontSort: boolean, dontCallListConVars: boolean): nil
end

--- A combination of `DModelSelect` and `DPropertySheet`.
declare class DModelSelectMulti extends DPropertySheet
    --- Adds a new tab of models.
    --- @param name Name of the tab to add.
    --- @param models Models list for this tab. See DModelSelect:SetModelList.
    --- @param convar ConVar to set when a model from this list is selected.
    --- @param dontSort Do not sort the list. (by the `Model` member)
    --- @param dontCallListConVars If set, only the `convar` from the 2nd argument will be set, not individual convars from the models list.
    @side(client)
    function AddModelList(name: string, models: { [any]: any }, convar: string, dontSort: boolean, dontCallListConVars: boolean): nil
end

--- A panel that fades its contents in and out once, like a notification.
declare class DNotify extends Panel
    --- Adds a panel to the notification
    --- @param pnl The panel to add
    --- @param lifeLength If set, overrides DNotify:SetLife for when the given panel should be removed.
    @side(client)
    function AddItem(pnl: Panel, lifeLength: number | nil): nil
    --- Returns the current alignment of this notification panel. Set by `DNotify:SetAlignment`.
    --- @return number The direction of the content, based on the number pad. See Enums/ContentAlignment.
    @side(client)
    function GetAlignment(): number
    --- Returns all the items added with `DNotify:AddItem`.
    --- @return { [any]: any } A table of Panels.
    @side(client)
    function GetItems(): { [any]: any }
    --- Returns the display time in seconds of the DNotify. This is set with
    --- `DNotify:SetLife`.
    --- @return number The display time in seconds.
    @side(client)
    function GetLife(): number
    --- Returns the spacing between items set by `DNotify:SetSpacing`.
    @side(client)
    function GetSpacing(): number
    --- Sets the alignment of the child panels in the notification
    --- @param alignment The direction of the content, based on the number pad. See Enums/ContentAlignment.
    @side(client)
    function SetAlignment(alignment: number): nil
    --- Sets the display time in seconds for the DNotify.
    --- @param time The time in seconds.
    @side(client)
    function SetLife(time: number): nil
    --- Sets the spacing between child elements of the notification panel.
    @side(client)
    function SetSpacing(spacing: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to position and fade in/out its `DNotify:GetItems`.
    @side(client)
    function Shuffle(): nil
end

--- Choose a number from a number line, with zooming for precision.
--- Zoom in by moving your mouse forward and moving back does the opposite. Looks like a blue circle until you click and hold on it
declare class DNumberScratch extends DImageButton
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used by `DNumberScratch:DrawScreen`.
    @side(client)
    function DrawNotches(level: number, x: number, y: number, w: number, h: number, range: number, value: number, min: number, max: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used by `DNumberScratch:PaintScratchWindow`.
    @side(client)
    function DrawScreen(x: number, y: number, w: number, h: number): nil
    --- Returns whether this panel is active or not, i.e. if the player is currently changing its value.
    @side(client)
    function GetActive(): boolean
    --- Returns the desired amount of numbers after the decimal point.
    --- @return number 0 for whole numbers only, 1 for one number after the decimal point, etc.
    @side(client)
    function GetDecimals(): number
    --- Returns the real value of the `DNumberScratch` as a number.
    --- See also `DNumberScratch:GetTextValue` and `DNumberScratch:GetFraction`.
    --- @return number The real value of the DNumberScratch
    @side(client)
    function GetFloatValue(): number
    --- Returns the value of the `DNumberScratch` as a fraction, a value between 0 and 1 where 0 is the minimum and 1 is the maximum value of the `DNumberScratch`.
    --- See also:
    --- * `DNumberScratch:GetTextValue`
    --- * `DNumberScratch:GetFloatValue`
    --- * `DNumberScratch:SetFraction`
    --- @return number A value between 0 and 1
    @side(client)
    function GetFraction(): number
    --- Returns the maximum value that can be selected on the number scratch
    --- @return number The maximum value that can be selected on the number scratch
    @side(client)
    function GetMax(): number
    --- Returns the minimum value that can be selected on the number scratch
    --- @return number The minimum value that can be selected on the number scratch
    @side(client)
    function GetMin(): number
    --- Returns the range of the `DNumberScratch`. Basically max value - min value.
    --- @return number The range of the DNumberScratch
    @side(client)
    function GetRange(): number
    --- Returns whether the scratch window should be visible or not.
    @side(client)
    function GetShouldDrawScreen(): boolean
    --- Returns the real value of the `DNumberScratch` as a string.
    --- See also `DNumberScratch:GetFloatValue` and `DNumberScratch:GetFraction`.
    --- @return string The real value of the DNumberScratch
    @side(client)
    function GetTextValue(): string
    --- Returns the zoom level of the scratch window
    @side(client)
    function GetZoom(): number
    --- Returns the ideal zoom level for the panel based on the `DNumberScratch:GetRange`.
    --- @return number The ideal zoom level for the panel based on the panels range.
    @side(client)
    function IdealZoom(): number
    --- Returns whether the player is currently editing the value of the `DNumberScratch`.
    @side(client)
    function IsEditing(): boolean
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used to lock the cursor in place.
    @side(client)
    function LockCursor(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used to paint the 'scratch' window.
    @side(client)
    function PaintScratchWindow(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets whether or not the panel is 'active'.
    --- Forcing this panel to be active may not work.
    --- @param active true to activate, false to deactivate.
    @side(client)
    function SetActive(active: boolean): nil
    --- Sets the desired amount of numbers after the decimal point.
    --- @param decimals 0 for whole numbers only, 1 for one number after the decimal point, etc.
    @side(client)
    function SetDecimals(decimals: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Does not trigger `DNumberScratch:OnValueChanged`
    --- Use `DNumberScratch:SetValue` instead.
    --- @param val The value to set
    @side(client)
    function SetFloatValue(val: number): nil
    --- Sets the value of the `DNumberScratch` as a fraction, a value between 0 and 1 where 0 is the minimum and 1 is the maximum value of the `DNumberScratch`
    --- @param frac A value between 0 and 1
    @side(client)
    function SetFraction(frac: number): nil
    --- Sets the max value that can be selected on the number scratch
    --- @param max The maximum number
    @side(client)
    function SetMax(max: number): nil
    --- Sets the minimum value that can be selected on the number scratch.
    --- @param min The minimum number
    @side(client)
    function SetMin(min: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets if the scratch window should be drawn or not. Cannot be used to force it to draw, only to hide it, which will not stop the panel from working with invisible window.
    @side(client)
    function SetShouldDrawScreen(shouldDraw: boolean): nil
    --- Sets the value of the `DNumberScratch` and triggers `DNumberScratch:OnValueChanged`
    --- @param val The value to set.
    @side(client)
    function SetValue(val: number): nil
    --- Sets the zoom level of the scratch panel.
    @side(client)
    function SetZoom(zoom: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Forces the assigned ConVar to be updated to the value of this `DNumberScratch`
    @side(client)
    function UpdateConVar(): nil
end

--- Basic text input field.
--- See `DTextEntry` for a more advanced version.
declare class TextEntry extends Panel
end

--- A form which may be used to display text the player is meant to select and copy or alternately allow them to enter some text of their own.
--- **NOTE**: At least one of your `DTextEntry`'s parents must either be an `EditablePanel` or derived from it (like a `DFrame`, for example), else it won't be able to focus and thus be unselectable.
--- You must also call `Panel:MakePopup` on said panel or the `DTextEntry` will not work.
declare class DTextEntry extends TextEntry
    --- Adds an entry to `DTextEntry`'s history.
    --- See `DTextEntry:SetHistoryEnabled`.
    --- @param text Text to add to the text entry's history.
    @side(client)
    function AddHistory(text: string): nil
    --- Called whenever the value of the panel has been updated (whether by user input or otherwise).
    --- It allows you to determine whether a user can modify the `TextEntry`'s text.
    --- By default, this only checks whether the panel disallows numeric characters, preventing it from being edited if the value contains any.
    --- This is actually an engine hook that only works on `TextEntry` derived elements.
    --- If you are looking for a way to modify character limits, see `Panel:SetMaximumCharCount`
    --- @param char The last character entered into the panel.
    --- @return boolean Return `true` to prevent the value from changing, `false` to allow it.
    @side(client)
    function AllowInput(char: string): boolean
    --- Returns whether a string is numeric or not.
    --- Always returns false if the `DTextEntry:SetNumeric` is set to false.
    --- @param strValue The string to check.
    --- @return boolean Whether the string is numeric or not.
    @side(client)
    function CheckNumeric(strValue: string): boolean
    --- Called by the DTextEntry when a list of autocompletion options is requested. Meant to be overridden.
    --- @param inputText Player's current input.
    --- @return { [any]: any } If a table is returned, the values of the table will show up as autocomplete suggestions for the user.
    @side(client)
    function GetAutoComplete(inputText: string): { [any]: any }
    --- Returns the cursor color of a DTextEntry.
    --- @return Color The color of the cursor as a Color.
    @side(client)
    function GetCursorColor(): Color
    --- Returns whether the textbox is disabled. Use `Panel:IsEnabled` instead.
    --- @return boolean Whether the textbox is disabled.
    --- @deprecated Use Panel:IsEnabled instead.
    @side(client)
    function GetDisabled(): boolean
    --- Alias of `DTextEntry:GetPaintBackground`. Use that instead.
    --- Whether the background is displayed or not.
    @side(client)
    function GetDrawBackground(): boolean
    --- Returns the value set by `DTextEntry:SetDrawBorder`.
    @side(client)
    function GetDrawBorder(): boolean
    --- Returns whether pressing Enter can cause the panel to lose focus. Note that a multiline DTextEntry cannot be escaped using the Enter key even when this function returns true.
    --- @return boolean Whether pressing the Enter key can cause the panel to lose focus.
    @side(client)
    function GetEnterAllowed(): boolean
    --- Returns the contents of the DTextEntry as a number.
    --- @return number Text of the DTextEntry as a float, or nil if it cannot be converted to a number using Global.tonumber.
    @side(client)
    function GetFloat(): number
    --- Returns the highlight/text selection color of the text entry. If it was not overwritten, it will return the derma skin value. (`colTextEntryTextHighlight`)
    --- @return Color The highlight Global.Color.
    @side(client)
    function GetHighlightColor(): Color
    --- Returns whether the history functionality of  `DTextEntry` is enabled. See `DTextEntry:AddHistory`.
    --- @return boolean Whether the history is enabled or not.
    @side(client)
    function GetHistoryEnabled(): boolean
    --- Similar to `DTextEntry:GetFloat`, but rounds the value to the nearest integer.
    --- @return number Text of the DTextEntry as a round number, or nil if it cannot be converted to a number.
    @side(client)
    function GetInt(): number
    --- Returns whether only numeric characters (`123456789.-`) can be entered into the DTextEntry.
    --- @return boolean Whether the DTextEntry is numeric or not.
    @side(client)
    function GetNumeric(): boolean
    --- Whether the background is displayed or not
    --- @return boolean `false` hides the background; this is `true` by default.
    @side(client)
    function GetPaintBackground(): boolean
    --- Return current color of panel placeholder
    --- @return Color Current placeholder color
    @side(client)
    function GetPlaceholderColor(): Color
    --- Returns the placeholder text set with `DTextEntry:SetPlaceholderText`.
    @side(client)
    function GetPlaceholderText(): string
    --- Returns whether or not the panel accepts tab key.
    --- @return boolean Whether the DTextEntry should ignore tab.
    @side(client)
    function GetTabbingDisabled(): boolean
    --- Returns the text color of a DTextEntry.
    --- @return Color The color of the text as a Color.
    @side(client)
    function GetTextColor(): Color
    --- Returns whether the `DTextEntry` is set to run `DTextEntry:OnValueChange` every time a character is typed or deleted or only when Enter is pressed.
    @side(client)
    function GetUpdateOnType(): boolean
    --- Returns whether this DTextEntry is being edited or not. (i.e. has focus)
    --- @return boolean Whether this DTextEntry is being edited or not
    @side(client)
    function IsEditing(): boolean
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called internally when the text inside the `DTextEntry` changes. This is an implementation of `TextEntry:OnTextChanged`
    --- You should not override this function. Use `DTextEntry:OnValueChange` instead.
    --- @param noMenuRemoval Determines whether to remove the autocomplete menu (false) or not (true).
    @side(client)
    function OnTextChanged(noMenuRemoval: boolean): nil
    --- **INTERNAL**: You really should be using `DTextEntry:GetAutoComplete` instead.
    --- Builds a `DMenu` for the DTextEntry based on the input table.
    --- @param tab Table containing results from DTextEntry:GetAutoComplete.
    @side(client)
    function OpenAutoComplete(tab: { [any]: any }): nil
    --- Sets the cursor's color in  DTextEntry (the blinking line).
    --- @param color The color to set the cursor to.
    @side(client)
    function SetCursorColor(color: Color): nil
    --- Disables input on a DTextEntry and greys it out visually. This differs from `DTextEntry:SetEditable` which doesn't visually change the textbox.
    --- @param disabled Whether the textbox should be disabled
    --- @deprecated Use Panel:SetEnabled instead.
    @side(client)
    function SetDisabled(disabled: boolean): nil
    --- Alias of `DTextEntry:SetPaintBackground`. Use that instead.
    @side(client)
    function SetDrawBackground(show: boolean): nil
    --- Does nothing.
    @side(client)
    function SetDrawBorder(bool: boolean): nil
    --- Disables Input on a DTextEntry. This differs from `DTextEntry:SetDisabled` - SetEditable will not affect the appearance of the textbox.
    --- @param enabled Whether the DTextEntry should be editable
    @side(client)
    function SetEditable(enabled: boolean): nil
    --- Sets whether pressing the Enter key will cause the DTextEntry to lose focus or not, provided it is not multiline. This is true by default.
    --- @param allowEnter If set to false, pressing Enter will not cause the panel to lose focus and will never call DTextEntry:OnEnter.
    @side(client)
    function SetEnterAllowed(allowEnter: boolean): nil
    --- Changes the font of the DTextEntry.
    --- @param font The name of the font to be changed to.
    @side(client)
    function SetFont(font: string): nil
    --- Sets/overrides the default highlight/text selection color of the text entry.
    --- @param color The new highlight Color.
    @side(client)
    function SetHighlightColor(color: Color): nil
    --- Enables or disables the history functionality of  `DTextEntry`. This allows the player to scroll through history elements using up and down arrow keys.
    --- See `DTextEntry:AddHistory`.
    --- @param enable Whether to enable history or not.
    @side(client)
    function SetHistoryEnabled(enable: boolean): nil
    --- Sets whether or not to decline non-numeric characters as input.
    --- Numeric characters are `1234567890.-`
    --- @param numericOnly Whether to accept only numeric characters.
    @side(client)
    function SetNumeric(numericOnly: boolean): nil
    --- Sets whether to show the default background of the DTextEntry.
    --- @param show `false` hides the background; this is `true` by default.
    @side(client)
    function SetPaintBackground(show: boolean): nil
    --- Allow you to set placeholder color.
    --- @param color The color of the placeholder.
    @side(client)
    function SetPlaceholderColor(color: Color | nil): nil
    --- Sets the placeholder text that will be shown while the text entry has no user text. The player will not need to delete the placeholder text if they decide to start typing.
    @side(client)
    function SetPlaceholderText(text: string | nil): nil
    --- Sets whether or not the panel accepts tab key.
    --- **NOTE**: Disabling tab key prevents the panel from unfocusing by mouse, however, still works for focusing to other keyboard focus.
    --- @param enabled Whether the DTextEntry should ignore tab.
    @side(client)
    function SetTabbingDisabled(enabled: boolean): nil
    --- Sets the text color of the `DTextEntry`.
    --- @param color The text color. Uses the Color.
    @side(client)
    function SetTextColor(color: Color): nil
    --- Sets whether we should fire `DTextEntry:OnValueChange` every time we type or delete a character or only when Enter is pressed.
    @side(client)
    function SetUpdateOnType(updateOnType: boolean): nil
    --- Sets the text of the `DTextEntry` and calls `DTextEntry:OnValueChange`.
    --- **NOTE**: The text of the `DTextEntry` only changes if it's not currently being typed in. If you would rather set the text regardless, use `Panel:SetText`.
    --- @param text The value to set.
    @side(client)
    function SetValue(text: string): nil
    --- **INTERNAL**: Used by `DTextEntry:OnTextChanged`, `DTextEntry:OnEnter` and `DTextEntry:OnLoseFocus`
    --- Updates the ConVar associated with the TextEntry to its new value.
    @side(client)
    function UpdateConvarValue(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to set text from the history.
    @side(client)
    function UpdateFromHistory(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to set text from the autocomplete menu.
    @side(client)
    function UpdateFromMenu(): nil
end

--- DNumberWang is a VGUI element that allows you to input a numeric value using up and down arrows or direct entry.
declare class DNumberWang extends DTextEntry
    --- Returns the amount of decimal places allowed in the number selector, set by `DNumberWang:SetDecimals`
    --- @return number The amount of decimal places allowed in the number selector.
    @side(client)
    function GetDecimals(): number
    --- Returns whatever is set by `DNumberWang:SetFloatValue` or 0.
    @side(client)
