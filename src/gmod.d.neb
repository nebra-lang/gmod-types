declare NPC_STATE_COMBAT: number
--- NPC is executing scripted sequence
declare NPC_STATE_SCRIPT: number
--- NPC is playing dead (used for expressions)
declare NPC_STATE_PLAYDEAD: number
--- NPC is prone to death
declare NPC_STATE_PRONE: number
--- NPC is dead
declare NPC_STATE_DEAD: number
--- Amount of `Enums/CLASS`. Used by `Global.Add_NPC_Class`.
declare NUM_AI_CLASSES: number
--- Amount of `Enums/HULL`.
declare NUM_HULLS: number
--- Not spectating
declare OBS_MODE_NONE: number
--- Camera doesn't move, but adjusts camera angles to follow the spectated target
declare OBS_MODE_DEATHCAM: number
--- TF2-like freeze-cam, then acts like `OBS_MODE_FIXED`.
declare OBS_MODE_FREEZECAM: number
--- Same as OBS_MODE_CHASE, but you can't rotate the view
declare OBS_MODE_FIXED: number
--- Spectate a specific player from first person view.
declare OBS_MODE_IN_EYE: number
--- Chase cam, 3rd person cam, free rotation around the spectated target
declare OBS_MODE_CHASE: number
--- Free roam/noclip-alike. Does not work from `GM:PlayerDeath`
declare OBS_MODE_ROAMING: number
--- Particle spawns in entity's origin and does not follow it
declare PATTACH_ABSORIGIN: number
--- Particle attaches to entity's origin and follows the entity
declare PATTACH_ABSORIGIN_FOLLOW: number
--- Create at a custom origin, but don't follow
declare PATTACH_CUSTOMORIGIN: number
--- Particle attaches to passed to `Global.ParticleEffectAttach` attachment id, but does not follow the entity
declare PATTACH_POINT: number
--- Particle attaches to passed to `Global.ParticleEffectAttach` attachment id and follows the entity
declare PATTACH_POINT_FOLLOW: number
--- Particle spawns in the beginning of coordinates ( Vector( 0, 0, 0 ) ), used for control points that don't attach to an entity
declare PATTACH_WORLDORIGIN: number
declare PLAYER_IDLE: number
declare PLAYER_WALK: number
