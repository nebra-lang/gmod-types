--- Huge static prop, possibly leftover from goldsrc
declare RENDERGROUP_STATIC_HUGE: number
--- Huge opaque entity, possibly leftover from goldsrc
declare RENDERGROUP_OPAQUE_HUGE: number
--- Static props?
declare RENDERGROUP_STATIC: number
--- For non transparent/solid entities. For scripted entities, this will have `ENTITY:Draw` called
declare RENDERGROUP_OPAQUE: number
--- For translucent/transparent entities For scripted entities, this will have `ENTITY:DrawTranslucent` called
declare RENDERGROUP_TRANSLUCENT: number
--- For both translucent/transparent and opaque/solid anim entities For scripted entities, this will have both, `ENTITY:Draw` and `ENTITY:DrawTranslucent` called
declare RENDERGROUP_BOTH: number
--- Solid weapon view models
declare RENDERGROUP_VIEWMODEL: number
--- Transparent overlays etc
declare RENDERGROUP_VIEWMODEL_TRANSLUCENT: number
--- For brush entities
declare RENDERGROUP_OPAQUE_BRUSH: number
--- Unclassfied. Won't get drawn.
declare RENDERGROUP_OTHER: number
--- Default render mode. Transparently has no effect.
declare RENDERMODE_NORMAL: number
--- Supports transparency. Use this to make alpha of `Global.Color` work for your entity. For players, it must be set for their active weapon aswell.
declare RENDERMODE_TRANSCOLOR: number
declare RENDERMODE_TRANSTEXTURE: number
--- Intended for glowing sprites. Allows transparency, and forces the sprite or model to be rendered unlit. The size of a sprite rendered with Glow is consistent with the screen size (unlike the alternative World Space Glow), making it appear larger at a distance, in comparison to the world. The GlowProxySize keyvalue affects this Render Mode on sprites.
declare RENDERMODE_GLOW: number
--- Enables Alphatesting. Legacy port from Goldsource. Obsolete in Source due to Alphatesting being handled in materials. Does not allow transparency.
declare RENDERMODE_TRANSALPHA: number
--- Add the material's color values to the existing image, instead of performing a multiplication. Sprites will appear through world geometry and the sprite/model will always brighten the world. Allows transparency.
declare RENDERMODE_TRANSADD: number
--- Causes the material to be not be drawn at all, similarly to Don't Render.
declare RENDERMODE_ENVIROMENTAL: number
--- Functions like Additive, but also blends between animation frames. Requires the material to have a functioning animating texture. Allows transparency.
declare RENDERMODE_TRANSADDFRAMEBLEND: number
--- Functions similarly to Additive, except that the alpha channel controls the opacity of the sprite. An example of use is for dark sprites, with an example material being sprites/strider_blackball.vmt.
declare RENDERMODE_TRANSALPHADD: number
--- Functions similarly to Glow, with the exception that the size of the sprite is relative to the world rather than the screen. The GlowProxySize keyvalue affects this Render Mode on sprites.
declare RENDERMODE_WORLDGLOW: number
--- The entity is still being drawn and networked albeit invisible, therefore not making this Render Mode ideal for performance reasons. To completely avoid drawing and networking an entity, see EF_NODRAW.
declare RENDERMODE_NONE: number
--- Only allowed for render targets that don't want a depth buffer (because if they have a depth buffer, the render target must be less than or equal to the size of the framebuffer).
declare RT_SIZE_NO_CHANGE: number
--- Don't play with the specified width and height other than making sure it fits in the framebuffer.
declare RT_SIZE_DEFAULT: number
--- Apply picmip to the render target's width and height.
declare RT_SIZE_PICMIP: number
--- frame_buffer_width / 4
declare RT_SIZE_HDR: number
--- Same size as frame buffer, or next lower power of 2 if we can't do that.
declare RT_SIZE_FULL_FRAME_BUFFER: number
--- Target of specified size, don't mess with dimensions
declare RT_SIZE_OFFSCREEN: number
--- Same size as the frame buffer, rounded up if necessary for systems that can't do non-power of two textures.
declare RT_SIZE_FULL_FRAME_BUFFER_ROUNDED_UP: number
--- Rounded down to power of 2, essentially
declare RT_SIZE_REPLAY_SCREENSHOT: number
--- Use the size passed in. Don't clamp it to the frame buffer size. Really.
declare RT_SIZE_LITERAL: number
--- Use the size passed in, don't clamp to the frame buffer size, but do apply picmip restrictions.
declare RT_SIZE_LITERAL_PICMIP: number
--- The schedule enum limit
declare LAST_SHARED_SCHEDULE: number
--- Begins AI script based on NPC's `m_hCine` save value.
declare SCHED_AISCRIPT: number
--- Idle stance and face ideal yaw angles.
declare SCHED_ALERT_FACE: number
declare SCHED_ALERT_FACE_BESTSOUND: number
declare SCHED_ALERT_REACT_TO_COMBAT_SOUND: number
--- Rotate 180 degrees and back to check for enemies.
declare SCHED_ALERT_SCAN: number
--- Remain idle until an enemy is heard or found.
declare SCHED_ALERT_STAND: number
--- Walk until an enemy is heard or found.
declare SCHED_ALERT_WALK: number
--- Remain idle until provoked or an enemy is found.
declare SCHED_AMBUSH: number
--- Performs ACT_ARM.
declare SCHED_ARM_WEAPON: number
--- Back away from enemy. If not possible to back away then go behind enemy.
declare SCHED_BACK_AWAY_FROM_ENEMY: number
--- Requires valid enemy, backs away from SaveValue: m_vSavePosition
declare SCHED_BACK_AWAY_FROM_SAVE_POSITION: number
--- Heavy damage was taken for the first time in a while.
declare SCHED_BIG_FLINCH: number
--- Begin chasing an enemy.
declare SCHED_CHASE_ENEMY: number
--- Failed to chase enemy.
declare SCHED_CHASE_ENEMY_FAILED: number
--- Face current enemy.
declare SCHED_COMBAT_FACE: number
--- Will walk around patrolling an area until an enemy is found.
declare SCHED_COMBAT_PATROL: number
declare SCHED_COMBAT_STAND: number
declare SCHED_COMBAT_SWEEP: number
declare SCHED_COMBAT_WALK: number
--- When not moving, will perform ACT_COWER.
declare SCHED_COWER: number
--- Regular NPC death.
declare SCHED_DIE: number
--- Plays NPC death sound (doesn't kill NPC).
declare SCHED_DIE_RAGDOLL: number
--- Holsters active weapon. (Only works with NPC's that can holster weapons)
declare SCHED_DISARM_WEAPON: number
declare SCHED_DROPSHIP_DUSTOFF: number
--- Preform Ducking animation. (Only works with npc_alyx)
declare SCHED_DUCK_DODGE: number
--- Search for a place to shoot current enemy.
declare SCHED_ESTABLISH_LINE_OF_FIRE: number
--- Fallback from an established line of fire.
declare SCHED_ESTABLISH_LINE_OF_FIRE_FALLBACK: number
--- Failed doing current schedule.
declare SCHED_FAIL: number
--- Failed to establish a line of fire.
declare SCHED_FAIL_ESTABLISH_LINE_OF_FIRE: number
declare SCHED_FAIL_NOSTOP: number
--- Failed to take cover.
declare SCHED_FAIL_TAKE_COVER: number
--- Fall to ground when in the air.
declare SCHED_FALL_TO_GROUND: number
--- Will express fear face. (Only works on NPCs with expressions)
declare SCHED_FEAR_FACE: number
declare SCHED_FLEE_FROM_BEST_SOUND: number
--- Plays ACT_FLINCH_PHYSICS.
declare SCHED_FLINCH_PHYSICS: number
--- Force walk to SaveValue: m_vecLastPosition (debug).
declare SCHED_FORCED_GO: number
--- Force run to SaveValue: m_vecLastPosition (debug).
declare SCHED_FORCED_GO_RUN: number
--- Pick up item if within a radius of 5 units.
declare SCHED_GET_HEALTHKIT: number
--- Take cover and reload weapon.
declare SCHED_HIDE_AND_RELOAD: number
--- Idle stance
declare SCHED_IDLE_STAND: number
--- Walk to position.
declare SCHED_IDLE_WALK: number
--- Walk to random position within a radius of 200 units.
declare SCHED_IDLE_WANDER: number
declare SCHED_INTERACTION_MOVE_TO_PARTNER: number
declare SCHED_INTERACTION_WAIT_FOR_PARTNER: number
declare SCHED_INVESTIGATE_SOUND: number
declare SCHED_MELEE_ATTACK1: number
declare SCHED_MELEE_ATTACK2: number
--- Move away from player.
declare SCHED_MOVE_AWAY: number
--- Stop moving and continue enemy scan.
declare SCHED_MOVE_AWAY_END: number
--- Failed to move away; stop moving.
declare SCHED_MOVE_AWAY_FAIL: number
--- Move away from enemy while facing it and checking for new enemies.
declare SCHED_MOVE_AWAY_FROM_ENEMY: number
--- Move to the range the weapon is preferably used at.
declare SCHED_MOVE_TO_WEAPON_RANGE: number
--- Pick up a new weapon if within a radius of 5 units.
