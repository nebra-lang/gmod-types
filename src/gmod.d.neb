--- Glass
declare CONTENTS_WINDOW: number
declare CONTENTS_AUX: number
--- Bullets go through, solids don't
declare CONTENTS_GRATE: number
declare CONTENTS_SLIME: number
--- Hits world but not skybox
declare CONTENTS_WATER: number
--- Things that block line of sight
declare CONTENTS_BLOCKLOS: number
--- Things that block light
declare CONTENTS_OPAQUE: number
declare CONTENTS_TESTFOGVOLUME: number
declare CONTENTS_TEAM4: number
declare CONTENTS_TEAM3: number
declare CONTENTS_TEAM1: number
declare CONTENTS_TEAM2: number
declare CONTENTS_IGNORE_NODRAW_OPAQUE: number
declare CONTENTS_MOVEABLE: number
declare CONTENTS_AREAPORTAL: number
declare CONTENTS_PLAYERCLIP: number
declare CONTENTS_MONSTERCLIP: number
declare CONTENTS_CURRENT_0: number
declare CONTENTS_CURRENT_180: number
declare CONTENTS_CURRENT_270: number
declare CONTENTS_CURRENT_90: number
declare CONTENTS_CURRENT_DOWN: number
declare CONTENTS_CURRENT_UP: number
--- Includes, among other things, client-side ragdolls and prop gibs
declare CONTENTS_DEBRIS: number
declare CONTENTS_DETAIL: number
--- Hitbox
declare CONTENTS_HITBOX: number
--- Ladder
declare CONTENTS_LADDER: number
--- NPCs
declare CONTENTS_MONSTER: number
declare CONTENTS_ORIGIN: number
--- Hits world but not skybox
declare CONTENTS_TRANSLUCENT: number
--- Last visible contents enumeration
declare LAST_VISIBLE_CONTENTS: number
--- Sum of all the visible contents enumerations
declare ALL_VISIBLE_CONTENTS: number
--- Makes this render target an HDR render target if the current system supports HDR.
declare CREATERENDERTARGETFLAGS_HDR: number
--- Does nothing.
declare CREATERENDERTARGETFLAGS_AUTOMIPMAP: number
--- Does nothing
declare CREATERENDERTARGETFLAGS_UNFILTERABLE_OK: number
--- Default citizen
declare CT_DEFAULT: number
--- Default citizen(?)
declare CT_DOWNTRODDEN: number
--- Refugee
declare CT_REFUGEE: number
--- Rebel
declare CT_REBEL: number
--- Odessa?
declare CT_UNIQUE: number
--- Error
declare D_ER: number
--- Hate
declare D_HT: number
--- Frightened / Fear
declare D_FR: number
--- Like
declare D_LI: number
--- Neutral
declare D_NU: number
--- Was the victim friendly?
declare DEATH_NOTICE_FRIENDLY_VICTIM: number
--- Was the attacker friendly?
declare DEATH_NOTICE_FRIENDLY_ATTACKER: number
declare DISPSURF_SURFACE: number
declare DISPSURF_WALKABLE: number
declare DISPSURF_BUILDABLE: number
declare DISPSURF_SURFPROP1: number
declare DISPSURF_SURFPROP2: number
--- Generic damage (used by weapon_fists)
declare DMG_GENERIC: number
--- Caused by physics interaction and ignored by airboat drivers. This is used by the Rollermine and an unused animation attack called 'Fireattack' by the Antlion Guard `ACT_RANGE_ATTACK1`
declare DMG_CRUSH: number
--- Bullet damage from Ceiling Turrets, the Strider, Turrets and most guns.
declare DMG_BULLET: number
--- Used by the Stunstick, Manhacks, Antlions, Antlion Guards, Headcrabs, Fast Headcrabs, all Zombies types, Hunter, and potentially other NPCs attacks
declare DMG_SLASH: number
--- Damage from fire
declare DMG_BURN: number
--- Hit by a vehicle (This will need to be set for passengers of some vehicle to receive damage)
declare DMG_VEHICLE: number
--- Fall damage
declare DMG_FALL: number
--- Explosion damage like grenades, helicopter bombs, combine mines, Will be ignored by most vehicle passengers.
declare DMG_BLAST: number
--- Blunt attacks such as from the Crowbar, Antlion Guard & Hunter
declare DMG_CLUB: number
--- Electrical damage, shows smoke at the damage position and its used by Stalkers & Vortigaunts
declare DMG_SHOCK: number
--- Sonic damage, used by the Gargantua and Houndeye NPCs
declare DMG_SONIC: number
--- Laser damage
declare DMG_ENERGYBEAM: number
--- Prevent a physics force.
declare DMG_PREVENT_PHYSICS_FORCE: number
--- Crossbow damage, never creates gibs.
declare DMG_NEVERGIB: number
--- Always create gibs
declare DMG_ALWAYSGIB: number
--- Drown damage
declare DMG_DROWN: number
--- Same as DMG_POISON
declare DMG_PARALYZE: number
--- Neurotoxin damage
declare DMG_NERVEGAS: number
--- Poison damage used by Antlion Workers & Poison Headcrabs.
declare DMG_POISON: number
--- Radiation damage & it will be ignored by most vehicle passengers
declare DMG_RADIATION: number
--- Damage applied to the player to restore health after drowning
declare DMG_DROWNRECOVER: number
--- Toxic chemical or acid burn damage used by the Antlion Workers
declare DMG_ACID: number
--- In an oven
declare DMG_SLOWBURN: number
--- Don't create a ragdoll on death
declare DMG_REMOVENORAGDOLL: number
--- Damage done by the gravity gun.
declare DMG_PHYSGUN: number
--- Plasma damage
declare DMG_PLASMA: number
--- Airboat gun damage
declare DMG_AIRBOAT: number
--- Forces the entity to dissolve on death. This is what the combine ball uses when it hits a target.
declare DMG_DISSOLVE: number
--- This won't hurt the player underwater
declare DMG_BLAST_SURFACE: number
--- Direct damage to the entity that does not go through any damage value modifications
declare DMG_DIRECT: number
--- The pellets fired from a shotgun
declare DMG_BUCKSHOT: number
--- Damage from SniperRound/SniperPenetratedRound ammo types
declare DMG_SNIPER: number
--- Damage from npc_missiledefense, npc_combinegunship, or monster_mortar
declare DMG_MISSILEDEFENSE: number
--- Don't dock
declare NODOCK: number
--- Fill parent
declare FILL: number
--- Dock to the left
declare LEFT: number
--- Dock to the right
declare RIGHT: number
--- Dock to the top
declare TOP: number
--- Dock to the bottom
declare BOTTOM: number
declare DOF_OFFSET: number
declare DOF_SPACING: number
--- Performs bone merge on client side, merging bone positions of child entities (`Entity:SetParent`) with those of the parent, by bone names. The skeletons should have identical proportions, however it is not a requirement.
declare EF_BONEMERGE: number
--- For use with EF_BONEMERGE. If this is set, then it places this ents origin at its parent and uses the parent's bbox + the max extents of the aiment. Otherwise, it sets up the parent's bones every frame to figure out where to place the aiment, which is inefficient because it'll setup the parent's bones even if the parent is not in the PVS.
declare EF_BONEMERGE_FASTCULL: number
--- DLIGHT centered at entity origin.
declare EF_BRIGHTLIGHT: number
--- Player flashlight.
declare EF_DIMLIGHT: number
--- Seems to have no effect. Has been replaced with [C_BaseEntity::IsNoInterpolationFrame()](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/client/c_baseentity.h#L1331-L1332). Don't interpolate the next frame.
declare EF_NOINTERP: number
--- Disables shadow.
declare EF_NOSHADOW: number
--- Prevents the entity from drawing and networking.
declare EF_NODRAW: number
--- Don't receive shadows.
declare EF_NORECEIVESHADOW: number
--- Makes the entity blink.
declare EF_ITEM_BLINK: number
--- Always assume that the parent entity is animating.
declare EF_PARENT_ANIMATES: number
--- Internal flag that is set by `Entity:FollowBone`.
declare EF_FOLLOWBONE: number
--- GMod-specific. Makes the entity not accept being lit by projected textures, including the player's flashlight.
declare EF_NOFLASHLIGHT: number
--- This entity is marked for death -- This allows the game to actually delete ents at a safe time. **WARNING**: You should never set this flag manually.
declare EFL_KILLME: number
--- Entity is dormant, no updates to client
declare EFL_DORMANT: number
--- Lets us know when the noclip command is active
declare EFL_NOCLIP_ACTIVE: number
--- Set while a model is setting up its bones
declare EFL_SETTING_UP_BONES: number
--- This is a special entity that should not be deleted when we respawn entities via `game.CleanUpMap`.
declare EFL_KEEP_ON_RECREATE_ENTITIES: number
--- One of the child entities is a player
declare EFL_HAS_PLAYER_CHILD: number
--- (Client only) need shadow manager to update the shadow
declare EFL_DIRTY_SHADOWUPDATE: number
--- Another entity is watching events on this entity (used by teleport)
declare EFL_NOTIFY: number
--- The default behavior in ShouldTransmit is to not send an entity if it doesn't have a model. Certain entities want to be sent anyway because all the drawing logic is in the client DLL. They can set this flag and the engine will transmit them even if they don't have model
declare EFL_FORCE_CHECK_TRANSMIT: number
--- This is set on bots that are frozen
declare EFL_BOT_FROZEN: number
--- Non-networked entity
declare EFL_SERVER_ONLY: number
--- Don't attach the edict
declare EFL_NO_AUTO_EDICT_ATTACH: number
--- Some 'dirty' bits with respect to absolute computations. Used internally by the engine when an entity's absolute position needs to be recalculated.
declare EFL_DIRTY_ABSTRANSFORM: number
--- Some 'dirty' bits with respect to absolute computations. Used internally by the engine when an entity's absolute velocity needs to be recalculated.
declare EFL_DIRTY_ABSVELOCITY: number
--- Some 'dirty' bits with respect to absolute computations. Used internally by the engine when an entity's absolute angular velocity needs to be recalculated.
declare EFL_DIRTY_ABSANGVELOCITY: number
--- Marks the entity as having a 'dirty' surrounding box. Used internally by the engine to recompute the entity's collision bounds.
declare EFL_DIRTY_SURROUNDING_COLLISION_BOUNDS: number
--- Used internally by the engine when an entity's "spatial partition" needs to be recalculated.
declare EFL_DIRTY_SPATIAL_PARTITION: number
--- This is set if the entity detects that it's in the skybox. This forces it to pass the "in PVS" for transmission
declare EFL_IN_SKYBOX: number
--- Entities with this flag set show up in the partition even when not solid
declare EFL_USE_PARTITION_WHEN_NOT_SOLID: number
--- Used to determine if an entity is floating
declare EFL_TOUCHING_FLUID: number
--- The entity is currently being lifted by a Barnacle.
declare EFL_IS_BEING_LIFTED_BY_BARNACLE: number
--- The entity is not affected by 'rotorwash push'--the wind-push effect caused by helicopters close to the ground in Half-Life 2.
declare EFL_NO_ROTORWASH_PUSH: number
--- Avoid executing the entity's Think
declare EFL_NO_THINK_FUNCTION: number
--- The entity is currently not simulating any physics.
declare EFL_NO_GAME_PHYSICS_SIMULATION: number
--- The entity is about to have its untouch callback checked, e.g. when this entity stops touching another entity.
declare EFL_CHECK_UNTOUCH: number
--- Entity shouldn't block NPC line-of-sight
declare EFL_DONTBLOCKLOS: number
--- NPCs should not walk on this entity
declare EFL_DONTWALKON: number
--- The entity shouldn't dissolve
declare EFL_NO_DISSOLVE: number
--- Mega physcannon can't ragdoll these guys
declare EFL_NO_MEGAPHYSCANNON_RAGDOLL: number
--- Don't adjust this entity's velocity when transitioning into water
declare EFL_NO_WATER_VELOCITY_CHANGE: number
--- Physcannon can't pick these up or punt them
declare EFL_NO_PHYSCANNON_INTERACTION: number
--- Doesn't accept forces from physics damage
declare EFL_NO_DAMAGE_FORCES: number
--- Save the `ConVar` value into either client.vdf or server.vdf Reported as "a" by `cvarlist`, except Lua `ConVar`s
declare FCVAR_ARCHIVE: number
--- Save the `ConVar` value into config.vdf on XBox
declare FCVAR_ARCHIVE_XBOX: number
--- Requires `sv_cheats` to be enabled to change the `ConVar` or run the command Reported as "cheat" by `cvarlist`
declare FCVAR_CHEAT: number
--- `IVEngineClient::ClientCmd` is allowed to execute this command Reported as "clientcmd_can_execute" by `cvarlist`
declare FCVAR_CLIENTCMD_CAN_EXECUTE: number
--- `ConVar` is defined by the client DLL. This flag is set automatically Reported as "cl" by `cvarlist`
declare FCVAR_CLIENTDLL: number
--- Force the `ConVar` to be recorded by demo recordings. Reported as "demo" by `cvarlist`
declare FCVAR_DEMO: number
--- Opposite of `FCVAR_DEMO`, ensures the `ConVar` is not recorded in demos Reported as "norecord" by `cvarlist`
declare FCVAR_DONTRECORD: number
--- `ConVar` is defined by the game DLL. This flag is set automatically Reported as "sv" by `cvarlist`
declare FCVAR_GAMEDLL: number
--- Set automatically on all ConVars and console commands created by the client Lua state. Reported as "lua_client" by `cvarlist`
declare FCVAR_LUA_CLIENT: number
--- Set automatically on all ConVars and console commands created by the server Lua state. Reported as "lua_server" by `cvarlist`
declare FCVAR_LUA_SERVER: number
--- Tells the engine to never print this variable as a string. This is used for variables which may contain control characters. Reported as "numeric" by `cvarlist`
declare FCVAR_NEVER_AS_STRING: number
--- No flags
declare FCVAR_NONE: number
--- For serverside `ConVar`s, notifies all players with blue chat text when the value gets changed, also makes the convar appear in [A2S_RULES](https://developer.valvesoftware.com/wiki/Server_queries#A2S_RULES) Reported as "nf" by `cvarlist`
declare FCVAR_NOTIFY: number
--- Makes the `ConVar` not changeable while connected to a server or in singleplayer
declare FCVAR_NOT_CONNECTED: number
--- Forces the `ConVar` to only have printable characters (No control characters) Reported as "print" by `cvarlist`
declare FCVAR_PRINTABLEONLY: number
--- Makes the `ConVar` value hidden from all clients (For example `sv_password`) Reported as "prot" by `cvarlist`
declare FCVAR_PROTECTED: number
--- For serverside `ConVar`s, it will enforce its value on all clients. The `ConVar` with the same name must also exist on the client! Reported as "rep" by `cvarlist`
declare FCVAR_REPLICATED: number
--- Prevents the server from querying value of this `ConVar`
declare FCVAR_SERVER_CANNOT_QUERY: number
--- The server is allowed to execute this command on clients. Reported as "server_can_execute" by `cvarlist`
declare FCVAR_SERVER_CAN_EXECUTE: number
--- Executing the command or changing the `ConVar` is only allowed in singleplayer Reported as "sp" by `cvarlist`
declare FCVAR_SPONLY: number
--- Don't log the `ConVar` changes to console/log files/users Reported as "log" by `cvarlist`
declare FCVAR_UNLOGGED: number
--- If this is set, the convar will become anonymous and won't show up in the `find` results.
declare FCVAR_UNREGISTERED: number
--- For clientside commands, sends the value to the server Reported as "user" by `cvarlist`
declare FCVAR_USERINFO: number
--- 128 levels
declare FFT_256: number
--- 256 levels
declare FFT_512: number
--- 512 levels
declare FFT_1024: number
--- 1024 levels
declare FFT_2048: number
--- 2048 levels
declare FFT_4096: number
--- 4096 levels
declare FFT_8192: number
--- 8192 levels
declare FFT_16384: number
--- 16384 levels
declare FFT_32768: number
--- Is the entity on ground or not
declare FL_ONGROUND: number
--- Is player ducking or not
declare FL_DUCKING: number
--- Is the player in the process of ducking or standing up
declare FL_ANIMDUCKING: number
--- The player is jumping out of water
declare FL_WATERJUMP: number
--- This player is controlling a func_train
declare FL_ONTRAIN: number
--- Indicates the entity is standing in rain
declare FL_INRAIN: number
--- Completely freezes the player Bots will still be able to look around.
declare FL_FROZEN: number
--- This player is controlling something UI related in the world, this prevents his movement, but doesn't freeze mouse movement, jumping, etc.
declare FL_ATCONTROLS: number
--- Is this entity a player or not
declare FL_CLIENT: number
--- Bots have this flag
declare FL_FAKECLIENT: number
--- Is the player in water or not
declare FL_INWATER: number
--- This entity can fly
declare FL_FLY: number
--- This entity can swim
declare FL_SWIM: number
--- This entity is a func_conveyor
declare FL_CONVEYOR: number
--- NPCs have this flag (NPC: Ignore player push)
declare FL_NPC: number
--- Whether the player has god mode enabled
declare FL_GODMODE: number
--- Makes the entity invisible to AI
declare FL_NOTARGET: number
--- This entity can be aimed at
declare FL_AIMTARGET: number
--- Not all corners are valid
declare FL_PARTIALGROUND: number
--- It's a static prop
declare FL_STATICPROP: number
--- worldgraph has this ent listed as something that blocks a connection
declare FL_GRAPHED: number
--- This entity is a grenade, unused
declare FL_GRENADE: number
--- Changes the SV_Movestep() behavior to not do any processing
declare FL_STEPMOVEMENT: number
--- Doesn't generate touch functions, calls `ENTITY:EndTouch` when this flag gets set during a touch callback
declare FL_DONTTOUCH: number
--- Base velocity has been applied this frame (used to convert base velocity into momentum)
declare FL_BASEVELOCITY: number
--- This entity is a brush and part of the world
declare FL_WORLDBRUSH: number
--- This entity can be seen by NPCs
declare FL_OBJECT: number
--- This entity is about to get removed
declare FL_KILLME: number
--- This entity is on fire
declare FL_ONFIRE: number
--- The entity is currently dissolving
declare FL_DISSOLVING: number
--- This entity is about to become a ragdoll
declare FL_TRANSRAGDOLL: number
--- This moving door can't be blocked by the player
declare FL_UNBLOCKABLE_BY_PLAYER: number
--- Forces the function to take `string`s only
declare FORCE_STRING: number
--- Forces the function to take `number`s only
declare FORCE_NUMBER: number
--- Forces the function to take `boolean`s only
declare FORCE_BOOL: number
--- Forces the function to take `Angle`s only
declare FORCE_ANGLE: number
--- Forces the function to take `Color`s only
declare FORCE_COLOR: number
--- Forces the function to take `Vector`s only
declare FORCE_VECTOR: number
declare FSASYNC_ERR_NOT_MINE: number
declare FSASYNC_ERR_RETRY_LATER: number
declare FSASYNC_ERR_ALIGNMENT: number
declare FSASYNC_ERR_FAILURE: number
declare FSASYNC_ERR_READING: number
declare FSASYNC_ERR_NOMEMORY: number
declare FSASYNC_ERR_UNKNOWNID: number
declare FSASYNC_ERR_FILEOPEN: number
declare FSASYNC_OK: number
declare FSASYNC_STATUS_PENDING: number
declare FSASYNC_STATUS_INPROGRESS: number
declare FSASYNC_STATUS_ABORTED: number
declare FSASYNC_STATUS_UNSERVICED: number
--- Ignore solid type + always call into the entity for ray tests
declare FSOLID_CUSTOMRAYTEST: number
--- Ignore solid type + always call into the entity for swept box tests
declare FSOLID_CUSTOMBOXTEST: number
--- The object is currently not solid
declare FSOLID_NOT_SOLID: number
--- This is something may be collideable but fires touch functions even when it's not collideable (when the FSOLID_NOT_SOLID flag is set)
declare FSOLID_TRIGGER: number
--- The player can't stand on this
declare FSOLID_NOT_STANDABLE: number
--- Contains volumetric contents (like water)
declare FSOLID_VOLUME_CONTENTS: number
--- Forces the collision representation to be world-aligned even if it's SOLID_BSP or SOLID_VPHYSICS
declare FSOLID_FORCE_WORLD_ALIGNED: number
--- Uses a special trigger bounds separate from the normal OBB
declare FSOLID_USE_TRIGGER_BOUNDS: number
--- Collisions are defined in root parent's local coordinate space
declare FSOLID_ROOT_PARENT_ALIGNED: number
--- This trigger will touch debris objects
declare FSOLID_TRIGGER_TOUCH_DEBRIS: number
--- The amount of bits needed to store the all the flags in a variable/sent over network.
declare FSOLID_MAX_BITS: number
--- Won't receive physics forces from collisions and won't collide with other `PhysObj` with the same flag set.
declare FVPHYSICS_CONSTRAINT_STATIC: number
--- Colliding with entities will cause 1000 damage with DMG_DISSOLVE as the damage type, but only if EFL_NO_DISSOLVE is not set.
declare FVPHYSICS_DMG_DISSOLVE: number
--- Does slice damage, not just blunt damage.
declare FVPHYSICS_DMG_SLICE: number
--- Will deal high physics damage even with a small mass.
declare FVPHYSICS_HEAVY_OBJECT: number
--- This `PhysObj` is part of an entity with multiple `PhysObj` , such as a ragdoll or a vehicle , and will be considered during collision damage events.
declare FVPHYSICS_MULTIOBJECT_ENTITY: number
--- Colliding with entities won't cause physics damage.
declare FVPHYSICS_NO_IMPACT_DMG: number
--- Like FVPHYSICS_NO_IMPACT_DMG, but only checks for NPCs. Usually set on Combine Balls fired by Combine Soldiers.
declare FVPHYSICS_NO_NPC_IMPACT_DMG: number
--- Doesn't allow the player to pick this `PhysObj` with the Gravity Gun or +use pickup.
declare FVPHYSICS_NO_PLAYER_PICKUP: number
--- We won't collide with other `PhysObj` associated to the same entity, only used for vehicles and ragdolls held by the Super Gravity Gun.
declare FVPHYSICS_NO_SELF_COLLISIONS: number
--- This `PhysObj` is part of a ragdoll.
declare FVPHYSICS_PART_OF_RAGDOLL: number
--- Set by the physics engine when two `PhysObj` are penetrating each other. This is only automatically updated for non-static physics objects.
declare FVPHYSICS_PENETRATING: number
--- Set when the player is holding this `PhysObj` with the Physics Gun, Gravity Gun or +use pickup.
declare FVPHYSICS_PLAYER_HELD: number
--- This object was thrown by the Gravity Gun , stuns Antlion guards, Hunters, and squashes Antlion grubs.
declare FVPHYSICS_WAS_THROWN: number
--- Slot for weapon gestures
declare GESTURE_SLOT_ATTACK_AND_RELOAD: number
declare GESTURE_SLOT_GRENADE: number
--- Slot for jump gestures
declare GESTURE_SLOT_JUMP: number
--- Slot for swimming gestures
declare GESTURE_SLOT_SWIM: number
--- Slot for flinching gestures
declare GESTURE_SLOT_FLINCH: number
declare GESTURE_SLOT_VCD: number
--- Slot for custom gestures
declare GESTURE_SLOT_CUSTOM: number
--- Initial state, the global state is off.
declare GLOBAL_OFF: number
--- The global state is enabled.
declare GLOBAL_ON: number
--- The global state is dead and is no longer active. It will be cleared.
