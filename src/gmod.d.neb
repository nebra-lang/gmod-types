declare SF_PHYSBOX_ALWAYS_PICK_UP: number
--- Gravity gun is NOT allowed to pick this up.
declare SF_PHYSBOX_NEVER_PICK_UP: number
--- Gravity gun is NOT allowed to punt this entity.
declare SF_PHYSBOX_NEVER_PUNT: number
