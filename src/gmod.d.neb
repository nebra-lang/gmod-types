    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Does nothing. Is not called by the `DTree` itself.
    --- Used as a placeholder empty function alongside `DTree:ExpandTo`, `DTree:MoveChildTo` and `DTree:ChildExpanded` to prevent errors when `DTree_Node:SetExpanded` is incorrectly used on a `DTree`.
    @side(client)
    function SetExpanded(bExpand: boolean): nil
    --- Sets the indentation size of the `DTree`, the distance between each "level" of the tree is offset on the left from the previous level.
    --- Currently this feature has no effect on the `DTree` element.
    --- @param size The new indentation size.
    @side(client)
    function SetIndentSize(size: number): nil
    --- Sets the height of each `DTree_Node` in the tree.
    --- The default value is 17.
    --- @param h The height to set.
    @side(client)
    override function SetLineHeight(h: number): nil
    --- Set the currently selected top-level node.
    --- @param node DTree_Node to select.
    @side(client)
    function SetSelectedItem(node: Panel): nil
    --- Sets whether or not the `Silkicons` next to each node of the DTree will be displayed.
    --- Individual icons can be set with `DTree_Node:SetIcon` or passed as the second argument in `DTree:AddNode`.
    --- @param show Whether or not to show icons.
    @side(client)
    function SetShowIcons(show: boolean): nil
    --- Returns whether or not the `Silkicons` next to each node of the DTree will be displayed.
    --- Alias of `DTree:GetShowIcons`.
    --- @return boolean Whether or not the silkicons next to each node will be displayed.
    @side(client)
    function ShowIcons(): boolean
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- This panel is created whenever you add a node to a `DTree`.
--- The root node of a `DTree` is also a `DTree_Node` and controls much of its action. it can be accessed with `DTree:Root`.
declare class DTree_Node extends DPanel
    --- A helper function that adds a new node and calls to `DTree_Node:MakeFolder` on it.
    --- @param name The name of the new node
    --- @param folder The folder in the filesystem to use, relative to the garrysmod/ folder.
    --- @param path The path to search in. See File Search Paths
    --- @param showFiles Should files be added as nodes (true) or folders only (false)
    --- @param wildcard The wildcard to use when searching for files.
    --- @return DTree_Node The created DTree_Node
    @side(client)
    function AddFolder(name: string, folder: string, path: string, showFiles: boolean | nil, wildcard: string | nil, bDontForceExpandable: boolean | nil): DTree_Node
    --- Add a child node to the DTree_Node
    --- @param name Name of the node.
    --- @param icon The icon that will show next to the node in the DTree.
    --- @return Panel Returns the created DTree_Node panel.
    @side(client)
    function AddNode(name: string, icon: string | nil): Panel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Adds the given panel to the child nodes list, a `DListLayout`.
