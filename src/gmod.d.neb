    @side(client)
    function GetSelectedNumber(): number
    --- Gets the code of the key currently bound by the DBinder. Same as `DBinder:GetSelectedNumber`.
    --- @return number The key code of the bound key. See Enums/KEY.
    @side(client)
    override function GetValue(): number
    --- Sets the current key bound by the `DBinder`, and updates the button's text as well as the `ConVar`.
    --- @param keyCode The key code of the key to bind. See Enums/KEY.
    @side(client)
    function SetSelectedNumber(keyCode: number): nil
    --- Alias of `DBinder:SetSelectedNumber`.
    --- @param keyCode The key code of the key to bind. See Enums/KEY.
    @side(client)
    function SetValue(keyCode: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used to set the text of the DBinder to the current key binding, or `NONE`.
    @side(client)
    function UpdateText(): nil
end

--- A transparent gray speech bubble panel made up of a rounded box and point coming from the bottom.
declare class DBubbleContainer extends DPanel
    --- Returns Background Color, See `DBubbleContainer:SetBackgroundColor`
    --- @return Color Color of the background.
    @side(client)
    override function GetBackgroundColor(): Color
    --- Sets the speech bubble position and size along with the dialog point position.
    --- @param x The x position of the dialog point. If this is set to a value greater than half of the set width, the entire bubble container will be moved in addition to the dialog point.
    --- @param y The y position of the bubble container. Has no effect unless set to a value greater than the set height + 64 pixels.
    --- @param w The width of the bubble container.
    --- @param h The height of the bubble container.
    @side(client)
    function OpenForPos(x: number, y: number, w: number, h: number): nil
    --- Sets Background Color, See Also `DBubbleContainer:GetBackgroundColor`
    --- @param color The New Color
    @side(client)
    override function SetBackgroundColor(color: Color): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- Used by `DCollapsibleCategory`
declare class DCategoryHeader extends DButton
end

--- DScrollPanel is a VGUI Element similar to DPanel however it has a vertical scrollbar docked to the right which can be used to put more content in a smaller area. DScrollPanels are essentially `DPanel`s with the Scroll Bar.
--- This can be used to replace the `DPanelList` with `DPanelList:EnableVerticalScrollbar` and get similar functionality as well as using a non-deprecated element.
--- If you would like to paint or edit the elements of the scrollbar use `DScrollPanel:GetVBar`. If you want to see if the scrollbar is visible then use the VBar.Enabled variable on the scrollbar's VBar.
--- **NOTE**: `Panel:DockPadding` will not have an effect on children of this panel. Use the function on `DScrollPanel:GetCanvas` instead.
declare class DScrollPanel extends DPanel
    --- Parents the passed panel to the DScrollPanel's canvas.
    --- @param pnl The panel to add.
    @side(client)
    function AddItem(pnl: Panel): nil
    --- Returns the canvas ( The panel all child panels are parented to ) of the DScrollPanel.
    --- @return Panel The canvas
    @side(client)
    function GetCanvas(): Panel
    --- Gets the `DScrollPanel`s padding, set by `DScrollPanel:SetPadding`.
    --- @return number DScrollPanels padding
    @side(client)
    function GetPadding(): number
    --- Returns the vertical scroll bar of the panel.
    --- @return any The DVScrollBar.
    @side(client)
    function GetVBar(): any
    --- Return the width of the DScrollPanel's canvas.
    --- @return number The width of the DScrollPanel's canvas
    @side(client)
    function InnerWidth(): number
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to rebuild the panel's children positioning. You should use `Panel:InvalidateLayout` instead.
    @side(client)
    function PerformLayoutInternal(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to rebuild the panel's children positioning. You should use `Panel:InvalidateLayout` instead.
    @side(client)
    function Rebuild(): nil
    --- Scrolls to the given child
    --- @param panel The panel to scroll to, must be a child of the DScrollPanel.
    @side(client)
    function ScrollToChild(panel: Panel): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the canvas of the DScrollPanel.
    --- @param canvas The new canvas
    @side(client)
    function SetCanvas(canvas: Panel): nil
    --- Sets the DScrollPanel's padding. This function appears to be unused.
    --- @param padding The padding of the DScrollPanel.
    @side(client)
    function SetPadding(padding: number): nil
end

--- A host for multiple `DCollapsibleCategory` panels.
--- As the name suggests, each one of them can be collapsed or expanded on demand by the user.
declare class DCategoryList extends DScrollPanel
    --- Adds a `DCollapsibleCategory` to the list.
    --- @param categoryName The name of the category to add.
    --- @return Panel The created DCollapsibleCategory
    @side(client)
    override function Add(categoryName: string): Panel
    --- Adds an element to the list.
    --- @param element VGUI element to add to the list.
    @side(client)
    override function AddItem(element: Panel): nil
    --- Calls `Panel:UnselectAll` on all child elements, if they have it.
    @side(client)
    override function UnselectAll(): nil
end

--- The DCheckBox is a checkbox. It allows you to get a boolean value from the user (true/false - yes/no)
declare class DCheckBox extends DButton
    --- Calls `DCheckBox:Toggle`
    @side(client)
    function DoClick(): nil
    --- An `Global.AccessorFunc` that gets the checked state of the checkbox.
    --- @return boolean Whether the box is checked or not.
    @side(client)
    function GetChecked(): boolean
    --- Returns whether the state of the checkbox is being edited. This means whether the user is currently clicking (mouse-down) on the checkbox, and applies to both the left and right mouse buttons.
    --- @return boolean Whether the checkbox is being clicked.
    @side(client)
    function IsEditing(): boolean
    --- An `Global.AccessorFunc` that sets the checked state of the checkbox. Does not call the checkbox's `DCheckBox:OnChange` and `Panel:ConVarChanged` methods, unlike `DCheckBox:SetValue`.
    --- @param checked Whether the box should be checked or not.
    @side(client)
    function SetChecked(checked: boolean): nil
    --- Sets the checked state of the checkbox, and calls the checkbox's `DCheckBox:OnChange` and `Panel:ConVarChanged` methods.
    --- @param checked Whether the box should be checked or not.
    @side(client)
    function SetValue(checked: boolean): nil
    --- Toggles the checked state of the checkbox, and calls the checkbox's `DCheckBox:OnChange` and `Panel:ConVarChanged` methods. `DCheckBox:DoClick` is an alias of this function.
    @side(client)
    override function Toggle(): nil
end

--- The **DCheckBoxLabel** is a `DCheckBox` with a `DLabel` next to it.
--- It allows you to get a boolean value from the user (true/false - yes/no)
declare class DCheckBoxLabel extends DPanel
    --- Gets the checked state of the checkbox. This calls the checkbox's `DCheckBox:GetChecked` function.
    --- @return boolean Whether the box is checked or not.
    @side(client)
    function GetChecked(): boolean
    --- An `Global.AccessorFunc` that gets the indentation of the element on the X axis. See also `DCheckBoxLabel:SetIndent`
    --- @return number How much the content is moved to the right in pixels
    @side(client)
    function GetIndent(): number
    --- Sets the color of the `DCheckBoxLabel`'s text to the bright text color defined in the skin.
    --- @param bright true makes the text bright.
    @side(client)
    function SetBright(bright: boolean): nil
    --- Sets the checked state of the checkbox. Does not call `DCheckBoxLabel:OnChange` or `Panel:ConVarChanged`, unlike `DCheckBoxLabel:SetValue`.
    --- @param checked Whether the box should be checked or not.
    @side(client)
    function SetChecked(checked: boolean): nil
    --- Sets the console variable to be set when the checked state of the `DCheckBoxLabel` changes.
    --- @param convar The name of the convar to set
    @side(client)
    override function SetConVar(convar: string): nil
    --- Sets the text of the `DCheckBoxLabel` to be dark colored in accordance with the currently active Derma skin.
    --- @param darkify True to be dark, false to be default
    @side(client)
    function SetDark(darkify: boolean): nil
    --- Sets the font of the text part of the `DCheckBoxLabel`.
    --- @param font Font name
    @side(client)
    function SetFont(font: string): nil
    --- An `Global.AccessorFunc` that sets the indentation of the element on the X axis.
    --- @param ident How much in pixels to move the content to the right
    @side(client)
    function SetIndent(ident: number): nil
    --- Sets the text color for the `DCheckBoxLabel`.
    --- @param color The text color. Uses the Color.
    @side(client)
    function SetTextColor(color: Color): nil
    --- Sets the checked state of the checkbox, and calls `DCheckBoxLabel:OnChange` and the checkbox's `Panel:ConVarChanged` methods.
    --- @param checked Whether the box should be checked or not (1 or 0 can also be used).
    @side(client)
    function SetValue(checked: boolean): nil
    --- Sizes the panel to the size of the internal DLabel and DButton
    @side(client)
    override function SizeToContents(): nil
    --- Toggles the checked state of the `DCheckBoxLabel`.
    @side(client)
    function Toggle(): nil
end

--- Colorful buttons. Used internally by `DColorPalette`.
declare class DColorButton extends DLabel
    --- An `Global.AccessorFunc` that returns the color of the button
    --- @return Color The Color of the button
    @side(client)
    override function GetColor(): Color
    --- An `Global.AccessorFunc` that returns value set by `DColorButton:SetDrawBorder`. See that page for more info.
    --- @return boolean Value set by DColorButton:SetDrawBorder.
    @side(client)
    function GetDrawBorder(): boolean
    --- An `Global.AccessorFunc` that returns the unique ID set by `DColorButton:SetID`.
    --- Used internally by `DColorPalette`
    --- @return number The unique ID of the button
    @side(client)
    function GetID(): number
    --- An `Global.AccessorFunc` that is an alias of `Panel:IsSelected`.
    @side(client)
    function GetSelected(): boolean
    --- Returns whether the `DColorButton` is currently being pressed (the user is holding it down).
    @side(client)
    function IsDown(): boolean
    --- Sets the color of the `DColorButton`.
    --- @param color A Color to set the color as
    --- @param noTooltip If true, the tooltip will not be reset to display the selected color.
    @side(client)
    override function SetColor(color: Color, noTooltip: boolean | nil): nil
    --- An `Global.AccessorFunc` that does absolutely nothing at all. Default value is automatically set to true.
    --- @param draw Does nothing.
    @side(client)
    function SetDrawBorder(draw: boolean): nil
    --- An `Global.AccessorFunc` that is used internally by `DColorPalette` to detect which button is which.
    --- Pairs with `DColorButton:GetID`
    --- @param id A unique ID to give this button
    @side(client)
    function SetID(id: number): nil
end

--- A tab oriented control where you can create multiple tabs with items within. Used mainly for organization.
declare class DPropertySheet extends Panel
    --- Adds a new tab.
    --- @param name Name of the tab
    --- @param pnl Panel to be used as contents of the tab. This normally should be a DPanel
    --- @param icon Icon for the tab. This will ideally be a Silkicons, but any material name can be used.
    --- @param noStretchX Should DPropertySheet try to fill itself with given panel horizontally.
    --- @param noStretchY Should DPropertySheet try to fill itself with given panel vertically.
    --- @param tooltip Tooltip for the tab when user hovers over it with his cursor
    --- @return { [any]: any } A table containing the following keys: * Panel Tab - The created DTab. * string Name - Name of the created tab * Panel Panel - The contents panel of the tab
    @side(client)
    function AddSheet(name: string, pnl: Panel, icon: string | nil, noStretchX: boolean | nil, noStretchY: boolean | nil, tooltip: string | nil): { [any]: any }
    --- Removes tab and/or panel from the parent DPropertySheet.
    --- **NOTE**: In case you close the active tab, it will be reset to the last item available in the list.
    --- @param tab The DTab of the sheet from DPropertySheet. See DPropertySheet:GetItems.
    --- @param removePanel Set to true to remove the associated panel object as well.
    --- @return Panel The panel of the tab.
    @side(client)
    function CloseTab(tab: Panel, removePanel: boolean): Panel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Internal function that handles the cross fade animation when the player switches tabs.
    @side(client)
    function CrossFade(anim: { [any]: any }, delta: number, data: { [any]: any }): nil
    --- Returns the active `DTab` of this `DPropertySheet`.
    --- @return Panel The DTab
    @side(client)
    function GetActiveTab(): Panel
    --- Returns the amount of time (in seconds) it takes to fade between tabs.
    --- Set by `DPropertySheet:SetFadeTime`
    --- @return number The amount of time (in seconds) it takes to fade between tabs.
    @side(client)
    function GetFadeTime(): number
    --- Returns a list of all tabs of this `DPropertySheet`.
    --- @return { [any]: any } A table of tables. Each table contains 3 key-value pairs: * string Name - The name of the tab. * Panel Tab - The DTab associated with the tab. * Panel Panel - The Panel associated with the tab.
    @side(client)
    function GetItems(): { [any]: any }
    --- Gets the padding from the parent panel to child panels.
    --- @return number Padding
    @side(client)
    function GetPadding(): number
    --- Returns whatever value was set by `DPropertySheet:SetShowIcons`.
    @side(client)
    function GetShowIcons(): boolean
    --- Sets the active tab of the `DPropertySheet`.
    --- @param tab The DTab to set active. See DPropertySheet:GetItems
    @side(client)
    function SetActiveTab(tab: Panel): nil
    --- Sets the amount of time (in seconds) it takes to fade between tabs.
    --- @param time The amount of time it takes (in seconds) to fade between tabs.
    @side(client)
    function SetFadeTime(time: number | nil): nil
    --- Sets the padding from parent panel to children panel.
    --- @param padding Amount of padding
    @side(client)
    function SetPadding(padding: number | nil): nil
    --- Does nothing.
    @side(client)
    function SetShowIcons(show: boolean): nil
    --- Creates a close button on the right side of the `DPropertySheet` that will run the given callback function when pressed.
    --- @param func Callback function to be called when the close button is pressed.
    @side(client)
    function SetupCloseButton(func: function): nil
    --- Sets the width of the `DPropertySheet` to fit the contents of all of the tabs.
    @side(client)
    function SizeToContentWidth(): nil
    --- Switches the active tab to a tab with given name.
    --- @param name Case sensitive name of the tab.
    @side(client)
    function SwitchToName(name: string): nil
end

--- The **DColorCombo** allows the user to choose color, without alpha,
--- using `DColorMixer` or `DColorPalette` in a tabbed view.
