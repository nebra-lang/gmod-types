declare SOUND_CONTEXT_PLAYER_VEHICLE: number
--- Never passes.
declare STENCIL_NEVER: number
--- Passes where the reference value is less than the stencil value.
declare STENCIL_LESS: number
--- Passes where the reference value is equal to the stencil value.
declare STENCIL_EQUAL: number
--- Passes where the reference value is less than or equal to the stencil value.
declare STENCIL_LESSEQUAL: number
--- Passes where the reference value is greater than the stencil value.
declare STENCIL_GREATER: number
--- Passes where the reference value is not equal to the stencil value.
declare STENCIL_NOTEQUAL: number
--- Passes where the reference value is greater than or equal to the stencil value.
declare STENCIL_GREATEREQUAL: number
--- Always passes.
declare STENCIL_ALWAYS: number
--- Preserves the existing stencil buffer value.
declare STENCIL_KEEP: number
--- Sets the value in the stencil buffer to 0.
declare STENCIL_ZERO: number
--- Sets the value in the stencil buffer to the reference value, set using `render.SetStencilReferenceValue`.
declare STENCIL_REPLACE: number
--- Increments the value in the stencil buffer by 1, clamping the result.
declare STENCIL_INCRSAT: number
--- Decrements the value in the stencil buffer by 1, clamping the result.
declare STENCIL_DECRSAT: number
--- Inverts the value in the stencil buffer.
declare STENCIL_INVERT: number
--- Increments the value in the stencil buffer by 1, wrapping around on overflow.
declare STENCIL_INCR: number
--- Decrements the value in the stencil buffer by 1, wrapping around on overflow.
declare STENCIL_DECR: number
--- Never passes.
declare STENCILCOMPARISONFUNCTION_NEVER: number
--- Passes where the reference value is less than the stencil value.
declare STENCILCOMPARISONFUNCTION_LESS: number
--- Passes where the reference value is equal to the stencil value.
declare STENCILCOMPARISONFUNCTION_EQUAL: number
--- Passes where the reference value is less than or equal to the stencil value.
declare STENCILCOMPARISONFUNCTION_LESSEQUAL: number
--- Passes where the reference value is greater than the stencil value.
declare STENCILCOMPARISONFUNCTION_GREATER: number
--- Passes where the reference value is not equal to the stencil value.
declare STENCILCOMPARISONFUNCTION_NOTEQUAL: number
--- Passes where the reference value is greater than or equal to the stencil value.
declare STENCILCOMPARISONFUNCTION_GREATEREQUAL: number
--- Always passes.
declare STENCILCOMPARISONFUNCTION_ALWAYS: number
--- Preserves the existing stencil buffer value.
declare STENCILOPERATION_KEEP: number
--- Sets the value in the stencil buffer to 0.
declare STENCILOPERATION_ZERO: number
--- Sets the value in the stencil buffer to the reference value, set using `render.SetStencilReferenceValue`.
declare STENCILOPERATION_REPLACE: number
--- Increments the value in the stencil buffer by 1, clamping the result.
declare STENCILOPERATION_INCRSAT: number
--- Decrements the value in the stencil buffer by 1, clamping the result.
declare STENCILOPERATION_DECRSAT: number
--- Inverts the value in the stencil buffer.
declare STENCILOPERATION_INVERT: number
--- Increments the value in the stencil buffer by 1, wrapping around on overflow.
declare STENCILOPERATION_INCR: number
--- Decrements the value in the stencil buffer by 1, wrapping around on overflow.
declare STENCILOPERATION_DECR: number
--- Normal step
declare STEPSOUNDTIME_NORMAL: number
--- Step on ladder
declare STEPSOUNDTIME_ON_LADDER: number
--- Step in water, with water reaching knee
declare STEPSOUNDTIME_WATER_KNEE: number
--- Step in water, with water reaching foot
declare STEPSOUNDTIME_WATER_FOOT: number
--- The current render is for opaque renderables only
declare STUDIO_RENDER: number
declare STUDIO_VIEWXFORMATTACHMENTS: number
--- The current render is for translucent renderables only
declare STUDIO_DRAWTRANSLUCENTSUBMODELS: number
--- The current render is for both opaque and translucent renderables
declare STUDIO_TWOPASS: number
declare STUDIO_STATIC_LIGHTING: number
declare STUDIO_WIREFRAME: number
declare STUDIO_ITEM_BLINK: number
declare STUDIO_NOSHADOWS: number
declare STUDIO_WIREFRAME_VCOLLIDE: number
--- Not a studio flag, but used to flag when we want studio stats
declare STUDIO_GENERATE_STATS: number
--- Not a studio flag, but used to flag model as using shadow depth material override
declare STUDIO_SSAODEPTHTEXTURE: number
--- Not a studio flag, but used to flag model as using shadow depth material override
declare STUDIO_SHADOWDEPTHTEXTURE: number
--- Not a studio flag, but used to flag model as a non-sorting brush model
declare STUDIO_TRANSPARENCY: number
--- Do not update/apply flexes. (`Entity:SetFlexWeight`)
declare STUDIO_SKIP_FLEXES: number
--- Do not render decals.
declare STUDIO_SKIP_DECALS: number
--- Value will hold the light strength
declare SURF_LIGHT: number
--- The surface is a 2D skybox
declare SURF_SKY2D: number
--- This surface is a skybox, equivalent to HitSky in `Structures/TraceResult`
declare SURF_SKY: number
--- This surface is animated water
declare SURF_WARP: number
--- This surface is translucent
declare SURF_TRANS: number
--- This surface cannot have portals placed on, used by Portal's gun
declare SURF_NOPORTAL: number
--- This surface is a trigger
declare SURF_TRIGGER: number
--- This surface is an invisible entity, equivalent to HitNoDraw in `Structures/TraceResult`
declare SURF_NODRAW: number
--- Make a primary bsp splitter
declare SURF_HINT: number
--- This surface can be ignored by impact effects
declare SURF_SKIP: number
--- This surface has no lights calculated
declare SURF_NOLIGHT: number
--- Calculate three lightmaps for the surface for bumpmapping
declare SURF_BUMPLIGHT: number
--- No shadows are cast on this surface
declare SURF_NOSHADOWS: number
--- No decals are applied to this surface
declare SURF_NODECALS: number
--- Don't subdivide patches on this surface
declare SURF_NOCHOP: number
--- This surface is part of an entity's hitbox
declare SURF_HITBOX: number
--- Just started
declare TASKSTATUS_NEW: number
--- Running task & movement.
declare TASKSTATUS_RUN_MOVE_AND_TASK: number
--- Just running movement.
declare TASKSTATUS_RUN_MOVE: number
--- Just running task.
declare TASKSTATUS_RUN_TASK: number
--- Completed, get next task.
declare TASKSTATUS_COMPLETE: number
--- Connecting team ID, set when player connects to the server
declare TEAM_CONNECTING: number
--- Unassigned team ID, set right after player connected
declare TEAM_UNASSIGNED: number
--- Spectator team ID
declare TEAM_SPECTATOR: number
--- Align the text on the left
declare TEXT_ALIGN_LEFT: number
--- Align the text in center
declare TEXT_ALIGN_CENTER: number
--- Align the text on the right
declare TEXT_ALIGN_RIGHT: number
--- Align the text on the top
declare TEXT_ALIGN_TOP: number
--- Align the text on the bottom
declare TEXT_ALIGN_BOTTOM: number
--- Unknown context.
declare TEXT_FILTER_UNKNOWN: number
--- Game content, only legally required filtering is performed.
declare TEXT_FILTER_GAME_CONTENT: number
--- Chat from another player.
declare TEXT_FILTER_CHAT: number
--- Character or item name.
declare TEXT_FILTER_NAME: number
--- Low quality, "pixel art" texture filtering.
declare TEXTUREFLAGS_POINTSAMPLE: number
--- Medium quality texture filtering.
declare TEXTUREFLAGS_TRILINEAR: number
--- Clamp S coordinates.
declare TEXTUREFLAGS_CLAMPS: number
--- Clamp T coordinates.
declare TEXTUREFLAGS_CLAMPT: number
--- High quality texture filtering.
declare TEXTUREFLAGS_ANISOTROPIC: number
--- Used in skyboxes. Makes sure edges are seamless.
declare TEXTUREFLAGS_HINT_DXT5: number
--- Purpose unknown.
declare TEXTUREFLAGS_PWL_CORRECTED: number
--- Texture is a normal map.
declare TEXTUREFLAGS_NORMAL: number
--- Render largest mipmap only. (Does not delete existing mipmaps, just disables them.)
declare TEXTUREFLAGS_NOMIP: number
--- Not affected by texture resolution settings.
declare TEXTUREFLAGS_NOLOD: number
--- No Minimum Mipmap
declare TEXTUREFLAGS_ALL_MIPS: number
--- Texture is an procedural texture (code can modify it).
declare TEXTUREFLAGS_PROCEDURAL: number
--- One bit alpha channel used.
declare TEXTUREFLAGS_ONEBITALPHA: number
--- Eight bit alpha channel used.
declare TEXTUREFLAGS_EIGHTBITALPHA: number
--- Texture is an environment map.
declare TEXTUREFLAGS_ENVMAP: number
--- Texture is a render target.
declare TEXTUREFLAGS_RENDERTARGET: number
--- Texture is a depth render target.
declare TEXTUREFLAGS_DEPTHRENDERTARGET: number
declare TEXTUREFLAGS_NODEBUGOVERRIDE: number
declare TEXTUREFLAGS_SINGLECOPY: number
--- Aka TEXTUREFLAGS_UNUSED_00080000
declare TEXTUREFLAGS_STAGING_MEMORY: number
--- Immediately destroy this texture when its reference count hits zero. Aka TEXTUREFLAGS_UNUSED_00100000
declare TEXTUREFLAGS_IMMEDIATE_CLEANUP: number
--- Aka TEXTUREFLAGS_UNUSED_00200000
declare TEXTUREFLAGS_IGNORE_PICMIP: number
declare TEXTUREFLAGS_UNUSED_00400000: number
--- Do not buffer for Video Processing, generally render distance.
declare TEXTUREFLAGS_NODEPTHBUFFER: number
declare TEXTUREFLAGS_UNUSED_01000000: number
--- Clamp U coordinates (for volumetric textures).
declare TEXTUREFLAGS_CLAMPU: number
--- Usable as a vertex texture
declare TEXTUREFLAGS_VERTEXTEXTURE: number
--- Texture is a SSBump. (SSB)
declare TEXTUREFLAGS_SSBUMP: number
declare TEXTUREFLAGS_UNUSED_10000000: number
--- Clamp to border colour on all texture coordinates
declare TEXTUREFLAGS_BORDER: number
--- Aka TEXTUREFLAGS_UNUSED_40000000
declare TEXTUREFLAGS_STREAMABLE_COARSE: number
--- Aka TEXTUREFLAGS_UNUSED_80000000
declare TEXTUREFLAGS_STREAMABLE_FINE: number
--- Generates no tracer effects
declare TRACER_NONE: number
--- Generates tracer effects
declare TRACER_LINE: number
--- Unused.
declare TRACER_RAIL: number
--- Unused.
declare TRACER_BEAM: number
--- Generates tracer and makes whizzing noises if the bullet flies past the player being shot at
declare TRACER_LINE_AND_WHIZ: number
--- Always transmit the entity
declare TRANSMIT_ALWAYS: number
--- Never transmit the entity, default for point entities
declare TRANSMIT_NEVER: number
--- Transmit when entity is in players [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community")
declare TRANSMIT_PVS: number
