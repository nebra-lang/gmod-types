declare SCHED_NEW_WEAPON_CHEAT: number
--- No schedule is being performed.
declare SCHED_NONE: number
--- Prevents movement until COND.NPC_UNFREEZE(68) is set.
declare SCHED_NPC_FREEZE: number
--- Run to random position and stop if enemy is heard or found.
declare SCHED_PATROL_RUN: number
--- Walk to random position and stop if enemy is heard or found.
declare SCHED_PATROL_WALK: number
declare SCHED_PRE_FAIL_ESTABLISH_LINE_OF_FIRE: number
declare SCHED_RANGE_ATTACK1: number
declare SCHED_RANGE_ATTACK2: number
--- Stop moving and reload until danger is heard.
declare SCHED_RELOAD: number
--- Retreat from the established enemy.
declare SCHED_RUN_FROM_ENEMY: number
declare SCHED_RUN_FROM_ENEMY_FALLBACK: number
declare SCHED_RUN_FROM_ENEMY_MOB: number
--- Run to random position within a radius of 500 units.
declare SCHED_RUN_RANDOM: number
declare SCHED_SCENE_GENERIC: number
declare SCHED_SCRIPTED_CUSTOM_MOVE: number
declare SCHED_SCRIPTED_FACE: number
declare SCHED_SCRIPTED_RUN: number
declare SCHED_SCRIPTED_WAIT: number
declare SCHED_SCRIPTED_WALK: number
--- Shoot cover that the enemy is behind.
declare SCHED_SHOOT_ENEMY_COVER: number
--- Sets the NPC to a sleep-like state.
declare SCHED_SLEEP: number
declare SCHED_SMALL_FLINCH: number
