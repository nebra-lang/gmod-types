--- @param string String to be networked
@side(shared)
declare function SetGlobal2String(index: any, string: string): nil
--- Defines a variable to be automatically networked to clients
--- | Allowed Types   |
--- | --------------- |
--- | Angle           |
--- | Boolean         |
--- | Entity          |
--- | Float           |
--- | Int             |
--- | String          |
--- | Vector          |
--- **WARNING**: Trying to network a type that is not listed above will result in a nil value!
--- **NOTE**: Running this function clientside will only set it clientside for the client it is called on!
--- @param index Index to identify the global vector with
--- @param value Value to be networked
@side(shared)
declare function SetGlobal2Var(index: any, value: any): nil
