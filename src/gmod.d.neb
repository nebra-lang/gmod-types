    function SetStepHeight(height: number): nil
    --- Sets the NPC's target. This is used in some engine schedules.
    --- @param entity The target of the NPC.
    @side(server)
    function SetTarget(entity: Entity): nil
    --- Sets the status of the current task.
    --- @param status The status. See Enums/TASKSTATUS.
    @side(server)
    function SetTaskStatus(status: number): nil
