declare PLAYERANIMEVENT_CUSTOM_GESTURE: number
--- Play sequence
declare PLAYERANIMEVENT_CUSTOM_SEQUENCE: number
--- Play sequence in gesture slot
declare PLAYERANIMEVENT_CUSTOM_GESTURE_SEQUENCE: number
--- Cancel reload animation
