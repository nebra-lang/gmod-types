    --- Returns whenever the panel has child panels.
    --- @return boolean hasChilds
    @side(client)
    function HasChildren(): boolean
    --- Returns if the panel is focused.
    --- @return boolean hasFocus
    @side(client)
    function HasFocus(): boolean
    --- Returns if the panel or any of its children(sub children and so on) has the focus.
    --- @return boolean hasHierarchicalFocus
    @side(client)
    function HasHierarchicalFocus(): boolean
    --- Returns whether the panel is a descendent of the given panel.
    --- @return boolean True if the panel is contained within parentPanel.
    @side(client)
    function HasParent(parentPanel: Panel): boolean
    --- Makes a panel invisible.
    @side(client)
    function Hide(): nil
    --- Marks the end of a clickable text segment in a `RichText` element, started with `Panel:InsertClickableTextStart`.
    @side(client)
    function InsertClickableTextEnd(): nil
    --- Starts the insertion of clickable text for a `RichText` element. Any text appended with `Panel:AppendText` between this call and `Panel:InsertClickableTextEnd` will become clickable text.
    --- The hook `PANEL:OnTextClicked` is called when the text is clicked.
    --- **NOTE**: The clickable text is a separate Derma panel which will not inherit the current font from the `RichText`.
    --- @param signalValue The text passed as the action signal's value.
    @side(client)
    function InsertClickableTextStart(signalValue: string): nil
    --- Inserts a color change in a `RichText` element, which affects the color of all text added with `Panel:AppendText` until another color change is applied.
    --- @param r The red value `(0 - 255)`.
    --- @param g The green value `(0 - 255)`.
    --- @param b The blue value `(0 - 255)`.
    --- @param a The alpha value `(0 - 255)`.
    @side(client)
    function InsertColorChange(r: number, g: number, b: number, a: number): nil
    --- Begins a text fade for a `RichText` element where the last appended text segment is fully faded out after a specific amount of time, at a specific speed.
    --- The alpha of the text at any given time is determined by the text's base alpha * ((`sustain` - `Global.CurTime`) / `length`) where `Global.CurTime` is added to `sustain` when this method is called.
    --- @param sustain The number of seconds the text remains visible.
    --- @param length The number of seconds it takes the text to fade out. If set **lower** than `sustain`, the text will not begin fading out until (`sustain` - `length`) seconds have passed. If set **higher** than `sustain`, the text will begin fading out immediately at a fraction of the base alpha. If set to **-1**, the text doesn't fade out.
    @side(client)
    function InsertFade(sustain: number, length: number): nil
    --- Invalidates the layout of this panel object and all its children. This will cause these objects to re-layout immediately, calling `PANEL:PerformLayout`. If you want to perform the layout in the next frame, you will have loop manually through all children, and call `Panel:InvalidateLayout` on each.
    --- @param recursive If `true`, the method will recursively invalidate the layout of all children. Otherwise, only immediate children are affected.
    @side(client)
    function InvalidateChildren(recursive: boolean | nil): nil
    --- Causes the panel to re-layout in the next frame. During the layout process  `PANEL:PerformLayout` will be called on the target panel.
    --- You should avoid calling this function every frame.
    --- Using this on a panel after clicking on a docked element will cause docked elements to reorient themselves incorrectly. This can be fixed by assigning a unique `Panel:SetZPos` to each docked element.
    --- @param layoutNow If true the panel will re-layout instantly and not wait for the next frame.
    @side(client)
    function InvalidateLayout(layoutNow: boolean | nil): nil
    --- Calls `Panel:InvalidateLayout` on the panel's `parent`. This function will silently fail if the panel has no parent.
    --- This will cause the parent panel to re-layout, calling `PANEL:PerformLayout`.
    --- Internally sets `LayingOutParent` to `true` on this panel, and will silently fail if it is already set.
    --- @param layoutNow If `true`, the re-layout will occur immediately, otherwise it will be performed in the next frame.
    @side(client)
    function InvalidateParent(layoutNow: boolean | nil): nil
    --- Determines whether the mouse cursor is hovered over one of this panel object's children. This is a reverse process using `vgui.GetHoveredPanel`, and looks upward to find the parent.
    --- @param immediate Set to true to check only the immediate children of given panel ( first level )
    --- @return boolean Whether or not one of this panel object's children is being hovered over.
    @side(client)
    function IsChildHovered(immediate: boolean | nil): boolean
    --- Returns whether this panel is draggable ( if user is able to drag it ) or not.
    --- @return boolean Whether this panel is draggable ( if user is able to drag it ) or not.
    @side(client)
    function IsDraggable(): boolean
    --- Returns whether this panel is currently being dragged or not.
    --- @return boolean Whether this panel is currently being dragged or not.
    @side(client)
    function IsDragging(): boolean
    --- Returns whether the the panel is enabled or disabled.
    --- See `Panel:SetEnabled` for a function that makes the panel enabled or disabled.
    --- @return boolean Whether the panel is enabled or disabled.
    @side(client)
    function IsEnabled(): boolean
    --- Returns whether the mouse cursor is hovering over this panel or not
    --- Uses `vgui.GetHoveredPanel` internally.
    --- Requires `Panel:SetMouseInputEnabled` to be set to true.
    --- @return boolean true if the panel is hovered
    @side(client)
    function IsHovered(): boolean
    --- Returns true if the panel can receive keyboard input.
    --- @return boolean keyboardInputEnabled
    @side(client)
    function IsKeyboardInputEnabled(): boolean
    --- Determines whether or not a `HTML` or `DHTML` element is currently loading a page.
    --- **NOTE**: Before calling `Panel:SetHTML` or `DHTML:OpenURL`, the result seems to be `false` with the Awesomium web renderer and `true` for the Chromium web renderer. This difference can be used to determine the available HTML5 capabilities.
    --- **NOTE**: On Awesomium, the result remains `true` until the root document is loaded and when in-page content is loading (when adding pictures, frames, etc.). During this state, the HTML texture is not refreshed and the panel is not painted (it becomes invisible).
    --- On Chromium, the value is only `true` when the root document is not ready. The rendering is not suspended when in-page elements are loading.
    --- @return boolean Whether or not the (D)HTML object is loading.
    @side(client)
    function IsLoading(): boolean
    --- Returns if the panel is going to be deleted in the next frame.
    --- @return boolean markedForDeletion
    @side(client)
    function IsMarkedForDeletion(): boolean
    --- Returns whether the panel was made modal or not. See `Panel:DoModal`.
    --- @return boolean True if the panel is modal.
    @side(client)
    function IsModal(): boolean
    --- Returns true if the panel can receive mouse input.
    --- @return boolean mouseInputEnabled
    @side(client)
    function IsMouseInputEnabled(): boolean
    --- Determines whether or not a `TextEntry` panel is in multi-line mode. This is set with `Panel:SetMultiline`.
    --- @return boolean Whether the object is in multi-line mode or not.
    @side(client)
    function IsMultiline(): boolean
    --- Returns whether the panel contains the given panel, recursively.
    --- @return boolean True if the panel contains childPanel.
    @side(client)
    function IsOurChild(childPanel: Panel): boolean
    --- Returns if the panel was made popup or not. See `Panel:MakePopup`
    --- @return boolean `true` if the panel was made popup.
    @side(client)
    function IsPopup(): boolean
    --- Determines if the panel object is selectable (like icons in the Spawn Menu, holding Shift). This is set with `Panel:SetSelectable`.
    --- @return boolean Whether the panel is selectable or not.
    @side(client)
    function IsSelectable(): boolean
    --- Returns if the panel object is selected (like icons in the Spawn Menu, holding Shift). This can be set in Lua using `Panel:SetSelected`.
    --- @return boolean Whether the panel object is selected or not. Always returns false if the object is not selectable. This can be modified using Panel:SetSelectable.
    @side(client)
    function IsSelected(): boolean
    --- Determines if the panel object is a selection canvas or not. This is set with `Panel:SetSelectionCanvas`.
    --- @return any The value (if any) set by Panel:SetSelectionCanvas.
    @side(client)
    function IsSelectionCanvas(): any
    --- Returns if the panel is valid and not marked for deletion.
    --- @return boolean True if the object is valid.
    @side(client)
    function IsValid(): boolean
    --- Returns if the panel is visible. This will **NOT** take into account visibility of the parent.
    --- @return boolean `true` if the panel ls visible, `false` otherwise.
    @side(client)
    function IsVisible(): boolean
    --- Returns if a panel allows world clicking set by `Panel:SetWorldClicker`.
    --- @return boolean If the panel allows world clicking.
    @side(client)
    function IsWorldClicker(): boolean
    --- Remove the focus from the panel.
    @side(client)
    function KillFocus(): nil
    --- Redefines the panel object's `Panel:SetPos` method to operate using frame-by-frame linear interpolation (`Global.Lerp`). When the panel's position is changed, it will move to the target position at the speed defined. You can undo this with `Panel:DisableLerp`.
    --- Unlike the other panel animation functions, such as `Panel:MoveTo`, this animation method will not operate whilst the game is paused. This is because it relies on `Global.FrameTime`.
    --- @param speed The speed at which to move the panel. This is affected by the value of `easeOut`. Recommended values are: * **0.1 - 10** when `easeOut` is `false`. * **0.1 - 1** when `easeOut` is `true`.
    --- @param easeOut This causes the panel object to 'jump' at the target, slowing as it approaches. This affects the `speed` value significantly, see above.
    @side(client)
    function LerpPositions(speed: number, easeOut: boolean): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Similar to `Panel:LoadControlsFromString` but loads controls from a file.
    --- @param path The path to load the controls from.
    --- @deprecated No longer does anything.
    @side(client)
    function LoadControlsFromFile(path: string): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Loads controls(positions, etc) from given data. This is what the default options menu uses.
    --- @param data The data to load controls from. Format unknown.
    --- @deprecated No longer does anything.
    @side(client)
    function LoadControlsFromString(data: string): nil
    --- Loads a .gwen file (created by GWEN Designer) and calls `Panel:LoadGWENString` with the contents of the loaded file.
    --- Used to load panel controls from a file.
    --- @param filename The file to open. The path is relative to garrysmod/garrysmod/.
    --- @param path The path used to look up the file. * "GAME" Structured like base folder (garrysmod/), searches all the mounted content (main folder, addons, mounted games etc) * "LUA" or "lsv" - All Lua folders (lua/) including gamesmodes and addons * "DATA" Data folder (garrysmod/data) * "MOD" Strictly the game folder (garrysmod/), ignores mounting.
    @side(client)
    function LoadGWENFile(filename: string, path: string | nil): nil
    --- Loads controls for the panel from a JSON string.
    --- @param str JSON string containing information about controls to create.
    @side(client)
    function LoadGWENString(str: string): nil
    --- Sets a new image to be loaded by a `TGAImage`.
    --- @param imageName The file path.
    --- @param strPath The PATH to search in. See File Search Paths. This isn't used internally.
    --- @deprecated DImage should be used instead (with `.png` or `.jpg` images). `TGAImage` panel has no advantages.
    @side(client)
    function LoadTGAImage(imageName: string, strPath: string): nil
    --- Returns the cursor position local to the position of the panel (usually the upper-left corner).
    --- @return number The x coordinate
    --- @return number The y coordinate
    @side(client)
    function LocalCursorPos(): (number, number)
    --- Takes X and Y coordinates relative to the panel and returns their corresponding positions relative to the screen.
    --- See also `Panel:ScreenToLocal`.
    --- **WARNING**: This function uses a cached value for the screen position of the panel, computed at the end of the last VGUI Think/Layout pass, so inaccurate results may be returned if the panel or any of its ancestors have been re-positioned outside of `PANEL:Think` or `PANEL:PerformLayout` within the last frame.
    --- **NOTE**: If the panel uses `Panel:Dock`, this function will return 0, 0 when the panel was created. The position will be updated in the next frame.
    --- @param posX The X coordinate of the position on the panel to translate.
    --- @param posY The Y coordinate of the position on the panel to translate.
    --- @return number The X coordinate relative to the screen.
    --- @return number The Y coordinate relative to the screen.
    @side(client)
    function LocalToScreen(posX: number, posY: number): (number, number)
    --- Focuses the panel and enables it to receive input.
    --- This automatically calls `Panel:SetMouseInputEnabled` and `Panel:SetKeyboardInputEnabled`) and sets them to `true`.
    --- **NOTE**: Panels derived from `Panel` will not work properly with this function. Due to this, any children will not be intractable with keyboard. Derive from `EditablePanel` instead.
    --- For non gui related mouse focus, you can use `gui.EnableScreenClicker`.
    @side(client)
    function MakePopup(): nil
    --- Allows the panel to receive mouse input even if the mouse cursor is outside the bounds of the panel.
    --- @param doCapture Set to true to enable, set to false to disable.
    @side(client)
    function MouseCapture(doCapture: boolean): nil
    --- Places the panel above the passed panel with the specified offset.
    --- @param panel Panel to position relatively to.
    --- @param offset The align offset.
    @side(client)
    function MoveAbove(panel: Panel, offset: number | nil): nil
    --- Places the panel below the passed panel with the specified offset.
    --- @param panel Panel to position relatively to.
    --- @param offset The align offset.
    @side(client)
    function MoveBelow(panel: Panel, offset: number | nil): nil
    --- Moves the panel by the specified coordinates using animation.
    --- @param moveX The number of pixels to move by in the horizontal (x) direction.
    --- @param moveY The number of pixels to move by in the vertical (y) direction.
    --- @param time The time (in seconds) in which to perform the animation.
    --- @param delay The delay (in seconds) before the animation begins.
    --- @param ease The easing of the start and/or end speed of the animation. See Panel:NewAnimation for how this works.
    --- @param callback The function to be called once the animation is complete. Function argument(s): * table `animData` - The Structures/AnimationData that was used. * Panel `targetPanel` - The panel object that was animated.
    @side(client)
    function MoveBy(moveX: number, moveY: number, time: number, delay: number | nil, ease: number | nil, callback: ({ [any]: any }, Panel) -> any | nil): nil
    --- Places the panel left to the passed panel with the specified offset.
    --- @param panel Panel to position relatively to.
    --- @param offset The align offset.
    @side(client)
    function MoveLeftOf(panel: Panel, offset: number | nil): nil
    --- Places the panel right to the passed panel with the specified offset.
    --- @param panel Panel to position relatively to.
    --- @param offset The align offset.
    @side(client)
    function MoveRightOf(panel: Panel, offset: number | nil): nil
    --- Moves the panel to the specified position using animation.
    --- **NOTE**: Setting the ease argument to 0 will result in the animation happening instantly, this applies to all MoveTo/SizeTo functions
    --- @param posX The target x coordinate of the panel.
    --- @param posY The target y coordinate of the panel.
    --- @param time The time to perform the animation within.
    --- @param delay The delay before the animation starts.
    --- @param ease The easing of the start and/or end speed of the animation. See Panel:NewAnimation for how this works.
    --- @param callback The function to be called once the animation finishes. Function argument(s): * table `animData` - The Structures/AnimationData that was used. * Panel `targetPanel` - The panel object that was animated.
    @side(client)
    function MoveTo(posX: number, posY: number, time: number, delay: number | nil, ease: number | nil, callback: ({ [any]: any }, Panel) -> any | nil): nil
    --- Moves this panel object in front of the specified sibling (child of the same parent) in the render order, and shuffles up the Z-positions of siblings now behind.
    --- @param siblingPanel The panel to move this one in front of. Must be a child of the same parent panel.
    --- @return boolean `false` if the passed panel is not a sibling, otherwise `nil`.
    @side(client)
    function MoveToAfter(siblingPanel: Panel): boolean
    --- Moves the panel object behind all other panels on screen. If the panel has been made a pop-up with `Panel:MakePopup`, it will still draw in front of any panels that haven't.
    @side(client)
    function MoveToBack(): nil
    --- Moves this panel object behind the specified sibling (child of the same parent) in the render order, and shuffles up the `Panel:SetZPos` of siblings now in front.
    --- @param siblingPanel The panel to move this one behind. Must be a child of the same parent panel.
    --- @return boolean `false` if the passed panel is not a sibling, otherwise `nil`.
    @side(client)
    function MoveToBefore(siblingPanel: Panel): boolean
    --- Moves the panel in front of all other panels on screen. Unless the panel has been made a pop-up using `Panel:MakePopup`, it will still draw behind any that have.
    @side(client)
    function MoveToFront(): nil
    --- Creates a new animation for the panel object.
    --- Methods that use this function:
    --- * `Panel:MoveTo`
    --- * `Panel:SizeTo`
    --- * `Panel:SlideUp`
    --- * `Panel:SlideDown`
    --- * `Panel:ColorTo`
    --- * `Panel:AlphaTo`
    --- * `Panel:MoveBy`
    --- * `Panel:LerpPositions`
    --- @param length The length of the animation in seconds.
    --- @param delay The delay before the animation starts.
    --- @param ease The power/index to use for easing. * Positive values greater than 1 will ease in; the higher the number, the sharper the curve's gradient (less linear). * A value of 1 removes all easing. * Positive values between 0 and 1 ease out; values closer to 0 increase the curve's gradient (less linear). * A value of 0 will break the animation and should be avoided. * Any value less than zero will ease in/out; the value has no effect on the gradient.
    --- @param callback The function to be called when the animation ends. Function argument(s): * table `animData` - The Structures/AnimationData that was used. * Panel `targetPanel` - The panel object that was animated.
    --- @return { [any]: any } Partially filled Structures/AnimationData with the following members: * number **EndTime** - Equal to `length` and `delay` arguments added together, plus either the Global.SysTime if there is no other animation queued or the end time of the last animation in the queue. * number **StartTime** - Equal to the `delay` argument, plus either the Global.SysTime if there is no other animation queued or the end time of the last animation in the queue. * number **Ease** - Equal to the `ease` argument. * function **OnEnd** - Equal to the `callback` argument.
    @side(client)
    function NewAnimation(length: number, delay: number | nil, ease: number | nil, callback: ({ [any]: any }, Panel) -> any | nil): { [any]: any }
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    @side(client)
    function NewObject(objectName: string): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    @side(client)
    function NewObjectCallback(objectName: string, callbackName: string): nil
    --- Sets whether this panel's drawings should be clipped within the parent panel's bounds.
    --- See `render.SetScissorRect` if you wish to set the clipping rect instead.
    --- **NOTE**: This only disabled clipping for the Paint Related functions (as far as i can tell at the current moment, more testing should be done) so things like the text of a `DLabel` will still be clipped to the parent.
    --- To fully disable the clipping of any children see `Global.DisableClipping`.
    --- @param disableClipping Whether to disable clipping or not. `true` to disable clipping, `false` to enable clipping.
    @side(client)
    function NoClipping(disableClipping: boolean): nil
    --- Returns the number of children of the panel object that are selected. This is equivalent to calling `Panel:IsSelected` on all child objects and counting the number of returns that are `true`.
    --- @return number The number of child objects that are currently selected. This does not include the parent object you are calling the method from.
    @side(client)
    function NumSelectedChildren(): number
    --- Instructs a HTML control to download and parse a HTML script using the passed URL.
    --- This function can only be used on `HTML` panel and its derivatives.
    --- @param URL URL to open. It has to start or be one of the following: * `http://` * `https://` * `asset://` * `about:blank` * `chrome://credits/`
    @side(client)
    function OpenURL(URL: string): nil
    --- Paints a ghost copy of the panel at the given position.
    --- **WARNING**: This function sets Z pos of panel's children (`PANEL:SetZPos`). It also briefly unparents and reparents the panel.
    --- @param posX The x coordinate to draw the panel from.
    --- @param posY The y coordinate to draw the panel from.
    @side(client)
    function PaintAt(posX: number, posY: number): nil
    --- Paints the panel at its current position. To use this you must call `Panel:SetPaintedManually`(true).
    --- @param unclamp If set, overrides panels' clipping so that it can render fully when its size is larger than the game's resolution.
    @side(client)
    function PaintManual(unclamp: boolean | nil): nil
    --- Parents the panel to the HUD.
    --- Makes it invisible on the escape-menu and disables controls.
    @side(client)
    function ParentToHUD(): nil
    --- Only works for TextEntries.
    --- Pastes the contents of the clipboard into the TextEntry.
    --- **NOTE**: Tab characters will be dropped from the pasted text
    --- @deprecated Due to privacy concerns, this function has been disabled
    @side(client)
    function Paste(): nil
    --- Sets the width and position of a `DLabel` and places the passed panel object directly to the right of it. Returns the `y` value of the bottom of the tallest object. The panel on which this method is run is not relevant; only the passed objects are affected.
    --- @param lblWidth The width to set the label to.
    --- @param x The horizontal (x) position at which to place the label.
    --- @param y The vertical (y) position at which to place the label.
    --- @param lbl The label to resize and position.
    --- @param panelObj The panel object to place to the right of the label.
    --- @return number The distance from the top of the parent panel to the bottom of the tallest object (the `y` position plus the height of the label or passed panel, depending on which is tallest).
    @side(client)
    function PositionLabel(lblWidth: number, x: number, y: number, lbl: Panel, panelObj: Panel): number
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Installs Lua defined functions into the panel.
    @side(client)
    function Prepare(): nil
    --- Enables the queue for panel animations. If enabled, the next new animation will begin after all current animations have ended. This must be called before `Panel:NewAnimation` to work, and only applies to the next new animation. If you want to queue many, you must call this before each.
    @side(client)
    function Queue(): nil
    --- Causes a `SpawnIcon` to rebuild its model image.
    @side(client)
    function RebuildSpawnIcon(): nil
    --- Re-renders a spawn icon with customized cam data.
    --- `Global.PositionSpawnIcon` can be used to easily calculate the necessary camera parameters.
    --- **NOTE**: This function does **not** accept the standard `Structures/CamData`.
    --- @param data A table containing the information needed to re-render the icon: * Vector cam_pos - The relative camera position the model is viewed from. * Angle cam_ang - The camera angle the model is viewed from. * number cam_fov - The camera's field of view (FOV). * Entity ent - The entity object of the model. Optional keys: * table lightbox - (As of 2026.08.26) Sets the "lightbox" for the model render. Wants 6 vectors (start index = 1). See render.SetModelLighting. * table lights - (As of 2026.08.26) Sets the "dynamic lights" for the model render. Same format as render.SetLocalModelLights. See the example below for how to retrieve these values.
    @side(client)
    function RebuildSpawnIconEx(data: { [any]: any }): nil
    --- Allows the panel to receive drag and drop events. Can be called multiple times with different names to receive multiple different draggable panel events.
    --- @param name Name of DnD panels to receive. This is set on the drag'n'drop-able panels via  Panel:Droppable
    --- @param func This function is called whenever a panel with valid name is hovering above and dropped on this panel. Function argument(s): * Panel `pnl` - The receiver panel * table `tbl` - A table of panels dropped onto receiver panel * boolean `dropped` - False if hovering over, true if dropped onto * number `menuIndex` - Index of clicked menu item from third argument of Panel:Receiver * number `x` - Cursor pos, relative to the receiver * number `y` - Cursor pos, relative to the receiver
    --- @param menu A table of strings that will act as a menu if drag'n'drop was performed with a right click
    @side(client)
    function Receiver(name: string, func: (Panel, { [any]: any }, boolean, number, number, number) -> any, menu: { [any]: any } | nil): nil
    --- Refreshes the HTML panel's current page.
    --- @param ignoreCache If true, the refresh will ignore cached content similar to "ctrl+f5" in most browsers.
    @side(client)
    function Refresh(ignoreCache: boolean | nil): nil
    --- Marks a panel for deletion so it will be deleted on the next frame.
    --- This will not mark child panels for deletion this frame, but they will be marked and deleted in the next frame.
    --- See also `Panel:IsMarkedForDeletion`
    --- Will automatically call `Panel:InvalidateParent`.
    @side(client)
    function Remove(): nil
    --- Attempts to obtain focus for this panel.
    @side(client)
    function RequestFocus(): nil
    --- Resets all text fades in a `RichText` element made with `Panel:InsertFade`.
    --- @param hold True to reset fades, false otherwise.
    --- @param expiredOnly Any value equating to `true` will reset fades only on text segments that are completely faded out.
    --- @param newSustain The new sustain value of each faded text segment. Set to -1 to keep the old sustain value.
    @side(client)
    function ResetAllFades(hold: boolean, expiredOnly: boolean, newSustain: number): nil
    --- Executes a string as JavaScript code on a web document panel.
    --- **NOTE**: This function does **NOT** allow you to pass variables from JavaScript (JS) to Lua context.
    --- If you wish to pass/return values from JS to Lua, you may want to use `DHTML:AddFunction` function to accomplish that job.
    --- **NOTE**: The Awesomium web renderer automatically delays the code execution if the document is not ready, but the Chromium web renderer does not!
    --- This means that with Chromium, you cannot JavaScript run code immediatly after calling `Panel:SetHTML` or `Panel:OpenURL`. You should wait for the events `HTML:OnDocumentReady` or `HTML:OnFinishLoadingDocument` to be triggered before proceeding, otherwise you may manipulate an empty / incomplete document.
    --- @param js Specify JavaScript code to be executed.
    @side(client)
    function RunJavascript(js: string): nil
    --- Saves the current state (caret position and the text inside) of a `TextEntry` as an undo state.
    --- See also `Panel:Undo`.
    @side(client)
    function SaveUndoState(): nil
    --- Translates global screen coordinate to coordinates relative to the panel.
    --- See also `Panel:LocalToScreen`.
    --- **WARNING**: This function uses a cached value for the screen position of the panel, computed at the end of the last VGUI Think/Layout pass, so inaccurate results may be returned if the panel or any of its ancestors have been re-positioned outside of `PANEL:Think` or `PANEL:PerformLayout` within the last frame.
    --- @param screenX The x coordinate of the screen position to be translated.
    --- @param screenY The y coordinate of the screed position be to translated.
    --- @return number Relativeposition X
    --- @return number Relativeposition Y
    @side(client)
    function ScreenToLocal(screenX: number, screenY: number): (number, number)
    --- Selects all items within a panel or object. For text-based objects, selects all text.
    --- **NOTE**: Only works on `RichText` and `TextEntry` and their derived panels by default (such as `DTextEntry`), and on any panel that manually reimplemented this method.
    @side(client)
    function SelectAll(): nil
    --- If called on a `TextEntry`, clicking the text entry for the first time will automatically select all of the text ready to be copied by the user.
    @side(client)
    function SelectAllOnFocus(): nil
    --- Selects all the text in a panel object. Will not select non-text items; for this, use `Panel:SelectAll`.
    --- @param resetCursorPos Reset cursor pos?
    --- @deprecated Duplicate of Panel:SelectAll.
    @side(client)
    function SelectAllText(resetCursorPos: boolean): nil
    --- Deselects all items in a panel object. For text-based objects, this will deselect all text.
    --- **NOTE**: Only works on `RichText` and `TextEntry` and their derived panels by default (such as `DTextEntry`), and on any panel that manually reimplemented this method.
    @side(client)
    function SelectNone(): nil
    --- Sets the achievement to be displayed by `AchievementIcon`.
    --- @param id Achievement number ID
    @side(client)
    function SetAchievement(id: number): nil
    --- Configures a `TextEntry` to allow user to type characters that are not included in the US-ASCII (7-bit ASCII) character set.
    --- Characters not included in US-ASCII are multi-byte characters in UTF-8. They can be accented characters, non-Latin characters and special characters.
    --- @param allowed Set to true in order not to restrict input characters.
    @side(client)
    function SetAllowNonAsciiCharacters(allowed: boolean): nil
    --- Sets the alpha multiplier for the panel
    --- @param alpha The alpha value in the range of 0-255.
    @side(client)
    function SetAlpha(alpha: number): nil
    --- Enables or disables animations for the panel object by overriding the `PANEL:AnimationThink` hook to nil and back.
    --- @param enable Whether to enable or disable animations.
    @side(client)
    function SetAnimationEnabled(enable: boolean): nil
    --- Sets whenever the panel should be removed if the parent was removed.
    --- @param autoDelete Whenever to delete if the parent was removed or not.
    @side(client)
    function SetAutoDelete(autoDelete: boolean): nil
    --- Sets the background color of a panel such as a `RichText`, `Label`, `DColorCube` or the base `Panel`.
    --- For many panels, such as `DLabel` and `Panel`, you must use `Panel:SetPaintBackgroundEnabled`( true ) for the background to appear.
    --- Please note that for most panels the engine will overwrite the foreground and background colors a frame after panel creation via the `PANEL:ApplySchemeSettings` hook, so you may want to set the color in that hook instead.
    --- See `Panel:SetFGColor` for the foreground color.
    --- **NOTE**: This doesn't apply to all VGUI elements and its function varies between them
    --- @param r The red channel of the color.
    --- @param g The green channel of the color.
    --- @param b The blue channel of the color.
    --- @param a The alpha channel of the color.
    @side(client)
    function SetBGColor(r: number, g: number, b: number, a: number): nil
    --- Sets the background color of a panel such as a `RichText`, `Label`, `DColorCube` or the base `Panel`.
    --- For many panels, such as `DLabel` and `Panel`, you must use `Panel:SetPaintBackgroundEnabled`( true ) for the background to appear.
    --- Please note that for most panels the engine will overwrite the foreground and background colors a frame after panel creation via the `PANEL:ApplySchemeSettings` hook, so you may want to set the color in that hook instead.
    --- See `Panel:SetFGColor` for the foreground color.
    --- **NOTE**: This doesn't apply to all VGUI elements and its function varies between them
    --- @param color A Color object/table to read the color from. This is slower than providing four numbers. You could use Color:Unpack to address this. You should also cache your color objects if you wish to use them, for performance reasons.
    @side(client)
    function SetBGColor(color: Color): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the background color of the panel.
    --- @param r The red channel of the color.
    --- @param g The green channel of the color.
    --- @param b The blue channel of the color.
    --- @param a The alpha channel of the color.
    @side(client)
    function SetBGColorEx(r: number, g: number, b: number, a: number): nil
    --- Sets the position of the caret (or text cursor) in a text-based panel object.
    --- @param offset Caret position/offset from the start of text. A value of `0` places the caret before the first character.
    @side(client)
    function SetCaretPos(offset: number): nil
    --- Sets the alignment of the contents.
    --- **NOTE**: This function only works on `Label` panels and its derivatives.
    --- **NOTE**: This function doesnt work, if `Panel:SetWrap` is true.
    --- @param alignment The direction of the content, based on the number pad. See Enums/ContentAlignment. 1: **bottom-left** 2: **bottom-center** 3: **bottom-right** 4: **middle-left** 5: **center** 6: **middle-right** 7: **top-left** 8: **top-center** 9: **top-right**
    @side(client)
    function SetContentAlignment(alignment: number): nil
    --- **WARNING**: This function does not exist on all panels
    --- **WARNING**: This function cannot interact with serverside convars unless you are host
    --- **NOTE**: Blocked convars will not work with this, see `Blocked ConCommands`
    --- Sets this panel's convar. When the convar changes this panel will update automatically.
    --- For developer implementation, see `Global.Derma_Install_Convar_Functions`.
    --- @param convar The console variable to check.
    @side(client)
    function SetConVar(convar: string): nil
    --- Stores a string in the named cookie using `Panel:GetCookieName` as prefix.
    --- You can also retrieve and modify this cookie by using the `cookie`. Cookies are stored in this format:
    --- ```
    --- panelCookieName.cookieName
    --- ```
    --- **WARNING**: The panel's cookie name MUST be set for this function to work. See `Panel:SetCookieName`.
    --- @param cookieName The unique name used to retrieve the cookie later.
    --- @param value The value to store in the cookie. This can be retrieved later as a string or number.
    @side(client)
    function SetCookie(cookieName: string, value: string): nil
    --- Sets the panel's cookie name. Calls `PANEL:LoadCookies` if defined.
    --- @param name The panel's cookie name. Used as prefix for Panel:SetCookie, therefore should be a unique value.
    @side(client)
    function SetCookieName(name: string): nil
    --- Sets the appearance of the cursor. You can find a list of all available cursors with image previews `here`.
    --- @param cursor The cursor to be set. Can be one of the following: * `arrow` * `beam` * `hourglass` * `waitarrow` * `crosshair` * `up` * `sizenwse` * `sizenesw` * `sizewe` * `sizens` * `sizeall` * `no` * `hand` * `blank` Set to anything else to set it to "none", the default fallback. Do note that a value of "none" does not, as one might assume, result in no cursor being drawn - hiding the cursor requires a value of "blank" instead.
    @side(client)
    function SetCursor(cursor: string): nil
    --- Sets the drag parent.
    --- Drag parent means that when we start to drag this panel, we'll really start dragging the defined parent.
    --- @param parent The panel to set as drag parent.
    @side(client)
    function SetDragParent(parent: Panel): nil
    --- Sets the visibility of the language selection box when typing in non-English mode.
    --- See `Panel:SetDrawLanguageIDAtLeft` for a function that changes the position of the language selection box.
    --- @param visible true to make it visible, false to hide it.
    @side(client)
    function SetDrawLanguageID(visible: boolean): nil
    --- Sets where to draw the language selection box.
    --- See `Panel:SetDrawLanguageID` for a function that hides or shows the language selection box.
    --- @param left true = left, false = right
    @side(client)
    function SetDrawLanguageIDAtLeft(left: boolean): nil
    --- Makes the panel render in front of all others, including the spawn menu and main menu.
    --- Priority is given based on the last call, so of two panels that call this method, the second will draw in front of the first.
    --- **NOTE**: This only makes the panel **draw** above other panels. If there's another panel that would have otherwise covered it, users will not be able to interact with it.
    --- Completely disregards `PANEL:ParentToHUD`.
    --- **WARNING**: This does not work when using `PANEL:SetPaintedManually` or `PANEL:PaintAt`.
    --- @param drawOnTop Whether or not to draw the panel in front of all others.
    @side(client)
    function SetDrawOnTop(drawOnTop: boolean | nil): nil
    --- Sets the target area for dropping when an object is being dragged around this panel using the `dragndrop`.
    --- This draws a target box of the specified size and position, until `Panel:DragHoverEnd` is called. It uses `Panel:DrawDragHover` to draw this area.
    --- @param x The x coordinate of the top-left corner of the drop area.
    --- @param y The y coordinate of the top-left corner of the drop area.
    --- @param width The width of the drop area.
    --- @param height The height of the drop area.
    @side(client)
    function SetDropTarget(x: number, y: number, width: number, height: number): nil
    --- Sets the enabled state of a panel object that supports being disabled, such as a `DButton` or `DTextEntry`.
    --- Disabled panels cannot be interacted with, and have a different appearance to indicate this.
    --- See `Panel:IsEnabled` for a function that retrieves the "enabled" state of a panel.
    --- @param enable Whether to enable or disable the panel object.
    @side(client)
    function SetEnabled(enable: boolean): nil
    --- Adds a shadow falling to the bottom right corner of the panel's text.
    --- **NOTE**: This works only on  panels that derive from `Label`.
    --- @param distance The distance of the shadow from the panel.
    --- @param Color The color of the shadow. Uses Color.
    @side(client)
    function SetExpensiveShadow(distance: number, Color: Color): nil
    --- Sets the foreground color of a panel.
    --- For a `Label` or `RichText`, this is the color of its text.
    --- This function calls `Panel:SetFGColorEx` internally.
    --- Please note that for most panels the engine will overwrite the foreground and background colors a frame after panel creation via the `PANEL:ApplySchemeSettings` hook, so you may want to set the color in that hook instead.
    --- See `Panel:SetBGColor` for the background color.
    --- **NOTE**: This doesn't apply to all VGUI elements (such as `DLabel`) and its function varies between them
    --- @param r The red channel of the color.
    --- @param g The green channel of the color.
    --- @param b The blue channel of the color.
    --- @param a The alpha channel of the color.
    @side(client)
    function SetFGColor(r: number, g: number, b: number, a: number): nil
    --- Sets the foreground color of a panel.
    --- For a `Label` or `RichText`, this is the color of its text.
    --- This function calls `Panel:SetFGColorEx` internally.
    --- Please note that for most panels the engine will overwrite the foreground and background colors a frame after panel creation via the `PANEL:ApplySchemeSettings` hook, so you may want to set the color in that hook instead.
    --- See `Panel:SetBGColor` for the background color.
    --- **NOTE**: This doesn't apply to all VGUI elements (such as `DLabel`) and its function varies between them
    --- @param color A Color object/table to read the color from. This is slower than providing four numbers. You could use Color:Unpack to address this. You should also cache your color objects if you wish to use them, for performance reasons.
    @side(client)
    function SetFGColor(color: Color): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the foreground color of the panel.
    --- For labels, this is the color of their text.
    --- @param r The red channel of the color.
    --- @param g The green channel of the color.
    --- @param b The blue channel of the color.
    --- @param a The alpha channel of the color.
    @side(client)
    function SetFGColorEx(r: number, g: number, b: number, a: number): nil
    --- Sets the panel that owns this FocusNavGroup to be the root in the focus traversal hierarchy. This function will only work on EditablePanel class panels and its derivatives.
    --- **NOTE**: Child panels that should be part of the tab navigation need `Panel:SetTabPosition` called on them.
    @side(client)
    function SetFocusTopLevel(state: boolean): nil
    --- Sets the font used to render this panel's text. This works for `Label`, `TextEntry` and `RichText`, but it's a better idea to use their local `SetFont` (`DTextEntry:SetFont`, `DLabel:SetFont`) methods when available.
    --- To retrieve the font used by a panel, call `Panel:GetFont`.
    --- @param fontName The name of the font. See Default_Fonts for a list of existing fonts. Alternatively, use surface.CreateFont to create your own custom font.
    @side(client)
    function SetFontInternal(fontName: string): nil
    --- Sets the height of the panel.
    --- Calls `PANEL:OnSizeChanged` and marks this panel for layout (`Panel:InvalidateLayout`).
    --- Automatically rounds the height down
    --- See also `Panel:SetSize`.
    --- @param height The height to be set.
    @side(client)
    function SetHeight(height: number): nil
    --- Allows you to set HTML code within a panel.
    --- @param HTML The HTML code to set.
    @side(client)
    function SetHTML(HTML: string): nil
    --- Enables or disables the keyboard input for the panel.
    --- @param keyboardInput Whether to enable or disable keyboard input.
    --- @deprecated Alias of Panel:SetKeyboardInputEnabled(lowercase)
    @side(client)
    function SetKeyBoardInputEnabled(keyboardInput: boolean): nil
    --- Allows or disallows the panel to receive keyboard focus and input. This is recursively applied to all children.
    --- @param enable Whether keyboard input should be enabled for this panel.
    @side(client)
    function SetKeyboardInputEnabled(enable: boolean): nil
    --- Sets the height of a single line of a `RichText` panel.
    --- @param height The new line height. Values below zero mean no override.
    @side(client)
    function SetLineHeight(height: number): nil
    --- Sets the maximum character count this panel should have.
    --- This function will only work on `RichText` and `TextEntry` panels and their derivatives.
    --- @param maxChar The new maximum amount of characters this panel is allowed to contain.
    @side(client)
    function SetMaximumCharCount(maxChar: number): nil
    --- Sets the minimum dimensions of the panel or object.
    --- You can restrict either or both values.
    --- Calling the function without arguments will remove the minimum size.
    --- @param minW The minimum width of the object.
    --- @param minH The minimum height of the object.
    @side(client)
    function SetMinimumSize(minW: number | nil, minH: number | nil): nil
    --- Sets the model to be displayed by `SpawnIcon`.
    --- **NOTE**: This must be called after setting size if you wish to use a different size spawnicon
    --- @param ModelPath The path of the model to set
    --- @param skin The skin to set
    --- @param bodygroups The body groups to set. Each single-digit number in the string represents a separate bodygroup, **This argument must be 9 characters in total**.
    @side(client)
    function SetModel(ModelPath: string, skin: number | nil, bodygroups: string | nil): nil
    --- Enables or disables the mouse input for the panel.
    --- **NOTE**: Panels parented to the context menu will not be clickable unless `Panel:SetKeyboardInputEnabled`) is enabled or `Panel:MakePopup` has been called. If you want the panel to have mouse input but you do not want to prevent players from moving, set `Panel:SetKeyboardInputEnabled`) to false immediately after calling `Panel:MakePopup`.
    --- @param mouseInput Whenever to enable or disable mouse input.
    @side(client)
    function SetMouseInputEnabled(mouseInput: boolean): nil
    --- Enables or disables the multi-line functionality of `TextEntry` panel and its derivatives.
    --- @param multiline Whether to enable multiline or not.
    @side(client)
    function SetMultiline(multiline: boolean): nil
    --- Sets the internal name of the panel. Can be retrieved with `Panel:GetName`.
    --- @param name The new name of the panel.
    @side(client)
    function SetName(name: string): nil
    --- Set to true to open links in an external browser. This only functions on the `x86-64` beta.
    @side(client)
    function SetOpenLinksExternally(openExternally: boolean): nil
    --- Sets whether the default background of the panel should be drawn or not. It's color is usually set by `Panel:SetBGColor`.
    --- @param paintBackground Whether to draw the background or not.
    @side(client)
    function SetPaintBackgroundEnabled(paintBackground: boolean): nil
    --- Sets whether the default border of the panel should be drawn or not.
    --- @param paintBorder Whether to draw the border or not.
    @side(client)
    function SetPaintBorderEnabled(paintBorder: boolean): nil
    --- Enables or disables painting of the panel manually with `Panel:PaintManual`.
    --- @param paintedManually True if the panel should be painted manually.
    @side(client)
    function SetPaintedManually(paintedManually: boolean): nil
    --- Sets the parent of the panel.
    --- **NOTE**: Panels parented to the context menu will not be clickable unless `Panel:SetMouseInputEnabled` and `Panel:SetKeyboardInputEnabled`) are both true or `Panel:MakePopup` has been called. If you want the panel to have mouse input but you do not want to prevent players from moving, set `Panel:SetKeyboardInputEnabled`) to false immediately after calling `Panel:MakePopup`.
    --- @param parent The new parent of the panel.
    @side(client)
    function SetParent(parent: Panel): nil
    --- Used by `AvatarImage` to load an avatar for given player.
    --- @param player The player to use avatar of.
    --- @param size The size of the avatar to use. Acceptable sizes are `32`, `64`, `184`. Non matching sizes will be clamped down to the highest valid number.
    @side(client)
    function SetPlayer(player: Player, size: number | nil): nil
    --- If this panel object has been made a popup with `Panel:MakePopup`, this method will prevent it from drawing in front of other panels when it receives input focus.
    --- @param stayAtBack If `true`, the popup panel will not draw in front of others when it gets focus, for example when it is clicked.
    @side(client)
    function SetPopupStayAtBack(stayAtBack: boolean): nil
    --- Sets the position of the panel's top left corner.
    --- This will trigger `PANEL:PerformLayout`. You should avoid calling this function in `PANEL:PerformLayout` to avoid infinite loops.
    --- See also `Panel:SetX` and `Panel:SetY`.
    --- **NOTE**: If you wish to position and re-size panels without much guesswork and have them look good on different screen resolutions, you may find `Panel:Dock` useful
    --- @param posX The x coordinate of the position.
    --- @param posY The y coordinate of the position.
    @side(client)
    function SetPos(posX: number, posY: number): nil
    --- Sets whenever the panel should be rendered in a screenshot. (`jpeg` or `screenshot` commands, Camera SWEP)
    --- @param renderInScreenshot Whether to render in the screenshot or not.
    @side(client)
    function SetRenderInScreenshots(renderInScreenshot: boolean): nil
    --- Sets whether the panel object can be selected or not (like icons in the Spawn Menu, holding Shift). If enabled, this will affect the function of a `DButton` whilst Shift is pressed. `Panel:SetSelected` can be used to select/deselect the object.
    --- @param selectable Whether the panel object should be selectable or not.
    @side(client)
    function SetSelectable(selectable: boolean): nil
    --- Sets the selected state of a selectable panel object. This functionality is set with `Panel:SetSelectable` and checked with `Panel:IsSelectable`.
    --- @param selected Whether the object should be selected or deselected. Panel:IsSelected can be used to determine the selected state of the object.
    @side(client)
    function SetSelected(selected: boolean | nil): nil
    --- Enables the panel object for selection (much like the spawn menu).
    --- @param set Whether to enable selection.
    @side(client)
    function SetSelectionCanvas(set: boolean): nil
    --- Sets the size of the panel.
    --- Calls `PANEL:OnSizeChanged` and marks this panel for layout (`Panel:InvalidateLayout`).
    --- Automatically rounds the width and height down
    --- See also `Panel:SetWidth` and `Panel:SetHeight`.
    --- **NOTE**: If you wish to position and re-size panels without much guesswork and have them look good on different screen resolutions, you may find `Panel:Dock` useful
    --- @param width The width of the panel.
    --- @param height The height of the panel.
    @side(client)
    function SetSize(width: number, height: number): nil
    --- Sets the derma skin that the panel object will use, and refreshes all panels with `derma.RefreshSkins`.
    --- @param skinName The name of the skin to use. The default derma skin is `Default`.
    @side(client)
    function SetSkin(skinName: string): nil
    --- Sets the `.png` image to be displayed on a  `SpawnIcon` or the panel it is based on - `ModelImage`.
    --- Only `.png` images can be used with this function.
    --- @param icon A path to the .png material, for example one of the Silkicons shipped with the game.
    @side(client)
    function SetSpawnIcon(icon: string): nil
    --- Used by `AvatarImage` panels to load an avatar by its 64-bit Steam ID (community ID).
    --- @param steamid The 64bit SteamID of the player to load avatar of
    --- @param size The size of the avatar to use. Acceptable sizes are 32, 64, 184.
    @side(client)
    function SetSteamID(steamid: string, size: number): nil
    --- When TAB is pressed, the next selectable panel in the number sequence is selected.
    --- **NOTE**: This function requires `Panel:SetFocusTopLevel` to be called on the parent panel for tab navigation to work.
    @side(client)
    function SetTabPosition(position: number): nil
    --- Sets height of a panel. An alias of `Panel:SetHeight`.
    --- @param height Desired height to set
    @side(client)
    function SetTall(height: number): nil
    --- Removes the panel after given time in seconds.
    --- **NOTE**: This function will not work if `PANEL:AnimationThink` is overridden, unless `Panel:AnimationThinkInternal` is called every frame.
    --- @param delay Delay in seconds after which the panel should be removed.
    @side(client)
    function SetTerm(delay: number): nil
    --- Sets the text value of a panel object containing text, such as a `Label`, `TextEntry` or  `RichText` and their derivatives, such as `DLabel`, `DTextEntry` or `DButton`.
    --- **WARNING**: When used on a `Label` or its derivatives ( `DLabel` and `DButton` ), it will automatically call `Panel:InvalidateLayout`, meaning that you should avoid running this function every frame on these panels to avoid unnecessary performance loss.
    --- **WARNING**: `Label` & its derivatives has hard length limit, maximum 1023 ascii characters.
    --- @param text The text value to set.
    @side(client)
    function SetText(text: string): nil
    --- Makes `TextEntry`'s text be replaced by `*` characters, just like a password-entry text field would.
    --- @param _ Whether to have the text be hidden.
    @side(client)
    function SetTextHidden(arg1: boolean): nil
    --- Sets the left and top text margins of a text-based panel object, such as a `DButton` or `DLabel`.
    --- @param insetX The left margin for the text, in pixels. This will only affect centered text if the margin is greater than its x-coordinate.
    --- @param insetY The top margin for the text, in pixels.
    @side(client)
    function SetTextInset(insetX: number, insetY: number): nil
    --- Sets text selection colors of a `RichText` element.
    --- @param textColor The Color to set for selected text.
    --- @param backgroundColor The Color to set for selected text background.
    @side(client)
    function SetTextSelectionColors(textColor: Color, backgroundColor: Color): nil
    --- Sets the height of a `RichText` element to accommodate the text inside.
    --- **NOTE**: This function internally relies on `Panel:GetNumLines`, so it should be called at least a couple frames after modifying the text using `Panel:AppendText`
    @side(client)
    function SetToFullHeight(): nil
    --- Sets the tooltip to be displayed when a player hovers over the panel object with their cursor.
    --- By default, `DTooltip` will be used. `Panel:SetTooltipPanelOverride` can be used to override the tooltip panel.
    --- @param str The text to be displayed in the tooltip. Set `nil` to disable it.
    @side(client)
    function SetTooltip(str: string | nil): nil
    --- Sets the tooltip delay. (time between hovering over the panel, and the tooltip showing up)
    --- Can be retrieved with `Panel:GetTooltipDelay`.
    --- @param tooltip The tooltip delay to set.
    @side(client)
    function SetTooltipDelay(tooltip: number): nil
    --- Sets the panel to be displayed as contents of a `DTooltip` when a player hovers over the panel object with their cursor. See `Panel:SetTooltipPanelOverride` if you are looking to override `DTooltip` itself.
    --- **NOTE**: `Panel:SetTooltip` will override this functionality.
    --- **WARNING**: Calling this from `PANEL:OnCursorEntered` is too late! The tooltip will not be displayed or be updated.
    --- Given panel or the previously set one will **NOT** be automatically removed.
    --- @param tooltipPanel The panel to use as the tooltip.
    @side(client)
    function SetTooltipPanel(tooltipPanel: Panel | nil): nil
    --- Sets the panel class to be created instead of `DTooltip` when the player hovers over this panel and a tooltip needs creating.
    --- @param override_ The panel class to override the default DTooltip. The new panel class must have the following methods: * Panel:SetText - If you are using Panel:SetTooltip. * DTooltip:SetContents - If you are using Panel:SetTooltipPanel. * DTooltip:OpenForPanel - A "hook" type function that gets called shortly after creation (and after the above 2) to open and position the tooltip. You can see this logic in `lua/includes/util/tooltips.lua`.
    @side(client)
    function SetTooltipPanelOverride(override_: string): nil
    --- Sets the underlined font for use by clickable text in a `RichText`. See also `Panel:InsertClickableTextStart`
    --- This function will only work on `RichText` panels.
    --- @param fontName The name of the font. See Default_Fonts for a list of existing fonts. Alternatively, use surface.CreateFont to create your own custom font.
    @side(client)
    function SetUnderlineFont(fontName: string): nil
    --- Sets the URL of a link-based panel such as `DLabelURL`.
    --- @param url The URL to set. It **must** begin with either `http://` or `https://`.
    @side(client)
    function SetURL(url: string): nil
    --- Sets the visibility of the vertical scrollbar.
    --- Works for `RichText` and `TextEntry`.
    --- @param display True to display the vertical text scroll bar, false to hide it.
    @side(client)
    function SetVerticalScrollbarEnabled(display: boolean | nil): nil
    --- Sets the "visibility" of the panel.
    --- @param visible The visibility of the panel.
    @side(client)
    function SetVisible(visible: boolean): nil
    --- Sets width of a panel. An alias of `Panel:SetWidth`.
    --- @param width Desired width to set
    @side(client)
    function SetWide(width: number): nil
    --- Sets the width of the panel.
    --- Calls `PANEL:OnSizeChanged` and marks this panel for layout (`Panel:InvalidateLayout`).
    --- Automatically rounds the width down
    --- See also `Panel:SetSize`.
    --- @param width The new width of the panel.
    @side(client)
    function SetWidth(width: number): nil
    --- This makes it so that when you're hovering over this panel you can "click" on the world. Your weapon aim (and its viewmodel) will follow the cursor. This is primarily used for the Sandbox context menu.
    --- @param enable Whether to enable or disable the feature for this panel.
    @side(client)
    function SetWorldClicker(enable: boolean): nil
    --- Sets whether text wrapping should be enabled or disabled on `Label` and `DLabel` panels.
    --- Use `DLabel:SetAutoStretchVertical` to automatically correct vertical size; `Panel:SizeToContents` will not set the correct height.
    --- @param wrap `True` to enable text wrapping, `false` otherwise.
    @side(client)
    function SetWrap(wrap: boolean): nil
    --- Sets the X position of the panel.
    --- Uses `Panel:SetPos` internally.
    --- @param x The X coordinate of the position.
    @side(client)
    function SetX(x: number): nil
    --- Sets the Y position of the panel.
    --- Uses `Panel:SetPos` internally.
    --- @param y The Y coordinate of the position.
    @side(client)
    function SetY(y: number): nil
    --- Sets the panels z position which determines the rendering order.
    --- Panels with lower z positions appear behind panels with higher z positions.
    --- This also controls in which order panels docked with `Panel:Dock` appears.
    --- @param zIndex The z position of the panel. Can't be lower than -32768 or higher than 32767.
    @side(client)
    function SetZPos(zIndex: number): nil
    --- Makes a panel visible.
    @side(client)
    function Show(): nil
    --- Uses animation to resize the panel to the specified size.
    --- @param sizeW The target width of the panel. Use -1 to retain the current width.
    --- @param sizeH The target height of the panel. Use -1 to retain the current height.
    --- @param time The time to perform the animation within.
    --- @param delay The delay before the animation starts.
    --- @param ease Easing of the start and/or end speed of the animation. See Panel:NewAnimation for how this works.
    --- @param callback The function to be called once the animation finishes. Function argument(s): * table `animData` - The Structures/AnimationData that was used. * Panel `targetPanel` - The panel object that was animated.
    @side(client)
    function SizeTo(sizeW: number | nil, sizeH: number | nil, time: number, delay: number | nil, ease: number | nil, callback: ({ [any]: any }, Panel) -> any | nil): nil
    --- Resizes the panel to fit the bounds of its children.
    --- **NOTE**: Your panel must have its layout updated (`Panel:InvalidateLayout`) for this function to work properly.
    --- **NOTE**: The sizeW and sizeH parameters are false by default. Therefore, calling this function with no arguments will result in a no-op.
    --- @param sizeW Resize with width of the panel.
    --- @param sizeH Resize the height of the panel.
    @side(client)
    function SizeToChildren(sizeW: boolean | nil, sizeH: boolean | nil): nil
    --- Resizes the panel so that its width and height fit all of the content inside.
    --- **NOTE**: Only works on `Label` derived panels such as `DLabel` by default, and on any panel that manually implemented the `Panel:SizeToContents` method, such as `DNumberWang` and `DImage`.
    --- **WARNING**: You must call this function **AFTER** setting text/font, adjusting child panels or otherwise altering the panel.
    @side(client)
    function SizeToContents(): nil
    --- Resizes the panel object's width to accommodate all child objects/contents.
    --- Only works on `Label` derived panels such as `DLabel` by default, and on any panel that manually implemented `Panel:GetContentSize` method.
    --- **NOTE**: You must call this function **AFTER** setting text/font or adjusting child panels.
    --- @param addVal The number of extra pixels to add to the width. Can be a negative number, to reduce the width.
    @side(client)
    function SizeToContentsX(addVal: number | nil): nil
    --- Resizes the panel object's height to accommodate all child objects/contents.
    --- Only works on `Label` derived panels such as `DLabel` by default, and on any panel that manually implemented `Panel:GetContentSize` method.
    --- **NOTE**: You must call this function **AFTER** setting text/font or adjusting child panels.
    --- @param addVal The number of extra pixels to add to the height.
    @side(client)
    function SizeToContentsY(addVal: number | nil): nil
    --- Slides the panel in from above.
    --- @param Length Time to complete the animation.
    @side(client)
    function SlideDown(Length: number): nil
    --- Slides the panel out to the top.
    --- @param Length Time to complete the animation.
    @side(client)
    function SlideUp(Length: number): nil
    --- Begins a box selection, enables mouse capture for the panel object, and sets the start point of the selection box to the mouse cursor's position, relative to this object. For this to work, either the object or its parent must be enabled as a selection canvas. This is set using `Panel:SetSelectionCanvas`.
    @side(client)
    function StartBoxSelection(): nil
    --- Stops all panel animations by clearing its animation list. This also clears all delayed animations.
    @side(client)
    function Stop(): nil
    --- Stops the loading of the `HTML` panel's current page.
    @side(client)
    function StopLoading(): nil
    --- Resizes the panel object's height so that its bottom is aligned with the top of the passed panel. An offset greater than zero will reduce the panel's height to leave a gap between it and the passed panel.
    --- @param tgtPanel The panel to align the bottom of this one with.
    --- @param offset The gap to leave between this and the passed panel. Negative values will cause the panel's height to increase, forming an overlap.
    @side(client)
    function StretchBottomTo(tgtPanel: Panel, offset: number | nil): nil
    --- Resizes the panel object's width so that its right edge is aligned with the left of the passed panel. An offset greater than zero will reduce the panel's width to leave a gap between it and the passed panel.
    --- @param tgtPanel The panel to align the right edge of this one with.
    --- @param offset The gap to leave between this and the passed panel. Negative values will cause the panel's width to increase, forming an overlap.
    @side(client)
    function StretchRightTo(tgtPanel: Panel, offset: number | nil): nil
    --- Sets the dimensions of the panel to fill its parent. It will only stretch in directions that aren't nil.
    --- @param offsetLeft The left offset to the parent.
    --- @param offsetTop The top offset to the parent.
    --- @param offsetRight The right offset to the parent.
    --- @param offsetBottom The bottom offset to the parent.
    @side(client)
    function StretchToParent(offsetLeft: number | nil, offsetTop: number | nil, offsetRight: number | nil, offsetBottom: number | nil): nil
    --- Toggles the selected state of a selectable panel object. This functionality is set with `Panel:SetSelectable` and checked with `Panel:IsSelectable`. To check whether the object is selected or not, `Panel:IsSelected` is used.
    @side(client)
    function ToggleSelection(): nil
    --- Toggles the visibility of a panel and all its children.
    @side(client)
    function ToggleVisible(): nil
    --- Restores the last saved state (caret position and the text inside) of a `TextEntry`. Should act identically to pressing CTRL+Z in a `TextEntry`.
    --- See also `Panel:SaveUndoState`.
    @side(client)
    function Undo(): nil
    --- Recursively deselects this panel object and all of its children. This will cascade to all child objects at every level below the parent.
    @side(client)
    function UnselectAll(): nil
    --- Forcibly updates the panels' HTML Material, similar to when Paint is called on it.This is only useful if the panel is not normally visible, i.e the panel exists purely for its HTML Material.
    --- **NOTE**: Only works on with panels that have a HTML Material. See `Panel:GetHTMLMaterial` for more details.
    --- **NOTE**: A good place to call this is in the `GM:PreRender` hook
    @side(client)
    function UpdateHTMLTexture(): nil
    --- Returns if a given panel is valid or not.
    --- @return boolean Whether the panel is valid or not, true being it is, false being it isn't.
    --- @deprecated Use Panel:IsValid instead.
    @side(client)
    function Valid(): boolean
end

--- Path object for a NextBot NPC and bots created by `player.CreateNextbot`. Returned by `Global.Path`.
declare class PathFollower
    --- Computes the shortest path to the provided entity arg. PathFollower Object must have `Chase` type.
    --- For PathFollower objects of the `Follow` type use `PathFollower:Compute`
    --- @param bot The bot to update along the path. This can also be a nextbot player (player.CreateNextbot)
    --- @param ent The entity we want to chase
    --- @param generator A function that allows you to alter the path generation. See example on PathFollower:Compute for the default function. Function argument(s): * CNavArea `area` - The area to move to. * CNavArea `fromArea` - The area to move from. * CNavLadder `ladder` - The ladder to move to or from (Validation required), if any. * Entity `elevator` - Will probably be always NULL * number `length` - Precomputed length between `area` and `fromArea`. Function return value(s): * number `cost` - The cost of movement between `area` and `fromArea`.
    @side(server)
    function Chase(bot: NextBot, ent: Entity, generator: (CNavArea, CNavArea, CNavLadder, Entity, number) -> number | nil): nil
    --- Compute shortest path from bot to 'goal' via A* algorithm. This only works if the PathFollower is the `Follow` Type.
    --- For PathFollowers of the `Chase` Type see `PathFollower:Chase`
    --- @param bot The nextbot we're generating for.  This can also be a nextbot player (player.CreateNextbot).
    --- @param goal The target location, the goal.
    --- @param generator A function that allows you to alter the path generation by adjusting the "cost". See example below for the default function. Function argument(s): * CNavArea `area` - The area to move to. * CNavArea `fromArea` - The area to move from. * CNavLadder `ladder` - The ladder to move to or from (Validation required), if any. * Entity `elevator` - Will probably be always NULL * number `length` - Precomputed length between `area` and `fromArea`. Function return value(s): * number `cost` - The cost of movement between `area` and `fromArea`.
    --- @return boolean * If returns true, path was found to the goal position. * If returns false, path may either be invalid (use IsValid() to check), or valid but doesn't reach all the way to the goal.
    @side(server)
    function Compute(bot: NextBot, goal: Vector, generator: (CNavArea, CNavArea, CNavLadder, Entity, number) -> number | nil): boolean
    --- Draws the path. This is meant for debugging - and uses `debugoverlay`.
    @side(server)
    function Draw(): nil
    --- Returns the first segment of the path.
    --- @return { [any]: any } A table with Structures/PathSegment.
    @side(server)
    function FirstSegment(): { [any]: any }
    --- Returns the age since the path was built
    --- @return number Path age
    @side(server)
    function GetAge(): number
    --- Returns all of the segments of the given path.
    --- @return PathSegment A table of tables with Structures/PathSegment.
    @side(server)
    function GetAllSegments(): PathSegment
    --- The closest position along the path to a position
    --- @param position The point we're querying for
    --- @return Vector The closest position on the path
    @side(server)
    function GetClosestPosition(position: Vector): Vector
    --- Returns the current goal data. Can return nil if the current goal is invalid, for example immediately after `PathFollower:Update`.
    --- @return { [any]: any } A table with Structures/PathSegment.
    @side(server)
    function GetCurrentGoal(): { [any]: any }
    --- Returns the cursor data
    --- @return { [any]: any } A table with 3 keys: number curvature Vector forward Vector pos
    @side(server)
    function GetCursorData(): { [any]: any }
    --- Returns the current progress along the path
    --- @return number The current progress
    @side(server)
    function GetCursorPosition(): number
    --- Returns the path end position
    --- @return Vector The end position
    @side(server)
    function GetEnd(): Vector
    --- Returns how close we can get to the goal to call it done.
    --- @return number The distance we're setting it to
    @side(server)
    function GetGoalTolerance(): number
    --- Returns the entity the bot is currently trying to avoid.
    --- @return Entity The current path hindrance, if any.
    --- @deprecated Currently always returns NULL due to internal implementation of Lua Nextbots, where nothing is considered a hindrance, so do not try to use.
    @side(server)
    function GetHindrance(): Entity
    --- Returns the total length of the path
    --- @return number The length of the path
    @side(server)
    function GetLength(): number
    --- Returns the minimum range movement goal must be along path.
    --- @return number The minimum look ahead distance
    @side(server)
    function GetMinLookAheadDistance(): number
    --- Returns the vector position of distance along path
    --- @param distance The distance along the path to query
    --- @return Vector The position
    @side(server)
    function GetPositionOnPath(distance: number): Vector
    --- Returns the path start position
    --- @return Vector The start position
    @side(server)
    function GetStart(): Vector
    --- Invalidates the current path
    @side(server)
    function Invalidate(): nil
    --- Returns true if the path is valid
    --- @return boolean Wether the path is valid or not.
    @side(server)
    function IsValid(): boolean
    --- Returns the last segment of the path.
    --- @return { [any]: any } A table with Structures/PathSegment.
    @side(server)
    function LastSegment(): { [any]: any }
    --- Moves the cursor by give distance.
    --- For a function that sets the distance, see `PathFollower:MoveCursorTo`.
    --- @param distance The distance to move the cursor (in relative world units)
    @side(server)
    function MoveCursor(distance: number): nil
    --- Sets the cursor position to given distance.
    --- For relative distance, see `PathFollower:MoveCursor`.
    --- @param distance The distance to move the cursor (in world units)
    @side(server)
    function MoveCursorTo(distance: number): nil
    --- Moves the cursor of the path to the closest position compared to given vector.
    --- @param type Seek type 0 = SEEK_ENTIRE_PATH - Search the entire path length 1 = SEEK_AHEAD - Search from current cursor position forward toward end of path 2 = SEEK_BEHIND - Search from current cursor position backward toward path start
    @side(server)
    function MoveCursorToClosestPosition(pos: Vector, type: number | nil, alongLimit: number | nil): nil
    --- Moves the cursor to the end of the path
    @side(server)
    function MoveCursorToEnd(): nil
    --- Moves the cursor to the end of the path
    @side(server)
    function MoveCursorToStart(): nil
    --- Returns the next segment of the path.
    --- @return { [any]: any } A table with Structures/PathSegment.
    @side(server)
    function NextSegment(): { [any]: any }
    --- Returns the previous segment of the path.
    --- @return { [any]: any } A table with Structures/PathSegment.
    @side(server)
    function PriorSegment(): { [any]: any }
    --- Resets the age which is retrieved by `PathFollower:GetAge` to 0.
    @side(server)
    function ResetAge(): nil
    --- How close we can get to the goal to call it done
    --- @param distance The distance we're setting it to
    @side(server)
    function SetGoalTolerance(distance: number): nil
    --- Sets minimum range movement goal must be along path
    --- @param mindist The minimum look ahead distance
    @side(server)
    function SetMinLookAheadDistance(mindist: number): nil
    --- Move the bot along the path.
    --- **NOTE**: player nextbots require `CUserCmd:SetForwardMove` to move forward along the path
    --- @param bot The bot to update along the path. This can also be a nextbot player (player.CreateNextbot)
    @side(server)
    function Update(bot: NextBot): nil
end

--- A PhysCollide holds collision data from VPhysics. These objects can be used to run (currently quite limited) collision tests, but do not represent actual physics objects.
--- Created by `Global.CreatePhysCollideBox` or `Global.CreatePhysCollidesFromModel`.
declare class PhysCollide
    --- Destroys the `PhysCollide` object.
    @side(shared)
    function Destroy(): nil
    --- Checks whether this `PhysCollide` object is valid or not.
    --- You should just use `Global.IsValid` instead.
    --- @return boolean Is valid or not.
    @side(shared)
    function IsValid(): boolean
    --- Performs a trace against this PhysCollide with the given parameters. This can be used for both line traces and box traces.
    --- @param origin The origin for the PhysCollide during the trace
    --- @param angles The angles for the PhysCollide during the trace
    --- @param rayStart The start position of the trace
    --- @param rayEnd The end position of the trace
    --- @param rayMins The mins of the trace's bounds
    --- @param rayMaxs The maxs of the trace's bounds
    --- @return Vector Hit position of the trace. This is false if the trace did not hit.
    --- @return Vector Hit normal of the trace
    --- @return number Fraction of the trace. This is calculated from the distance between startPos, hitPos, and endPos.
    @side(shared)
    function TraceBox(origin: Vector, angles: Angle, rayStart: Vector, rayEnd: Vector, rayMins: Vector, rayMaxs: Vector): (Vector, Vector, number)
end

--- This is the object returned by `Entity:GetPhysicsObject`, `Entity:GetPhysicsObjectNum` and `Vehicle:GetWheel`.
--- It represents a physics object. An entity can have multiple physics objects (ragdolls), one physics objects (props), or none. (NPCs, non physics entities, etc.)
--- Physics objects are usually simulated by the physics engine and usually dictate the position of the entity, and not the other way around.
declare class PhysObj
    --- Adds the specified [angular velocity](https://en.wikipedia.org/wiki/Angular_velocity) velocity to the current `PhysObj`.
    --- @param angularVelocity The additional velocity in `degrees/s`. (Local to the physics object.) Does nothing on frozen objects.
    @side(shared)
    function AddAngleVelocity(angularVelocity: Vector): nil
    --- Adds one or more bit flags.
    --- @param flags Bitflag, see Enums/FVPHYSICS.
    @side(shared)
    function AddGameFlag(flags: number): nil
    --- Adds the specified velocity to the current.
    --- @param velocity Additional velocity in `source_unit/s`. (World frame) Does nothing on frozen objects.
    @side(shared)
    function AddVelocity(velocity: Vector): nil
    --- Rotates the object so that it's angles are aligned to the ones inputted.
    @side(shared)
    function AlignAngles(from_: Angle, to: Angle): Angle
    --- Applies the specified impulse in the mass center of the physics object.
    --- **NOTE**: This will not work on players, use `Entity:SetVelocity` instead.
    --- @param impulse The [impulse](https://en.wikipedia.org/wiki/Impulse_(physics)) to be applied in `kg*source_unit/s`. (The vector is in world frame)
    @side(shared)
    function ApplyForceCenter(impulse: Vector): nil
    --- Applies the specified impulse on the physics object at the specified position.
    --- @param impulse The impulse to be applied in `kg*source_unit/s`. (World frame)
    --- @param position The position in world coordinates (`source units`) where the force is applied to the physics object.
    @side(shared)
    function ApplyForceOffset(impulse: Vector, position: Vector): nil
    --- Applies the specified angular impulse to the physics object. See `PhysObj:CalculateForceOffset`
    --- @param angularImpulse The angular impulse to be applied in `kg * m^2 * degrees / s`. (The vector is in world frame) The unit conversion between meters and source units in this case is `1 meter ≈ 39.37 source units (100/2.54 exactly)`
    @side(shared)
    function ApplyTorqueCenter(angularImpulse: Vector): nil
    --- Calculates the linear and angular impulse on the object's center of mass for an offset impulse.The outputs can be used with `PhysObj:ApplyForceCenter` and `PhysObj:ApplyTorqueCenter`, respectively.
    --- **Be careful to convert the angular impulse to world frame (`PhysObj:LocalToWorldVector`) if you are going to use it with ApplyTorqueCenter.**
    --- @param impulse The impulse acting on the object in `kg*source_unit/s`. (World frame)
    --- @param position The location of the impulse in world coordinates (`source units`)
    --- @return Vector The calculated linear impulse on the physics object's center of mass in `kg*source_unit/s`. (World frame)
    --- @return Vector The calculated angular impulse on the physics object's center of mass in `kg*m^2*degrees/s`. (Local frame)
    @side(shared)
    function CalculateForceOffset(impulse: Vector, position: Vector): (Vector, Vector)
    --- Calculates the linear and angular velocities on the center of mass for an offset impulse. The outputs can be directly passed to `PhysObj:AddVelocity` and `PhysObj:AddAngleVelocity`, respectively.
    --- **WARNING**: This will return zero length vectors if the physics object's motion is disabled. See `PhysObj:IsMotionEnabled`.
    --- @param impulse The impulse acting on the object in `kg*source_unit/s`. (World frame)
    --- @param position The location of the impulse in world coordinates (`source units`)
    --- @return Vector The calculated linear velocity from the impulse on the physics object's center of mass in `source_unit/s`. (World frame)
    --- @return Vector The calculated angular velocity from the impulse on the physics object's center of mass in `degrees/s`. (Local frame)
    @side(shared)
    function CalculateVelocityOffset(impulse: Vector, position: Vector): (Vector, Vector)
    --- Removes one of more specified flags.
    --- @param flags Bitflag, see Enums/FVPHYSICS.
    @side(shared)
    function ClearGameFlag(flags: number): nil
    --- Allows you to move a PhysObj to a point and angle in 3D space. Works with any PhysObj, not just physics shadows.
    --- @param shadowparams The parameters for the shadow. See Structures/ShadowControlParams.
    @side(shared)
    function ComputeShadowControl(shadowparams: { [any]: any }): nil
    --- Sets whether the physics object should collide with anything or not, including world.
    --- **WARNING**: This function currently has major problems with player collisions, and as such should be avoided at all costs.
    --- A better alternative to this function would be using `Entity:SetCollisionGroup`( COLLISION_GROUP_WORLD ).
    --- @param enable True to enable, false to disable.
    @side(shared)
    function EnableCollisions(enable: boolean): nil
    --- Sets whenever the physics object should be affected by drag.
    --- @param enable True to enable, false to disable.
    @side(shared)
    function EnableDrag(enable: boolean): nil
    --- Sets whether the PhysObject should be affected by gravity
    --- @param enable True to enable, false to disable.
    @side(shared)
    function EnableGravity(enable: boolean): nil
    --- Sets whether the physobject should be able to move or not.
    --- This is the exact method the Physics Gun uses to freeze props. If a motion-disabled physics object is grabbed with the physics gun, the object will be able to move again. To disallow this, use `GM:PhysgunPickup`.
    --- @param enable True to enable, false to disable.
    @side(shared)
    function EnableMotion(enable: boolean): nil
    --- Returns the mins and max of the physics object Axis-Aligned Bounding Box.
    --- @return Vector | nil The minimum extents of the bounding box, or `nil` for runtime generated physics object.
    --- @return Vector The maximum extents of the bounding box.
    @side(shared)
    function GetAABB(): (Vector | nil, Vector)
    --- Returns the angles of the physics object in degrees.
    --- @return Angle The angles of the physics object.
    @side(shared)
    function GetAngles(): Angle
    --- Gets the angular velocity of the object in degrees per second as a local vector. You can use dot product to read the magnitude from a specific axis.
    --- @return Vector The angular velocity
    @side(shared)
    function GetAngleVelocity(): Vector
    --- Returns the buoyancy ratio of the physics object. (How well it floats in water).
    --- **NOTE**: This feature is not available on x86-64 beta and on MacOS version of the game.
    --- @return number Buoyancy ratio, where 0 is not buoyant at all (like a rock), and 1 is very buoyant (like wood)
    @side(shared)
    function GetBuoyancyRatio(): number
    --- Returns the contents flag of the `PhysObj`.
    --- @return number The Enums/CONTENTS.
    @side(shared)
    function GetContents(): number
    --- Returns the linear and angular damping of the physics object.
    --- @return number The linear damping
    --- @return number The angular damping
    @side(shared)
    function GetDamping(): (number, number)
    --- Returns the sum of the linear and rotational kinetic energies of the physics object.
    --- @return number The kinetic energy
    @side(shared)
    function GetEnergy(): number
    --- Returns the parent entity of the physics object.
    --- @return Entity The entity this physics object belongs to
    @side(shared)
    function GetEntity(): Entity
    --- Returns the friction snapshot of this physics object. This is useful for determining if an object touching ground for example.
    --- @return { [any]: any } A table of tables containing the following data: * PhysObj Other - The other physics object we came in contact with * number EnergyAbsorbed - * number FrictionCoefficient - * number NormalForce - * Vector Normal - Direction of the friction event * Vector ContactPoint - Contact point of the friction event * number Material - Surface Property ID of our physics obj * number MaterialOther - Surface Property ID of the physics obj we came in contact with
    @side(server)
    function GetFrictionSnapshot(): { [any]: any }
    --- Returns the index this physics object is on its `PhysObj:GetEntity`.
    --- Useful for `Entity:TranslateBoneToPhysBone`.
    --- @return number The physics object index on its parent entity.
    @side(shared)
    function GetIndex(): number
    --- Returns the principal moments of inertia `(Ixx, Iyy, Izz)` of the physics object, in the local frame, with respect to the center of mass.
    --- @return Vector The moment of inertia in `kg * m^2` The unit conversion between meters and source units in this case is `1 meter ≈ 39.37 source units (100/2.54 exactly)` This value changes proportionally to the physics object's mass (e.g. making the object twice as heavy will result in it having twice the angular inertia)
    @side(shared)
    function GetInertia(): Vector
    --- Returns 1 divided by the angular inertia. See `PhysObj:GetInertia`
    --- @return Vector The inverted angular inertia Returns `[0, 0, 0]` on frozen physics objects.
    @side(shared)
    function GetInvInertia(): Vector
    --- Returns 1 divided by the physics object's mass (in kilograms).
    --- @return number The inverted mass. Returns 0 on frozen physics objects.
    @side(shared)
    function GetInvMass(): number
    --- Returns the mass of the physics object.
    --- @return number The mass in kilograms.
    @side(shared)
    function GetMass(): number
    --- Returns the center of mass of the physics object as a local vector.
    --- @return Vector The center of mass of the physics object.
    @side(shared)
    function GetMassCenter(): Vector
    --- Returns the [physical material](https://developer.valvesoftware.com/wiki/Material_surface_properties) ($surfaceprop) of the physics object.
    --- See `util.GetSurfaceData` for a function that adds these types as well as further explanation of what they are.
    --- @return string The physical material name. ($surfaceprop)
    @side(shared)
    function GetMaterial(): string
    --- Returns the physics mesh of the object which is used for physobj-on-physobj collision.
    --- @return { [any]: any } Table of Structures/MeshVertexs where each three vertices represent a triangle. Returns nil if the physics object is a sphere.
    @side(shared)
    function GetMesh(): { [any]: any }
    --- Returns all convex physics meshes of the object. See `Entity:PhysicsInitMultiConvex` for more information.
    --- @return { [any]: any } Table of Structures/MeshVertexs where each Structures/MeshVertex is an independent convex mesh and each three vertices represent a triangle. Returns nil if the physics object is a sphere.
    @side(shared)
    function GetMeshConvexes(): { [any]: any }
    --- Returns the name of the physics object.
    --- @return string The name of the physics object.
    @side(shared)
    function GetName(): string
    --- Returns the position of the physics object.
    --- @return Vector The position in world coordinates. (`source units`)
    @side(shared)
    function GetPos(): Vector
    --- Returns the position and angle of the physics object as a 3x4 matrix (`VMatrix` is 4x4 so the fourth row goes unused). The first three columns store the angle as a [rotation matrix](https://en.wikipedia.org/wiki/Rotation_matrix), and the fourth column stores the position vector.
    --- @return VMatrix The position and angle matrix.
    @side(shared)
    function GetPositionMatrix(): VMatrix
    --- Returns the rotation damping of the physics object.
    --- @return number The rotation damping
    @side(shared)
    function GetRotDamping(): number
    --- Returns the angles of the `PhysObj` shadow. See `PhysObj:UpdateShadow`.
    --- @return Angle The angles of the PhysObj shadow.
    @side(shared)
    function GetShadowAngles(): Angle
    --- Returns the position of the `PhysObj` shadow. See `PhysObj:UpdateShadow`.
    --- @return Vector The position of the PhysObj shadow.
    @side(shared)
    function GetShadowPos(): Vector
    --- Returns the speed damping of the physics object.
    --- @return number speedDamping
    @side(shared)
    function GetSpeedDamping(): number
    --- Returns the internal and external stress of the entity.
    --- @return number The external stress (`𝜎𝑒`). It's the value of a giving force to other entities (in kg).
    --- @return number The internal stress (`𝜎𝑖`). It's the value of a receiving force from other entities (in kg).
    @side(server)
    function GetStress(): (number, number)
    --- Returns the surface area of the physics object in source-units². Or nil if the PhysObj is a generated sphere or box.
    --- @return number | nil The surface area or `nil` if the PhysObj is a generated sphere or box.
    @side(shared)
    function GetSurfaceArea(): number | nil
    --- Returns the absolute directional velocity of the physobject.
    --- @return Vector velocity
    @side(shared)
    function GetVelocity(): Vector
    --- Returns the world velocity of a point in world coordinates about the object. This is useful for objects rotating around their own axis/origin.
    --- @param point A point to test in world space coordinates
    --- @return Vector Velocity at the given point
    @side(shared)
    function GetVelocityAtPoint(point: Vector): Vector
    --- Returns the volume in source units³. Or nil if the PhysObj is a generated sphere or box.
    --- @return number | nil The volume or `nil` if the PhysObj is a generated sphere or box.
    @side(shared)
    function GetVolume(): number | nil
    --- Returns whenever the specified flag(s) is/are set.
    --- @param flags Bitflag, see Enums/FVPHYSICS.
    --- @return boolean If flag was set or not
    @side(shared)
    function HasGameFlag(flags: number): boolean
    --- Returns whether the physics object is "sleeping".
    --- See `PhysObj:Sleep` for more information.
    --- @return boolean Whether the physics object is sleeping.
    @side(shared)
    function IsAsleep(): boolean
    --- Returns whenever the entity is able to collide or not.
    --- @return boolean isCollisionEnabled
    @side(shared)
    function IsCollisionEnabled(): boolean
    --- Returns whenever the entity is affected by drag.
    --- @return boolean dragEnabled
    @side(shared)
    function IsDragEnabled(): boolean
    --- Returns whenever the entity is affected by gravity.
    --- @return boolean `true` if the gravity is enabled, `false` otherwise
    @side(shared)
    function IsGravityEnabled(): boolean
    --- Returns if the physics object can move itself (by velocity, acceleration)
    --- @return boolean `true` if the motion is enabled, `false` otherwise.
    @side(shared)
    function IsMotionEnabled(): boolean
    --- Returns whenever the entity is able to move.
    --- @return boolean movable
    @side(shared)
    function IsMoveable(): boolean
    --- Returns whenever the physics object is penetrating another physics object.
    --- This is internally implemented as `PhysObj:HasGameFlag( FVPHYSICS_PENETRATING )` and thus is only updated for non-static physics objects.
    --- @return boolean Whether the physics object is penetrating another object.
    @side(shared)
    function IsPenetrating(): boolean
    --- Returns if the physics object is valid/not NULL.
    --- @return boolean Whether the physics object is valid or not.
    @side(shared)
    function IsValid(): boolean
    --- Translates a vector in the physics object's local space into worldspace coordinates.
    --- **NOTE**: Internally transforms the vector by the `PhysObj:GetPositionMatrix`.
    --- So in GLua it approximates to:
    --- ```
    --- local matrixWorldTransform = PhysObj:GetPositionMatrix()
    --- local vecWorldspaced = Vector()
    --- vecWorldspaced:Set( vecLocal )
    --- vecWorldspaced:Mul( matrixWorldTransform )
    --- return vecWorldspaced
    --- ```
    --- @param vecLocal A vector in the physics object's local space.
    --- @return Vector The corresponding worldspace vector.
    @side(shared)
    function LocalToWorld(vecLocal: Vector): Vector
    --- Rotationally transforms a vector in the physics object's local space by the `PhysObj:GetPositionMatrix`.
    --- **NOTE**: In contrast to `PhysObj:LocalToWorld`, this function doesn't translate the vector.
    --- @param vecLocal A vector in the physics object's local space.
    --- @return Vector The resulting vector from the rotational transformation.
    @side(shared)
    function LocalToWorldVector(vecLocal: Vector): Vector
    --- Prints debug info about the state of the physics object to the console.
    @side(shared)
    function OutputDebugInfo(): nil
    --- Call this when the collision filter conditions change due to this object's state (e.g. changing solid type or collision group)
    @side(shared)
    function RecheckCollisionFilter(): nil
    --- A convinience function for `Angle:RotateAroundAxis`.
    --- @param dir Direction, around which we will rotate
    --- @param ang Amount of rotation, in degrees
    --- @return Angle The resulting angle
    @side(shared)
    function RotateAroundAxis(dir: Vector, ang: number): Angle
    --- Sets the amount of [drag](https://en.wikipedia.org/wiki/Drag_(physics)) to apply to a physics object when attempting to rotate.
    --- @param coefficient [Drag coefficient](https://en.wikipedia.org/wiki/Drag_coefficient). The bigger this value is, the slower the angles will change.
    @side(shared)
    function SetAngleDragCoefficient(coefficient: number): nil
    --- Sets the angles of the physobject in degrees.
    --- @param angles The new angles of the physobject. The new angle will not be applied on the parent entity while the physics object is asleep (`PhysObj:Sleep`)
    @side(shared)
    function SetAngles(angles: Angle): nil
    --- Sets the specified [angular velocity](https://en.wikipedia.org/wiki/Angular_velocity) on the `PhysObj`
    --- @param angularVelocity The new velocity in `degrees/s`. (Local frame)
    @side(shared)
    function SetAngleVelocity(angularVelocity: Vector): nil
    --- Sets the specified instantaneous [angular velocity](https://en.wikipedia.org/wiki/Angular_velocity) on the `PhysObj`
    --- @param angularVelocity The new velocity to set velocity.
    @side(shared)
    function SetAngleVelocityInstantaneous(angularVelocity: Vector): nil
    --- Sets the buoyancy ratio of the physics object. (How well it floats in water)
    --- @param buoyancy Buoyancy ratio, where 0 is not buoyant at all (like a rock), and 1 is very buoyant (like wood). You can set values larger than 1 for greater effect.
    @side(shared)
    function SetBuoyancyRatio(buoyancy: number): nil
    --- Sets the contents flag of the `PhysObj`.
    --- @param contents The Enums/CONTENTS.
    @side(shared)
    function SetContents(contents: number): nil
    --- Sets the linear and angular damping of the physics object.
    --- @param linearDamping Linear damping.
    --- @param angularDamping Angular damping.
    @side(shared)
    function SetDamping(linearDamping: number, angularDamping: number): nil
    --- Modifies how much drag (air resistance) affects the object.
    --- @param drag The drag coefficient It can be positive or negative.
    @side(shared)
    function SetDragCoefficient(drag: number): nil
    --- Sets the angular inertia. See `PhysObj:GetInertia`.
    --- **NOTE**: This does not affect linear inertia.
    --- @param angularInertia The angular inertia of the object.
    @side(shared)
    function SetInertia(angularInertia: Vector): nil
    --- Sets the mass of the physics object.
    --- **WARNING**: This resets `PhysObj:SetBuoyancyRatio` (Recalculated based materials' and the physics objects' densities, latter of which is dependent on mass).
    --- If you used a custom ratio, you will have to re-set it again after `SetMass`.
    --- @param mass The mass in kilograms, in range `[0.1, 50000]`
    @side(shared)
    function SetMass(mass: number): nil
    --- Sets the material of the physobject.
    --- **NOTE**: Impact sounds will only change if this is called on client
    --- @param materialName The name of the phys material to use. From this list: [Valve Developer](https://developer.valvesoftware.com/wiki/Material_surface_properties)
    @side(shared)
    function SetMaterial(materialName: string): nil
    --- Sets the position of the physobject.
    --- @param position The new position of the physobject in world coordinates. (`source units`). The new position will not be applied on the parent entity while the physics object is asleep (`PhysObj:Sleep`)
    --- @param teleport If `true`, temporarily disables collisions of the physics objects just before moving it, then enables collisions back again.
    @side(shared)
    function SetPos(position: Vector, teleport: boolean | nil): nil
    --- Sets the velocity of the physics object for the next iteration.
    --- @param velocity The new velocity of the physics object in `source_unit/s`. (World frame)
    @side(shared)
    function SetVelocity(velocity: Vector): nil
    --- Sets the velocity of the physics object.
    --- @param velocity The new velocity of the physics object.
    @side(shared)
    function SetVelocityInstantaneous(velocity: Vector): nil
    --- Makes the physics object "sleep". The physics object will no longer be moving unless it is "woken up" by either a collision with another moving object, or by `PhysObj:Wake`.
    --- This is an optimization feature of the physics engine. Normally physics objects will automatically "sleep" when not moving for a short while, to save resources, but it can be used for other purposes, for example to temporarily suspend an object mid air.
    @side(shared)
    function Sleep(): nil
    --- Unlike `PhysObj:SetPos` and `PhysObj:SetAngles`, this allows the movement of a physobj while leaving physics interactions intact.
    --- This is used internally by the motion controller of the Gravity Gun , the +use pickup and the Physics Gun, and entities such as the crane.
    --- **NOTE**: This is the ideal function to move a physics shadow created with `Entity:PhysicsInitShadow` or `Entity:MakePhysicsObjectAShadow`.
    --- @param targetPosition The position we should move to.
    --- @param targetAngles The angle we should rotate towards.
    --- @param frameTime The frame time to use for this movement, can be generally filled with Global.FrameTime or ENTITY:PhysicsSimulate with the deltaTime. Can be set to 0 when you need to update the physics object just once.
    @side(shared)
    function UpdateShadow(targetPosition: Vector, targetAngles: Angle, frameTime: number): nil
    --- Wakes the physics object, so that it will continue to simulate physics/gravity.
    --- See `PhysObj:Sleep` for more information.
    @side(shared)
    function Wake(): nil
    --- Translates a worldspace vector into the physics object's local space.
    --- @param vec A worldspace vector.
    --- @return Vector The corresponding local space vector.
    @side(shared)
    function WorldToLocal(vec: Vector): Vector
    --- Rotationally transforms a worldspace vector into the physics object's local space by the inverted `PhysObj:GetPositionMatrix`.
    --- For example, in GMod this is used in thrusters, for working out linear force for local acceleration.
    --- **NOTE**: In contrast to `PhysObj:WorldToLocal`, this function doesn't translate the vector.
    --- @param vec A worldspace vector.
    --- @return Vector The resulting vector from the rotational transformation.
    @side(shared)
    function WorldToLocalVector(vec: Vector): Vector
end

--- Created by `util.GetPixelVisibleHandle` and used by `util.PixelVisible`.
declare class pixelvis_handle_t
end

--- This is a list of all methods only available for players. It is also possible to call `Entity` functions on the Player.
@overrideCtor("$class($args)")
declare class Player extends Entity
    --- Returns the player with the matching `Player:UserID`.
    --- For a function that returns a player based on their `Entity:EntIndex`, see `Global.Entity`.
    --- For a function that returns a player based on their connection ID, see `player.GetByID`.
    --- @param playerIndex The player index.
    constructor(playerIndex: number)
    --- Returns the player's AccountID part of their full SteamID.
    --- Since this does not include other vital parts of the SteamID such as "Account Type" and "Account Instance", it should be avoided, as AccountIDs are finite, and can theoretically be the same for multiple valid accounts.
    --- See `Player:SteamID` for the text representation of the full SteamID.
    --- See `Player:SteamID64` for a 64bit representation of the full SteamID.
    --- **NOTE**: In a `-multirun` environment, this will return `-1` for all "copies" of a player because they are not authenticated with Steam.
    --- For bots this will return values starting with `0` for the first bot, `1` for the second bot and so on.
    --- @return number The AccountID of Player's SteamID.
    @side(shared)
    function AccountID(): number
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- Adds an entity to the player's clean up list. This uses `cleanup.Add` internally.
    --- @param type The Cleanup type for this Entity.
    --- @param ent The Entity to add.
    @side(server)
    function AddCleanup(type: string, ent: Entity): nil
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- Adds an entity to the player's list of entities of the same type. See `Player:GetCount` to get the current count of entities of an entity type added with this function.
    --- @param str The type of this Entity.
    --- @param ent The Entity you want to add to the list.
    @side(shared)
    function AddCount(str: string, ent: Entity): nil
    --- Adds the provided amount to the player's death count.
    --- @param count The amount to add to the death count.
    @side(server)
    function AddDeaths(count: number): nil
    --- Adds the provided amount to the player's frag/kill count.
    --- @param count The amount to add.
    @side(server)
    function AddFrags(count: number): nil
    --- Adds an entity to the player's list of frozen objects.
    --- @param ent The Entity to add.
    --- @param physobj The physics object of the Entity.
    @side(server)
    function AddFrozenPhysicsObject(ent: Entity, physobj: PhysObj): nil
    --- Sets up the voting system for the player.
    --- This is a really barebone system. By calling this a vote gets started, when the player presses 0-9 the callback function gets called along with the key the player pressed. Use the draw callback to draw the vote panel.
    --- @param name Name of the vote
    --- @param timeout Time until the vote expires
    --- @param vote_callback The function to be run when the player presses 0-9 while a vote is active. Function argument(s): * number `voteNum` - Which option the player pressed, 1-9 and 0 being the very last option. Function return value(s): * boolean `` - Return true to remove this option from the vote.
    --- @param draw_callback Used to draw the vote panel.
    @side(client)
    function AddPlayerOption(name: string, timeout: number, vote_callback: (number) -> boolean, draw_callback: function): nil
    --- Plays a sequence directly from a sequence number, similar to `Player:AnimRestartGesture`. This function has the advantage to play sequences that haven't been bound to an existing `Enums/ACT`
    --- **WARNING**: This is not automatically networked. This function has to be called on the client to be seen by said client.
    --- @param slot Gesture slot using Enums/GESTURE_SLOT
    --- @param sequenceId The sequence ID to play, can be retrieved with Entity:LookupSequence.
    --- @param cycle The cycle to start the animation at, ranges from 0 to 1.
    --- @param autokill If the animation should not loop. true = stops the animation, false = the animation keeps playing.
    @side(shared)
    function AddVCDSequenceToGestureSlot(slot: number, sequenceId: number, cycle: number, autokill: boolean | nil): nil
    --- Checks if the player is alive.
    --- Player specific implementation of `Entity:Alive`, the value is synchronized to the client.
    --- @return boolean Whether the player is alive
    @side(shared)
    override function Alive(): boolean
    --- Sets if the player can toggle their flashlight. Function exists on both the server and client but has no effect when ran on the client.
    --- This is a Lua method that internally uses `GM:PlayerSwitchFlashlight`. If current gamemode overwrites that hook and doesn't respect `Player:CanUseFlashlight`, this function will not have any effect.
    --- @param canFlashlight True allows flashlight toggling
    @side(shared)
    function AllowFlashlight(canFlashlight: boolean): nil
    --- Lets the player spray their decal without delay
    --- @param allow Allow or disallow
    @side(server)
    function AllowImmediateDecalPainting(allow: boolean): nil
    --- Resets player gesture in selected slot.
    --- @param slot Slot to reset. See the Enums/GESTURE_SLOT.
    @side(shared)
    function AnimResetGestureSlot(slot: number): nil
    --- Restart a gesture on a player, within a gesture slot.
    --- **WARNING**: This is not automatically networked. This function has to be called on the client to be seen by said client.
    --- @param slot Gesture slot using Enums/GESTURE_SLOT
    --- @param activity The activity ( see Enums/ACT ) or sequence that should be played
    --- @param autokill Whether the animation should be automatically stopped. true = stops the animation, false = the animation keeps playing/looping
    @side(shared)
    function AnimRestartGesture(slot: number, activity: number, autokill: boolean | nil): nil
    --- Restarts the main animation on the player, has the same effect as calling `Entity:SetCycle`( 0 ).
    @side(shared)
    function AnimRestartMainSequence(): nil
    --- Sets the sequence of the animation playing in the given gesture slot.
    --- @param slot The gesture slot. See Enums/GESTURE_SLOT
    --- @param sequenceID Sequence ID to set.
    @side(shared)
    function AnimSetGestureSequence(slot: number, sequenceID: number): nil
    --- Sets the weight of the animation playing in the given gesture slot.
    --- @param slot The gesture slot. See Enums/GESTURE_SLOT
    --- @param weight The weight this slot should be set to. Value must be ranging from 0 to 1.
    @side(shared)
    function AnimSetGestureWeight(slot: number, weight: number): nil
    --- Returns the player's armor.
    --- @return number The player's armor.
    @side(shared)
    function Armor(): number
    --- Bans the player from the server for a certain amount of minutes.
    --- @param minutes Duration of the ban in minutes (0 is permanent)
    --- @param kick Whether to kick the player after banning them or not
    @side(server)
    function Ban(minutes: number, kick: boolean | nil): nil
    --- Returns true if the player's flashlight hasn't been disabled by `Player:AllowFlashlight`.
    --- **NOTE**: This is not synchronized between clients and server automatically!
    --- @return boolean Whether the player can use flashlight.
    @side(shared)
    function CanUseFlashlight(): boolean
    --- Prints a string to the chatbox of the client.
    --- **WARNING**: Just like the `usermessage`, this function is affected by the 255 byte limit!
    --- @param message String to be printed
    @side(shared)
    function ChatPrint(message: string): nil
    --- Checks if the limit of an entity type added by `Player:AddCount` is hit or not. If it's hit, it will call the `GM:PlayerCheckLimit` hook, and call `Player:LimitHit` if the hook doesn't return `false`.
    --- This will always return `true` in singleplayer, as singleplayer does not have limits.
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- @param str The entity type to check the limit for. Default types: * "constraints" * "props" * "ragdolls" * "vehicles" * "effects" * "balloons" * "cameras" * "npcs" * "sents" * "dynamite" * "lamps" * "lights" * "wheels" * "thrusters" * "hoverballs" * "buttons" * "emitters"
    --- @return boolean Returns `true` if the limit of this type is not hit, `false` otherwise.
    @side(shared)
    function CheckLimit(str: string): boolean
    --- Runs the concommand on the player. This does not work on bots. If used clientside, always runs the command on the local player.
    --- If you wish to directly modify the movement input of bots, use `GM:StartCommand` instead.
    --- **NOTE**: Some commands/convars are blocked from being run/changed using this function, usually to prevent harm/annoyance to clients. For a list of blocked commands, see `Blocked ConCommands`.
    --- @param command command to run
    @side(shared)
    function ConCommand(command: string): nil
    --- Creates the player's death ragdoll entity and deletes the old one.
    --- This is normally used when a player dies, to create their death ragdoll.
    --- The ragdoll will be created with the player's properties such as `Position`, `Angles`, `PlayerColor`, `Velocity` and `Model`.
    --- You can retrieve the entity this creates with `Player:GetRagdollEntity`.
    @side(server)
    function CreateRagdoll(): nil
    --- Disables the default player's crosshair. Can be reenabled with `Player:CrosshairEnable`. This will affect `WEAPON:DoDrawCrosshair`.
    @side(server)
    function CrosshairDisable(): nil
    --- Enables the player's crosshair, if it was previously disabled via `Player:CrosshairDisable`.
    @side(server)
    function CrosshairEnable(): nil
    --- Returns whether the player is crouching or not (`FL_DUCKING` flag).
    --- @return boolean Whether the player is crouching.
    @side(shared)
    function Crouching(): boolean
    --- Returns the player's death count
    --- @return number The number of deaths the player has had.
    @side(shared)
    function Deaths(): number
    --- Prints the players' name and position to the console.
    @side(shared)
    function DebugInfo(): nil
    --- Detonates all tripmines belonging to the player.
    @side(server)
    function DetonateTripmines(): nil
    --- Disables world clicking for given player. See `Panel:SetWorldClicker` and `Player:IsWorldClickingDisabled`.
    --- @param disable Whether the world clicking should be disabled.
    @side(server)
    function DisableWorldClicking(disable: boolean): nil
    --- Sends a third person animation event to the player.
    --- Calls `GM:DoAnimationEvent` with `PLAYERANIMEVENT_CUSTOM_GESTURE` as the event, data as the given data.
    --- @param data The data to send.
    @side(shared)
    function DoAnimationEvent(data: number): nil
    --- Starts the player's attack animation. The attack animation is determined by the weapon's HoldType.
    --- Similar to other animation event functions, calls `GM:DoAnimationEvent` with `PLAYERANIMEVENT_ATTACK_PRIMARY` as the event and no extra data.
    @side(shared)
    function DoAttackEvent(): nil
    --- Sends a specified third person animation event to the player.
    --- Calls `GM:DoAnimationEvent` with specified arguments.
    --- @param event The event to send. See Enums/PLAYERANIMEVENT.
    --- @param data The data to send alongside the event.
    @side(shared)
    function DoCustomAnimEvent(event: number, data: number): nil
    --- Sends a third person reload animation event to the player.
    --- Similar to other animation event functions, calls `GM:DoAnimationEvent` with `PLAYERANIMEVENT_RELOAD` as the event and no extra data.
    @side(shared)
    function DoReloadEvent(): nil
    --- Sends a third person secondary fire animation event to the player.
    --- Similar to other animation event functions, calls `GM:DoAnimationEvent` with `PLAYERANIMEVENT_ATTACK_SECONDARY` as the event and no extra data.
    @side(shared)
    function DoSecondaryAttack(): nil
    --- Show/Hide the player's weapon's viewmodel.
    --- @param draw Should draw
    --- @param vm Which view model to show/hide, 0-2.
    @side(shared)
    function DrawViewModel(draw: boolean, vm: number | nil): nil
    --- Show/Hide the player's weapon's worldmodel.
    --- @param draw Should draw
    @side(server)
    function DrawWorldModel(draw: boolean): nil
    --- Drops the players' weapon of a specific class.
    --- @param class_ The class to drop.
    --- @param target If set, launches the weapon at given position. There is a limit to how far it is willing to throw the weapon. Overrides velocity argument.
    --- @param velocity If set and previous argument is unset, launches the weapon with given velocity. If the velocity is higher than 400, it will be clamped to 400.
    @side(server)
    function DropNamedWeapon(class_: string, target: Vector | nil, velocity: Vector | nil): nil
    --- Drops any object the player is currently holding with either Gravity Gun, Physics Gun or `+use` (E key)
    --- See also `Entity:ForcePlayerDrop`.
    --- @param entity Only drop if the held entity is this entity. If left blank, drop any held entity.
    @side(server)
    function DropObject(entity: Entity | nil): nil
    --- Forces the player to drop the specified weapon
    --- @param weapon Weapon to be dropped. If unset, will default to the currently equipped weapon.
    --- @param target If set, launches the weapon at given position. There is a limit to how far it is willing to throw the weapon. Overrides velocity argument.
    --- @param velocity If set and previous argument is unset, launches the weapon with given velocity. If the velocity is higher than 400, it will be clamped to 400.
    @side(server)
    function DropWeapon(weapon: Weapon | nil, target: Vector | nil, velocity: Vector | nil): nil
    --- Force puts the player into a specified vehicle.
    --- This **does not** bypass `GM:CanPlayerEnterVehicle`.
    --- @param vehicle Vehicle the player will enter
    @side(server)
    function EnterVehicle(vehicle: Vehicle): nil
    --- Equips the player with the HEV suit.
    --- Allows the player to zoom, walk slowly, sprint, pickup armor batteries, use the health and armor stations and also shows the HUD.
    --- The player also emits a flatline sound on death, which can be overridden with `GM:PlayerDeathSound`.
    --- The player is automatically equipped with the suit on spawn, if you wish to stop that, use `Player:RemoveSuit`.
    --- @param playEffects If set to `true`, play the suit glove admire animation if player is holding no weapons.
    @side(server)
    function EquipSuit(playEffects: boolean | nil): nil
    --- Forces the player off the current ladder if they are on one.
    @side(server)
    function ExitLadder(): nil
    --- Forces the player to exit the vehicle if they're in one.
    --- This function will bypass `GM:CanExitVehicle`. See also `GM:PlayerLeaveVehicle`
    @side(server)
    function ExitVehicle(): nil
    --- Enables/Disables the player's flashlight.
    --- `Player:CanUseFlashlight` must be true in order for the player's flashlight to be changed.
    --- `GM:PlayerSwitchFlashlight` can block this function.
    --- **NOTE**: Added in [2025.11.12](https://gmod.facepunch.com/changelist/4026), the `gmod_flashlight` attachment is used as a source for the player's flashlight. In thirdperson, the playermodel and weapon worldmodel are checked; in firstperson, the viewmodel is checked. If the attachment isn't found, default engine functionality is used.
    --- The light sprite attached to the playermodel when the flashlight is on will also follow the playermodel's `gmod_flashlight` attachment if it exists.
    --- @param isOn Turns the flashlight on/off
    @side(server)
    function Flashlight(isOn: boolean): nil
    --- Returns true if the player's flashlight is on.
    --- @return boolean Whether the player's flashlight is on.
    @side(shared)
    function FlashlightIsOn(): boolean
    --- Returns the amount of frags a player has.
    --- **NOTE**: The value will change depending on the player's kill or suicide: +1 for a kill, -1 for a suicide.
    --- @return number frags
    @side(shared)
    function Frags(): number
    --- Freeze the player. Frozen players cannot move, look around, or attack. Key bindings are still called. Similar to `Player:Lock` but the player can still take damage.
    --- Manages the `FL_FROZEN` flag on the player.
    --- @param frozen Whether the player should be frozen.
    @side(server)
    function Freeze(frozen: boolean | nil): nil
    --- Returns the player's active weapon.
    --- If used on a `Global.LocalPlayer`() and the player is spectating another player with `OBS_MODE_IN_EYE`, the weapon returned will be of the spectated player.
    --- @return Weapon The weapon the player currently has equipped or NULL if the player doesn't have an active weapon eg. when they're dead.
    @side(shared)
    function GetActiveWeapon(): Weapon
    --- Returns the player's current activity.
    --- @return number The player's current activity. See Enums/ACT.
    @side(server)
    function GetActivity(): number
    --- Returns the direction that the player is aiming.
    --- @return Vector The direction vector of players aim
    @side(shared)
    function GetAimVector(): Vector
    --- Returns true if the players' model is allowed to rotate around the pitch and roll axis.
    --- @return boolean Allowed
    @side(shared)
    function GetAllowFullRotation(): boolean
    --- Returns whether the player is allowed to use their weapons in a vehicle or not.
    --- @return boolean Whether the player is allowed to use their weapons in a vehicle or not.
    @side(shared)
    function GetAllowWeaponsInVehicle(): boolean
    --- Returns a table of all ammo the player has.
    --- @return { [any]: any } A table with the following format * number Key - AmmoID to be used with functions like game.GetAmmoName. * number Value - Amount of ammo the player has of this kind.
    @side(shared)
    function GetAmmo(): { [any]: any }
    --- Gets the amount of ammo the player has.
    --- @param ammotype The ammunition type. Can be either number ammo ID or string ammo name.
    --- @return number The amount of ammo player has in reserve.
    @side(shared)
    function GetAmmoCount(ammotype: any): number
    --- Gets if the player will be pushed out of nocollided players.
    --- @return boolean pushed
    @side(shared)
    function GetAvoidPlayers(): boolean
    --- Returns true if the player is able to walk using the (default) alt key.
    --- @return boolean AbleToWalk
    @side(shared)
    function GetCanWalk(): boolean
    --- Determines whenever the player is allowed to use the zoom functionality.
    --- @return boolean canZoom
    @side(shared)
    function GetCanZoom(): boolean
    --- Returns the player's class id.
    --- @return number The player's class id.
    @side(shared)
    function GetClassID(): number
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- Gets the total amount of entities of an entity type added by `Player:AddCount`.
    --- Default types:
    --- ```
    --- balloons
    --- buttons
    --- cameras
    --- dynamite
    --- effects
    --- emitters
    --- hoverballs
    --- lamps
    --- lights
    --- npcs
    --- props
    --- ragdolls
    --- sents
    --- thrusters
    --- vehicles
    --- wheels
    --- ```
    --- @param type Type to get entity count of.
    --- @param minus If specified, it will reduce the counter by this value. Works only serverside.
    --- @return number The returned count.
    @side(shared)
    function GetCount(type: string, minus: number | nil): number
    --- Returns the crouched walk speed multiplier.
    --- See also `Player:GetWalkSpeed` and `Player:SetCrouchedWalkSpeed`.
    --- @return number The crouched walk speed multiplier.
    @side(shared)
    function GetCrouchedWalkSpeed(): number
    --- Returns the last command which was sent by the specified player. This can only be called on the player which `Global.GetPredictionPlayer`() returns.
    --- **NOTE**: When called clientside in singleplayer during `WEAPON:Think`, it will return nothing as the hook is not technically predicted in that instance. See the note on the page.
    --- This will fail in `GM:StartCommand`.
    --- @return CUserCmd Last user commands
    @side(shared)
    function GetCurrentCommand(): CUserCmd
    --- Gets the current applied view offset, which transitions between the player's standing and ducked view offset depending on their duck state.
    --- Do not confuse with `Player:GetViewOffset` and `Player:GetViewOffsetDucked`, which always return the standing or ducked offset respectively.
    --- @return Vector The actual view offset.
    @side(shared)
    function GetCurrentViewOffset(): Vector
    --- Gets the entity the player is currently driving via the `drive` library.
    --- @return Entity The currently driven entity, or NULL entity
    @side(shared)
    function GetDrivingEntity(): Entity
    --- Returns driving mode of the player. See `Entity Driving`.
    --- @return number The drive mode ID or 0 if player doesn't use the drive system.
    @side(shared)
    function GetDrivingMode(): number
    --- Returns a player's duck speed (in seconds)
    --- @return number duckspeed
    @side(shared)
    function GetDuckSpeed(): number
    --- Returns the entity the player is currently using, like func_tank mounted turrets or +use prop pickups.
    --- @return Entity Entity in use, or NULL entity otherwise. For +use prop pickups, this will be NULL clientside.
    @side(shared)
    function GetEntityInUse(): Entity
    --- Returns a table with information of what the player is looking at.
    --- The results of this function are **cached** clientside every frame.
    --- Uses `util.GetPlayerTrace` internally and is therefore bound by its limits.
    --- See also `Player:GetEyeTraceNoCursor`.
    --- @return TraceResult Trace information, see Structures/TraceResult.
    @side(shared)
    function GetEyeTrace(): TraceResult
    --- Returns the trace according to the players view direction, ignoring their mouse (holding C and moving the mouse in Sandbox).
    --- The results of this function are **cached** clientside every frame.
    --- Uses `util.GetPlayerTrace` internally and is therefore bound by its limits.
    --- See also `Player:GetEyeTrace`.
    --- @return TraceResult Trace result. See Structures/TraceResult.
    @side(shared)
    function GetEyeTraceNoCursor(): TraceResult
    --- Returns the color of a player's flashlight.
    --- @return Color Flashlight color
    @side(client)
    function GetFlashlightColor(): Color
    --- Returns the FOV of the player.
    --- @return number Field of view as a float
    @side(shared)
    function GetFOV(): number
    --- Returns the steam "relationship" towards the player.
    --- @return string Should return one of four different things depending on their status on your friends list: "friend", "blocked", "none", "requested" or "error_nofriendid" for bots.
    @side(client)
    function GetFriendStatus(): string
    --- Gets the hands entity of a player
    --- @return Entity The hands entity if players has one
    @side(shared)
    function GetHands(): Entity
    --- Returns the widget the player is hovering with their mouse.
    --- @return Entity The hovered widget.
    @side(shared)
    function GetHoveredWidget(): Entity
    --- Retrieves the minimum and maximum `Vectors` of the [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for the `Player's` physics and movement `Hull Traces`.
    --- See also: `Player:SetHull`, `Player:SetHullDuck`, `Player:GetHullDuck`
    --- @return Vector The hull mins, the lowest corner of the Player's bounding box.
    --- @return Vector The hull maxs, the highest corner of the Player's bounding box, opposite of the mins.
    @side(shared)
    function GetHull(): (Vector, Vector)
    --- Retrieves the minimum and maximum `Vectors` of the [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for the `Player's` physics and movement `Hull Traces` while they are crouching (or "Ducking").
    --- See also: `Player:SetHullDuck`, `Player:GetHull`, `Player:SetHull`
    --- @return Vector The hull mins, the lowest corner of the Player's bounding box while crouching.
    --- @return Vector The hull maxs, the highest corner of the Player's crouching bounding box, opposite of the mins.
    @side(shared)
    function GetHullDuck(): (Vector, Vector)
    --- Retrieves the value of a client-side `ConVar`. The `ConVar` must have a `FCVAR_USERINFO` flag for this to work.
    --- On client this function will return value of the local player, regardless of which player the function was called on!
    --- See `Player:GetInfoNum` for the same function that automatically converts the string to a number.
    --- @param convarName The name of the client-side ConVar.
    --- @return string The value of the ConVar. Will return empty string if the convar doesn't exist (when called on the server), or `nil` when called on client, or the convar is blacklisted, such as password convars (both realms). The returned value is truncated to 259 bytes.
    @side(shared)
    function GetInfo(convarName: string): string
    --- Retrieves the numeric value of a client-side convar, returns nil if value is not convertible to a number. The `ConVar` must have a `FCVAR_USERINFO` flag for this to work.
    --- @param cVarName The name of the ConVar to query the value of
    --- @param default Default value if we failed to retrieve the number.
    --- @return number The value of the ConVar or the default value
    @side(shared)
    function GetInfoNum(cVarName: string, default: number): number
    --- Returns the jump power of the player
    --- @return number Jump power
    @side(shared)
    function GetJumpPower(): number
    --- Returns the player's ladder climbing speed.
    --- See `Player:GetWalkSpeed` for normal walking speed, `Player:GetRunSpeed` for sprinting speed and `Player:GetSlowWalkSpeed` for slow walking speed.
    --- @return number The ladder climbing speed.
    @side(shared)
    function GetLadderClimbSpeed(): number
    --- Returns the timescale multiplier of the player movement.
    --- @return number The timescale multiplier, defaults to `1`.
    @side(shared)
    function GetLaggedMovementValue(): number
    --- Returns the maximum amount of armor the player should have. Default value is 100.
    --- @return number The new max armor value
    @side(shared)
    function GetMaxArmor(): number
    --- Returns the player's maximum movement speed.
    --- See also `Player:SetMaxSpeed`, `Player:GetWalkSpeed` and `Player:GetRunSpeed`.
    --- @return number The maximum movement speed the player can go at.
    @side(shared)
    function GetMaxSpeed(): number
    --- Returns the player's name, this is an alias of `Player:Nick`.
    --- **NOTE**: This function overrides `Entity:GetName` (in the Lua metatable, not in c++), keep it in mind when dealing with `ents.FindByName` or any engine function which requires the mapping name.
    --- @return string The player's name.
    --- @deprecated Use Player:Nick.
    @side(shared)
    override function GetName(): string
    --- Returns whenever the player is set not to collide with their teammates.
    --- @return boolean noCollideWithTeammates
    @side(shared)
    function GetNoCollideWithTeammates(): boolean
    --- Returns the the observer mode of the player
    --- @return number Observe mode of that player, see Enums/OBS_MODE.
    @side(shared)
    function GetObserverMode(): number
    --- Returns the entity the player is currently observing.
    --- Set using `Player:SpectateEntity`.
    --- @return Entity The entity the player is currently spectating, or Global_Variables if the player has no target.
    @side(shared)
    function GetObserverTarget(): Entity
    --- Returns a **P**ersistent **Data** key-value pair from the SQL database. (`sv.db` when called on server, `cl.db` when called on client)
    --- Internally uses the `sql` library. See `util.GetPData` for cases when the player is not currently on the server.
    --- **NOTE**: This function internally uses `Player:SteamID64`, it previously utilized `Player:UniqueID` which can cause collisions (two or more players sharing the same PData entry). `Player:SetPData` now replaces all instances of `Player:UniqueID` with `Player:SteamID64` when running `Player:SetPData`
    --- **NOTE**: PData is not networked from servers to clients!
    --- @param key Name of the PData key
    --- @param default Default value if PData key doesn't exist.
    --- @return string The data in the SQL database or the default value given.
    @side(shared)
    function GetPData(key: string, default: any | nil): string
    --- Returns a player's character model color.
    --- The part of the model that is colored is determined by the model's materials, and is therefore different for each model.
    --- See `Player:GetWeaponColor` for the accompanying function for the weapon color.
    --- **NOTE**: Override this function clientside on any Entity (including a player) with a supported model set (such as default player models) and returned color will apply to the model. This is done via the `PlayerColor` `matproxy`.
    --- @return Vector The format is `Vector(r,g,b)`, and each color component should be between 0 and 1.
    @side(shared)
    function GetPlayerColor(): Vector
    --- Returns a table containing player information.
    --- @return { [any]: any } A table containing player information.
    @side(shared)
    function GetPlayerInfo(): { [any]: any }
    --- Returns the preferred carry angles of an object, if any are set.
    --- Calls `GM:GetPreferredCarryAngles` with the target entity and returns the carry angles.
    --- @param carryEnt Entity to retrieve the carry angles of.
    --- @return Angle Carry angles or nil if the entity has no preferred carry angles.
    @side(server)
    override function GetPreferredCarryAngles(carryEnt: Entity): Angle
    --- Returns the widget entity the player is using.
    --- Having a pressed widget stops the player from firing their weapon to allow input to be passed onto the widget.
    --- @return Entity The pressed widget.
    @side(shared)
    function GetPressedWidget(): Entity
    --- Returns the weapon the player previously had equipped.
    --- @return Entity The previous weapon of the player. This is not guaranteed to be a weapon entity so it should be checked with `Entity:IsWeapon` for safety.
    @side(shared)
    function GetPreviousWeapon(): Entity
    --- Returns players screen punch effect angle. See `Player:ViewPunch` and `Player:SetViewPunchAngles`
    --- @return Angle The punch angle
    --- @deprecated You should use Player:GetViewPunchAngles instead.
    @side(shared)
    function GetPunchAngle(): Angle
    --- Returns players death ragdoll. The ragdoll is created by `Player:CreateRagdoll`.
    --- **NOTE**: Calling `Entity:GetPos` server-side with this function then will return the position where `Player:CreateRagdoll` was used, as it is a hl2mp_ragdoll which is a serverside point entity that creates a clientside ragdoll for everyone (opposed to prop_ragdoll that is serverside and networks).
    --- @return Entity The ragdoll. Unlike normal clientside ragdolls (`C_ClientRagdoll`), this will be a `C_HL2MPRagdoll` on the client, and `hl2mp_ragdoll` on the server.
    @side(shared)
    function GetRagdollEntity(): Entity
    --- Returns the render angles for the player.
    --- @return Angle The render angles of the player. Only **yaw** part of the angle seems to be present.
    @side(shared)
    override function GetRenderAngles(): Angle
    --- Returns the player's sprint speed.
    --- See also `Player:SetRunSpeed`, `Player:GetWalkSpeed` and `Player:GetMaxSpeed`.
    --- @return number The sprint speed
    @side(shared)
    function GetRunSpeed(): number
    --- Returns the position of a Player's view
    --- **NOTE**: This is the same as calling `Entity:EyePos` on the player.
    --- @return Vector The position of the player's view.
    @side(shared)
    function GetShootPos(): Vector
    --- Returns the player's slow walking speed, which is activated via +WALK keybind.
    --- See `Player:GetWalkSpeed` for normal walking speed, `Player:GetRunSpeed` for sprinting speed and `Player:GetLadderClimbSpeed` for ladder climb speed.
    --- @return number The new slow walking speed.
    @side(shared)
    function GetSlowWalkSpeed(): number
    --- Returns the maximum height player can step onto.
    --- @return number The maximum height player can get up onto without jumping, in hammer units.
    @side(shared)
    function GetStepSize(): number
    --- Returns the player's HEV suit power.
    --- This will only work for the local player when used clientside.
    --- @return number The current suit power.
    @side(shared)
    function GetSuitPower(): number
    --- Returns the number of seconds that the player has been timing out for. You can check if a player is timing out with `Player:IsTimingOut`.
    --- **NOTE**: This function is relatively useless because it is tied to the value of the `sv_timeout` ConVar, which is irrelevant to the description above. [This is not considered as a bug](https://discord.com/channels/565105920414318602/567617926991970306/748970396224585738).
    --- @return number Timeout seconds.
    @side(server)
    function GetTimeoutSeconds(): number
    --- Returns `TOOL` table of players current tool, or of the one specified.
    --- @param mode Classname of the tool to retrieve. ( Filename of the tool in gmod_tool/stools/ )
    --- @return { [any]: any } TOOL table, or nil if the table wasn't found or the player doesn't have a tool gun.
    @side(shared)
    function GetTool(mode: string | nil): { [any]: any }
    --- Returns a player's unduck speed (in seconds)
    --- @return number unduck speed
    @side(shared)
    function GetUnDuckSpeed(): number
    --- Returns the entity the player would use if they would press their `+use` keybind.
    --- **NOTE**: Because entity physics objects usually do not exist on the client, the client's use entity will resolve to whatever the crosshair is placed on within a little less than 72 units of the player's eye position. This differs from the entity returned by the server, which has fully physical use checking. See `util.TraceHull`.
    --- Issue tracker: [5027](https://github.com/Facepunch/garrysmod-issues/issues/5027)
    --- @return Entity The entity that would be used or NULL.
    @side(shared)
    function GetUseEntity(): Entity
    --- Returns the player's user group. By default, player user groups are loaded from `garrysmod/settings/users.txt`.
    --- @return string The user group of the player. This will return `"user"` if player has no user group.
    @side(shared)
    function GetUserGroup(): string
    --- Returns the vehicle the player is driving.
    --- @return Vehicle The vehicle the player is currently driving, if any. Returns NULL entity if the player is not driving.
    @side(shared)
    function GetVehicle(): Vehicle
    --- Returns the entity the player is using to see from (such as the player itself, the camera, or another entity).
    --- **NOTE**: This function will not return the currently spectated entity. See `Player:GetObserverTarget`.
    --- @return Entity The entity the player is using to see from
    @side(shared)
    function GetViewEntity(): Entity
    --- Returns the player's view model entity by the index.
    --- Each player has 3 view models by default, but only the first one is used.
    --- To use the other viewmodels in your SWEP, see `Entity:SetWeaponModel`.
    --- **NOTE**: In the Client `realm`, other players' viewmodels are not available unless they are being spectated.
    --- @param index optional index of the view model to return, can range from 0 to 2
    --- @return Entity The view model entity
    @side(shared)
    function GetViewModel(index: number | nil): Entity
    --- Returns the view offset of the player, which equals the difference between the player's actual position and their view when standing.
    --- See also `Player:GetViewOffsetDucked`.
    --- @return Vector New view offset, must be local vector to player's Entity:GetPos
    @side(shared)
    function GetViewOffset(): Vector
    --- Returns the ducked view offset of the player, which equals the difference between the player's actual position and their view when ducked.
    --- See also `Player:GetViewOffset`.
    --- @return Vector New crouching view offset, must be local vector to player's Entity:GetPos
    @side(shared)
    function GetViewOffsetDucked(): Vector
    --- Returns players screen punch effect angle.
    --- @return Angle The punch angle
    @side(shared)
    function GetViewPunchAngles(): Angle
    --- Returns client's view punch velocity. See `Player:ViewPunch` and `Player:SetViewPunchVelocity`
    --- @return Angle The current view punch angle velocity.
    @side(shared)
    function GetViewPunchVelocity(): Angle
    --- Returns the current voice volume scale for given player on client.
    --- @return number The voice volume scale, where 0 is 0% and 1 is 100%.
    @side(client)
    function GetVoiceVolumeScale(): number
    --- Returns the player's normal walking speed. Not sprinting, not slow walking. (+walk)
    --- See also `Player:SetWalkSpeed`, `Player:GetMaxSpeed` and `Player:GetRunSpeed`.
    --- @return number The normal walking speed.
    @side(shared)
    function GetWalkSpeed(): number
    --- Returns the weapon for the specified class
    --- @param className Class name of weapon
    --- @return Weapon The weapon for the specified class, or NULL ENTITY if the player does not have this weapon.
    @side(shared)
    function GetWeapon(className: string): Weapon
    --- Returns a player's weapon color.
    --- The part of the model that is colored is determined by the model itself, and is different for each model.
    --- See `Player:GetPlayerColor` for the accompanying function for the player character model color.
    --- @return Vector The format is `Vector(r,g,b)`, and each color should be between 0 and 1.
    @side(shared)
    function GetWeaponColor(): Vector
    --- Returns a table of the player's weapons.
    --- **NOTE**: This function returns a sequential table. Prefer to loop it with `Global.ipairs` instead of the `Global.pairs` function.
    --- @return Weapon[] All the weapons the player currently has.
    @side(shared)
    function GetWeapons(): Weapon[]
    --- Gives the player a weapon.
    --- This function will call `GM:PlayerCanPickupWeapon`. If that hook returns false, this function will do nothing.
    --- **NOTE**: While this function is meant for weapons/pickupables only, it is **not** restricted to weapons. Any entity can be spawned using this function, including NPCs and SENTs.
    --- @param weaponClassName Class name of weapon to give the player
    --- @param bNoAmmo Set to true to not give any ammo on weapon spawn. (Reserve ammo set by DefaultClip)
    --- @return Weapon The weapon given to the player, if one was given. It will return NULL if the player already has the weapon, or the weapon entity (entity with given classname) doesn't exist.
    @side(server)
    function Give(weaponClassName: string, bNoAmmo: boolean | nil): Weapon
    --- Gives ammo to a player
    --- @param amount Amount of ammo
    --- @param type Type of ammo. This is a string for named ammo types, and a number for ammo ID. You can find a list of default ammo types Default_Ammo_Types.
    --- @param hidePopup Hide display popup when giving the ammo
    --- @return number Ammo given.
    @side(server)
    function GiveAmmo(amount: number, type: string | number, hidePopup: boolean | nil): number
    --- Disables god mode on the player. Removes the `FL_GODMODE` flag from the player.
    @side(server)
    function GodDisable(): nil
    --- Enables god mode on the player. Adds the `FL_GODMODE` flag to the player.
    @side(server)
    function GodEnable(): nil
    --- Returns whether the player has god mode or not, contolled by `Player:GodEnable` and `Player:GodDisable`.
    --- @return boolean Whether the player has god mode or not.
    @side(shared)
    function HasGodMode(): boolean
    --- Returns if the player has the specified weapon
    --- @param className Class name of the weapon
    --- @return boolean True if the player has the weapon
    @side(shared)
    function HasWeapon(className: string): boolean
    --- Returns if the player is in a vehicle
    --- @return boolean Whether the player is in a vehicle.
    @side(shared)
    function InVehicle(): boolean
    --- Returns the player's IP address and connection port in ip:port form
    --- **NOTE**: Returns `Error!` for bots.
    --- @return string The player's IP address and connection port
    @side(server)
    function IPAddress(): string
    --- Returns whether the player is an admin or not. It will also return `true` if the player is `Player:IsSuperAdmin` by default.
    --- Internally this is determined by `Player:IsUserGroup`.
    --- @return boolean True if the player is an admin or a super admin.
    @side(shared)
    function IsAdmin(): boolean
    --- Returns if the player is an bot or not
    --- @return boolean `true` if the player is a bot.
    @side(shared)
    function IsBot(): boolean
    --- Returns true from the point when the player is sending client info but not fully in the game until they disconnect.
    --- @return boolean isConnected
    @side(server)
    function IsConnected(): boolean
    --- Used to find out if a player is currently 'driving' an entity (by which we mean 'right click > drive' ).
    --- @return boolean A value representing whether or not the player is 'driving' an entity.
    @side(shared)
    function IsDrivingEntity(): boolean
    --- Returns whether the players movement is currently frozen, controlled by `Player:Freeze`.
    --- @return boolean Whether the players movement is currently frozen or not.
    @side(shared)
    function IsFrozen(): boolean
    --- Returns whether the player identity was confirmed by the Steam network.
    --- See also `GM:NetworkIDValidated`.
    --- @return boolean Whether the player has been fully authenticated or not. This will always be true for singleplayer and the listen server host. This will always be false for bots.
    @side(server)
    function IsFullyAuthenticated(): boolean
    --- Returns if a player is the host of the current session.
    --- @return boolean `true` if the player is the listen server host, `false` otherwise. This will always be `true` in single player, and `false` on a dedicated server.
    @side(shared)
    function IsListenServerHost(): boolean
    --- Returns whether or not the player is voice muted locally.
    --- @return boolean whether or not the player is muted locally.
    @side(client)
    function IsMuted(): boolean
    --- Returns true if the player is playing a taunt.
    --- @return boolean Whether the player is playing a taunt.
    @side(shared)
    function IsPlayingTaunt(): boolean
    --- Returns whenever the player is heard by the local player clientside, or if the player is speaking serverside.
    --- @return boolean Is the player speaking or not.
    @side(shared)
    function IsSpeaking(): boolean
    --- Returns whether the player is currently sprinting or not, specifically if they are holding their sprint key and are allowed to sprint.
    --- This will not check if the player is currently sprinting into a wall. (i.e. holding their sprint key but not moving)
    --- @return boolean Is the player sprinting or not
    @side(shared)
    function IsSprinting(): boolean
    --- Returns whenever the player is equipped with the suit item.
    --- This will only work for the local player when used clientside.
    --- @return boolean Is the suit equipped or not.
    @side(shared)
    function IsSuitEquipped(): boolean
    --- Returns whether the player is a super admin.
    --- Internally this is determined by `Player:IsUserGroup`. See also `Player:IsAdmin`.
    --- @return boolean True if the player is a super admin.
    @side(shared)
    function IsSuperAdmin(): boolean
    --- Returns `true` if the player is timing out (i.e. is losing connection), `false` otherwise.
    --- A player is considered timing out when more than 4 seconds has elapsed since a network packet was received from given player.
    --- @return boolean Whether the player is timing out.
    @side(server)
    function IsTimingOut(): boolean
    --- Returns whether the player is typing in their chat.
    --- This may not work properly if the server uses a custom chatbox.
    --- @return boolean Whether the player is typing in their chat or not.
    @side(shared)
    function IsTyping(): boolean
    --- Returns whether the player is in specified group or not. See `Player:GetUserGroup` for a way to get player's user group.
    --- @param groupName Group to check the player for.
    --- @return boolean `true` if the player has the given user group.
    @side(shared)
    function IsUserGroup(groupName: string): boolean
    --- Returns if the player can be heard by the local player.
    --- @return boolean isAudible
    @side(client)
    function IsVoiceAudible(): boolean
    --- Returns if the player currently walking. (`+walk` keybind)
    --- @return boolean `true` if the player is currently walking.
    @side(shared)
    function IsWalking(): boolean
    --- Returns whether the player is using the world clicking feature, see `Panel:SetWorldClicker`
    --- @return boolean Is the player world clicking or not.
    @side(shared)
    function IsWorldClicking(): boolean
    --- Returns whether the world clicking is disabled for given player or not. See `Player:DisableWorldClicking`.
    --- @return boolean Whether the world clicking is disabled or not.
    @side(shared)
    function IsWorldClickingDisabled(): boolean
    --- Returns whether a key is down. This is not networked to other players, meaning only the local client can see the keys they are pressing.
    --- @param key The key, see Enums/IN
    --- @return boolean whether the key is down or not.
    @side(shared)
    function KeyDown(key: number): boolean
    --- Gets whether a key was down one tick ago.
    --- @param key The key, see Enums/IN
    --- @return boolean Is key down ?
    @side(shared)
    function KeyDownLast(key: number): boolean
    --- Gets whether a key was just pressed this tick.
    --- @param key Corresponds to an Enums/IN. You can use bit.bor here (see example 2)
    --- @return boolean Was pressed or not
    @side(shared)
    function KeyPressed(key: number): boolean
    --- Gets whether a key was just released this tick.
    --- @param key The key, see Enums/IN
    --- @return boolean Was released or not
    @side(shared)
    function KeyReleased(key: number): boolean
    --- Kicks the player from the server.
    --- **NOTE**: This can not be run before the player has fully joined in. Use `game.KickID` for that.
    --- @param reason Reason to show for disconnection. This will be shortened to ~512 chars, though this includes the command itself and the player index so will realistically be more around ~498. It is recommended to avoid going near the limit to avoid truncation.
    @side(server)
    function Kick(reason: string | nil): nil
    --- Kills a player and calls `GM:PlayerDeath`.
    @side(server)
    function Kill(): nil
    --- Kills a player without notifying the rest of the server.
    --- This will call `GM:PlayerSilentDeath` instead of `GM:PlayerDeath`.
    @side(server)
    function KillSilent(): nil
    --- This allows the server to mitigate the lag of the player by moving back all the entities that can be lag compensated to the time the player attacked with his weapon.
    --- This technique is most commonly used on things that hit other entities instantaneously, such as traces.
    --- **NOTE**: `Entity:FireBullets` calls this function internally.
    --- Lag compensation only works for players and entities that have been enabled with `Entity:SetLagCompensated`
    --- Despite being defined shared, it can only be used server-side in a `Predicted Hook`.
    --- **WARNING**: This function NEEDS to be disabled after you're done with it or it will break the movement of the entities affected!
    --- Lag compensation does not support pose parameters.
    --- @param lagCompensation The state of the lag compensation, true to enable and false to disable.
    @side(shared)
    function LagCompensation(lagCompensation: boolean): nil
    --- Returns the hitgroup where the player was last hit.
    --- @return number Hitgroup, see Enums/HITGROUP
    @side(server)
    function LastHitGroup(): number
    --- Shows "limit hit" notification in sandbox.
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- @param type Type of hit limit.
    @side(server)
    function LimitHit(type: string): nil
    --- Returns the direction a player is looking as a entity/local-oriented angle.
    --- Unlike `Entity:EyeAngles`, this function does not include angles of the Player's `Entity:GetParent`.
    --- Does not work correctly clientside for non local players when in a vehicle. (validate: when parented in general?)
    --- @return Angle The local eye angles.
    @side(shared)
    function LocalEyeAngles(): Angle
    --- Stops a player from using any inputs, such as moving, turning, or attacking. Key binds are still called. Similar to `Player:Freeze` but the player takes no damage.
    --- Adds the `FL_FROZEN` and `FL_GODMODE` flags to the player.
    @side(server)
    function Lock(): nil
    --- Returns the position of a Kinect bone.
    --- @param bone Bone to get the position of. Must be from 0 to 19.
    --- @return Vector Position of the bone.
    @side(shared)
    function MotionSensorPos(bone: number): Vector
    --- Returns the player's nick name. Identical to `Player:Nick` and `Player:GetName`.
    --- @return string Player's name.
    --- @deprecated Use Player:Nick.
    @side(shared)
    function Name(): string
    --- Returns the player's nick name also known as display name, as it appears in Steam.
    --- @return string Player's nick name
    @side(shared)
    function Nick(): string
    --- Returns the 64-bit SteamID aka CommunityID of the Steam Account that owns the Garry's Mod license this player is using. This is useful for detecting players using Steam Family Sharing.
    --- If player is not using Steam Family Sharing, this will return the player's actual SteamID64().
    --- **NOTE**: This data will only be available after the player has fully authenticated with Steam. See `Player:IsFullyAuthenticated`.
    --- @return string The 64bit SteamID
    @side(server)
    function OwnerSteamID64(): string
    --- Returns the percentage of packets lost by the client. It is not networked so it only returns 0 when run clientside.
    --- @return number Percentage of packets lost (0-100)
    @side(shared)
    function PacketLoss(): number
    --- Unfreezes the props player is looking at. This is essentially the same as pressing reload with the physics gun, including double press for unfreeze all.
    --- For freezing props, use `PhysObj:EnableMotion`.
    --- @return number Number of props unfrozen.
    @side(shared)
    function PhysgunUnfreeze(): number
    --- This makes the player hold (same as pressing E on a small prop) given entity.
    --- Not to be confused with picking up items like ammo or health kits.
    --- This picks up the passed entity regardless of its mass or distance from the player.
    --- @param entity Entity to pick up.
    @side(server)
    function PickupObject(entity: Entity): nil
    --- Forces the player to pickup an existing weapon entity. The player will not pick up the weapon if they already own a weapon of given type, or if the player could not normally have this weapon in their inventory.
    --- This function **will** bypass `GM:PlayerCanPickupWeapon`.
    --- @param wep The weapon to try to pick up.
    --- @param ammoOnly If set to true, the player will only attempt to pick up the ammo from the weapon. The weapon will not be picked up even if the player doesn't have a weapon of this type, and the weapon will be removed if the player picks up any ammo from it.
    --- @return boolean Whether the player succeeded in picking up the weapon or not.
    @side(server)
    function PickupWeapon(wep: Weapon, ammoOnly: boolean | nil): boolean
    --- Returns the player's ping to server.
    --- @return number The player's ping.
    @side(shared)
    function Ping(): number
    --- Plays the correct step sound according to what the player is staying on.
    --- @param volume Volume for the sound, in range from 0 to 1
    @side(server)
    function PlayStepSound(volume: number | nil): nil
    --- Displays a message either in their chat, console, or center of the screen. See also `Global.PrintMessage`.
    --- **NOTE**: When called serverside, this uses the archaic user message system (the `umsg`) and hence is limited to ≈250 characters.
    --- `HUD_PRINTCENTER` will not work when this is called clientside.
    --- @param type Which type of message should be sent to the player (Enums/HUD).
    --- @param message Message to be sent to the player.
    @side(shared)
    function PrintMessage(type: number, message: string): nil
    --- Removes all ammo from a certain player
    @side(server)
    function RemoveAllAmmo(): nil
    --- Removes all weapons and ammo from the player.
    @side(server)
    function RemoveAllItems(): nil
    --- Removes the amount of the specified ammo from the player.
    --- @param ammoCount The amount of ammunition to remove.
    --- @param ammoName The name of the ammunition to remove from. This can also be a number ammoID.
    @side(shared)
    function RemoveAmmo(ammoCount: number, ammoName: string | number): nil
    --- Removes a **P**ersistent **Data** key-value pair from the SQL database. (`sv.db` when called on server, `cl.db` when called on client)
    --- Internally uses the `sql` library. See `util.RemovePData` for cases when the player is not currently on the server.
    --- **NOTE**: This function internally uses `Player:SteamID64`, it previously utilized `Player:UniqueID` which can cause collisions (two or more players sharing the same PData entry). `Player:SetPData` now replaces all instances of `Player:UniqueID` with `Player:SteamID64` when running `Player:SetPData`
    --- **NOTE**: PData is not networked from servers to clients!
    --- @param key Key to remove
    --- @return boolean true is succeeded, false otherwise
    @side(shared)
    function RemovePData(key: string): boolean
    --- Strips the player's suit item.
    @side(server)
    function RemoveSuit(): nil
    --- Resets both normal and duck hulls to their default values.
    @side(shared)
    function ResetHull(): nil
    --- Forces the player to say whatever the first argument is. Works on bots too.
    --- **NOTE**: This function ignores the default chat message cooldown
    --- **WARNING**: The argument can only contain 126 characters. [Source SDK 2013](https://github.com/ValveSoftware/source-sdk-2013/blob/0d8dceea4310fde5706b3ce1c70609d72a38efdf/sp/src/game/server/client.cpp#L84-L86)
    --- @param text The text to force the player to say.
    --- @param teamOnly Whether to send this message to our own team only.
    @side(server)
    function Say(text: string, teamOnly: boolean | nil): nil
    --- Fades the screen
    --- @param flags Fade flags defined with Enums/SCREENFADE.
    --- @param color The color of the screenfade
    --- @param fadeTime Fade(in/out) effect transition time ( From no fade to full fade and vice versa ). This is limited to 7 bits integer part and 9 bits fractional part.
    --- @param fadeHold Fade effect hold time. This is limited to 7 bits integer part and 9 bits fractional part.
    @side(shared)
    function ScreenFade(flags: number, color: Color | nil, fadeTime: number, fadeHold: number): nil
    --- Sets the active weapon of the player by its class name.
    --- **WARNING**: This will switch the weapon out of prediction, causing delay on the client and `WEAPON:Deploy` and `WEAPON:Holster` to be called out of prediction. Try using `CUserCmd:SelectWeapon` or `input.SelectWeapon`, instead.
    --- **NOTE**: This will trigger the weapon switch event and associated animations. To switch weapons silently, use `Player:SetActiveWeapon`.
    --- @param className The class name of the weapon to switch to. If the player doesn't have the specified weapon, nothing will happen. You can use Player:Give to give the weapon first.
    @side(server)
    function SelectWeapon(className: string): nil
    --- Sends a hint to a player.
    --- **NOTE**: This function is only available in Sandbox and its derivatives. Since this adds `#Hint_` to the beginning of each message, you should only use it with default hint messages, or those cached with `language.Add`. For hints with custom text, look at `notification.AddLegacy`.
    --- @param name Name/class/index of the hint. You can find a list of hint names for this function List_of_Hint_Classes.
    --- @param delay Delay in seconds before showing the hint
    @side(server)
    function SendHint(name: string, delay: number): nil
    --- Executes a simple Lua string on the player.
    --- **NOTE**: If you need to use this function more than once consider using `net` library. Send net message and make the entire code you want to execute in `net.Receive` on client.
    --- @param script The script to execute, limited to 6000 bytes.
    @side(server)
    function SendLua(script: string): nil
    --- Sets the player's active weapon. You should use `CUserCmd:SelectWeapon` or `Player:SelectWeapon`, instead in most cases.
    --- This function will not trigger the weapon switch events or associated equip animations. It will bypass
    --- `GM:PlayerSwitchWeapon` and the currently active weapon's `WEAPON:Holster` return value.
    --- @param weapon The weapon to equip.
    @side(server)
    function SetActiveWeapon(weapon: Weapon): nil
    --- Sets the player's activity.
    --- @param act The new activity to set. See Enums/ACT.
    @side(server)
    function SetActivity(act: number): nil
    --- Set if the players' model is allowed to rotate around the pitch and roll axis.
    --- @param Allowed Allowed to rotate
    @side(shared)
    function SetAllowFullRotation(Allowed: boolean): nil
    --- Allows player to use their weapons in a vehicle. You need to call this before entering a vehicle.
    --- Shooting in a vehicle fires two bullets.
    --- @param allow Show we allow player to use their weapons in a vehicle or not.
    @side(server)
    function SetAllowWeaponsInVehicle(allow: boolean): nil
    --- Sets the amount of the specified ammo for the player.
    --- @param ammoCount The amount of ammunition to set.
    --- @param ammoType The ammunition type. Can be either number ammo ID or string ammo name. See Default Ammo Types for default values.
    @side(shared)
    function SetAmmo(ammoCount: number, ammoType: any): nil
    --- Sets the player armor value.
    --- See `GM:HandlePlayerArmorReduction` for a hook that allows manipulating what armor does.
    --- @param amount The amount to set the armor value of the player to.
    @side(server)
    function SetArmor(amount: number): nil
    --- Pushes the player away from other players whenever the player inside another players' bounding box.
    --- This avoidance is performed clientside by altering movement sent to server.
    --- This applies to players within a single team. (`Player:Team`)
    --- @param avoidPlayers Whether to avoid teammates, or not.
    @side(shared)
    function SetAvoidPlayers(avoidPlayers: boolean): nil
    --- Set if the player should be allowed to walk using the (default) alt key. (`+walk` keybind)
    --- @param canWalk `true` allows the player to walk.
    @side(shared)
    function SetCanWalk(canWalk: boolean): nil
    --- Sets whether the player can use the HL2 suit zoom (`+zoom` bind) or not.
    --- @param canZoom Whether to make the player able or unable to zoom.
    @side(shared)
    function SetCanZoom(canZoom: boolean): nil
    --- **INTERNAL**: Use `player_manager.SetPlayerClass` instead.
    --- Sets the player's class id.
    --- @param classID The class id the player is being set with.
    @side(shared)
    function SetClassID(classID: number): nil
    --- Sets the crouched walk speed multiplier.
    --- Has no effect for values above 1.
    --- See also `Player:SetWalkSpeed` and `Player:GetCrouchedWalkSpeed`.
    --- @param speed The walk speed multiplier that crouch speed should be.
    @side(shared)
    function SetCrouchedWalkSpeed(speed: number): nil
    --- Sets the **actual** view offset which equals the difference between the players actual position and their view when standing.
    --- Do not confuse with `Player:SetViewOffset` and `Player:SetViewOffsetDucked`
    --- @param viewOffset The new view offset.
    @side(shared)
    function SetCurrentViewOffset(viewOffset: Vector): nil
    --- Sets a player's death count
    --- @param deathCount Number of deaths (positive or negative)
    @side(server)
    function SetDeaths(deathCount: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the driving entity and driving mode.
    --- Use `drive.PlayerStartDriving` instead, see `Entity Driving`.
    --- @param drivingEntity The entity the player should drive.
    --- @param drivingMode The driving mode index.
    @side(shared)
    function SetDrivingEntity(drivingEntity: Entity | nil, drivingMode: number): nil
    --- Activates a given DSP (Digital Signal Processor) effect on all sounds that the player hears. This is equivalent to setting `dsp_player` convar on the player.
    --- To apply a DSP effect to individual sounds, see `CSoundPatch:SetDSP`
    --- @param dspEffectId The index of the DSP sound filter to apply. For a list of the available IDs and their meaning, see DSP_Presets.
    --- @param fastReset If set to true the sound filter will be removed faster. **This only works clientside** If used serverside, a message will be displayed (`SetPlayerDSP: fastReset only valid from client`) in the server console.
    @side(shared)
    function SetDSP(dspEffectId: number, fastReset: boolean): nil
    --- Sets how quickly a player ducks.
    --- This will not work for values >= 1.
    --- @param duckSpeed How quickly the player will duck.
    @side(shared)
    function SetDuckSpeed(duckSpeed: number): nil
    --- Sets the local angle of the player's view (may rotate body too if angular difference is large)
    --- **NOTE**: This function works differently when the player is in a vehicle. In that case passing `Angle(0, 90, 0)` will have the player look forward (out the windshield) and `Angle(0, 0, 0)` will have them look to the right.
    --- @param angle Angle to set the view to
    @side(shared)
    function SetEyeAngles(angle: Angle): nil
    --- Sets the color of a player's flashlight.
    --- Can be used on other players.
    --- @param color Flashlight color
    @side(client)
    function SetFlashlightColor(color: Color | nil): nil
    --- Set a player's FOV (Field Of View) over a certain amount of time.
    --- This is meant to be called on the server or shared (for prediction), it will have no effect if called clientside only. You may want to use `GM:CalcView` for that instead.
    --- @param fov the angle of perception (FOV). Set to 0 to return to default user FOV. ( Which is ranging from 75 to 100, depending on user settings )
    --- @param time the time it takes to transition to the FOV expressed in a floating point.
    --- @param requester The requester or "owner" of the zoom event. Only this entity will be able to change the player's FOV until it is set back to 0.
    @side(shared)
    function SetFOV(fov: number, time: number | nil, requester: Entity | nil): nil
    --- Sets a player's frags (kills)
    --- @param fragCount Number of frags (positive or negative)
    @side(server)
    function SetFrags(fragCount: number): nil
    --- Sets the hands entity of a player.
    --- The hands entity is an entity introduced in Garry's Mod 13 and it's used to show the player's hands attached to the viewmodel.
    --- This is similar to the approach used in L4D and CS:GO, for more information on how to implement this system in your gamemode visit `Using Viewmodel Hands`.
    --- @param hands The hands entity to set
    @side(shared)
    function SetHands(hands: Entity): nil
    --- Sets the widget that is currently hovered by the player's mouse.
    --- @param widget The widget entity that the player is hovering.
    @side(shared)
    function SetHoveredWidget(widget: Entity | nil): nil
    --- Sets the size of the `Player's` [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for physics and movement `Hull Traces`.
    --- See also: `Player:GetHull`, `Player:SetHullDuck`, `Player:GetHullDuck`
    --- **NOTE**: This value is **not** replicated automatically to clients and must be manually called in both the Server and Client `Realms`.
    --- @param mins The hull mins, the lowest corner of the Player's bounding box.
    --- @param maxs The hull maxs, the highest corner of the Player's bounding box, opposite of the mins.
    @side(shared)
    function SetHull(mins: Vector, maxs: Vector): nil
    --- Sets the size of the `Player's` [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for physics and movement `Hull Traces` while they are crouching (or "Ducking").
    --- See also: `Player:GetHullDuck`, `Player:GetHull`, `Player:SetHull`
    --- **NOTE**: This value is **not** replicated automatically to clients and must be manually called in both the Server and Client `Realms`.
    --- @param mins The hull mins, the lowest corner of the Player's bounding box while crouching.
    --- @param maxs The hull maxs, the highest corner of the Player's crouching bounding box, opposite of the mins.
    @side(shared)
    function SetHullDuck(mins: Vector, maxs: Vector): nil
    --- Sets the jump power, eg. the velocity that will be applied to the player when they jump.
    --- @param jumpPower The new jump velocity.
    @side(shared)
    function SetJumpPower(jumpPower: number): nil
    --- Sets the player's ladder climbing speed.
    --- See `Player:SetWalkSpeed` for normal walking speed, `Player:SetRunSpeed` for sprinting speed and `Player:SetSlowWalkSpeed` for slow walking speed.
    --- @param speed The ladder climbing speed.
    @side(shared)
    function SetLadderClimbSpeed(speed: number): nil
    --- Slows down the player movement simulation by the timescale, this is used internally in the HL2 weapon stripping sequence.
    --- It achieves such behavior by multiplying the `Global.FrameTime` by the specified timescale at the start of the movement simulation and then restoring it afterwards.
    --- **NOTE**: This is reset to 1 on spawn.
    --- There is no weapon counterpart to this, you'll have to hardcode the multiplier in the weapon or call `Weapon:SetNextPrimaryFire` / `Weapon:SetNextSecondaryFire` manually.
    --- @param timescale The timescale multiplier.
    @side(server)
    function SetLaggedMovementValue(timescale: number): nil
    --- Sets the hitgroup where the player was last hit.
    --- @param hitgroup The hitgroup to set as the "last hit", see Enums/HITGROUP.
    @side(server)
    function SetLastHitGroup(hitgroup: number): nil
    --- Sets the maximum amount of armor the player should have. This affects default built-in armor pickups, but not `Player:SetArmor`.
    --- @param maxarmor The new max armor value.
    @side(server)
    function SetMaxArmor(maxarmor: number): nil
    --- Sets the maximum speed which the player can move at.
    --- **NOTE**: This is called automatically by the engine. If you wish to limit player speed without setting their run/sprint speeds, see `CMoveData:SetMaxClientSpeed`.
    --- @param walkSpeed The maximum speed.
    @side(shared)
    function SetMaxSpeed(walkSpeed: number): nil
    --- Sets if the player should be voicechat muted locally.
    --- @param mute Mute or unmute.
    @side(client)
    function SetMuted(mute: boolean): nil
    --- Sets whenever the player should not collide with their teammates, based on their `Player:Team`.
    --- **NOTE**: This will only work for teams with ID 1 to 4 due to internal Engine limitations.
    --- **NOTE**: This causes traces with `COLLISION_GROUP_PLAYER` to pass through players.
    --- @param shouldNotCollide `true` to disable, `false` to enable collision.
    @side(shared)
    function SetNoCollideWithTeammates(shouldNotCollide: boolean): nil
    --- Sets the players visibility towards NPCs.
    --- Internally this toggles the `FL_NOTARGET` flag, which you can manually test for using `Entity:IsFlagSet`
    --- @param visibility The visibility.
    @side(server)
    function SetNoTarget(visibility: boolean): nil
    --- Sets the players observer mode. You must start the spectating first with `Player:Spectate`.
    --- @param mode Spectator mode using Enums/OBS_MODE.
    @side(shared)
    function SetObserverMode(mode: number): nil
    --- Writes a **P**ersistent **Data** key-value pair to the SQL database. (`sv.db` when called on server, `cl.db` when called on client)
    --- Internally uses the `sql` library. See `util.SetPData` for cases when the player is not currently on the server.
    --- **NOTE**: This function internally uses `Player:SteamID64`, it previously utilized `Player:UniqueID` which could have caused collisions (two or more players sharing the same PData entry). `Player:SetPData` now replaces all instances of `Player:UniqueID` with `Player:SteamID64` when running `Player:SetPData`
    --- **NOTE**: PData is not networked from servers to clients!
    --- @param key Name of the PData key
    --- @param value Value to write to the key (**must** be an SQL valid data type, such as a string or integer)
    --- @return boolean Whether the operation was successful or not
    @side(shared)
    function SetPData(key: string, value: any): boolean
    --- Sets the player model's color. The part of the model that is colored is determined by the model itself, and is different for each model.
    --- @param Color This is the color to be set. The format is Vector(r, g, b), and each color should be between 0 and 1.
    @side(shared)
    function SetPlayerColor(Color: Vector): nil
    --- Sets the widget that is currently in use by the player's mouse.
    --- Having a pressed widget stops the player from firing their weapon to allow input to be passed onto the widget.
    --- @param pressedWidget The widget the player is currently using.
    @side(shared)
    function SetPressedWidget(pressedWidget: Entity | nil): nil
    --- Sets the render angles of a player. Value set by this function is reset to player's angles (`Entity:GetAngles`) right after `GM:UpdateAnimation`.
    --- @param ang The new render angles to set
    @side(shared)
    override function SetRenderAngles(ang: Angle): nil
    --- Sets the player's sprint speed.
    --- See also `Player:GetRunSpeed`, `Player:SetWalkSpeed` and `Player:SetMaxSpeed`.
    --- **NOTE**: player_default class run speed is: `400`
    --- @param runSpeed The new sprint speed when `sv_friction` is below `10`. Higher `sv_friction` values will result in slower speed. Has to be `7` or above or the player **won't** be able to move.
    @side(shared)
    function SetRunSpeed(runSpeed: number): nil
    --- Sets the player's slow walking speed, which is activated via +WALK keybind.
    --- See `Player:SetWalkSpeed` for normal walking speed, `Player:SetRunSpeed` for sprinting speed and `Player:SetLadderClimbSpeed` for ladder climb speed.
    --- @param speed The new slow walking speed.
    @side(shared)
    function SetSlowWalkSpeed(speed: number): nil
    --- Sets the maximum height a player can step onto without jumping.
    --- @param stepHeight The new maximum height the player can step onto without jumping
    @side(shared)
    function SetStepSize(stepHeight: number): nil
    --- Sets the player's HEV suit power.
    --- This will only work for the local player when used clientside.
    --- @param power The new suit power.
    @side(shared)
    function SetSuitPower(power: number): nil
    --- Sets whenever to suppress the pickup notification for the player.
    --- @param doSuppress Whenever to suppress the notice or not.
    @side(shared)
    function SetSuppressPickupNotices(doSuppress: boolean): nil
    --- Sets the player to the chosen team. The value is networked to clients at reduced bit count (16 bits) as as a signed value, so the real range is [-32768, 32767].
    --- Can be retrieved via `Player:Team`
    --- @param team The team that the player is being set to.
    @side(server)
    function SetTeam(team: number): nil
    --- Sets how quickly a player un-ducks
    --- @param UnDuckSpeed How quickly the player will un-duck
    @side(shared)
    function SetUnDuckSpeed(UnDuckSpeed: number): nil
    --- Sets up the player's hands for the viewmodel. Calls `GM:PlayerSetHandsModel` to determine the model. If no entity is provided, uses the player's own hands model. If spectating another entity, pass that entity to use its hands model instead.
    --- @param ent If the player is spectating an entity, this should be the entity the player is spectating, so we can use its hands model instead.
    @side(server)
    function SetupHands(ent: Entity | nil): nil
    --- Sets the usergroup of the player.
    --- @param groupName The user group of the player.
    @side(server)
    function SetUserGroup(groupName: string): nil
    --- Attaches the players view to the position and angles of the specified entity.
    --- **NOTE**: By default, the view is in first person and its model will not be rendered. `Player:SetObserverMode` can be used to enable drawing of view entity.
    --- @param viewEntity The entity to attach the player view to.
    @side(server)
    function SetViewEntity(viewEntity: Entity): nil
    --- Sets the **desired** view offset which equals the difference between the players actual position and their view when standing.
    --- If you want to set **actual** view offset, use `Player:SetCurrentViewOffset`
    --- See also `Player:SetViewOffsetDucked` for **desired** view offset when crouching.
    --- @param viewOffset The new desired view offset when standing.
    @side(shared)
    function SetViewOffset(viewOffset: Vector): nil
    --- Sets the **desired** view offset which equals the difference between the players actual position and their view when crouching.
    --- If you want to set **actual** view offset, use `Player:SetCurrentViewOffset`
    --- See also `Player:SetViewOffset` for **desired** view offset when standing.
    --- @param viewOffset The new desired view offset when crouching.
    @side(shared)
    function SetViewOffsetDucked(viewOffset: Vector): nil
    --- Sets client's view punch angle, but not the velocity. See `Player:ViewPunch`
    --- @param punchAngle The angle to set.
    @side(shared)
    function SetViewPunchAngles(punchAngle: Angle): nil
    --- Sets client's view punch velocity. See `Player:ViewPunch` and `Player:SetViewPunchAngles`
    --- @param punchVel The angle velocity to set.
    @side(shared)
    function SetViewPunchVelocity(punchVel: Angle): nil
    --- Sets the voice volume scale for given player on client. This value will persist from server to server, but will be reset when the game is shut down.
    --- **NOTE**: This doesn't work on bots, their scale will always be `1`. Does not work with multiruns.
    --- @param _ The voice volume scale, where `0` is 0% and `1` is 100%.
    @side(client)
    function SetVoiceVolumeScale(arg1: number): nil
    --- Sets the player's normal walking speed. Not sprinting, not slow walking +walk.
    --- See also `Player:SetSlowWalkSpeed`, `Player:GetWalkSpeed`, `Player:SetCrouchedWalkSpeed`, `Player:SetMaxSpeed` and `Player:SetRunSpeed`.
    --- Using a speed of `0` can lead to prediction errors, and can cause players to move at sv_maxvelocity
    --- **NOTE**: `player_default` class walk speed is: `200`.
    --- @param walkSpeed The new walk speed when `sv_friction` is below `10`. Higher `sv_friction` values will result in slower speed. Has to be `7` or above or the player **won't** be able to move.
    @side(shared)
    function SetWalkSpeed(walkSpeed: number): nil
    --- Sets the player weapon's color. The part of the model that is colored is determined by the model itself, and is different for each model.
    --- @param Color This is the color to be set. The format is Vector(r,g,b), and each color should be between 0 and 1.
    @side(shared)
    function SetWeaponColor(Color: Vector): nil
    --- Returns whether the **local player's** player model will be drawn at the time the function is called.
    --- Despite this being a method on a player object, this will always represent the state of the `local player`, not of the player entity this method is used on.
    --- @return boolean `true` if the player's playermodel is visible
    @side(client)
    function ShouldDrawLocalPlayer(): boolean
    --- Sets whether the player's current weapon should drop on death.
    --- **NOTE**: This is reset on spawn to the `player class`'s **DropWeaponOnDie** field by `player_manager.OnPlayerSpawn`.
    --- @param drop Whether to drop the player's current weapon or not
    @side(server)
    function ShouldDropWeapon(drop: boolean): nil
    --- Opens the player steam profile page in the steam overlay browser.
    @side(client)
    function ShowProfile(): nil
    --- Signals the entity that it was dropped by the gravity gun.
    --- @param ent Entity that was dropped.
    @side(server)
    function SimulateGravGunDrop(ent: Entity): nil
    --- Signals the entity that it was picked up by the gravity gun. This call is only required if you want to simulate the situation of picking up objects.
    --- @param ent The entity picked up
    --- @param lightning Whether or not to show lightning effects around the entity
    @side(server)
    function SimulateGravGunPickup(ent: Entity, lightning: boolean | nil): nil
    --- Starts spectate mode for given player. This will also affect the players movetype in some cases.
    --- `Player:UnSpectate` should be used to remove the player from spectate mode, or call this with `OBS_MODE_NONE`.
    --- The player must be respawned, otherwise they will be able to walk through doors and become invincible. This will be fixed in a future update.
    --- @param mode Spectate mode, see Enums/OBS_MODE.
    @side(server)
    function Spectate(mode: number): nil
    --- Makes the player spectate the entity.
    --- To get the applied spectated entity, use `Player:GetObserverTarget`.
    --- @param entity Entity to spectate.
    @side(server)
    function SpectateEntity(entity: Entity): nil
    --- Makes a player spray their decal.
    --- @param sprayOrigin The location to spray from
    --- @param sprayEndPos The location to spray to
    @side(server)
    function SprayDecal(sprayOrigin: Vector, sprayEndPos: Vector): nil
    --- Disables the sprint on the player.
    @side(server)
    function SprintDisable(): nil
    --- Enables the sprint on the player.
    @side(server)
    function SprintEnable(): nil
    --- Doesn't appear to do anything.
    --- @deprecated This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    @side(shared)
    function StartSprinting(): nil
    --- When used in a `GM:SetupMove` hook, this function will force the player to walk, as well as preventing the player from sprinting.
    --- @deprecated This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    @side(shared)
    function StartWalking(): nil
    --- Returns the player's SteamID.
    --- See `Player:AccountID` for a shorter version of the SteamID and `Player:SteamID64` for the full SteamID.
    --- It is recommended to use `Player:SteamID64` over the other SteamID formats whenever possible.
    --- **NOTE**: In a `-multirun` environment, this will return `STEAM_ID_LAN` for all "copies" of a player because they are not authenticated with Steam.
    --- For Bots this will return `BOT`.
    --- @return string "Text" representation of the player's SteamID.
    @side(shared)
    function SteamID(): string
    --- Returns the player's full **64-bit SteamID**, also known as **CommunityID**. Information on how data is packed into this value can be found [here](https://developer.valvesoftware.com/wiki/SteamID).
    --- See `Player:AccountID` for a function that returns only the Account ID part of the SteamID and `Player:SteamID` for the text version of the SteamID.
    --- **NOTE**: In a `-multirun` environment, this will return `"0"` for all "copies" of a player because they are not authenticated with Steam.
    --- For bots, this will return `90071996842377216` (equivalent to `STEAM_0:0:0`) for the first bot to join.
    --- For each additional bot, the number increases by 1. So the next bot will be `90071996842377217` (`STEAM_0:1:0`) then `90071996842377218` (`STEAM_0:0:1`) and so on.
    --- @return string Player's 64-bit SteamID aka CommunityID. The return value is a string, not a number, since Lua's numbers are unable to store the entire 64bit numbers without data loss.
    @side(shared)
    function SteamID64(): string
    --- When used in a `GM:SetupMove` hook, this function will prevent the player from sprinting.
    --- When +walk is engaged, the player will still be able to sprint to half speed (normal run speed) as opposed to full sprint speed without this function.
    --- @deprecated This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    @side(shared)
    function StopSprinting(): nil
    --- When used in a `GM:SetupMove` hook, this function behaves unexpectedly by preventing the player from sprinting similar to `Player:StopSprinting`.
    --- @deprecated This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    @side(shared)
    function StopWalking(): nil
    --- Turns off the zoom mode of the player. (+zoom console command)
    --- Basically equivalent of entering "-zoom" into player's console.
    @side(server)
    function StopZooming(): nil
    --- Removes all ammo from the player.
    --- @deprecated Alias of Player:RemoveAllAmmo
    @side(server)
    function StripAmmo(): nil
    --- Removes the specified weapon class from a certain player
    --- **NOTE**: this function will call the `Entity:OnRemove` but if you try use `Entity:GetOwner` it will return nil
    --- @param weapon The weapon class to remove
    @side(server)
    function StripWeapon(weapon: string): nil
    --- Removes all weapons from a certain player
    @side(server)
    function StripWeapons(): nil
    --- Prevents a hint from showing up.
    --- **NOTE**: This function is only available in Sandbox and its derivatives
    --- @param name Hint name/class/index to prevent from showing up. You can find a list of hint names for this function List_of_Hint_Classes.
    @side(server)
    function SuppressHint(name: string): nil
    --- Attempts to switch the player weapon to the one specified in the "cl_defaultweapon" convar, if the player does not own the specified weapon nothing will happen.
    --- If you want to switch to a specific weapon, use: `Player:SetActiveWeapon`
    @side(server)
    function SwitchToDefaultWeapon(): nil
    --- Returns the player's team ID, set by `Player:SetTeam`
    --- Returns 0 clientside when the game is not fully loaded.
    --- @return number The player's team's index number, as in the Enums/TEAM or a custom team defined in team.SetUp.
    @side(shared)
    function Team(): number
    --- Returns the time in seconds since the player connected.
    --- Bots will always return value 0.
    --- @return number How long this player was connected to the server for, in seconds.
    @side(server)
    function TimeConnected(): number
    --- Performs a trace hull and applies damage to the entities hit, returns the first entity hit.
    --- **WARNING**: Hitting the victim entity with this function in `ENTITY:OnTakeDamage` can cause infinite loops.
    --- @param startPos The start position of the hull trace.
    --- @param endPos The end position of the hull trace.
    --- @param mins The minimum coordinates of the hull.
    --- @param maxs The maximum coordinates of the hull.
    --- @param damage The damage to be applied.
    --- @param damageFlags Bitflag specifying the damage type, see Enums/DMG.
    --- @param damageForce The force to be applied to the hit object.
    --- @param damageAllNPCs Whether to apply damage to all hit NPCs or not.
    --- @return Entity The hit entity
    @side(server)
    function TraceHullAttack(startPos: Vector, endPos: Vector, mins: Vector, maxs: Vector, damage: number, damageFlags: number, damageForce: number, damageAllNPCs: boolean): Entity
    --- Translates `Enums/ACT` according to the holdtype of players currently held weapon.
    --- @param act The initial Enums/ACT
    --- @return number Translated Enums/ACT
    @side(shared)
    function TranslateWeaponActivity(act: number): number
    --- Unfreezes all objects the player has frozen with their Physics Gun. Same as double pressing R while holding Physics Gun.
    @side(shared)
    function UnfreezePhysicsObjects(): nil
    --- Returns a 32 bit integer that remains constant for a player across joins/leaves and across different servers. This can be used when a string is inappropriate - e.g. in a database primary key.
    --- **NOTE**: In Singleplayer, this function will always return 1.
    --- In a `-multirun` environment, the value returned is different on the serverside and clientside.
    --- @return number The player's Unique ID
    --- @deprecated **This function has collisions,** where more than one player can have the same UniqueID. It is **highly** recommended to use Player:SteamID64, Player:SteamID or Player:AccountID instead, which are guaranteed to be unique to each player.
    @side(shared)
    function UniqueID(): number
    --- Returns a table that will stay allocated for the specific player serverside between connects until the server shuts down or change map. On client it has no such special behavior.
    --- **NOTE**: This table is not synchronized (networked) between client and server.
    --- @param key Unique table key.
    --- @return { [any]: any } The table that contains any info you have put in it.
    @side(shared)
    function UniqueIDTable(key: any): { [any]: any }
    --- Unlocks the player movement if locked previously.
    --- Will disable godmode for the player if locked previously.
    @side(server)
    function UnLock(): nil
    --- Removes the player from the spectate mode entirely.
    --- The player must be respawned, otherwise they will be able to walk through doors and become invincible. This will be fixed in a future update.
    @side(server)
    function UnSpectate(): nil
    --- Returns the player's user ID. This number will always be unique, but will reset if the player reconnects. (Always increments for each connecting player)
    --- You can use `Global.Player` global function to get a player by their user ID.
    --- @return number The player's user ID
    @side(shared)
    function UserID(): number
    --- Simulates a push on the client's screen. This **adds** view punch velocity, and does not reset the current view punch angle, for which you can use `Player:SetViewPunchAngles`.
    --- **NOTE**: Despite being defined shared, it only functions when called server-side.
    --- @param punchAngle The angle in which to push the player's screen.
    @side(shared)
    function ViewPunch(punchAngle: Angle): nil
    --- Resets the player's view punch (and the view punch velocity, read more at `Player:ViewPunch`) effect back to normal.
    --- @param tolerance Reset all ViewPunch below this threshold.
    @side(shared)
    function ViewPunchReset(tolerance: number | nil): nil
    --- Returns the players voice volume, how loud the player's voice communication currently is, as a number in range of [0,1].
    --- @return number The voice volume.
    @side(client)
    function VoiceVolume(): number
end

--- A client side projected texture, created by `Global.ProjectedTexture`.
@overrideCtor("$class($args)")
declare class ProjectedTexture
    --- Creates a new `ProjectedTexture`.
    constructor()
    --- Returns the angle of the ProjectedTexture, which were previously set by `ProjectedTexture:SetAngles`
    --- @return Angle The angles of the ProjectedTexture.
    @side(client)
    function GetAngles(): Angle
    --- Returns the brightness of the ProjectedTexture, which was previously set by `ProjectedTexture:SetBrightness`
    --- @return number The brightness of the ProjectedTexture.
    @side(client)
    function GetBrightness(): number
    --- Returns the color of the ProjectedTexture, which was previously set by `ProjectedTexture:SetColor`.
    --- @return Color The Color of the ProjectedTexture.
    @side(client)
    function GetColor(): Color
    --- Returns the constant attenuation of the projected texture, which can also be set by `ProjectedTexture:SetConstantAttenuation`.
    --- @return number The constant attenuation
    @side(client)
    function GetConstantAttenuation(): number
    --- Returns whether shadows are enabled for this ProjectedTexture, which was previously set by `ProjectedTexture:SetEnableShadows`
    --- @return boolean Whether shadows are enabled.
    @side(client)
    function GetEnableShadows(): boolean
    --- Returns the projection distance of the ProjectedTexture, which was previously set by `ProjectedTexture:SetFarZ`
    --- @return number The projection distance of the ProjectedTexture.
    @side(client)
    function GetFarZ(): number
    --- Returns the horizontal FOV of the ProjectedTexture, which was previously set by `ProjectedTexture:SetHorizontalFOV` or `ProjectedTexture:SetFOV`
    --- @return number The horizontal FOV of the ProjectedTexture.
    @side(client)
    function GetHorizontalFOV(): number
    --- Returns whenever or not the Texture should light up world geometry.
    --- @return boolean `true` if the Texture should light up world geometry.
    @side(client)
    function GetLightWorld(): boolean
    --- Returns the linear attenuation of the projected texture, which can also be set by `ProjectedTexture:SetLinearAttenuation`.
    --- @return number The linear attenuation.
    @side(client)
    function GetLinearAttenuation(): number
    --- Returns the NearZ value of the ProjectedTexture, which was previously set by `ProjectedTexture:SetNearZ`
    --- @return number NearZ of the ProjectedTexture.
    @side(client)
    function GetNearZ(): number
    --- Returns the state of projected texture view-frustum culling. See `ProjectedTexture:SetNoCull`.
    --- @return boolean `false` if culling is enabled (default), `true` if disabled.
    @side(client)
    function GetNoCull(): boolean
    --- Returns the current orthographic settings of the Projected Texture. To set these values, use `ProjectedTexture:SetOrthographic`.
    --- @return boolean Whether or not this projected texture is orthographic. When false, nothing else is returned.
    --- @return number left
    --- @return number top
    --- @return number right
    --- @return number bottom
    @side(client)
    function GetOrthographic(): (boolean, number, number, number, number)
    --- Returns the position of the ProjectedTexture, which was previously set by `ProjectedTexture:SetPos`
    --- @return Vector The position of the ProjectedTexture.
    @side(client)
    function GetPos(): Vector
    --- Returns the quadratic attenuation of the projected texture, which can also be set by `ProjectedTexture:SetQuadraticAttenuation`.
    --- @return number The quadratic attenuation
    @side(client)
    function GetQuadraticAttenuation(): number
    --- Returns the shadow depth bias of the projected texture.
    --- Set by `ProjectedTexture:SetShadowDepthBias`.
    --- @return number The current shadow depth bias.
    @side(client)
    function GetShadowDepthBias(): number
    --- Returns the shadow "filter size" of the projected texture. `0` is fully pixelated, higher values will blur the shadow more.
    --- Set by `ProjectedTexture:SetShadowFilter`.
    --- @return number The current shadow filter size.
    @side(client)
    function GetShadowFilter(): number
    --- Returns the shadow depth slope scale bias of the projected texture.
    --- Set by `ProjectedTexture:SetShadowSlopeScaleDepthBias`.
    --- @return number The current shadow depth slope scale bias.
    @side(client)
    function GetShadowSlopeScaleDepthBias(): number
    --- Returns whether shadow updates are disabled for this ProjectedTexture, which was previously set by `ProjectedTexture:SetSkipShadowUpdates`.
    --- @return boolean Whether shadow updates are disabled.
    @side(client)
    function GetSkipShadowUpdates(): boolean
    --- Returns the target entity of this projected texture.
    --- @return Entity The current target entity.
    @side(client)
    function GetTargetEntity(): Entity
    --- Returns the texture of the ProjectedTexture, which was previously set by `ProjectedTexture:SetTexture`
    --- @return ITexture The texture of the ProjectedTexture.
    @side(client)
    function GetTexture(): ITexture
    --- Returns the texture frame of the ProjectedTexture, which was previously set by `ProjectedTexture:SetTextureFrame`
    --- @return number The texture frame.
    @side(client)
    function GetTextureFrame(): number
    --- Returns the vertical FOV of the ProjectedTexture, which was previously set by `ProjectedTexture:SetVerticalFOV` or `ProjectedTexture:SetFOV`
    --- @return number The vertical FOV of the ProjectedTexture.
    @side(client)
    function GetVerticalFOV(): number
    --- Returns true if the projected texture is valid (i.e. has not been removed), false otherwise.
    --- Instead of calling this directly it's a good idea to call `Global.IsValid` in case the variable is nil.
    --- ```
    --- IsValid( ptexture )
    --- ```
    --- This not only checks whether the projected texture is valid - but also checks whether it's nil.
    --- @return boolean Whether the projected texture is valid.
    @side(client)
    function IsValid(): boolean
    --- Removes the projected texture. After calling this, `ProjectedTexture:IsValid` will return false, and any hooks with the projected texture as the identifier will be automatically deleted.
    @side(client)
    function Remove(): nil
    --- Sets the angles (direction) of the projected texture.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetAngles(angle: Angle): nil
    --- Sets the brightness of the projected texture.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param brightness The brightness to give the projected texture. A float from 0 to 1, where 1 is 100% brightness. Can be higher.
    @side(client)
    function SetBrightness(brightness: number): nil
    --- Sets the color of the projected texture.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param color Unlike other projected textures, this color can only go up to 255.
    @side(client)
    function SetColor(color: Color): nil
    --- Sets the constant attenuation of the projected texture.
    --- See also `ProjectedTexture:SetLinearAttenuation` and `ProjectedTexture:SetQuadraticAttenuation`.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetConstantAttenuation(constAtten: number): nil
    --- Enable or disable shadows cast from the projected texture.
    --- **NOTE**: As with all types of projected textures (including the player's flashlight and env_projectedtexture), there can only be 8 projected textures with shadows enabled in total.This limit can be increased with the launch parameter `-numshadowtextures LIMIT` where `LIMIT` is the new limit.Naturally, many projected lights with shadows enabled will drastically decrease framerate.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetEnableShadows(newState: boolean): nil
    --- Sets the distance at which the projected texture ends.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetFarZ(farZ: number): nil
    --- Sets the angle of projection.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param fov Must be higher than 0 and lower than 180
    @side(client)
    function SetFOV(fov: number): nil
    --- Sets the horizontal angle of projection without affecting the vertical angle.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param hFOV The new horizontal Field Of View for the projected texture. Must be in range between 0 and 180.
    @side(client)
    function SetHorizontalFOV(hFOV: number): nil
    --- Set whenever or not the Texture should light up world geometry.
    --- @param lightworld Set it to `true` if the Texture should light up world geometry.
    @side(client)
    function SetLightWorld(lightworld: boolean): nil
    --- Sets the linear attenuation of the projected texture.
    --- See also `ProjectedTexture:SetConstantAttenuation` and `ProjectedTexture:SetQuadraticAttenuation`.
    --- The default value of linear attenuation when the projected texture is created is 100. (others are 0, as you are not supposed to mix them)
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetLinearAttenuation(linearAtten: number): nil
    --- Sets the distance at which the projected texture begins its projection.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- **NOTE**: Setting this to 0 will disable the projected texture completely! This may be useful if you want to disable a projected texture without actually removing it
    --- **NOTE**: This seems to affect the rendering of shadows - a higher Near Z value will have shadows begin to render closer to their casting object. Comparing a low Near Z value (like 1) with a normal one (12) or high one (1000) is the easiest way to understand this artifact
    @side(client)
    function SetNearZ(nearZ: number): nil
    --- Allows disabling of projected texture view-frustum culling for cases where said culling creates unwanted side effects. Disabling culling will have a negative effect on performance.
    --- Culling makes projected textures off screen to stop rendering/updating.
    --- @param enable `false` to enable culling (default), `true` to disable.
    @side(client)
    function SetNoCull(enable: boolean): nil
    --- Changes the current projected texture between orthographic and perspective projection.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- Shadows dont work. (For non static props and for most map brushes)
    --- @param orthographic When false, all other arguments are ignored and the texture is reset to perspective projection.
    --- @param left The amount of units left from the projected texture's origin to project.
    --- @param top The amount of units upwards from the projected texture's origin to project.
    --- @param right The amount of units right from the projected texture's origin to project.
    --- @param bottom The amount of units downwards from the projected texture's origin to project.
    @side(client)
    function SetOrthographic(orthographic: boolean, left: number, top: number, right: number, bottom: number): nil
    --- Move the Projected Texture to the specified position.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetPos(position: Vector): nil
    --- Sets the quadratic attenuation of the projected texture.
    --- See also `ProjectedTexture:SetLinearAttenuation` and `ProjectedTexture:SetConstantAttenuation`.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    @side(client)
    function SetQuadraticAttenuation(quadAtten: number): nil
    --- Sets the shadow depth bias of the projected texture.
    --- The initial value is `0.0001`. Normal projected textures obey the value of the `mat_depthbias_shadowmap` `ConVar`.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param bias The shadow depth bias to set.
    @side(client)
    function SetShadowDepthBias(bias: number): nil
    --- Sets the shadow "filter size" of the projected texture. `0` is fully pixelated, higher values will blur the shadow more. The initial value is the value of `r_projectedtexture_filter` `ConVar`.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param filter The shadow filter size to set.
    @side(client)
    function SetShadowFilter(filter: number): nil
    --- Sets the shadow depth slope scale bias of the projected texture.
    --- The initial value is `2`. Normal projected textures obey the value of the `mat_slopescaledepthbias_shadowmap` `ConVar`.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param bias The shadow depth slope scale bias to set.
    @side(client)
    function SetShadowSlopeScaleDepthBias(bias: number): nil
    --- Sets whether shadow updates are disabled for this ProjectedTexture. This can be useful to save up on performance, but it will inevitably cause graphical glitches if left not updating for long.
    --- @param enable Whether future shadow updates should be skipped.
    @side(client)
    function SetSkipShadowUpdates(enable: boolean): nil
    --- Sets the target entity for this projected texture, meaning it will only be lighting the given entity and the world.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param target The target entity, or `NULL` to reset.
    @side(client)
    function SetTargetEntity(target: Entity | nil): nil
    --- Sets the texture to be projected.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param texture The name of the texture. Can also be an ITexture.
    @side(client)
    function SetTexture(texture: string): nil
    --- For animated textures, this will choose which frame in the animation will be projected.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param frame The frame index to use.
    @side(client)
    function SetTextureFrame(frame: number): nil
    --- Sets the vertical angle of projection without affecting the horizontal angle.
    --- You must call `ProjectedTexture:Update` after using this function for it to take effect.
    --- @param vFOV The new vertical Field Of View for the projected texture. Must be in range between 0 and 180.
    @side(client)
    function SetVerticalFOV(vFOV: number): nil
    --- Updates the Projected Light and applies all previously set parameters.
    --- The best place to call this function is in `GM:PreDrawOpaqueRenderables`.
    @side(client)
    function Update(): nil
end

--- The object returned by `ai_schedule.New`.
declare class Schedule
    --- Adds a task to the schedule. See also `Schedule:AddTaskEx` if you wish to customize task start and run function names.
    --- See also `ENTITY:StartSchedule`, `NPC:StartEngineTask`, and `NPC:RunEngineTask`.
    --- @param taskname Custom task name
    --- @param taskdata Task data to be passed into the NPC's functions
    @side(server)
    function AddTask(taskname: string, taskdata: any): nil
    --- Adds a task to the schedule with completely custom function names.
    --- See also `Schedule:AddTask`.
    --- @param start The full name of a function on the entity's table to be ran when the task is started.
    --- @param run The full name of a function on the entity's table to be ran when the task is continuously running.
    --- @param data Task data to be passed into the NPC's functions
    @side(server)
    function AddTaskEx(start: string, run: string, data: number): nil
    --- Adds an engine task to the schedule.
    --- @param taskname Task name, see [ai_task.h](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/ai_task.h#L89-L502)
    --- @param taskdata Task data, can be a float.
    @side(server)
    function EngTask(taskname: string, taskdata: number): nil
    --- Returns the task at the given index.
    --- @param num Task index.
    @side(server)
    function GetTask(num: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Initialises the Schedule. Called by `ai_schedule.New` when the Schedule is created.
    --- @param debugName The name passed from ai_schedule.New.
    @side(server)
    function Init(debugName: string): nil
    --- Returns the number of tasks in the schedule.
    --- @return number The number of tasks in this schedule.
    @side(server)
    function NumTasks(): number
end

--- An object returned by `util.Stack`.
--- Like a Lua table, a Stack is a container. It follows the principle of LIFO (last in, first out).
--- The Stack works like a stack of papers: the first page you put down (push) will be the last one you remove (pop). That also means that the last page you put down, will be the first to be removed.
declare class Stack
    --- Pop an item from the stack
    --- @param amount Amount of items you want to pop.
    --- @return any Latest popped item.
    @side(shared)
    function Pop(amount: number | nil): any
    --- Pop an item from the stack
    --- @param amount Amount of items you want to pop.
    --- @return { [any]: any } The Popped Items.
    @side(shared)
    function PopMulti(amount: number | nil): { [any]: any }
    --- Push an item onto the stack
    --- @param object The item you want to push
    @side(shared)
    function Push(object: any): nil
    --- Returns the size of the stack
    --- @return number The size of the stack
    @side(shared)
    function Size(): number
    --- Get the item at the top of the stack
    --- @return any The item at the top of the stack
    @side(shared)
    function Top(): any
end

--- A brush surface object returned by `Entity:GetBrushSurfaces`.
--- Brush surfaces are a part of what makes up the map geometry aside from displacements. Any primitive brush model, including most breakable windows, can be represented by this object.
--- This object internally uses the `SurfaceHandle_t` class, which is an alias for `msurface2_t*`.
declare class SurfaceInfo
    --- Returns the brush surface's material.
    --- @return IMaterial Material of one portion of a brush model.
    @side(shared)
    function GetMaterial(): IMaterial
    --- Returns a list of vertices the brush surface is built from.
    --- @return Vector[] A list of Vector points. This will usually be 4 corners of a quadrilateral in counter-clockwise order.
    @side(shared)
    function GetVertices(): Vector[]
    --- Checks if the brush surface is a nodraw surface, meaning it will not be drawn by the engine.
    --- **NOTE**: This internally checks the SURFDRAW_NODRAW flag.
    --- @return boolean Returns true if this surface won't be drawn.
    @side(shared)
    function IsNoDraw(): boolean
    --- Checks if the brush surface is displaying the skybox.
    --- **NOTE**: This internally checks the SURFDRAW_SKY flag.
    --- @return boolean Returns true if the surface is the sky.
    @side(shared)
    function IsSky(): boolean
    --- Checks if the brush surface is water.
    --- **NOTE**: This internally checks the SURFDRAW_WATER flag.
    --- @return boolean Returns true if the surface is water.
    @side(shared)
    function IsWater(): boolean
end

--- A single AI task. Returned by `ai_task.New`.
declare class Task
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Initialises the AI task. Called by `ai_task.New`.
    @side(server)
    function Init(): nil
    --- Initialises the AI task as an engine task.
    --- @param taskname The name of the task.
    @side(server)
    function InitEngine(taskname: string, taskdata: number): nil
    --- Initialises the AI task as NPC method-based.
    --- @param startname The name of the NPC method to call on task start.
    --- @param runname The name of the NPC method to call on task run.
    @side(server)
    function InitFunctionName(startname: string, runname: string, taskdata: number): nil
    --- Determines if the task is an engine task (`TYPE_ENGINE`, 1).
    @side(server)
    function IsEngineType(): nil
    --- Determines if the task is an NPC method-based task (`TYPE_FNAME`, 2).
    @side(server)
    function IsFNameType(): nil
    --- Runs the AI task.
    --- @param target The NPC to run the task on.
    @side(server)
    function Run(target: NPC): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Runs the AI task as an NPC method. This requires the task to be of type `TYPE_FNAME`.
    --- @param target The NPC to run the task on.
    @side(server)
    function Run_FName(target: NPC): nil
    --- Starts the AI task.
    --- @param target The NPC to start the task on.
    @side(server)
    function Start(target: NPC): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Starts the AI task as an NPC method.
    --- @param target The NPC to start the task on.
    @side(server)
    function Start_FName(target: NPC): nil
end

--- A list of functions available inside a Sandbox Toolgun tool.
--- You can find the hooks `here`, and members `here`.
declare class Tool
    --- Returns whether the tool is allowed to be used or not. This function ignores the `SANDBOX:CanTool` hook.
    --- By default this will always return true clientside and uses `TOOL.AllowedCVar`which is a `ConVar` object pointing to  `toolmode_allow_*toolname*` convar on the server.
    --- @return boolean Returns true if the tool is allowed.
    @side(shared)
    function Allowed(): boolean
    --- Builds a list of all ConVars set via the ClientConVar variable on the `Structures/TOOL` and their default values. This is used for the preset system.
    --- @return { [any]: any } A list of all convars and their default values.
    @side(shared)
    function BuildConVarList(): { [any]: any }
    --- **INTERNAL**: This is called automatically for most toolgun actions so you shouldn't need to use it.
    --- Checks all added objects to see if they're still valid, if not, clears the list of objects.
    @side(shared)
    function CheckObjects(): nil
    --- Clears all objects previously set with `Tool:SetObject`.
    @side(shared)
    function ClearObjects(): nil
    --- **INTERNAL**: This is called automatically for all tools.
    --- Initializes the tool object
    --- @return Tool The created tool object.
    @side(shared)
    function Create(): Tool
    --- **INTERNAL**: This is called automatically for all tools.
    --- Creates clientside ConVars based on the ClientConVar table specified in the tool structure. Also creates the 'toolmode_allow_X' ConVar.
    @side(shared)
    function CreateConVars(): nil
    --- Retrieves a physics bone number previously stored using `Tool:SetObject`.
    --- @param id The id of the object which was set in Tool:SetObject.
    --- @return number Associated physics bone with given id.
    @side(shared)
    function GetBone(id: number): number
    --- Attempts to grab a clientside tool `ConVar` value as a `boolean`.
    --- @param name Name of the ConVar to retrieve. The function will automatically add the `mytoolfilename_` part to it.
    --- @param default The default value to return in case the lookup fails.
    --- @return number The value of the requested ConVar. It will be true if the value if the convar is not 0, just like ConVar:GetBool
    @side(shared)
    function GetClientBool(name: string, default: boolean | nil): number
    --- Attempts to grab a clientside tool `ConVar` as a `string`.
    --- @param name Name of the convar to retrieve. The function will automatically add the `mytoolfilename_` part to it.
    --- @return string The value of the requested ConVar.
    @side(shared)
    function GetClientInfo(name: string): string
    --- Attempts to grab a clientside tool `ConVar`'s value as a `number`.
    --- @param name Name of the convar to retrieve. The function will automatically add the `mytoolfilename_` part to it.
    --- @param default The default value to return in case the lookup fails.
    --- @return number The value of the requested ConVar.
    @side(shared)
    function GetClientNumber(name: string, default: number | nil): number
    --- Retrieves an Entity previously stored using `Tool:SetObject`.
    --- @param id The id of the object which was set in Tool:SetObject.
    --- @return Entity Associated Entity with given id.
    @side(shared)
    function GetEnt(id: number): Entity
    --- Returns a language key based on this tool's name and the current stage it is on.
    --- @return string The returned language key, for example `"#tool.weld.1"`
    @side(shared)
    function GetHelpText(): string
    --- Retrieves an local vector previously stored using `Tool:SetObject`.
    --- See also `Tool:GetPos`.
    --- @param id The id of the object which was set in Tool:SetObject.
    --- @return Vector Associated local vector with given id.
    @side(shared)
    function GetLocalPos(id: number): Vector
    --- Returns the name of the current tool mode.
    --- @return string The current tool mode.
    @side(shared)
    function GetMode(): string
    --- Retrieves an normal vector previously stored using `Tool:SetObject`.
    --- @param id The id of the object which was set in Tool:SetObject.
    --- @return Vector Associated normal vector with given id.
    @side(shared)
    function GetNormal(id: number): Vector
    --- Returns the current operation of the tool set by `Tool:SetOperation`.
    --- @return number The current operation the tool is at.
    @side(shared)
    function GetOperation(): number
    --- Returns the owner of this tool.
    --- @return Player Player using the tool
    @side(shared)
    function GetOwner(): Player
    --- Retrieves an `PhysObj` previously stored using `Tool:SetObject`.
    --- See also `Tool:GetEnt`.
    --- @param id The id of the object which was set in Tool:SetObject.
    --- @return PhysObj Associated PhysObj with given id. If it wasn't specified, returns current PhysObj of associated Entity.
    @side(shared)
    function GetPhys(id: number): PhysObj
    --- Retrieves an vector previously stored using `Tool:SetObject`. See also `Tool:GetLocalPos`.
    --- @param id The id of the object which was set in Tool:SetObject.
    --- @return Vector Associated vector with given id. The vector is converted from Tool:GetLocalPos.
    @side(shared)
    function GetPos(id: number): Vector
    --- Attempts to grab a serverside tool `ConVar`.
    --- This will not do anything on client, despite the function being defined shared.
    --- @param name Name of the convar to retrieve. The function will automatically add the "mytoolfilename_" part to it.
    --- @return string The value of the requested ConVar.
    @side(shared)
    function GetServerInfo(name: string): string
    --- Returns the current stage of the tool set by `Tool:SetStage`.
    --- @return number The current stage of the current operation the tool is at.
    @side(shared)
    function GetStage(): number
    --- Returns the Tool Gun (`gmod_tool`) Scripted `Weapon`.
    --- @return Weapon The tool gun weapon. (`gmod_tool`)
    --- @deprecated Use Tool:GetWeapon instead.
    @side(shared)
    function GetSWEP(): Weapon
    --- Returns the Tool Gun (`gmod_tool`) Scripted `Weapon`.
    --- @return Weapon The tool gun weapon. (`gmod_tool`)
    @side(shared)
    function GetWeapon(): Weapon
    --- Initializes the ghost entity with the given model. Removes any old ghost entity if called multiple times.
    --- The ghost is a regular prop_physics entity in singleplayer games, and a clientside prop in multiplayer games.
    --- @param model The model of the new ghost entity
    --- @param pos Position to initialize the ghost entity at, usually not needed since this is updated in Tool:UpdateGhostEntity.
    --- @param angle Angle to initialize the ghost entity at, usually not needed since this is updated in Tool:UpdateGhostEntity.
    @side(shared)
    function MakeGhostEntity(model: string, pos: Vector, angle: Angle): nil
    --- Returns the amount of stored objects ( `Entity`s ) the tool has.
    --- Are TOOLs limited to 4 entities?
    --- @return number The amount of stored objects, or Tool:GetStage clientide.
    @side(shared)
    function NumObjects(): number
    --- Automatically forces the tool's control panel to be rebuilt.
    --- @param extra_args Any arguments given to this function will be added to TOOL.BuildCPanel's arguments.
    @side(client)
    function RebuildControlPanel(...: any): nil
    --- Removes any ghost entity created for this tool.
    --- This is called automatically at various points, including when changing tools, holstering the toolgun, therefore it is a very good idea to implement this callback in your custom tool to cleanup any custom ghost entities.
    @side(shared)
    function ReleaseGhostEntity(): nil
    --- Stores an `Entity` for later use in the tool.
    --- The stored values can be retrieved by `Tool:GetEnt`, `Tool:GetPos`, `Tool:GetLocalPos`, `Tool:GetPhys`, `Tool:GetBone` and `Tool:GetNormal`
    --- @param id The id of the object to store.
    --- @param ent The entity to store.
    --- @param pos The position to store. this position is in **global space** and is internally converted to **local space** relative to the object, so when you retrieve it later it will be corrected to the object's new position
    --- @param phys The physics object to store.
    --- @param bone The hit bone to store.
    --- @param normal The hit normal to store.
    @side(shared)
    function SetObject(id: number, ent: Entity, pos: Vector, phys: PhysObj, bone: number, normal: Vector): nil
    --- Sets the current operation of the tool. Does nothing clientside. See also `Tool:SetStage`.
    --- Operations and stages work as follows:
    --- * Operation 1
    --- * * Stage 1
    --- * * Stage 2
    --- * * Stage 3
    --- * Operation 2
    --- * * Stage 1
    --- * * Stage 2
    --- * * Stage ...
    --- @param operation The new operation ID to set.
    @side(shared)
    function SetOperation(operation: number): nil
    --- Sets the current stage of the tool. Does nothing clientside.
    --- See also `Tool:SetOperation`.
    --- @param stage The new stage to set.
    @side(shared)
    function SetStage(stage: number): nil
    --- Initializes the ghost entity based on the supplied entity.
    --- @param ent The entity to copy ghost parameters off
    @side(shared)
    function StartGhostEntity(ent: Entity): nil
    --- **INTERNAL**: Called on deploy automatically
    --- Sets the tool's stage to how many stored objects the tool has.
    @side(shared)
    function UpdateData(): nil
    --- Updates the position and orientation of the ghost entity based on where the toolgun owner is looking along with data from object with id 1 set by `Tool:SetObject`.
    --- This should be called in the tool's `TOOL:Think` hook.
    --- This command is only used for tools that move props, such as easy weld, axis and motor. If you want to update a ghost like the thruster tool does it for example, check its [source code](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stools/thruster.lua#L179).
    @side(shared)
    function UpdateGhostEntity(): nil
end

--- List of all possible functions to manipulate vectors.
--- Created by `Global.Vector`.
--- Type   | Name           | Description
--- ------ | -------------- | ------------------------------
--- `number` | `x`, `X`, `r` or `1` | The X component of the vector.
--- `number` | `y`, `Y`, `g` or `2` | The Y component of the vector.
--- `number` | `z`, `Z`, `b` or `3` | The Z component of the vector.
--- Metamethod | Second Operand | Description
--- ---------- | -------------- | -----------
--- `__add` | `Vector` | Returns new `Vector` with the result of addition.
--- `__div` | `number` or `Vector` | Returns new `Vector` with the result of division.
--- `__eq` | `any` | Compares 2 operands, if they both are `Vector`, compares each individual component.
--- `__index` | `number` or `string` | Gets the component of the `Vector`. Returns a `number`.
--- `__mul` | `number` or `Vector`| Returns new `Vector` with the result of multiplication.
--- `__newindex` | `number` or `string` | Sets the component of the `Vector`. Accepts `number` and `string`.
--- `__sub` | `Vector` | Returns new `Vector` with the result of subtraction.
--- `__tostring` | | Returns `x y z`.
--- `__unm` | | Returns new `Vector` with the result of negation.
@overrideCtor("$class($args)")
declare class Vector
    --- Creates a `Vector` object.
    --- **WARNING**: Creating Vectors is relatively expensive when used in often running hooks or in operations requiring very frequent calls (like loops for example) due to object creation and garbage collection. It is better to store the vector in a variable or to use the `default vectors` available. See `Vector:Add`.
    --- @param x The x component of the vector.
    --- @param y The y component of the vector.
    --- @param z The z component of the vector.
    constructor(x: number | nil, y: number | nil, z: number | nil)
    --- Creates a `Vector` object.
    --- **WARNING**: Creating Vectors is relatively expensive when used in often running hooks or in operations requiring very frequent calls (like loops for example) due to object creation and garbage collection. It is better to store the vector in a variable or to use the `default vectors` available. See `Vector:Add`.
    --- @param vector Creates a new Vector that is a copy of the given Vector.
    constructor(vector: Vector)
    --- Creates a `Vector` object.
    --- **WARNING**: Creating Vectors is relatively expensive when used in often running hooks or in operations requiring very frequent calls (like loops for example) due to object creation and garbage collection. It is better to store the vector in a variable or to use the `default vectors` available. See `Vector:Add`.
    --- @param vectorString Attempts to parse the input string from the Global.print format of an Vector. Returns a Vector with its `x`, `y`, and `z` set to `0` if the string cannot be parsed.
    constructor(vectorString: string)
    --- Adds the values of the argument vector to the original vector. This function is the same as vector1 + vector2 without creating a new vector object, skipping object construction and garbage collection.
    --- @param vector The vector to add.
    @side(shared)
    function Add(vector: Vector): nil
    --- Returns an angle representing the normal of the vector.
    --- @return Angle The angle/direction of the vector.
    @side(shared)
    function Angle(): Angle
    --- Returns the angle of this vector (normalized), but instead of assuming that up is `Global.Vector`( 0, 0, 1 ) (Like `Vector:Angle` does) you can specify which direction is 'up' for the angle.
    --- @param up The up direction vector
    --- @return Angle The angle
    @side(shared)
    function AngleEx(up: Vector): Angle
    --- Calculates the cross product of this vector and the passed one.
    --- The cross product of two vectors is a 3-dimensional vector with a direction perpendicular (at right angles) to both of them (according to the [right-hand rule](https://en.wikipedia.org/wiki/Right-hand_rule)), and magnitude equal to the area of parallelogram they span. This is defined as the product of the magnitudes, the sine of the angle between them, and unit (normal) vector `n` defined by the right-hand rule:
    --- :**a** &times; **b** = |**a**| |**b**| sin(&theta;) **n̂**
    --- where **a** and **b** are vectors, and **n̂** is a unit vector (magnitude of 1) perpendicular to both.
    --- @param otherVector Vector to calculate the cross product with.
    --- @return Vector The cross product of the two vectors.
    @side(shared)
    function Cross(otherVector: Vector): Vector
    --- Returns the Euclidean distance between the vector and the other vector.
    --- **NOTE**: This function is more expensive than `Vector:DistToSqr`. However, please see the notes for `Vector:DistToSqr` before using it as squared distances are not the same as euclidean distances.
    --- @param otherVector The vector to get the distance to.
    --- @return number Distance between the vectors.
    @side(shared)
    function Distance(otherVector: Vector): number
    --- Returns the Euclidean distance between the vector and the other vector in 2D space. The Z axis is ignored.
    --- **NOTE**: This function is more expensive than `Vector:Distance2DSqr`. However, please see the notes for `Vector:Distance2DSqr` before using it as squared distances are not the same as Euclidean distances.
    --- @param otherVector The vector to get the distance to.
    --- @return number Distance between the vectors in 2D space.
    @side(shared)
    function Distance2D(otherVector: Vector): number
    --- Returns the squared distance between 2 vectors in 2D space, ignoring the Z axis. This is faster than `Vector:Distance2D` as calculating the square root is an expensive process.
    --- **NOTE**: Squared distances should not be summed. If you need to sum distances, use `Vector:Distance2D`.
    --- When performing a distance check, ensure the distance being checked against is squared.
    --- @param otherVec The vector to calculate the distance to.
    --- @return number Squared distance to the vector in 2D space.
    @side(shared)
    function Distance2DSqr(otherVec: Vector): number
    --- Returns the squared distance of 2 vectors, this is quicker to call than `Vector:Distance` as DistToSqr does not need to calculate the square root, which is an expensive process.
    --- **NOTE**: Squared distances should not be summed. If you need to sum distances, use `Vector:Distance`.
    --- When performing a distance check, ensure the distance being checked against is squared. See example code below.
    --- @param otherVec The vector to calculate the distance to.
    --- @return number Squared distance to the vector.
    @side(shared)
    function DistToSqr(otherVec: Vector): number
    --- Divide the vector by the given number, that means x, y and z are divided by that value. This will change the value of the original vector, see example 2 for division without changing the value.
    --- @param divisor The value to divide the vector with.
    @side(shared)
    function Div(divisor: number): nil
    --- Returns the [dot product](https://en.wikipedia.org/wiki/Dot_product#Geometric_definition)  of this vector and the passed one.
    --- The dot product of two vectors is the product of their magnitudes (lengths), and the cosine of the angle between them:
    --- **a · b** = |**a**| |**b**| cos(θ)
    --- where **a** and **b** are vectors.
    --- See `Vector:Length` for obtaining magnitudes.
    --- A dot product returns just the cosine of the angle if both vectors are normalized, and zero if the vectors are at right angles to each other.
    --- @param otherVector The vector to calculate the dot product with
    --- @return number The dot product between the two vectors
    @side(shared)
    function Dot(otherVector: Vector): number
    --- Returns the dot product of the two vectors.
    --- @param Vector The other vector.
    --- @return number Dot Product
    --- @deprecated This is an alias of Vector:Dot. Use that instead.
    @side(shared)
    function DotProduct(Vector: Vector): number
    --- Returns the negative version of this vector, i.e. a vector with every component to the negative value of itself.
    --- See also `Vector:Negate`.
    --- @return Vector The negative of this vector.
    @side(shared)
    function GetNegated(): Vector
    --- Returns a normalized version of the vector. This is a alias of `Vector:GetNormalized`.
    --- @return Vector Normalized version of the vector.
    --- @deprecated Use Vector:GetNormalized instead.
    @side(shared)
    function GetNormal(): Vector
    --- Returns a normalized version of the vector. Normalized means vector with same direction but with length of 1.
    --- This does not affect the vector you call it on; to do this, use `Vector:Normalize`.
    --- @return Vector Normalized version of the vector.
    @side(shared)
    function GetNormalized(): Vector
    --- Returns if the vector is equal to another vector with the given tolerance.
    --- @param compare The vector to compare to.
    --- @param tolerance The tolerance range.
    --- @return boolean Are the vectors equal or not.
    @side(shared)
    function IsEqualTol(compare: Vector, tolerance: number): boolean
    --- Checks whenever all fields of the vector are 0.
    --- @return boolean Do all fields of the vector equal 0 or not
    @side(shared)
    function IsZero(): boolean
    --- Returns the [Euclidean length](https://en.wikipedia.org/wiki/Euclidean_vector#Length) of the vector: &radic;(x&sup2; + y&sup2; + z&sup2;).
    --- **WARNING**: This is a relatively expensive process since it uses the square root. It is recommended that you use `Vector:LengthSqr` whenever possible.
    --- @return number Length of the vector.
    @side(shared)
    function Length(): number
    --- Returns the length of the vector in two dimensions, without the Z axis.
    --- **WARNING**: This is a relatively expensive process since it uses the square root. It is recommended that you use `Vector:Length2DSqr` whenever possible.
    --- @return number Length of the vector in two dimensions, √(x² + y²)
    @side(shared)
    function Length2D(): number
    --- Returns the squared length of the vectors x and y value, x&sup2; + y&sup2;.
    --- This is faster than `Vector:Length2D` as calculating the square root is an expensive process.
    --- @return number Squared length of the vector in two dimensions
    @side(shared)
    function Length2DSqr(): number
    --- Returns the squared length of the vector, x&sup2; + y&sup2; + z&sup2;.
    --- This is faster than `Vector:Length` as calculating the square root is an expensive process.
    --- @return number Squared length of the vector
    @side(shared)
    function LengthSqr(): number
    --- Scales the vector by the given `number` (that means x, y and z are multiplied by that value), a `Vector` (X, Y, and Z of each vector are multiplied) or a `VMatrix` (Transforms the vector by the matrix's rotation/translation).
    --- @param multiplier The value to multiply the vector with.
    @side(shared)
    function Mul(multiplier: number): nil
    --- Scales the vector by the given `number` (that means x, y and z are multiplied by that value), a `Vector` (X, Y, and Z of each vector are multiplied) or a `VMatrix` (Transforms the vector by the matrix's rotation/translation).
    --- @param multiplier The vector to multiply the vector with.
    @side(shared)
    function Mul(multiplier: Vector): nil
    --- Scales the vector by the given `number` (that means x, y and z are multiplied by that value), a `Vector` (X, Y, and Z of each vector are multiplied) or a `VMatrix` (Transforms the vector by the matrix's rotation/translation).
    --- @param matrix The matrix to transform the vector by.
    @side(shared)
    function Mul(matrix: VMatrix): nil
    --- Negates this vector, i.e. sets every component to the negative value of itself. Same as `Vector( -vec.x, -vec.y, -vec.z )` but without creating new vector object
    @side(shared)
    function Negate(): nil
    --- Normalizes the given vector. This changes the vector you call it on, if you want to return a normalized copy without affecting the original, use `Vector:GetNormalized`.
    @side(shared)
    function Normalize(): nil
    --- Randomizes each element of this Vector object.
    --- @param min The minimum value for each component.
    --- @param max The maximum value for each component.
    @side(shared)
    function Random(min: number | nil, max: number | nil): nil
    --- Rotates a vector by the given angle.
    --- Doesn't return anything, but rather changes the original vector.
    --- @param rotation The angle to rotate the vector by.
    @side(shared)
    function Rotate(rotation: Angle): nil
    --- Copies the values from the second vector to the first vector.
    --- @param vector The vector to copy from.
    @side(shared)
    function Set(vector: Vector): nil
    --- Sets the x, y, and z of the vector.
    --- @param x The x component
    --- @param y The y component
    --- @param z The z component
    @side(shared)
    function SetUnpacked(x: number, y: number, z: number): nil
    --- Substracts the values of the second vector from the orignal vector, this function can be used to avoid garbage collection.
    --- @param vector The other vector.
    @side(shared)
    function Sub(vector: Vector): nil
    --- Translates the `Vector` (values ranging from 0 to 1) into a `Color`. This will also range the values from 0 - 1 to 0 - 255.
    --- x * 255 -> r
    --- y * 255 -> g
    --- z * 255 -> b
    --- This is the opposite of `Color:ToVector`
    --- @return Color The created Color.
    @side(shared)
    function ToColor(): Color
    --- Returns where on the screen the specified position vector would appear. A related function is `gui.ScreenToVector`, which converts a 2D coordinate to a 3D direction.
    --- **NOTE**: Should be called from a 3D rendering environment or after `cam.Start3D` or it may not work correctly.
    --- Errors in a render hook can make this value incorrect until the player restarts their game.
    --- `cam.Start3D` or 3D context `cam.Start` with non-default parameters incorrectly sets the reference FOV for this function, causing incorrect return values. This can be fixed by creating and ending a default 3D context (`cam.Start3D` with no arguments).
    --- @return ToScreenData The created Structures/ToScreenData.
    @side(client)
    function ToScreen(): ToScreenData
    --- Returns the vector as a table with three elements.
    --- @return { [any]: any } The table with elements 1 = x, 2 = y, 3 = z.
    @side(shared)
    function ToTable(): { [any]: any }
    --- Returns the x, y, and z of the vector.
    --- @return number x or Vector[1].
    --- @return number y or Vector[2].
    --- @return number z or Vector[3].
    @side(shared)
    function Unpack(): (number, number, number)
    --- Returns whenever the given vector is in a box created by the 2 other vectors.
    --- @param boxStart The first vector.
    --- @param boxEnd The second vector.
    --- @return boolean Is the vector in the box or not.
    @side(shared)
    function WithinAABox(boxStart: Vector, boxEnd: Vector): boolean
    --- Sets x, y and z to 0.
    @side(shared)
    function Zero(): nil
end

--- This is a list of all methods only available for vehicles. It is also possible to call `Entity` functions on vehicles.
declare class Vehicle extends Entity
    --- Returns the remaining boosting time left.
    --- @return number The remaining boosting time left
    @side(server)
    function BoostTimeLeft(): number
    --- Tries to find an Exit Point for leaving vehicle, if one is unobstructed in the direction given.
    --- @param yaw Yaw/roll from vehicle angle to check for exit
    --- @param distance Distance from origin to drop player
    --- @return Vector Returns the vector for exit position or nil if cannot exit that way.
    @side(server)
    function CheckExitPoint(yaw: number, distance: number): Vector
    --- Sets whether the engine is enabled or disabled, i.e. can be started or not.
    --- @param enable Enable or disable the engine
    @side(server)
    function EnableEngine(enable: boolean): nil
    --- Returns information about the ammo of the vehicle
    --- @return number Ammo type of the vehicle ammo
    --- @return number Clip size
    --- @return number Count
    @side(client)
    function GetAmmo(): (number, number, number)
    --- Returns third person camera distance.
    --- @return number Camera distance
    @side(shared)
    function GetCameraDistance(): number
    --- Gets the driver of the vehicle, returns `NULL` if no driver is present.
    --- @return Entity The driver of the vehicle.
    @side(shared)
    function GetDriver(): Entity
    --- Returns the current speed of the vehicle in Half-Life Hammer Units (in/s). Same as `Entity:GetVelocity` + `Vector:Length`.
    --- @return number The speed of the vehicle
    @side(server)
    function GetHLSpeed(): number
    --- Returns the max speed of the vehicle in MPH.
    --- @return number The max speed of the vehicle in MPH
    @side(server)
    function GetMaxSpeed(): number
    --- Returns some info about the vehicle.
    --- @return OperatingParams The operating parameters.
    @side(server)
    function GetOperatingParams(): OperatingParams
    --- Gets the passenger of the vehicle, returns `NULL` if no drivers is present.
    --- @param passenger The index of the passenger ( 0 is the driver )
    --- @return Entity The passenger
    @side(shared)
    function GetPassenger(passenger: number): Entity
    --- Returns the seat position and angle of a given passenger seat.
    --- @param role The passenger role. ( 0 is the driver )
    --- @return Vector The seat position in worldspace coordinates.
    --- @return Angle The seat angle in worldspace coordinates.
    @side(server)
    function GetPassengerSeatPoint(role: number): (Vector, Angle)
    --- Returns the current RPM of the vehicle. This value is fake and doesn't actually affect the vehicle movement.
    --- @return number The RPM.
    @side(server)
    function GetRPM(): number
    --- Returns the current speed of the vehicle in MPH.
    --- @return number The speed of the vehicle in MPH
    @side(server)
    function GetSpeed(): number
    --- Returns the current steering of the vehicle.
    --- @return number The current steering of the vehicle.
    @side(server)
    function GetSteering(): number
    --- Returns the maximum steering degree of the vehicle
    --- @return number The maximum steering degree of the vehicle
    @side(server)
    function GetSteeringDegrees(): number
    --- Returns if vehicle has thirdperson mode enabled or not.
    --- @return boolean Returns `true` if third person mode enabled, `false` otherwise
    @side(shared)
    function GetThirdPersonMode(): boolean
    --- Returns the current throttle of the vehicle.
    --- @return number The current throttle of the vehicle
    @side(server)
    function GetThrottle(): number
    --- Returns the vehicle class name. This is only useful for Sandbox spawned vehicles or any vehicle that properly sets the vehicle class with `Vehicle:SetVehicleClass`.
    --- @return string The class name of the vehicle.
    @side(shared)
    function GetVehicleClass(): string
    --- Returns the vehicle parameters of given vehicle.
    --- @return VehicleParams The vehicle parameters.
    @side(server)
    function GetVehicleParams(): VehicleParams
    --- Returns the view position and forward angle of a given passenger seat.
    --- @param role The passenger role. 0 is the driver. This parameter seems to be ignored by the game engine and is therefore optional.
    --- @return Vector The view position, will be 0, 0, 0 on failure
    --- @return Angle The view angles, will be 0, 0, 0 on failure
    --- @return number The field of view, will be 0 on failure
    @side(shared)
    function GetVehicleViewPosition(role: number | nil): (Vector, Angle, number)
    --- Returns the `PhysObj` of given wheel.
    --- @param wheel The wheel to retrieve
    --- @return PhysObj The wheel
    @side(server)
    function GetWheel(wheel: number): PhysObj
    --- Returns the base wheel height.
    --- @param wheel The wheel to get the base wheel height of.
    --- @return number The base wheel height.
    @side(server)
    function GetWheelBaseHeight(wheel: number): number
    --- Returns the wheel contact point.
    --- @param wheel The wheel to check
    --- @return Vector The contact position
    --- @return number The Surface Properties ID of hit surface.
    --- @return boolean Whether the wheel is on ground or not
    @side(server)
    function GetWheelContactPoint(wheel: number): (Vector, number, boolean)
    --- Returns the wheel count of the vehicle
    --- @return number The amount of wheels
    @side(server)
    function GetWheelCount(): number
    --- Returns the total wheel height.
    --- @param wheel The wheel to get the base wheel height of.
    --- @return number The total wheel height.
    @side(server)
    function GetWheelTotalHeight(wheel: number): number
    --- Returns whether this vehicle has boost at all.
    --- @return boolean Whether this vehicle has boost at all.
    @side(server)
    function HasBoost(): boolean
    --- Returns whether this vehicle has a brake pedal. See `Vehicle:SetHasBrakePedal`.
    --- @return boolean Whether this vehicle has a brake pedal or not.
    @side(server)
    function HasBrakePedal(): boolean
    --- Returns whether this vehicle is currently boosting or not.
    --- @return boolean Whether this vehicle is currently boosting or not.
    @side(server)
    function IsBoosting(): boolean
    --- Returns whether the engine is enabled or not, i.e. whether it can be started.
    --- @return boolean Whether the engine is enabled
    @side(server)
    function IsEngineEnabled(): boolean
    --- Returns whether the engine is started or not.
    --- @return boolean Whether the engine is started or not.
    @side(server)
    function IsEngineStarted(): boolean
    --- Determines whether a given `Vehicle` is fully initialized.
    --- It is possible, in uncommon circumstances, for a `valid` `vehicle` entity to be in an invalid state, such as before `Entity:Spawn` is called on the vehicle after creation.
    --- If this function returns `false`, then the `Vehicle` functions are not usable on this vehicle, while `Entity` functions are.
    --- @return boolean `true` if the Vehicle is in a valid state, or `false` if the Vehicle is in an invalid state.
    @side(shared)
    function IsValidVehicle(): boolean
    --- Returns whether this vehicle's engine is underwater or not. ( Internally the attachment point "engine" or "vehicle_engine" is checked )
    --- @return boolean Whether this vehicle's engine is underwater or not.
    @side(server)
    function IsVehicleBodyInWater(): boolean
    --- Releases the vehicle's handbrake (Jeep) so it can roll without any passengers.
    --- This will be overwritten if the vehicle has a driver. Same as `Vehicle:SetHandbrake`( false )
    @side(server)
    function ReleaseHandbrake(): nil
    --- Sets the boost. It is possible that this function does not work while the vehicle has a valid driver in it.
    --- @param boost The new boost value
    @side(server)
    function SetBoost(boost: number): nil
    --- Sets the third person camera distance of the vehicle.
    --- @param distance Camera distance to set to
    @side(shared)
    function SetCameraDistance(distance: number): nil
    --- Turns on or off the Jeep handbrake so it can roll without a driver inside.
    --- Does nothing while the vehicle has a driver in it.
    --- @param handbrake true to turn on, false to turn off.
    @side(server)
    function SetHandbrake(handbrake: boolean): nil
    --- Sets whether this vehicle has a brake pedal.
    --- @param brakePedal Whether this vehicle has a brake pedal
    @side(server)
    function SetHasBrakePedal(brakePedal: boolean): nil
    --- Sets maximum reverse throttle
    --- @param maxRevThrottle The new maximum throttle. This number must be negative.
    @side(server)
    function SetMaxReverseThrottle(maxRevThrottle: number): nil
    --- Sets maximum forward throttle
    --- @param maxThrottle The new maximum throttle.
    @side(server)
    function SetMaxThrottle(maxThrottle: number): nil
    --- Sets spring length of given wheel
    --- @param wheel The wheel to change spring length of
    --- @param length The new spring length
    @side(server)
    function SetSpringLength(wheel: number, length: number): nil
    --- Sets the steering of the vehicle.
    --- The correct range, 0 to 1 or -1 to 1
    --- @param front Angle of the front wheels (-1 to 1)
    --- @param rear Angle of the rear wheels (-1 to 1)
    @side(server)
    function SetSteering(front: number, rear: number): nil
    --- Sets the maximum steering degrees of the vehicle
    --- @param steeringDegrees The new maximum steering degree
    @side(server)
    function SetSteeringDegrees(steeringDegrees: number): nil
    --- Sets the third person mode state.
    --- @param enable Enable or disable the third person mode for this vehicle
    @side(shared)
    function SetThirdPersonMode(enable: boolean): nil
    --- Sets the throttle of the vehicle. It is possible that this function does not work with a valid driver in it.
    --- @param throttle The new throttle.
    @side(server)
    function SetThrottle(throttle: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the vehicle class name.
    --- @param class_ The vehicle class name to set
    @side(shared)
    function SetVehicleClass(class_: string): nil
    --- Sets whether the entry or exit camera animation should be played or not.
    --- @param bOn Whether the entry or exit camera animation should be played or not.
    @side(server)
    function SetVehicleEntryAnim(bOn: boolean): nil
    --- Sets the vehicle parameters for given vehicle.
    --- **NOTE**: Not all variables from the `Structures/VehicleParams` can be set.
    --- @param params The new new vehicle parameters. See Structures/VehicleParams.
    @side(server)
    function SetVehicleParams(params: { [any]: any }): nil
    --- Sets friction of given wheel.  This function may be broken.
    --- @param wheel The wheel to change the friction of
    --- @param friction The new friction to set
    @side(server)
    function SetWheelFriction(wheel: number, friction: number): nil
    --- Starts or stops the engine.
    --- @param start True to start, false to stop.
    @side(server)
    function StartEngine(start: boolean): nil
end

--- A 4x4 matrix.
--- This page lists all possible functions to manipulate matrices.
--- This object can be created by `Global.Matrix`.
--- Metamethod | Second Operand | Description
--- ---------- | -------------- | -----------
--- `__add` | `VMatrix` | Returns new `VMatrix` with the result of addition.
--- `__eq` | `any` | Compares 2 operands, if they both are `VMatrix`, compares each individual component.
--- `__mul` | `VMatrix` or `Vector` | Returns new `VMatrix` or `Vector` with the result of multiplication.
--- `__sub` | `VMatrix` | Returns new `VMatrix` with the result of subtraction.
--- `__tostring` |  | Returns a `string` in format `[%f,\t%f,\t%f,\t%f]\n[%f,\t%f,\t%f,\t%f]\n[%f,\t%f,\t%f,\t%f]\n[%f,\t%f,\t%f,\t%f]`.
--- `__unm` | | Returns new `VMatrix` with the result of negation.
declare class VMatrix
    --- Adds given matrix to this matrix.
    --- @param input The input matrix to add.
    @side(shared)
    function Add(input: VMatrix): nil
    --- Returns the absolute rotation of the matrix. Scaled matrix might produce unexpected results!
    --- @return Angle Absolute rotation of the matrix
    @side(shared)
    function GetAngles(): Angle
    --- Returns a specific field in the matrix.
    --- @param row Row of the field whose value is to be retrieved, from 1 to 4
    --- @param column Column of the field whose value is to be retrieved, from 1 to 4
    --- @return number The value of the specified field
    @side(shared)
    function GetField(row: number, column: number): number
    --- Gets the forward direction of the matrix.
    --- ie. The first column of the matrix, excluding the w coordinate.
    --- @return Vector The forward direction of the matrix.
    @side(shared)
    function GetForward(): Vector
    --- Returns an inverted matrix without modifying the original matrix.
    --- Inverting the matrix will fail if its [determinant](https://en.wikipedia.org/wiki/Determinant) is 0 or close to 0. (ie. its "scale" in any direction is 0.)
    --- See also `VMatrix:GetInverseTR`.
    --- @return VMatrix The inverted matrix if possible, nil otherwise
    @side(shared)
    function GetInverse(): VMatrix
    --- Returns an inverted matrix without modifying the original matrix. This function will not fail, but only works correctly on matrices that contain only translation and/or rotation.
    --- Using this function on a matrix with modified scale may return an incorrect inverted matrix.
    --- To get the inverse of a matrix that contains other modifications, see `VMatrix:GetInverse`.
    --- @return VMatrix The inverted matrix.
    @side(shared)
    function GetInverseTR(): VMatrix
    --- Gets the right direction of the matrix.
    --- ie. The second column of the matrix, negated, excluding the w coordinate.
    --- @return Vector The right direction of the matrix.
    @side(shared)
    function GetRight(): Vector
    --- Returns the absolute scale of the matrix.
    --- @return Vector Absolute scale of the matrix
    @side(shared)
    function GetScale(): Vector
    --- Returns the absolute translation of the matrix.
    --- @return Vector Absolute translation of the matrix
    @side(shared)
    function GetTranslation(): Vector
    --- Returns the transpose (each row becomes a column) of this matrix.
    --- @return VMatrix The transposed matrix.
    @side(shared)
    function GetTransposed(): VMatrix
    --- Gets the up direction of the matrix.
    --- ie. The third column of the matrix, excluding the w coordinate.
    --- @return Vector The up direction of the matrix.
    @side(shared)
    function GetUp(): Vector
    --- Initializes the matrix as Identity matrix.
    @side(shared)
    function Identity(): nil
    --- Inverts the matrix.
    --- Inverting the matrix will fail if its [determinant](https://en.wikipedia.org/wiki/Determinant) is 0 or close to 0. (ie. its "scale" in any direction is 0.)
    --- If the matrix cannot be inverted, it does not get modified.
    --- See also `VMatrix:InvertTR`.
    --- @return boolean Whether the matrix was inverted or not
    @side(shared)
    function Invert(): boolean
    --- Quickly inverts the matrix. This function will not fail, but only works correctly on matrices that contain only translation and/or rotation.
    --- Using this function on a matrix with modified scale may return an incorrect inverted matrix.
    --- To invert a matrix that contains other modifications, see `VMatrix:Invert`. This function is faster.
    @side(shared)
    function InvertTR(): nil
    --- Returns whether the matrix is equal to Identity matrix or not.
    --- @return boolean Is the matrix an Identity matrix or not
    @side(shared)
    function IsIdentity(): boolean
    --- Returns whether the matrix is a rotation matrix or not.
    --- Technically it checks if the forward, right and up vectors are orthogonal and normalized.
    --- @return boolean Is the matrix a rotation matrix or not
    @side(shared)
    function IsRotationMatrix(): boolean
    --- Checks whenever all fields of the matrix are 0, aka if this is a [null matrix](https://en.wikipedia.org/wiki/Zero_matrix).
    --- @return boolean If the matrix is a null matrix.
    @side(shared)
    function IsZero(): boolean
    --- Multiplies this matrix by given matrix.
    --- @param input The input matrix to multiply by.
    @side(shared)
    function Mul(input: VMatrix): nil
    --- Rotates the matrix by the given angle.
    --- Postmultiplies the matrix by a rotation matrix (A = AR).
    --- @param rotation Rotation.
    @side(shared)
    function Rotate(rotation: Angle): nil
    --- Scales the matrix by the given vector.
    --- Postmultiplies the matrix by a scaling matrix (A = AS).
    --- @param scale Vector to scale with matrix with.
    @side(shared)
    function Scale(scale: Vector): nil
    --- Scales the absolute translation with the given value.
    --- @param scale Value to scale the translation with.
    @side(shared)
    function ScaleTranslation(scale: number): nil
    --- Copies values from the given matrix object.
    --- @param src The matrix to copy values from.
    @side(shared)
    function Set(src: VMatrix): nil
    --- Sets the absolute rotation of the matrix.
    --- @param angle New angles.
    @side(shared)
    function SetAngles(angle: Angle): nil
    --- Sets a specific field in the matrix.
    --- @param row Row of the field to be set, from 1 to 4
    --- @param column Column of the field to be set, from 1 to 4
    --- @param value The value to set in that field
    @side(shared)
    function SetField(row: number, column: number, value: number): nil
    --- Sets the forward direction of the matrix.
    --- ie. The first column of the matrix, excluding the w coordinate.
    --- @param forward The forward direction of the matrix.
    @side(shared)
    function SetForward(forward: Vector): nil
    --- Sets the right direction of the matrix.
    --- ie. The second column of the matrix, negated, excluding the w coordinate.
    --- @param right The right direction of the matrix.
    @side(shared)
    function SetRight(right: Vector): nil
    --- Modifies the scale of the matrix while preserving the rotation and translation.
    --- @param scale The scale to set.
    @side(shared)
    function SetScale(scale: Vector): nil
    --- Sets the absolute translation of the matrix.
    --- @param translation New translation.
    @side(shared)
    function SetTranslation(translation: Vector): nil
    --- Sets each component of the matrix.
    @side(shared)
    function SetUnpacked(e11: number, e12: number, e13: number, e14: number, e21: number, e22: number, e23: number, e24: number, e31: number, e32: number, e33: number, e34: number, e41: number, e42: number, e43: number, e44: number): nil
    --- Sets the up direction of the matrix.
    --- ie. The third column of the matrix, excluding the w coordinate.
    --- @param up The up direction of the matrix.
    @side(shared)
    function SetUp(up: Vector): nil
    --- Subtracts given matrix from this matrix.
    --- @param input The input matrix to subtract.
    @side(shared)
    function Sub(input: VMatrix): nil
    --- Converts the matrix to a 4x4 table. See `Global.Matrix` function.
    --- @return { [any]: any } The 4x4 table.
    @side(shared)
    function ToTable(): { [any]: any }
    --- Translates the matrix by the given vector aka. adds the vector to the translation.
    --- Postmultiplies the matrix by a translation matrix (A = AT).
    --- @param translation Vector to translate the matrix by.
    @side(shared)
    function Translate(translation: Vector): nil
    --- Returns each component of the matrix, expanding rows before columns.
    --- @return number VMatrix:GetField(1, 1)
    --- @return number VMatrix:GetField(1, 2)
    --- @return number VMatrix:GetField(1, 3)
    --- @return number VMatrix:GetField(1, 4)
    --- @return number VMatrix:GetField(2, 1)
    --- @return number VMatrix:GetField(2, 2)
    --- @return number VMatrix:GetField(2, 3)
    --- @return number VMatrix:GetField(2, 4)
    --- @return number VMatrix:GetField(3, 1)
    --- @return number VMatrix:GetField(3, 2)
    --- @return number VMatrix:GetField(3, 3)
    --- @return number VMatrix:GetField(3, 4)
    --- @return number VMatrix:GetField(4, 1)
    --- @return number VMatrix:GetField(4, 2)
    --- @return number VMatrix:GetField(4, 3)
    --- @return number VMatrix:GetField(4, 4)
    @side(shared)
    function Unpack(): (number, number, number, number, number, number, number, number, number, number, number, number, number, number, number, number)
    --- Sets all components of the matrix to 0, also known as a [null matrix](https://en.wikipedia.org/wiki/Zero_matrix).
    --- This function is more efficient than setting each element manually.
    @side(shared)
    function Zero(): nil
end

--- This is a list of all methods only available for weapons. It is also possible to call `Entity` functions on weapons.
--- **NOTE**: A list of available methods has been expanded in your navigation bar.
declare class Weapon extends Entity
    --- Returns whether the weapon allows to being switched from when a better ( `Weapon:GetWeight` ) weapon is being picked up.
    --- @return boolean Whether the weapon allows to being switched from.
    @side(shared)
    function AllowsAutoSwitchFrom(): boolean
    --- Returns whether the weapon allows to being switched to when a better (`Weapon:GetWeight`) weapon is being picked up.
    --- @return boolean Whether the weapon allows to being switched to.
    @side(shared)
    function AllowsAutoSwitchTo(): boolean
    --- Calls a SWEP function on client. Does nothing on client.
    --- **WARNING**: This uses the `usermessage` internally, because of that, the combined length of the arguments of this function may not exceed 254 bytes/characters or the function will cease to function!
    --- @param functionName Name of function to call. If you want to call `SWEP:MyFunc()` on client, you type in `"MyFunc"`
    --- @param data Custom data to be passed to the target SWEP function as the first argument.
    @side(shared)
    function CallOnClient(functionName: string, data: string | nil): nil
    --- Returns how much primary ammo is in the magazine.
    --- **NOTE**: This is not shared between clients and will instead return the maximum primary clip size.
    --- @return number The amount of primary ammo in the magazine.
    @side(shared)
    function Clip1(): number
    --- Returns how much secondary ammo is in the magazine.
    --- **NOTE**: This is not shared between clients and will instead return the maximum secondary clip size.
    --- @return number The amount of secondary ammo in the magazine.
    @side(shared)
    function Clip2(): number
    --- Forces the weapon to reload while playing given animation.
    --- **NOTE**: This will stop the `Weapon:Think` function from getting called while the weapon is reloading!
    --- @param act Sequence to use as reload animation. Uses the Enums/ACT.
    --- @return boolean Did reloading actually take place
    @side(shared)
    function DefaultReload(act: number): boolean
    --- Returns the sequence enumeration number that the weapon is playing.
    --- This can return inconsistent results between the server and client.
    --- @return number Current activity, see Enums/ACT. Returns 0 if the weapon doesn't have active sequence.
    @side(shared)
    function GetActivity(): number
    --- Returns the weapon deploy speed, as set by `Weapon:SetDeploySpeed`. If not previously set, the value will be polled from the `sv_defaultdeployspeed` `ConVar`.
    --- @return number The value to set deploy speed to.
    @side(shared)
    function GetDeploySpeed(): number
    --- Returns the hold type of the weapon.
    --- @return string The hold type of the weapon. You can find a list of default hold types Hold_Types.
    @side(shared)
    function GetHoldType(): string
    --- Returns maximum primary clip size
    --- @return number Maximum primary clip size
    @side(shared)
    function GetMaxClip1(): number
    --- Returns maximum secondary clip size
    --- @return number Maximum secondary clip size
    @side(shared)
    function GetMaxClip2(): number
    --- Gets the next time the weapon can primary fire. ( Can call `WEAPON:PrimaryAttack` )
    --- @return number The time, relative to Global.CurTime
    @side(shared)
    function GetNextPrimaryFire(): number
    --- Gets the next time the weapon can secondary fire. ( Can call `WEAPON:SecondaryAttack` )
    --- @return number The time, relative to Global.CurTime
    @side(shared)
    function GetNextSecondaryFire(): number
    --- Gets the primary ammo type of the given weapon.
    --- @return number The ammo type ID, or -1 if not found.
    @side(shared)
    function GetPrimaryAmmoType(): number
    --- Returns the non-internal name of the weapon, that should be for displaying.
    --- **NOTE**: If that returns an untranslated message (#HL2_XX), use `language.GetPhrase` to see the "nice" name.
    --- **NOTE**: If SWEP.PrintName is not set in the Weapon or the Weapon Base then "" will be returned.
    --- @return string The "nice" name of the weapon.
    @side(shared)
    function GetPrintName(): string
    --- Gets the ammo type of the given weapons secondary fire.
    --- @return number The secondary ammo type ID, or -1 if not found.
    @side(shared)
    function GetSecondaryAmmoType(): number
    --- Returns the slot of the weapon.
    --- **NOTE**: The slot numbers start from 0.
    --- @return number The slot of the weapon.
    @side(shared)
    function GetSlot(): number
    --- Returns slot position of the weapon
    --- @return number The slot position of the weapon
    @side(shared)
    function GetSlotPos(): number
    --- Returns the view model of the weapon.
    --- @return string The view model of the weapon.
    @side(shared)
    function GetWeaponViewModel(): string
    --- Returns the world model of the weapon.
    --- @return string The world model of the weapon.
    @side(shared)
    function GetWeaponWorldModel(): string
    --- Returns the "weight" of the weapon, which is used when deciding which `Weapon` is better by the engine.
    --- @return number The weapon "weight".
    @side(shared)
    function GetWeight(): number
    --- Returns whether the weapon has ammo left or not. It will return false when there's no ammo left in the magazine **and** when there's no reserve ammo left.
    --- **NOTE**: This will return true for weapons like crowbar, gravity gun, etc.
    --- @return boolean Whether the weapon has ammo or not.
    @side(shared)
    function HasAmmo(): boolean
    --- Returns whenever the weapon is carried by the local player.
    --- @return boolean Is the weapon is carried by the local player or not
    @side(client)
    function IsCarriedByLocalPlayer(): boolean
    --- Checks if the weapon is a SWEP or a built-in weapon.
    --- @return boolean Returns true if weapon is scripted ( SWEP ), false if not ( A built-in HL2/HL:S weapon )
    @side(shared)
    override function IsScripted(): boolean
    --- Returns whether the weapon is visible. The term visibility is not exactly what gets checked here, first it checks if the owner is a player, then checks if the active view model has EF_NODRAW flag NOT set.
    --- @return boolean Is visible or not
    @side(shared)
    function IsWeaponVisible(): boolean
    --- Returns the time since this weapon last fired a bullet with `Entity:FireBullets` in seconds. It is not networked.
    --- @return number The time in seconds when the last bullet was fired.
    @side(shared)
    function LastShootTime(): number
    --- Forces weapon to play activity/animation.
    --- @param act Activity to play. See the Enums/ACT (specifically `ACT_VM_`).
    @side(shared)
    function SendWeaponAnim(act: number): nil
    --- Sets the activity the weapon is playing.
    --- See also `Weapon:GetActivity`.
    --- @param act The new activity to set, see Enums/ACT.
    @side(shared)
    function SetActivity(act: number): nil
    --- Lets you change the number of bullets in the given weapons primary clip.
    --- @param ammo The amount of bullets the clip should contain
    @side(shared)
    function SetClip1(ammo: number): nil
    --- Lets you change the number of bullets in the given weapons secondary clip.
    --- @param ammo The amount of bullets the clip should contain
    @side(shared)
    function SetClip2(ammo: number): nil
    --- Sets the weapon deploy speed. This value needs to match on client and server.
    --- @param speed The value to set deploy speed to. Values less than `1` will slow down the animations. Minimum value is `0.1`.
    @side(shared)
    function SetDeploySpeed(speed: number): nil
    --- Sets the hold type of the weapon. This function also calls `WEAPON:SetWeaponHoldType` and properly networks it to all clients.
    --- **NOTE**: This only works on scripted weapons.
    --- Using this function on weapons held by bots will not network holdtype changes to clients if the world model is set to an empty string (SWEP.WorldModel = "").
    --- @param name Name of the hold type. You can find all default hold types Hold_Types
    @side(shared)
    function SetHoldType(name: string): nil
    --- Sets the time since this weapon last fired in seconds. Used in conjunction with `Weapon:LastShootTime`.
    --- This value is **not** networked to the client if set from server.
    --- @param time The time in seconds when the last time the weapon was fired.
    @side(shared)
    function SetLastShootTime(time: number | nil): nil
    --- Sets when the weapon can fire again. Time should be based on `Global.CurTime`.
    --- **NOTE**: The standard HL2 Pistol (`weapon_pistol`) bypasses this function due to an [internal implementation](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/hl2/weapon_pistol.cpp#L313-L317).
    --- This will fire extra bullets if the time is set to less than `Global.CurTime`.
    --- @param time Time when player should be able to use primary fire again
    @side(shared)
    function SetNextPrimaryFire(time: number): nil
    --- Sets when the weapon can alt-fire again. Time should be based on `Global.CurTime`.
    --- @param time Time when player should be able to use secondary fire again
    @side(shared)
    function SetNextSecondaryFire(time: number): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- This object is created by `Global.WorkshopFileBase` which is used internally to fetch data of the specific namespace
--- or to publish saves and dupes.
--- This also exists on the Server but most functions may throw an error. It's meant to be used clientside.
--- **NOTE**: You need to set the `HTML` field to a `DHTML` panel that is set up correctly like [here](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenttypes/dupes.lua#L12), or else you might get errors.
declare class WorkshopFileBase
    --- Fetches all subscriptions for the set namespace and type
    --- **NOTE**: If you want to use the type `local` you need to implement the `:FetchLocal(offset, perpage)` function!
    --- @param type The type to search for. (`local`, `subscribed`, `subscribed_ugc`, `mine`, `favorite`)
    --- @param offset Skips the first x results.
    --- @param perpage How many results per page should be returned.
    --- @param extratags additional tags to filter the results.
    --- @param searchText text that needs to be in the addon title. Use an empty string for none
    --- @param filter The filter for the results. (`enabledonly`, `disabledonly`)
    --- @param sort How it should be sorted. If set to `nil`, it will fallback to `timeadded`. (`title`, `size`, `updated`)
    @side(shared)
    function Fetch(type: string, offset: number, perpage: number, extratags: { [any]: any }, searchText: string, filter: number | nil, sort: string | nil): nil
    --- Fetches all subscriptions for the set namespace and passes the result to `WorkshopFileBase:FillFileInfo`.
    --- @param offset Skips the first x results.
    --- @param perpage How many results per page should be returned.
    --- @param tags additional tags to filter the results.
    --- @param searchText text that needs to be in the addon title. Use an empty string for none
    --- @param isUGC if true it will use engine.GetUserContent instead of engine.GetAddons
    --- @param filter The filter for the results. (`enabledonly`, `disabledonly`)
    --- @param sort How it should be sorted. If set to `nil`, it will fallback to `timeadded`. (`title`, `size`, `updated`)
    @side(shared)
    function FetchSubscribed(offset: number, perpage: number, tags: { [any]: any }, searchText: string, isUGC: boolean | nil, filter: number | nil, sort: string | nil): nil
    --- Updates the set HTML panel with the newly fetched results
    --- @param results The type to search for. (`local`, `subscribed`, `subscribed_ugc`, `mine`, `favorite`)
    --- @param isUGC Skips the first x results.
    @side(shared)
    function FillFileInfo(results: { [any]: any }, isUGC: boolean): nil
    --- Creates a `UGCPublishWindow` to publish the dupe or save
    --- @param filename The type to search for. (`local`, `subscribed`, `subscribed_ugc`, `mine`, `favorite`)
    --- @param image The image to use
    @side(shared)
    function Publish(filename: string, image: string): nil
    --- Retrieves the username for the given SteamID.
    --- @param steamid SteamID to retrieve the name for
    --- @param callback Callback function. Function argument(s): * string `name` - The retrieved name
    @side(shared)
    function RetrieveUserName(steamid: string, callback: (string) -> any): nil
end

--- Used to show an icon for any of the [Garry's Mod Steam achievements](http://steamcommunity.com/stats/GarrysMod/achievements).
--- If the viewer has not unlocked the achievement on Steam, the icon will be grayed out.
declare class AchievementIcon extends Panel
end

--- Used to show a player's Steam avatar. You are recommended but not limited to pick one of the following sizes: 16, 32, 64, 84, 128, 184.
declare class AvatarImage extends Panel
end

--- Base panel for elements using the [Awesomium](http://www.awesomium.com) UI engine.
--- **NOTE**: On the `x86-64` beta this panel isn't actually Awesomium, its the same as `HTML` (`HtmlPanel`)
declare class Awesomium extends Panel
end

--- A standard Derma text label. A lot of this panels functionality is a base for button elements, such as `DButton`
declare class DLabel extends Panel
    --- Called just before `DLabel:DoClick`.
    --- In `DLabel` does nothing and is safe to override. Used by `DMenuOption` and `DCollapsibleCategory`'s tabs.
    @side(client)
    function DoClickInternal(): nil
    --- Called just before `DLabel:DoDoubleClick`. In `DLabel` does nothing and is safe to override.
    @side(client)
    function DoDoubleClickInternal(): nil
    --- Returns whether the label stretches vertically or not.
    --- Set by `DLabel:SetAutoStretchVertical`.
    --- @return boolean Whether the label stretches vertically or not.
    @side(client)
    function GetAutoStretchVertical(): boolean
    --- Returns whether the `DLabel` should set its text color to the current skin's bright text color.
    --- See `DLabel:SetBright`.
    @side(client)
    function GetBright(): boolean
    --- Returns the actual color of the text.
    --- See also `DLabel:GetTextColor` and `DLabel:GetTextStyleColor`.
    --- @return Color The the actual Color of the text.
    @side(client)
    function GetColor(): Color
    --- Returns whether the `DLabel` should set its text color to the current skin's dark text color.
    --- See `DLabel:SetDark`.
    @side(client)
    function GetDark(): boolean
    --- Gets the disabled state of the `DLabel`. This is set with `DLabel:SetDisabled`.
    --- @return boolean The disabled state of the label.
    --- @deprecated Use Panel:IsEnabled instead.
    @side(client)
    function GetDisabled(): boolean
    --- Returns whether or not double clicking will call `DLabel:DoDoubleClick`.
    --- See `DLabel:SetDoubleClickingEnabled`.
    --- @return boolean true = enabled, false means disabled
    @side(client)
    function GetDoubleClickingEnabled(): boolean
    --- Returns whether or not the panel background is being drawn. Alias of `DLabel:GetPaintBackground`.
    --- @return boolean True if the panel background is drawn, false otherwise.
    --- @deprecated You should use DLabel:GetPaintBackground instead.
    @side(client)
    function GetDrawBackground(): boolean
    --- Returns the current font of the DLabel. This is set with `DLabel:SetFont`.
    --- @return string The name of the font in use.
    @side(client)
    override function GetFont(): string
    --- Returns whether the `DLabel` should set its text color to the current skin's highlighted text color.
    --- See `DLabel:SetHighlight`.
    @side(client)
    function GetHighlight(): boolean
    --- Used internally by `DComboBox`.
    --- Returns whether the frame is part of a derma menu or not.
    --- If this is `true`, `Global.CloseDermaMenus` will not be called when the frame is clicked, and thus any open menus will remain open.
    --- @return boolean Whether this panel is a Menu Component
    @side(client)
    function GetIsMenu(): boolean
    --- Returns whether the toggle functionality is enabled for a label. Set with `DLabel:SetIsToggle`.
    --- @return boolean Whether or not toggle functionality is enabled.
    @side(client)
    function GetIsToggle(): boolean
    --- Returns whether or not the background should be painted.
    --- @return boolean If the background is painted or not
    @side(client)
    function GetPaintBackground(): boolean
    --- Returns the "override" text color, set by `DLabel:SetTextColor`.
    --- @return Color The Color of the text, or nil.
    @side(client)
    function GetTextColor(): Color
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Returns the "internal" or fallback color of the text.
    --- See also `DLabel:GetTextColor` and `DLabel:SetTextStyleColor`.
    --- @return Color The "internal" Color of the text
    @side(client)
    function GetTextStyleColor(): Color
    --- Returns the current toggle state of the label. This can be set with `DLabel:SetToggle` and toggled with `DLabel:Toggle`.
    --- In order to use toggle functionality, you must first call `DLabel:SetIsToggle` with `true`, as it is disabled by default.
    --- @return boolean The current toggle state.
    @side(client)
    function GetToggle(): boolean
    --- Automatically adjusts the height of the label dependent of the height of the text inside of it.
    --- @param stretch Whenever to stretch the label vertically or not.
    @side(client)
    function SetAutoStretchVertical(stretch: boolean): nil
    --- Sets the color of the text to the bright text color defined in the skin.
    --- Disables `DLabel:SetDark`. Gets overridden by `DLabel:SetHighlight`.
    --- You should only consider using this if you are using background elements that are not manually painted and are using the skin colors. Otherwise use `DLabel:SetTextColor`.
    --- @param bright Whenever to set the text to bright or not.
    @side(client)
    function SetBright(bright: boolean): nil
    --- Changes color of label. Alias of `DLabel:SetTextColor`.
    --- @param color The color to set. Uses Color.
    @side(client)
    function SetColor(color: Color): nil
    --- Sets the color of the text to the dark text color defined in the skin.
    --- Disables `DLabel:SetBright`. Gets overridden by `DLabel:SetHighlight`.
    --- You should only consider using this if you are using background elements that are not manually painted and are using the skin colors. Otherwise use `DLabel:SetTextColor`.
    --- @param dark Whenever to set the text to dark or not.
    @side(client)
    function SetDark(dark: boolean): nil
    --- Sets the disabled state of the `DLabel`.
    --- When disabled, the label does not respond to click, toggle or drag & drop actions.
    --- @param disable `true` to disable the DLabel, `false` to enable it.
    --- @deprecated Use Panel:SetEnabled instead.
    @side(client)
    function SetDisabled(disable: boolean): nil
    --- Sets whether or not double clicking should call `DLabel:DoDoubleClick`.
    --- This is enabled by default.
    --- @param enable true to enable, false to disable
    @side(client)
    function SetDoubleClickingEnabled(enable: boolean): nil
    --- Sets whether or not to draw the panel background. Alias of `DLabel:SetPaintBackground`.
    --- @param draw True to show the panel's background, false to hide it.
    --- @deprecated You should use DLabel:SetPaintBackground instead.
    @side(client)
    function SetDrawBackground(draw: boolean): nil
    --- Sets the font of the label.
    --- @param fontName The name of the font. See Default_Fonts for a list of existing fonts. Alternatively, use surface.CreateFont to create your own custom font.
    @side(client)
    function SetFont(fontName: string): nil
    --- Sets the color of the text to the highlight text color defined in the skin.
    --- For the default Derma skin this makes the label red.
    --- Overrides colors set by both `DLabel:SetBright` and `DLabel:SetDark` while active.
    --- You should only consider using this if you are using background elements that are not manually painted and are using the skin colors. Otherwise use `DLabel:SetTextColor`.
    --- @param highlight true to set the label's color to skins's text highlight color, false otherwise.
    @side(client)
    function SetHighlight(highlight: boolean): nil
    --- Used internally by `DComboBox`.
    --- Sets whether the frame is part of a derma menu or not.
    --- If this is set to `true`, `Global.CloseDermaMenus` will not be called when the frame is clicked, and thus any open menus will remain open.
    --- @param isMenu Whether this pane is a Menu Component
    @side(client)
    function SetIsMenu(isMenu: boolean): nil
    --- Enables or disables toggle functionality for a label. Retrieved with `DLabel:GetIsToggle`.
    --- You must call this before using `DLabel:SetToggle`, `DLabel:GetToggle` or `DLabel:Toggle`.
    --- @param allowToggle Whether or not to enable toggle functionality.
    @side(client)
    function SetIsToggle(allowToggle: boolean): nil
    --- Sets whether or not the background should be painted. This is mainly used by derivative classes, such as `DButton`.
    @side(client)
    function SetPaintBackground(paint: boolean): nil
    --- Sets the text color of the `DLabel`. This will take precedence over `DLabel:SetTextStyleColor`.
    --- @param color The text color. Uses Color.
    @side(client)
    function SetTextColor(color: Color): nil
    --- **INTERNAL**: Use `DLabel:SetTextColor` instead!
    --- Used by `DLabel:SetDark`, `DLabel:SetBright` and `DLabel:SetHighlight` to set the text color without affecting `DLabel:SetTextColor` calls.
    --- @param color The text color. Uses the Color.
    @side(client)
    function SetTextStyleColor(color: Color): nil
    --- Sets the toggle state of the label. This can be retrieved with `DLabel:GetToggle` and toggled with `DLabel:Toggle`.
    --- In order to use toggle functionality, you must first call `DLabel:SetIsToggle` with `true`, as it is disabled by default.
    --- @param toggleState The toggle state to be set.
    @side(client)
    function SetToggle(toggleState: boolean): nil
    --- Toggles the label's state. This can be set and retrieved with `DLabel:SetToggle` and `DLabel:GetToggle`.
    --- In order to use toggle functionality, you must first call `DLabel:SetIsToggle` with `true`, as it is disabled by default.
    @side(client)
    function Toggle(): nil
    --- A hook called from within `PANEL:ApplySchemeSettings` to determine the color of the text on display.
    --- @param skin A table supposed to contain the color values listed above.
    @side(client)
    function UpdateColours(skin: { [any]: any }): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called internally to update the color of the text.
    @side(client)
    function UpdateFGColor(): nil
end

--- A standard Derma button.
--- By default, a `DButton` is 22px tall.
declare class DButton extends DLabel
    --- An `Global.AccessorFunc` that returns value set by `DButton:SetDrawBorder`. See that page for more info.
    --- @return boolean value set by DButton:SetDrawBorder.
    @side(client)
    function GetDrawBorder(): boolean
    --- Returns true if the DButton is currently depressed (a user is clicking on it).
    --- @return boolean Whether or not the button is depressed.
    @side(client)
    function IsDown(): boolean
    --- Sets a console command to be called when the button is clicked.
    --- This overrides the button's `DoClick` method.
    --- @param command The console command to be called.
    --- @param args The arguments for the command.
    @side(client)
    function SetConsoleCommand(command: string, args: string | nil): nil
    --- Does absolutely nothing at all. Default value is automatically set to true.
    --- @param draw Does nothing.
    @side(client)
    function SetDrawBorder(draw: boolean): nil
    --- Sets an image to be displayed as the button's background. Alias of `DButton:SetImage`
    --- @param img The image file to use, relative to `/materials`. If this is nil, the image background is removed.
    @side(client)
    function SetIcon(img: string | nil): nil
    --- Sets an image to be displayed as the button's background.
    --- See `DButton:SetMaterial` for equivalent function that uses `IMaterial` instead.
    --- Also see: `DImageButton`
    --- @param img The image file to use, relative to the `materials/` folder. Can be set to `nil` to remove the image background.
    @side(client)
    function SetImage(img: string | nil): nil
    --- Sets an image to be displayed as the button's background.
    --- See `DButton:SetImage` for equivalent function that uses file paths instead. Also see `DImageButton`.
    --- @param img The material to use. If this is nil, the image background is removed.
    @side(client)
    function SetMaterial(img: IMaterial | nil): nil
    --- A hook called from within `DLabel`'s `PANEL:ApplySchemeSettings` to determine the color of the text on display.
    --- @param skin A table supposed to contain the color values listed above.
    @side(client)
    override function UpdateColours(skin: { [any]: any }): nil
end

--- Creates a button that players can click on.
--- [View source](https://github.com/Facepunch/garrysmod/blob/dfdafba0f04e75be122961291a56d9c1714a3d8a/garrysmod/lua/vgui/dbutton.lua#L181-L193)
declare class Button extends DButton
end

--- **INTERNAL**: Use `DCheckBoxLabel` instead.
--- Engine checkbox
declare class CheckButton extends Panel
end

--- An editable `DLabel`, double click on it to edit.
--- This is used in the spawnmenu spawnlist headers.
declare class DLabelEditable extends DLabel
    --- Returns whether the editable label will stretch to the text entered or not.
    --- @return boolean Whether the editable label will stretch to the text entered or not.
    @side(client)
    function GetAutoStretch(): boolean
    --- Returns whether this `DLabelEditable` is being edited or not. (i.e. has focus)
    --- @return boolean Whether this DLabelEditable is being edited or not
    @side(client)
    function IsEditing(): boolean
    --- A hook called when the player presses Enter (i.e. the finished editing the label) and the text has changed.
    --- Allows you to override/modify the text that will be set to display.
    --- @param txt The original user input text
    --- @return string If provided, will override the text that will be applied to the label itself.
    @side(client)
    function OnLabelTextChanged(txt: string): string
    --- Sets whether the editable label should stretch to the text entered or not.
    --- @param stretch Whether the editable label should stretch to the text entered or not.
    @side(client)
    function SetAutoStretch(stretch: boolean): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- The ContentHeader is used internally by the Spawnmenu and only use this if you know
--- what you're doing because you can break a few things with it.
declare class ContentHeader extends DLabelEditable
    --- Creates a `Global.DermaMenu` and adds a delete option before opening the menu
    --- @param hookname A Populate Hook like PopulateEntities
    @side(client)
    function OpenMenu(style: string, hookname: string | nil): nil
    @side(client)
    function ToTable(bigtable: { [any]: any }): nil
end

--- The spawn icon used for SWEPs and other SENTs, commonly featured as part of the spawn menu.
--- Do note that at least one of your ContentIcon's parents must either be an `EditablePanel` or derived from it
--- (like a `DFrame`, for example), else it won't be able to focus and thus be unclickable.
--- This control only exists in Sandbox derived gamemodes.
declare class ContentIcon extends DButton
    --- An `Global.AccessorFunc` that returns the color set by `ContentIcon:SetColor`
    --- @return Color See Color
    @side(client)
    override function GetColor(): Color
    --- An `Global.AccessorFunc` that returns the content type used to save and restore the content icon in a spawnlist.
    --- @return string The content type, for example "entity" or "weapon".
    @side(client)
    function GetContentType(): string
    --- An `Global.AccessorFunc` that returns a table of weapon classes for the content icon with "NPC" content type to be randomly chosen from when user tries to spawn the NPC.
    --- @return { [any]: any } A table of weapon classes to be chosen from when user tries to spawn the NPC.
    @side(client)
    function GetNPCWeapon(): { [any]: any }
    --- An `Global.AccessorFunc` that returns the internal "name" for the content icon, usually a class name for an entity.
    --- @return string Internal "name" to be used when user left clicks the icon.
    @side(client)
    function GetSpawnName(): string
    --- A hook for override, by default does nothing. Called when user right clicks on the content icon, you are supposed to open a `Global.DermaMenu` here with additional options.
    @side(client)
    function OpenMenu(): nil
    --- An `Global.AccessorFunc` that sets whether the content item is admin only. This makes the icon to display a admin icon in the top left corner of the icon.
    --- @param adminOnly Whether this content should be admin only or not
    @side(client)
    function SetAdminOnly(adminOnly: boolean): nil
    --- An `Global.AccessorFunc` that sets the color for the content icon. Currently is not used by the content icon panel.
    --- @param clr The color to set. See Color
    @side(client)
    override function SetColor(clr: Color): nil
    --- An `Global.AccessorFunc` that sets the content type used to save and restore the content icon in a spawnlist.
    --- @param type The content type, for example "entity" or "weapon"
    @side(client)
    function SetContentType(type: string): nil
    --- Sets the material to be displayed as the content icon.
    --- @param path Path to the icon to use.
    @side(client)
    override function SetMaterial(path: string): nil
    --- Sets the tool tip and the "nice" name to be displayed by the content icon.
    --- @param name "Nice" name to display.
    @side(client)
    override function SetName(name: string): nil
    --- An `Global.AccessorFunc` that sets a table of weapon classes for the content icon with "NPC" content type to be randomly chosen from when user tries to spawn the NPC.
    --- @param weapons A table of weapon classes to be chosen from when user tries to spawn the NPC.
    @side(client)
    function SetNPCWeapon(weapons: { [any]: any }): nil
    --- An `Global.AccessorFunc` that sets the internal "name" for the content icon, usually a class name for an entity.
    --- @param name Internal "name" to be used when user left clicks the icon.
    @side(client)
    function SetSpawnName(name: string): nil
end

--- A simple rectangular box, commonly used for parenting other elements to. Pretty much all elements are based on this.
declare class DPanel extends Panel
    --- Returns the panel's background color.
    --- **NOTE**: By default this returns **nil** even though the default background color is white
    --- @return Color Color of the panel's background.
    @side(client)
    function GetBackgroundColor(): Color
    --- Returns whether or not the panel is disabled.
    --- @return boolean `true` if the panel is disabled (mouse input disabled and background alpha set to 75), `false` if its enabled (mouse input enabled and background alpha set to 255).
    --- @deprecated Use Panel:IsEnabled.
    @side(client)
    function GetDisabled(): boolean
    --- Returns whether or not the panel background is being drawn. Alias of `DPanel:GetPaintBackground`.
    --- @return boolean True if the panel background is drawn, false otherwise.
    --- @deprecated You should use DPanel:GetPaintBackground instead.
    @side(client)
    function GetDrawBackground(): boolean
    --- Used internally by `DMenu`.
    --- Returns whether the frame is part of a derma menu or not.
    --- If this is `true`, `Global.CloseDermaMenus` will not be called when the frame is clicked, and thus any open menus will remain open.
    --- @return boolean Whether this panel is a Menu Component
    @side(client)
    function GetIsMenu(): boolean
    --- Returns whether or not the panel background is being drawn.
    --- @return boolean True if the panel background is drawn, false otherwise.
    @side(client)
    function GetPaintBackground(): boolean
    --- Does nothing. Returns value set by `DPanel:SetTabbingDisabled`.
    @side(client)
    function GetTabbingDisabled(): boolean
    --- Sets the background color of the panel.
    --- @param color The background Color.
    @side(client)
    function SetBackgroundColor(color: Color): nil
    --- Sets whether or not to disable the panel.
    --- @param disabled True to disable the panel (mouse input disabled and background alpha set to 75), false to enable it (mouse input enabled and background alpha set to 255).
    --- @deprecated Use Panel:SetEnabled instead.
    @side(client)
    function SetDisabled(disabled: boolean): nil
    --- Sets whether or not to draw the panel background. Alias of `DPanel:SetPaintBackground`.
    --- @param draw True to show the panel's background, false to hide it.
    --- @deprecated You should use DPanel:SetPaintBackground instead.
    @side(client)
    function SetDrawBackground(draw: boolean): nil
    --- Used internally by `DMenu`.
    --- Sets whether the frame is part of a derma menu or not.
    --- If this is set to `true`, `Global.CloseDermaMenus` will not be called when the frame is clicked, and thus any open menus will remain open.
    --- @param isMenu Whether this pane is a Menu Component
    @side(client)
    function SetIsMenu(isMenu: boolean): nil
    --- Sets whether or not to paint/draw the panel background.
    --- @param paint True to show the panel's background, false to hide it.
    @side(client)
    function SetPaintBackground(paint: boolean): nil
    --- Does nothing.
    @side(client)
    function SetTabbingDisabled(draw: boolean): nil
    --- Does nothing.
    @side(client)
    function UpdateColours(): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- The ContentSidebar is internally used by the spawnmenu and manages things like the Spawnmenu Toolbar.
--- It internally uses a DTree which is accessible with ContentSidebar .Tree.
--- When `ContentSidebar:EnableModify` has been called ContentSidebar.Toolbox will return a `ContentSidebarToolbox`
declare class ContentSidebar extends DPanel
    --- Creates a Save Notification which will be shown when `SANDBOX:SpawnlistContentChanged` has been called.
    --- @param hookname A Populate Hook like PopulateEntities
    @side(client)
    function CreateSaveNotification(style: string, hookname: string | nil): nil
    --- Internally calls `ContentSidebar:EnableSearch`, `ContentSidebar:CreateSaveNotification` and creates a ContentSidebarToolbox which is accessible under ContentSidebar.Toolbox. Call the Hook `SANDBOX:OpenToolbox` to open the created Toolbox
    @side(client)
    function EnableModify(): nil
    --- Creates a search bar which will be displayed over the Nodes.
    --- @param hookname A Populate Hook like PopulateEntities
    @side(client)
    function EnableSearch(style: string, hookname: string | nil): nil
end

--- A simple Derma Drawer
declare class DDrawer extends Panel
    --- Closes the `DDrawer`.
    @side(client)
    function Close(): nil
    --- An `Global.AccessorFunc` that returns the Open Size of DDrawer.
    --- @return number Open size.
    @side(client)
    function GetOpenSize(): number
    --- An `Global.AccessorFunc` that returns the Open Time of DDrawer.
    --- @return number Time in seconds.
    @side(client)
    function GetOpenTime(): number
    --- Opens the `DDrawer`.
    @side(client)
    function Open(): nil
    --- An `Global.AccessorFunc` that sets the height of DDrawer
    --- @param Value Height of DDrawer. Default is `100`.
    @side(client)
    function SetOpenSize(Value: number): nil
    --- An `Global.AccessorFunc` that sets the time (in seconds) for DDrawer to open.
    --- @param value Length in seconds. Default is 0.3
    @side(client)
    function SetOpenTime(value: number): nil
    --- Toggles the `DDrawer`.
    @side(client)
    function Toggle(): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- The ContentSidebarToolbox is internally used by the `ContentSidebar` and is used to change the icon of a category.
--- It internally consists of a `DTextEntry`, `DPanel`, `DImageButton`, `Panel`, `ContentHeader` and a `DIconBrowser`
declare class ContentSidebarToolbox extends DDrawer
end

--- A base for all context menu panels ( The ones used for tool options in sandbox )
declare class ContextBase extends Panel
    --- Called by spawnmenu functions (when creating a context menu) to fill this control with data.
    --- @param contextData A two-membered table: * string convar - The console variable to use. Calls ContextBase:SetConVar. * string label - The text to display inside the control's label.
    @side(client)
    function ControlValues(contextData: { [any]: any }): nil
    --- Returns the `ConVar` for the panel to change/handle, set by `ContextBase:SetConVar`
    --- @return string The ConVar for the panel to change.
    @side(client)
    function ConVar(): string
    --- Sets the `ConVar` for the panel to change/handle.
    --- @param cvar The ConVar for the panel to change.
    @side(client)
    override function SetConVar(cvar: string): nil
    --- You should override this function and use it to check whether your convar value changed.
    @side(client)
    function TestForChanges(): nil
end

--- The collapsible category allows you to create numerous sections of controls, and have the ability to contract/expand them.
--- Consider using `DCategoryList` if you plan on using more than 1 of these.
declare class DCollapsibleCategory extends Panel
    --- Adds a new text button to the collapsible category, like the tool menu in Spawnmenu.
    --- @param name The name of the button
    --- @return DButton The DButton
    @side(client)
    override function Add(name: string): DButton
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Internal function that handles the open/close animations.
    @side(client)
    function AnimSlide(anim: { [any]: any }, delta: number, data: { [any]: any }): nil
    --- Forces the category to open or collapse
    --- @param expand True to open, false to collapse
    @side(client)
    function DoExpansion(expand: boolean): nil
    --- An `Global.AccessorFunc` that returns the expand/collapse animation time set by `DCollapsibleCategory:SetAnimTime`.
    --- @return number The animation time in seconds
    @side(client)
    function GetAnimTime(): number
    --- Returns whether or not the panel background is being drawn. Alias of `DCollapsibleCategory:GetPaintBackground`.
    --- @return boolean True if the panel background is drawn, false otherwise.
    --- @deprecated You should use DCollapsibleCategory:GetPaintBackground instead.
    @side(client)
    function GetDrawBackground(): boolean
    --- Returns whether the DCollapsibleCategory is expanded or not.
    --- @return boolean If expanded it will return true.
    @side(client)
    function GetExpanded(): boolean
    --- Returns the header height of the `DCollapsibleCategory`.
    --- See also `DCollapsibleCategory:SetHeaderHeight`.
    --- @return number The current height of the header.
    @side(client)
    function GetHeaderHeight(): number
    --- If set, the `DCategoryList` that created this panel.
    --- See also `DCollapsibleCategory:SetList`.
    --- @return DCategoryList The DCategoryList that created us.
    @side(client)
    function GetList(): DCategoryList
    --- Doesn't actually do anything.
    --- Returns the number set by `DCollapsibleCategory:SetPadding`.
    @side(client)
    function GetPadding(): number
    --- An `Global.AccessorFunc` that returns whether or not the background should be painted.
    --- @return boolean If the background is painted or not
    @side(client)
    function GetPaintBackground(): boolean
    --- Returns whatever was set by `DCollapsibleCategory:SetStartHeight`
    @side(client)
    function GetStartHeight(): number
    --- Sets the time in seconds it takes to expand the DCollapsibleCategory
    --- @param time The time in seconds it takes to expand
    @side(client)
    function SetAnimTime(time: number): nil
    --- Sets the contents of the DCollapsibleCategory.
    --- @param pnl The panel, containing the contents for the DCollapsibleCategory, mostly an DScrollPanel
    @side(client)
    function SetContents(pnl: Panel): nil
    --- Sets whether or not to draw the panel background. Alias of `DCollapsibleCategory:SetPaintBackground`.
    --- @param draw True to show the panel's background, false to hide it.
    --- @deprecated You should use DCollapsibleCategory:SetPaintBackground instead.
    @side(client)
    function SetDrawBackground(draw: boolean): nil
    --- Sets whether the `DCollapsibleCategory` is expanded or not upon opening the container.
    --- You should use `DCollapsibleCategory:Toggle` or `DCollapsibleCategory:DoExpansion` instead.
    --- @param expanded Whether it shall be expanded or not by default
    @side(client)
    function SetExpanded(expanded: boolean | nil): nil
    --- Sets the header height of the `DCollapsibleCategory`.
    --- See also `DCollapsibleCategory:GetHeaderHeight`.
    --- @param height The new height to set. Default height is 20.
    @side(client)
    function SetHeaderHeight(height: number): nil
    --- Sets the name of the DCollapsibleCategory.
    --- @param label The label/name of the DCollapsibleCategory.
    @side(client)
    function SetLabel(label: string): nil
    --- Used internally by `DCategoryList` when it creates a `DCollapsibleCategory` during `DCategoryList:Add`.
    --- If set, `Panel:UnselectAll` will be called on the list, instead of calling it on the category panel itself when a category is clicked.
    --- @param pnl The Panel:UnselectAll that is the "parent" of this panel.
    @side(client)
    function SetList(pnl: Panel): nil
    --- Doesn't actually do anything.
    @side(client)
    function SetPadding(padding: number): nil
    --- Sets whether or not the background should be painted.
    @side(client)
    function SetPaintBackground(paint: boolean): nil
    --- Does nothing.
    @side(client)
    function SetStartHeight(height: number): nil
    --- Toggles the expanded state of the `DCollapsibleCategory`.
    --- See `DCollapsibleCategory:GetExpanded` for a function to retrieve the expanded state.
    @side(client)
    function Toggle(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to update the "AltLine" property on all "child" panels.
    @side(client)
    function UpdateAltLines(): nil
end

--- An easy form with functions to quickly add form elements
declare class DForm extends DCollapsibleCategory
    --- Adds one or two items to the DForm.
    --- If this method is called with only one argument, it is added to the bottom of the form. If two arguments are passed, they are placed side-by-side at the bottom of the form.
    --- Internally, this function is used by the various DForm functions to, for example, add labels to the left of buttons.
    --- @param left Left-hand element to add to the DForm.
    --- @param right Right-hand element to add to the DForm.
    @side(client)
    function AddItem(left: Panel, right: Panel | nil): nil
    --- Adds a `DButton` onto the `DForm`
    --- @param text The text on the button
    --- @param concommand The concommand to run when the button is clicked
    --- @param args The arguments to pass on to the concommand when the button is clicked
    --- @return DButton The created DButton
    @side(client)
    function Button(text: string, concommand: string | nil, ...: any): DButton
    --- Adds a `DCheckBoxLabel` onto the `DForm`.
    --- **NOTE**: This will run `DCheckBoxLabel:OnChange` when being added. This is caused by `Panel:SetConVar` being used when this function is used. To avoid this, use `DForm:AddItem` with a `DCheckBoxLabel`.
    --- @param label The label to be set next to the check box
    --- @param convar The console variable to change when this is changed
    --- @return DCheckBoxLabel The created DCheckBoxLabel
    @side(client)
    function CheckBox(label: string, convar: string): DCheckBoxLabel
    --- Adds a `DComboBox` onto the `DForm`
    --- @param title Text to the left of the combo box
    --- @param convar Console variable to change when the user selects something from the dropdown.
    --- @return DComboBox The created DComboBox
    --- @return DLabel The created DLabel
    @side(client)
    function ComboBox(title: string, convar: string): (DComboBox, DLabel)
    --- Adds a `DLabel` onto the `DForm`. Unlike `DForm:Help`, this is indented and is colored blue, depending on the derma skin.
    --- @param help The help message to be displayed.
    --- @return DLabel The created DLabel
    @side(client)
    function ControlHelp(help: string): DLabel
    --- An Accessor Function in DForm that does nothing.
    @side(client)
    function GetAutoSize(): boolean
    --- An `Global.AccessorFunc` that does nothing.
    @side(client)
    function GetSpacing(): number
    --- Adds a `DLabel` onto the `DForm` as a helper
    --- @param help The help message to be displayed
    --- @return DLabel The created DLabel
    @side(client)
    function Help(help: string): DLabel
    --- Adds a `DListBox` onto the `DForm`
    --- @param label The label to set on the DListBox
    --- @return DListBox The created DListBox
    --- @return DLabel The created DLabel if label string was specified
    --- @deprecated Use DListView with DForm:AddItem instead.
    @side(client)
    function ListBox(label: string | nil): (DListBox, DLabel)
    --- Adds a `DNumberWang` onto the `DForm`
    --- @param label The label to be placed next to the DNumberWang
    --- @param convar The console variable to change when the slider is changed
    --- @param min The minimum value of the slider
    --- @param max The maximum value of the slider
    --- @param decimals The number of decimals to allow in the slider (Optional)
    --- @return DNumberWang The created DNumberWang
    --- @return DLabel The created DLabel
    @side(client)
    function NumberWang(label: string, convar: string, min: number, max: number, decimals: number | nil): (DNumberWang, DLabel)
    --- Adds a `DNumSlider` onto the `DForm`
    --- @param label A short label for the slider.
    --- @param convar The `console variable` to change when the slider is changed
    --- @param min The minimum value of the slider
    --- @param max The maximum value of the slider
    --- @param decimals The number of decimals to allow for the slider value.
    --- @return DNumSlider The created DNumSlider.
    @side(client)
    function NumSlider(label: string, convar: string, min: number, max: number, decimals: number | nil): DNumSlider
    --- Creates a `DPanelSelect` and docks it to the top of the DForm.
    --- @return DPanelSelect The created DPanelSelect.
    --- @deprecated This is derived from the deprecated DPanelSelect.
    @side(client)
    function PanelSelect(): DPanelSelect
    --- Creates a `PropSelect` panel and docks it to the top of the DForm.
    --- @param label The label to display above the prop select.
    --- @param convar The convar to set the selected model to.
    --- @param models A table of models to display for selection. Supports 2 formats: 1) Key is the model and value are the convars to set when that model is selected in format `convar=value` 2) An table of tables where each table must have the following keys: * string model - The model. * number skin - Model's skin. Defaults to 0 * string tooltip - Displayed when user hovers over the model. Defaults to the model path. * The key of the table is the value of the convar.
    --- @param height The height of the prop select panel, in 64px icon increments.
    --- @return PropSelect The created PropSelect panel.
    @side(client)
    function PropSelect(label: string, convar: string, models: { [any]: any }, height: number | nil): PropSelect
    --- Does nothing.
    @side(client)
    function Rebuild(): nil
    --- an `Global.AccessorFunc` that does nothing
    @side(client)
    function SetAutoSize(arg1: boolean): nil
    --- Sets the title (header) name of the DForm. This is `Label` until set.
    --- @param name The new header name.
    --- @deprecated This is an alias of derived DCollapsibleCategory:SetLabel
    @side(client)
    override function SetName(name: string): nil
    --- An `Global.AccessorFunc` that does nothing.
    @side(client)
    function SetSpacing(arg1: number): nil
    --- Adds a `DTextEntry` to a `DForm`
    --- @param label The label to be next to the text entry
    --- @param convar The console variable to be changed when the text entry is changed
    --- @return DTextEntry The created DTextEntry
    --- @return DLabel The created DLabel
    @side(client)
    function TextEntry(label: string, convar: string): (DTextEntry, DLabel)
end

--- Used by the context menu in sandbox.
declare class ControlPanel extends DForm
    --- Adds a control to the control panel.
    --- @param type The control type to add. The complete list is: * header * textbox * label * checkbox/toggle * slider * propselect * matselect * ropematerial * button * numpad * color * combobox * listbox * materialgallery
    --- @param controlinfo Each control takes their own table structure. You may search "AddControl" on GitHub for examples. Here is a full list of each type and the table members it requires: * header * description * textbox: * label (def: "Untitled") * command * label: * text * checkbox, toggle (same thing): * label (def: "Untitled") * command * help (boolean, if true assumes label is a language string (`#tool.toolname.stuff`) and adds `.help` at the end) * slider: (DForm:NumSlider) * type (optional string, if equals `float` then 2 digits after the decimal will be used, otherwise 0) * label (def: `Untitled`) * command * min (def: `0`) * max (def: `100`) * help (boolean, see above) * propselect: * (data goes directly to PropSelect's :ControlValues(data)) * matselect: * (data goes directly to MatSelect's :ControlValues(data)) * ropematerial: * convar (notice: NOT called command this time!) * button: * label / text (if label is missing will use text. Def: `No Label`) * command * numpad: * command * command2 * label * label2 * color: * label * red (convar) * green (convar) * blue (convar) * alpha (convar) * combobox: * menubutton (if doesn't equal "1", becomes a listbox) * folder * options (optional, ha) * cvars (optional) * listbox: * height (if set, becomes DListView, otherwise is CtrlListBox) * label (def: `unknown`) * options (optional) * materialgallery: * width (def: `32`) * height (def: `32`) * rows (def: `4`) * convar * options
    --- @return Panel Returns created control
    --- @deprecated It is recommended to use DForm's members instead.
    @side(client)
    function AddControl(type: string, controlinfo: { [any]: any }): Panel
    --- Adds an item by calling `DForm:AddItem`.
    --- @param panel Panel to add as an item to the control panel.
    @side(client)
    function AddPanel(panel: Panel): nil
    --- Alias of `Panel:Clear`.
    @side(client)
    function ClearControls(): nil
    --- Creates a `CtrlColor` (a color picker) panel and adds it as an `item`.
    --- @param label The label for this color picker.
    --- @param convarR Name of the convar that will store the R component of the selected color.
    --- @param convarG Name of the convar that will store the G component of the selected color.
    --- @param convarB Name of the convar that will store the B component of the selected color.
    --- @param convarA Name of the convar that will store the A component of the selected color.
    --- @return any The created CtrlColor panel.
    @side(client)
    function ColorPicker(label: string, convarR: string, convarG: string, convarB: string, convarA: string | nil): any
    --- Sets control values of the control panel.
    --- @param data A two-membered table: * boolean closed - Sets if the control panel should be unexpanded. * string label - The text to display inside the control's label.
    @side(client)
    function ControlValues(data: { [any]: any }): nil
    --- Calls the given function with this panel as the only argument. Used by the spawnmenu to populate the control panel.
    --- @param func The builder function. Function argument(s): * ControlPanel `panelToPopulate` -
    --- @deprecated This is dumb. Just call the builder function directly.
    @side(client)
    function FillViaFunction(func: (ControlPanel) -> any): nil
    --- Returns this control panel.
    --- @return ControlPanel The same control panel the function is being called on.
    @side(client)
    function GetEmbeddedPanel(): ControlPanel
    --- Creates a CtrlNumPad (a Sandbox key binder) panel and adds it as an `item`.
    --- @param label1 The label for the left key binder.
    --- @param convar1 The name of the convar that will store the key code for player selected key of the left key binder.
    --- @param label2 If set and `convar2` is set, the label for the right key binder.
    --- @param convar2 If set and `label2` is set, the name of the convar that will store the key code for player selected key of the right key binder.
    --- @return CtrlNumPad The created CtrlNumPad panel.
    @side(client)
    function KeyBinder(label1: string, convar1: string, label2: string | nil, convar2: string | nil): CtrlNumPad
    --- Creates a `MatSelect` panel and adds it as an `item`.
    --- @param convar Calls MatSelect:ContextBase:SetConVar with this value.
    --- @param options If specified, calls MatSelect:AddMaterial(key, value) for each table entry. If the table key is a number, the function will instead be called with the value as both arguments.
    --- @param autostretch If specified, calls MatSelect:SetAutoHeight with this value.
    --- @param width If specified, calls MatSelect:SetItemWidth with this value.
    --- @param height If specified, calls MatSelect:SetItemHeight with this value.
    --- @return MatSelect The created MatSelect panel.
    @side(client)
    function MatSelect(convar: string, options: { [any]: any } | nil, autostretch: boolean | nil, width: number | nil, height: number | nil): MatSelect
    --- Creates a `ControlPresets` panel and adds it as an `item`.
    --- @param group The presets group. Must be unique.
    --- @param cvarList A table of convar names as keys and their defaults as the values. Typically the output of Tool:BuildConVarList.
    --- @return ControlPresets The created ControlPresets panel.
    @side(client)
    function ToolPresets(group: string, cvarList: { [any]: any }): ControlPresets
end

--- A preset manager, found at the top of almost every default tool's C-menu.
--- This control only exists in Sandbox derived gamemodes.
declare class ControlPresets extends Panel
    --- Adds a convar to be managed by this control.
    --- @param convar The convar to add.
    @side(client)
    function AddConVar(convar: string): nil
    --- Adds option to the `DComboBox` subelement with `DComboBox:AddChoice` then adds it to the `options` subtable
    --- @param strName Name
    --- @param data data
    @side(client)
    function AddOption(strName: string, data: any): nil
    --- Runs `Panel:Clear` on the Internal `DComboBox`
    @side(client)
    override function Clear(): nil
    --- Get a list of all Console Variables being managed by this panel.
    --- @return { [any]: any } numbered table of convars
    @side(client)
    function GetConVars(): { [any]: any }
    --- Checks if Data is valid then uses `Global.pairs` to iterate over the data parameter and run each entry using `Global.RunConsoleCommand`
    --- Index and Value parameters appear to not be used. Further testing should be done to confirm
    --- @param index Name
    @side(client)
    function OnSelect(index: number, value: any, data: { [any]: any }): nil
    --- Creates and opens `PresetEditor`
    @side(client)
    function OpenPresetEditor(): nil
    @side(client)
    function QuickSaveInternal(text: string): nil
    @side(client)
    function QuickSavePreset(): nil
    @side(client)
    function ReloadPresets(): nil
    --- Set the name label text.
    --- @param name The text to put in the label
    @side(client)
    function SetLabel(name: string): nil
    --- Uses `table.Merge` to combine the provided table into the `Options` subtable
    --- @param Options Options
    @side(client)
    function SetOptions(Options: { [any]: any }): nil
    --- @param strName Name of preset to set
    @side(client)
    function SetPreset(strName: string): nil
    --- Alias of `ControlPresets:ReloadPresets`
    @side(client)
    function Update(): nil
end

--- A field with multiple selectable values.
declare class DComboBox extends DButton
    --- Adds a choice to the combo box.
    --- @param value The text show to the user.
    --- @param data The data accompanying this string. If left empty, the value argument is used instead. Can be accessed with the second argument of DComboBox:GetSelected, DComboBox:GetOptionData and as an argument of DComboBox:OnSelect.
    --- @param select Should this be the default selected text show to the user or not.
    --- @param icon Adds an icon for this choice.
    --- @return number The index of the new option.
    @side(client)
    function AddChoice(value: string, data: any | nil, select: boolean | nil, icon: string | nil): number
    --- Adds a spacer below the currently last item in the drop down. Recommended to use with `DComboBox:SetSortItems` set to `false`.
    @side(client)
    function AddSpacer(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Ran every frame to update the value of this panel to the value of the associated convar. See `Panel:SetConvar`.
    @side(client)
    function CheckConVarChanges(): nil
    --- Selects a combo box option by its index and changes the text displayed at the top of the combo box.
    --- @param value The text to display at the top of the combo box.
    --- @param index The option index.
    @side(client)
    function ChooseOption(value: string, index: number): nil
    --- Selects an option within a combo box based on its table index.
    --- @param index Selects the option with given index.
    @side(client)
    function ChooseOptionID(index: number): nil
    --- Clears the combo box's text value, choices, and data values.
    @side(client)
    override function Clear(): nil
    --- Closes the combo box menu. Called when the combo box is clicked while open.
    @side(client)
    function CloseMenu(): nil
    --- Returns an option's data based on the given index.
    --- @param index The option index.
    --- @return any The option's data value.
    @side(client)
    function GetOptionData(index: number): any
    --- Returns an option's text based on the given index.
    --- @param index The option index.
    --- @return string The option's text value.
    @side(client)
    function GetOptionText(index: number): string
    --- Returns an option's text based on the given data.
    --- @param data The data to look up the name of. If given a number and no matching data was found, the function will test given data against each Global.tonumber'd data entry.
    --- @return string The option's text value. If no matching data was found, the data itself will be returned. If multiple identical data entries exist, the first instance will be returned.
    @side(client)
    function GetOptionTextByData(data: string): string
    --- Returns the currently selected option's text and data
    --- @return string The option's text value.
    --- @return any The option's stored data.
    @side(client)
    function GetSelected(): (string, any)
    --- Returns the index (ID) of the currently selected option.
    --- @return number The ID of the currently selected option.
    @side(client)
    function GetSelectedID(): number
    --- An `Global.AccessorFunc` that returns an whether the items in the dropdown will be alphabetically sorted or not.
    --- See `DComboBox:SetSortItems`.
    --- @return boolean True if enabled, false otherwise.
    @side(client)
    function GetSortItems(): boolean
    --- Returns whether or not the combo box's menu is opened.
    --- @return boolean True if the menu is open, false otherwise.
    @side(client)
    function IsMenuOpen(): boolean
    --- Opens the combo box drop down menu. Called when the combo box is clicked.
    @side(client)
    function OpenMenu(): nil
    --- Removes a choice added with `DComboBox:AddChoice`
    --- @param index The index of the option to remove.
    --- @return string The text of the removed option.
    --- @return any The data of the removed option that was provided.
    @side(client)
    function RemoveChoice(index: number): (string, any)
    --- An `Global.AccessorFunc` that sets whether or not the items should be sorted alphabetically in the dropdown menu of the `DComboBox`. If set to false, items will appear in the order they were added by `DComboBox:AddChoice` calls.
    --- This is enabled by default.
    --- @param sort true to enable, false to disable
    @side(client)
    function SetSortItems(sort: boolean): nil
    --- Sets the text shown in the combo box when the menu is not collapsed.
    --- @param value The text in the DComboBox.
    @side(client)
    function SetValue(value: string): nil
end

--- A `DComboBox` based dropdown menu with build in easy `ConVar` support.
--- This control only exists in Sandbox derived gamemodes.
declare class CtrlListBox extends DComboBox
end

--- CtrlNumPad is a `VGUI` element designed primarily for `SpawnMenu` and `ControlPanel`. It is used to create a `DBinder` with at least one `DLabel`. Each change made by the player in the `CtrlNumPad` acts on a previously defined `ConVar`.
--- To retrieve the panels associated with this panel:
--- * To retrieve the `DBinder` created, you can use this variable associated with the panel: `PANEL.NumPad1`
--- * To retrieve the first `DLabel` created, you can use this variable associated with the panel: `PANEL.Label1`
--- * To retrieve the second `DLabel` created, you can use this variable associated with the panel: `PANEL.Label2`
--- By default, the `DLabel:SetDark` function is activated on both DLabels.
--- To retrieve the value of the `CtrlNumPad` you can use these functions : `Player:GetInfoNum`, `CtrlNumPad:GetValue1` or `CtrlNumPad:GetValue2`
declare class CtrlNumPad extends Panel
    --- The value (key bind) of the first `DBinder`.
    --- @return number The key bind or `KEY_NONE`.
    @side(client)
    function GetValue1(): number
    --- The value (key bind) of the second `DBinder`, if it's enabled.
    --- @return number The key bind or `KEY_NONE`.
    @side(client)
    function GetValue2(): number
    --- The name of the convar that will store the key code for player selected key of the left key binder.
    --- @param cvar The convar that will be used in the event of a key change by a player.
    @side(client)
    function SetConVar1(cvar: string): nil
    --- If set and label2 is set, the name of the convar that will store the key code for player selected key of the right key binder.
    --- @param cvar The convar that will be used in the event of a key change by a player.
    @side(client)
    function SetConVar2(cvar: string): nil
    --- The label for the left key binder.
    --- @param txt The label for the left key binder.
    @side(client)
    function SetLabel1(txt: string): nil
    --- If set and convar2 is set, the label for the right key binder.
    --- @param txt The label for the right key binder.
    @side(client)
    function SetLabel2(txt: string): nil
end

--- DModelPanel is a VGUI element that projects a 3D model onto a 2D plane. See also `DAdjustableModelPanel`
declare class DModelPanel extends DButton
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used by the DModelPanel's paint hook to draw the model and background.
    @side(client)
    function DrawModel(): nil
    --- Returns the ambient lighting used on the rendered entity.
    --- @return Color The color of the ambient lighting.
    @side(client)
    function GetAmbientLight(): Color
    --- Returns whether or not the panel entity should be animated when the default `DModelPanel:LayoutEntity` function is called.
    --- @return boolean True if the panel entity can be animated with Entity:SetSequence directly, false otherwise.
    @side(client)
    function GetAnimated(): boolean
    --- Returns the animation speed of the panel entity, see `DModelPanel:SetAnimSpeed`.
    --- @return number The animation speed.
    @side(client)
    function GetAnimSpeed(): number
    --- Returns the position of the model viewing camera.
    --- @return Vector The position of the camera.
    @side(client)
    function GetCamPos(): Vector
    --- Returns the color of the rendered entity.
    --- @return Color The color of the entity.
    @side(client)
    override function GetColor(): Color
    --- Returns the entity being rendered by the model panel.
    --- @return CSEnt The rendered entity (client-side)
    @side(client)
    function GetEntity(): CSEnt
    --- Returns the FOV (field of view) the camera is using.
    --- @return number The FOV of the camera.
    @side(client)
    function GetFOV(): number
    --- Returns the angles of the model viewing camera. Is **nil** until changed with `DModelPanel:SetLookAng`.
    --- @return Angle The angles of the camera.
    @side(client)
    function GetLookAng(): Angle
    --- Returns the position the viewing camera is pointing toward.
    --- @return Vector The position the camera is pointing toward.
    @side(client)
    function GetLookAt(): Vector
    --- Gets the model of the rendered entity.
    --- @return string The model of the rendered entity.
    @side(client)
    function GetModel(): string
    --- This function is used in `DModelPanel:LayoutEntity`. It will progress the animation, set using `Entity:SetSequence`. By default, it is the walking animation.
    @side(client)
    function RunAnimation(): nil
    --- Sets the ambient lighting used on the rendered entity.
    --- @param color The color of the ambient lighting.
    @side(client)
    function SetAmbientLight(color: Color): nil
    --- Sets whether or not to animate the entity when the default `DModelPanel:LayoutEntity` is called.
    --- @param animated True to animate, false otherwise.
    @side(client)
    function SetAnimated(animated: boolean): nil
    --- Sets the speed used by `DModelPanel:RunAnimation` to advance frame on an entity sequence.
    --- **NOTE**: `Entity:FrameAdvance` doesn't seem to have any functioning arguments and therefore changing this will not have any affect on the panel entity's sequence speed without reimplementation. It only affects the value returned by `DModelPanel:GetAnimSpeed`
    --- @param animSpeed The animation speed.
    @side(client)
    function SetAnimSpeed(animSpeed: number): nil
    --- Sets the position of the camera.
    --- @param pos The position to set the camera at.
    @side(client)
    function SetCamPos(pos: Vector): nil
    --- Sets the color of the rendered entity.
    --- **NOTE**: This does not work on Garry's Mod player models since they use a different color system. To modify a player model color, see Example 2 on the `DModelPanel` page
    --- @param color The render color of the entity.
    @side(client)
    override function SetColor(color: Color): nil
    --- Sets the directional lighting used on the rendered entity.
    --- @param direction The light direction, see Enums/BOX.
    --- @param color The Color of the directional lighting.
    @side(client)
    function SetDirectionalLight(direction: number, color: Color): nil
    --- Sets the entity to be rendered by the model panel.
    --- **NOTE**: If you set `ent` to a shared entity you must set `ent` to nil before removing this panel or else a "Trying to remove server entity on client!" error is thrown
    --- @param ent The new panel entity.
    @side(client)
    function SetEntity(ent: Entity): nil
    --- Sets the panel camera's FOV (field of view).
    --- @param fov The field of view value.
    @side(client)
    function SetFOV(fov: number): nil
    --- Sets the angles of the camera.
    --- @param ang The angles to set the camera to.
    @side(client)
    function SetLookAng(ang: Angle): nil
    --- Makes the panel's camera face the given position. Basically sets the camera's angles (`DModelPanel:SetLookAng`) after doing some math.
    --- @param pos The position to orient the camera toward.
    @side(client)
    function SetLookAt(pos: Vector): nil
    --- Sets the model of the rendered entity.
    --- **NOTE**: This function may give a different model than expected. This is not a bug, however this problem may appear with some player models which are renamed several times in a wrong way. To solve that, you can use `Entity:SetModel` and `Entity:SetModelName` on the internal panel entity. More information : https://github.com/Facepunch/garrysmod-issues/issues/4534.
    --- @param model The model to apply to the entity.
    @side(client)
    override function SetModel(model: string): nil
    --- Runs a `Global.ClientsideScene` on the panel's entity.
    --- @param path The path to the scene file. (.vcd)
    @side(client)
    function StartScene(path: string): nil
end

--- A derivative of the DModelPanel in which the user may modify the perspective of the model with their mouse and keyboard by clicking and dragging.
--- The keyboard keys W S A D Up Down Left Right Space and Ctrl can be used when the right mouse is held down, with Shift acting as a speed multiplier. When the left mouse is used, the Shift key holds the current `y` angle steady.
--- This is used by `IconEditor` for modifying spawn icons.
declare class DAdjustableModelPanel extends DModelPanel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used by the panel to perform mouse capture operations when adjusting the model.
    @side(client)
    function CaptureMouse(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used to adjust the perspective in the model panel via the keyboard, when the right mouse button is used.
    @side(client)
    function FirstPersonControls(): nil
    --- Gets whether mouse and keyboard-based adjustment of the perspective has been enabled. See `DAdjustableModelPanel:SetFirstPerson` for more information.
    --- This is an `Global.AccessorFunc`
    --- @return boolean Whether first person controls are enabled. See DAdjustableModelPanel:FirstPersonControls.
    @side(client)
    function GetFirstPerson(): boolean
    --- Returns the movement speed multiplier set by `DAdjustableModelPanel:SetMovementScale`.
    --- An `Global.AccessorFunc`
    --- @return number The movement scale, where `1` is normal, `2` is double, etc.
    @side(client)
    function GetMovementScale(): number
    --- Enables mouse and keyboard-based adjustment of the perspective.
    --- This is set to `true` automatically each time mouse capture is enabled, and hence doesn't serve as a usable setting, other than to disable this functionality after the `PANEL:OnMousePressed` event.
    --- An `Global.AccessorFunc`
    --- @param enable Whether to enable/disable first person controls. See DAdjustableModelPanel:FirstPersonControls.
    @side(client)
    function SetFirstPerson(enable: boolean): nil
    --- Sets the movement speed multiplier. Currently this only affects first person camera controls.
    --- @param _ The movement scale, where `1` is normal, `2` is double, etc.
    @side(client)
    function SetMovementScale(arg1: number): nil
end

--- A bar to select the opacity (alpha level) of a color.
declare class DAlphaBar extends DPanel
    --- Returns the base color of the alpha bar. This is the color for which the alpha channel is being modified. An `Global.AccessorFunc`
    --- @return Color The current base Color.
    @side(client)
    function GetBarColor(): Color
    --- Returns the alpha value of the alpha bar. An `Global.AccessorFunc`
    --- @return number The current alpha value.
    @side(client)
    override function GetValue(): number
    --- Sets the base color of the alpha bar. This is the color for which the alpha channel is being modified. An `Global.AccessorFunc`
    --- @param clr The new Color to set. See Global.Color.
    @side(client)
    function SetBarColor(clr: Color): nil
    --- Sets the alpha value or the alpha bar. An `Global.AccessorFunc`
    --- @param alpha The new alpha value to set
    @side(client)
    function SetValue(alpha: number): nil
end

--- Input which can bind a command to a key. Used for binding inputs and outputs of TOOLs.
declare class DBinder extends DButton
    --- Gets the code of the key currently bound by the DBinder. Same as `DBinder:GetValue`. An `Global.AccessorFunc`
