--- Called when a player earns an achievement.
declare interface achievement_earned
    --- The achievement ID.
    achievement: number
    --- The Player:UserID of the player.
    player: number
end

--- Called when a player makes progress on an achievement.
--- **NOTE**: Only called clientside for the player who made progress.
declare interface achievement_event
    --- the name of the achievement.
    achievement_name: string
    --- amount of steps toward achievement.
    cur_val: number
    --- total amount of steps in achievement.
    max_val: number
end

--- Table structure that describes a Source Engine ammo type.
--- See `game.AddAmmoType` and `game.GetAmmoData`.
declare interface AmmoData
    --- Damage type using Enums/DMG. Related function is game.GetAmmoDamageType.
    dmgtype: number | nil
    --- The force of the ammo. Related function is game.GetAmmoForce.
    force: number | nil
    --- The maximum water splash size.
    maxsplash: number | nil
    --- The minimum water splash size.
    minsplash: number | nil
    --- Name of the ammo. Related functions are game.GetAmmoName and game.GetAmmoID.
    name: string
    --- The damage dealt to NPCs. Related function is game.GetAmmoNPCDamage. Can also be a string with the name of a convar. The value will automatically update with the convar's.
    npcdmg: number | nil
    --- The damage dealt to players. Related function is game.GetAmmoPlayerDamage. Can also be a string with the name of a convar. The value will automatically update with the convar's.
    plydmg: number | nil
    --- Tracer type using Enums/TRACER.
    tracer: number | nil
    --- Maximum amount of ammo of this type the player should be able to carry in reserve. `-2` makes this ammo type infinite. Related function is game.GetAmmoMax. Can also be a string with the name of a convar. The value will automatically update with the convar's. `gmod_maxammo` convar will override this value if set to above 0, **which it is by default**.
    maxcarry: number | nil
    --- Flags for the ammo type using Enums/AMMO.
    flags: number | nil
end

--- Table used by various functions, such as `Entity:GetAttachment`.
declare interface AngPos
    --- An Angle object.
    Ang: Angle
    --- An Vector object.
    Pos: Vector
    --- The bone ID the attachment point is parented to.
    Bone: number
end

--- Table used by panel animation methods, primarily `Panel:AnimationThinkInternal`, and returned by `Panel:NewAnimation`.
declare interface AnimationData
    --- The system time value returned by Global.SysTime when the animation starts/will start.
    StartTime: number
    --- The system time value returned by Global.SysTime when the animation ends/will end.
    EndTime: number
    --- The ease in/out level of the animation.
    Ease: number | nil
    --- The callback function that will be called upon completion of the animation. Function argument(s): * table `animData` - This structure. * Panel `tgtPanel` - The panel the animation was run on.
    OnEnd: ({ [any]: any }, Panel) -> any
    --- The `think` function called every frame that will animate the panel object. This varies based on the animation. You can create a custom function for this if you aren't using the stock panel methods. Function argument(s): * table `animData` - This structure. * Panel `tgtPanel` - The panel the animation is being run on. The progress fraction of the animation, between 0 and 1. The change rate of this number will not be linear if you are easing.
    Think: ({ [any]: any }, Panel) -> any
    --- The target position, or target translation of the panel object. Used by Panel:MoveTo and Panel:MoveBy respectively.
    Pos: Vector
    --- The position of the panel object when the animation started. Used by Panel:MoveTo and Panel:MoveBy.
    StartPos: Vector
    --- Whether to resize the panel horizontally or not. Only used by Panel:SizeTo.
    SizeX: boolean
    --- Whether to resize the panel vertically or not. Only used by Panel:SizeTo.
    SizeY: boolean
    --- The target size of the panel object. Only used by Panel:SizeTo.
    Size: Vector | nil
    --- The size of the panel object when the animation started. Only used by Panel:SizeTo.
    StartSize: Vector
    --- The target colour of the panel object. Only used by Panel:ColorTo.
    Color: Color
    --- The colour of the panel object when the animation started. Only used by Panel:ColorTo.
    StartColor: Color
    --- The target alpha (0-255) of the panel object. Only used by Panel:AlphaTo.
    Alpha: number
    --- The alpha (0-255) of the panel object when the animation started. Only used by Panel:AlphaTo.
    StartAlpha: number
    --- The speed to use for transitions when using linear interpolation (Lerp) animations. Only used by Panel:LerpPositions.
    Speed: number
    --- Whether or not to use easing to make the panel 'jump' at its target, slowing as it approaches. Only used by Panel:LerpPositions.
    UseGravity: boolean
end

