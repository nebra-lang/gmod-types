--- Long Visibility/Shoot
declare SF_NPC_LONG_RANGE: number
--- Ignore player push - Don't give way to player
declare SF_NPC_NO_PLAYER_PUSHAWAY: number
--- NPC Doesn't drop weapon on death
declare SF_NPC_NO_WEAPON_DROP: number
--- Don't acquire enemies or avoid obstacles
declare SF_NPC_START_EFFICIENT: number
