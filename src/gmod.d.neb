    Tooltip: string
end

--- Information about custom fields that are not exclusive to `Scripted Entities`, fields that have an effect on any entity.
--- See also `Structures/ENT`
declare interface Custom_Entity_Fields
    --- Sandbox and Sandbox derived only. Called by the `Drive property` to override the default drive type, which is `drive_sandbox`.
    GetEntityDriveMode: function
    --- Documented at ENTITY:OnEntityCopyTableFinish.
    OnEntityCopyTableFinish: function
    --- Documented at ENTITY:PostEntityCopy.
    PostEntityCopy: function
    --- Documented at ENTITY:PostEntityPaste.
    PostEntityPaste: function
    --- Documented at ENTITY:PreEntityCopy.
    PreEntityCopy: function
    --- Documented at ENTITY:OnDuplicated.
    OnDuplicated: function
    --- Sandbox or Sandbox derived only. If set to `true`, physgun will not be able to pick this entity up. This can also be set from map, see Sandbox Specific Mapping
    PhysgunDisabled: boolean | nil
    --- Sandbox or Sandbox derived only. Called from GM:PhysgunPickup, overrides `PhysgunDisabled`
    PhysgunPickup: function
    --- Sandbox or Sandbox derived only. Controls which tools **and** properties can be used on this entity. Format is a list of strings where each string is the tool or property classname. This can also be set from map, see Sandbox Specific Mapping
    m_tblToolsAllowed: { [any]: any }
    --- Documented at ENTITY:GravGunPickupAllowed.
    GravGunPickupAllowed: function
    --- Documented at ENTITY:GravGunPunt.
    GravGunPunt: function
    --- Documented at ENTITY:CanProperty.
    CanProperty: function
    --- Documented at ENTITY:CanTool.
    CanTool: function
    --- If set, the entity will not be duplicated via the built-in duplicator system.
    DoNotDuplicate: boolean | nil
    --- Documented at ENTITY:CalcAbsolutePosition.
    CalcAbsolutePosition: function
    --- Documented at ENTITY:RenderOverride.
    RenderOverride: function
    --- Internal. Do not use. Use Entity:SetRenderOrigin instead.
    m_RenderOrigin: Vector
    --- Internal. Do not use. Use Entity:SetRenderAngles instead.
    m_RenderAngles: Angle
end

