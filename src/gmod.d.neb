--- A simple menu with sub menu, icon and convar support.
declare class DMenu extends DScrollPanel
    --- Creates a `DMenuOptionCVar` and adds it as an option into the menu. Checking and unchecking the option will alter the given console variable's value.
    --- @param strText The text of the button
    --- @param convar The console variable to change
    --- @param on The value of the console variable to set when the option is checked
    --- @param off The value of the console variable to set when the option is unchecked
    --- @param funcFunction If set, the function will be called every time the option is pressed/clicked/selected. Function argument(s): * Panel `pnl` - The DMenuOptionCVar that was clicked.
    --- @return DMenuOptionCVar The created DMenuOptionCVar
    @side(client)
    function AddCVar(strText: string, convar: string, on: string, off: string, funcFunction: (Panel) -> any | nil): DMenuOptionCVar
    --- Add an option to the DMenu
    --- @param name Name of the option.
    --- @param func Function to execute when this option is clicked. Function argument(s): * Panel `pnl` - The DMenuOption that was clicked.
    --- @return Panel Returns the created DMenuOption panel.
    @side(client)
    function AddOption(name: string, func: (Panel) -> any | nil): Panel
    --- Adds a panel to the `DMenu` as if it were an option.
    --- This invokes `DScrollPanel:AddItem` and will not create a new panel if a class name is passed, unlike `Panel:Add`.
    --- @param pnl The panel that you want to add.
    @side(client)
    function AddPanel(pnl: Panel): nil
    --- Adds a horizontal line spacer.
    @side(client)
    function AddSpacer(): nil
    --- Add a sub menu to the DMenu
    --- @param Name Name of the sub menu.
    --- @param func Function to execute when this sub menu is clicked. Function argument(s): * Panel `pnl` - The DMenuOption that was clicked.
    --- @return Panel The created sub DMenu
    --- @return Panel The created DMenuOption
    @side(client)
    function AddSubMenu(Name: string, func: (Panel) -> any | nil): (Panel, Panel)
    --- Returns the number of child elements of `DMenu`'s `DScrollPanel:GetCanvas`.
    --- @return number The number of child elements
    @side(client)
    override function ChildCount(): number
    --- Clears all highlights made by `DMenu:HighlightItem`.
    --- Doesn't appear to be used or do anything.
    @side(client)
    function ClearHighlights(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally by `DMenu:OpenSubMenu`.
    --- @param menu The menu to close
    @side(client)
    function CloseSubMenu(menu: Panel): nil
    --- Gets a child by its index.
    --- @param childIndex The index of the child to get. Unlike `Panel:GetChild`, this index starts at 1.
    @side(client)
    override function GetChild(childIndex: number): nil
    --- Set by `DMenu:SetDeleteSelf`
    @side(client)
    function GetDeleteSelf(): boolean
    --- Returns the value set by `DMenu:SetDrawBorder`.
    @side(client)
    function GetDrawBorder(): boolean
    --- Returns whether the `DMenu` should draw the icon column with a different color or not.
    --- See `DMenu:SetDrawColumn`
    --- @return boolean Whether to draw the column or not
    @side(client)
    function GetDrawColumn(): boolean
    --- Returns the maximum height of the `DMenu`.
    --- @return number The maximum height in pixels
    @side(client)
    function GetMaxHeight(): number
    --- Returns the minimum width of the `DMenu` in pixels
    --- @return number the minimum width of the DMenu
    @side(client)
    function GetMinimumWidth(): number
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Returns the currently opened submenu.
    --- Used internally to store the open submenu by `DMenu:Hide`, `DMenu:OpenSubMenu`.
    --- @return Panel The currently opened submenu, if any.
    @side(client)
    function GetOpenSubMenu(): Panel
    --- Used to safely hide (not remove) the menu. This will also hide any opened submenues recursively.
    @side(client)
    override function Hide(): nil
    --- Highlights selected item in the `DMenu` by setting the item's key "Highlight" to true.
    --- Doesn't appear to be working or used.
    --- @param item The item to highlight.
    @side(client)
    function HighlightItem(item: Panel): nil
    --- Opens the `DMenu` at given position.
    --- @param x Position (X coordinate) to open the menu at.
    --- @param y Position (Y coordinate) to open the menu at.
    --- @param skipanimation This argument does nothing.
    --- @param ownerpanel If `x` and `y` are not set manually, setting this argument will offset the `y` position of the opened menu by the height of given panel.
    @side(client)
    function Open(x: number | nil, y: number | nil, skipanimation: any | nil, ownerpanel: Panel | nil): nil
    --- Closes any active sub menus, and opens a new one.
    --- @param item The DMenuOption to open the submenu at
    --- @param menu The submenu to open. If set to nil, the function just closes existing submenus.
    @side(client)
    function OpenSubMenu(item: Panel, menu: Panel | nil): nil
    --- Called when a option has been selected
    --- @param option The DMenuOption that was selected
    --- @param optionText The options text
    @side(client)
    function OptionSelected(option: Panel, optionText: string): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called by `DMenuOption`. Calls `DMenu:OptionSelected`.
    --- @param option The DMenuOption that called this function
    @side(client)
    function OptionSelectedInternal(option: Panel): nil
    --- Set to true by default. IF set to true, the menu will be deleted when it is closed, not simply hidden.
    --- This is used by `DMenuBar`
    --- @param newState true to delete menu on close, false to simply hide.
    @side(client)
    function SetDeleteSelf(newState: boolean): nil
    --- Does nothing.
    @side(client)
    function SetDrawBorder(bool: boolean): nil
    --- Sets whether the `DMenu` should draw the icon column with a different color.
    --- @param draw Whether to draw the column or not
    @side(client)
    function SetDrawColumn(draw: boolean): nil
    --- Sets the maximum height the `DMenu` can have. If the height of all menu items exceed this value, a scroll bar will be automatically added.
    --- @param maxHeight The maximum height of the DMenu to set, in pixels
    @side(client)
    function SetMaxHeight(maxHeight: number): nil
    --- Sets the minimum width of the `DMenu`. The menu will be stretched to match the given value.
    --- @param minWidth The minimum width of the DMenu in pixels
    @side(client)
    function SetMinimumWidth(minWidth: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to store the open submenu by `DMenu:Hide`, `DMenu:OpenSubMenu`, `DMenu:CloseSubMenu`
    --- @param item The menu to store
    @side(client)
    function SetOpenSubMenu(item: Panel): nil
end

--- A simple menu bar.
declare class DMenuBar extends DPanel
    --- Creates a new `DMenu` object tied to a `DButton` with the given label on the menu bar.
    --- This will create a new menu regardless of whether or not one with the same label exists. To add **or** get a menu, use `DMenuBar:AddOrGetMenu`.
    --- @param label The name (label) of the derma menu to create.
    --- @return Panel The new DMenu which will be opened when the button is clicked.
    @side(client)
    function AddMenu(label: string): Panel
    --- Retrieves a `DMenu` object from the menu bar. If one with the given label doesn't exist, a new one is created.
    --- To add a DMenu without checking, use `DMenuBar:AddMenu`.
    --- @param label The name (label) of the derma menu to get or create.
    --- @return Panel The DMenu with the given label.
    @side(client)
    function AddOrGetMenu(label: string): Panel
    --- Returns whether or not the background should be painted. Is the same as `DMenuBar:GetPaintBackground`
    --- @return boolean Should the background be painted
    --- @deprecated Use DMenuBar:GetPaintBackground instead.
    @side(client)
    override function GetDrawBackground(): boolean
    --- Returns whether or not the panel is a menu. Used for closing menus when another panel is selected.
    --- @return boolean Is a menu
    @side(client)
    override function GetIsMenu(): boolean
    --- If a menu is visible/opened, then the menu is returned.
    --- @return Panel Returns the visible/open menu or nil.
    @side(client)
    function GetOpenMenu(): Panel
    --- Returns whether or not the background should be painted. Is the same as `DMenuBar:GetDrawBackground`
    --- @return boolean Should the background be painted
    @side(client)
    override function GetPaintBackground(): boolean
    --- Sets whether or not the background should be painted. Is the same as `DMenuBar:SetPaintBackground`
    --- @param shouldPaint Should the background be painted
    --- @deprecated Use DMenuBar:SetPaintBackground
    @side(client)
    override function SetDrawBackground(shouldPaint: boolean): nil
    --- Sets whether or not the panel is part of a DMenu.
    --- If this is set to `true`, `Global.CloseDermaMenus` will not be called when the panel is clicked, and thus any open menus will remain open.
    --- @param isMenu Is this a menu
    @side(client)
    override function SetIsMenu(isMenu: boolean): nil
    --- Sets whether or not the background should be painted. Is the same as `DMenuBar:SetDrawBackground`
    --- @param shouldPaint Should the background be painted
    @side(client)
    override function SetPaintBackground(shouldPaint: boolean): nil
end

