declare SNDLVL_40dB: number
--- Refrigerator
declare SNDLVL_45dB: number
--- Average home
declare SNDLVL_50dB: number
declare SNDLVL_55dB: number
--- Normal conversation, clothes dryer
declare SNDLVL_60dB: number
--- *The same as SNDLVL_60dB*
declare SNDLVL_IDLE: number
--- Washing machine, dishwasher
