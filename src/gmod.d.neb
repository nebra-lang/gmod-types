    --- * `DColorPalette:GetConVarB` - For the blue channel
    --- @return string The ConVar name for the alpha channel of the color
    @side(client)
    function GetConVarA(): string
    --- An `Global.AccessorFunc` that returns the `ConVar` name for the blue channel of the color.
    --- See also:
    --- * `DColorPalette:GetConVarR` - For the red channel
    --- * `DColorPalette:GetConVarG` - For the green channel
    --- * `DColorPalette:GetConVarA` - For the alpha channel
    --- @return string The ConVar name for the blue channel of the color
    @side(client)
    function GetConVarB(): string
    --- An `Global.AccessorFunc` that returns the `ConVar` name for the green channel of the color.
    --- See also:
    --- * `DColorPalette:GetConVarR` - For the red channel
    --- * `DColorPalette:GetConVarB` - For the blue channel
    --- * `DColorPalette:GetConVarA` - For the alpha channel
    --- @return string The ConVar name for the green channel of the color
    @side(client)
    function GetConVarG(): string
    --- An `Global.AccessorFunc` that returns the `ConVar` name for the red channel of the color.
    --- See also:
    --- * `DColorPalette:GetConVarG` - For the green channel
    --- * `DColorPalette:GetConVarB` - For the blue channel
    --- * `DColorPalette:GetConVarA` - For the alpha channel
    --- @return string The ConVar name for the red channel of the color
    @side(client)
    function GetConVarR(): string
    --- An `Global.AccessorFunc` that returns the number of rows of the palette, provided 6 colors fill each row. This value is equal to the number of colors in the DColorPalette divided by 6.
    --- @return number Number of rows of the DColorPalette.
    @side(client)
    function GetNumRows(): number
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to make sure changes on one palette affect other palettes with same name.
    @side(client)
    function NetworkColorChange(): nil
    --- Called when a palette button has been pressed. For Override
    --- @param pnl The DColorButton that was pressed.
    @side(client)
    function OnRightClickButton(pnl: Panel): nil
    --- Resets this entire color palette to a default preset one, without saving.
    --- See `DColorPalette:ResetSavedColors` for version that also saves the changes.
    @side(client)
    function Reset(): nil
    --- Resets this entire color palette to a default preset one and saves the changes.
    --- See `DColorPalette:Reset` for version that does not save the changes.
    @side(client)
    function ResetSavedColors(): nil
    --- Saves the color of given button across sessions.
    --- The color is saved as a panel cookie, see `Panel:SetCookie` and `Panel:SetCookieName`.
    --- It is expected that the amount of colors per palette (`Panel:SetCookieName`) is the same every time.
    --- @param btn The button to save the color of. Used to get the ID of the button.
    --- @param clr The color to save to this button's index
    @side(client)
    function SaveColor(btn: Panel, clr: Color): nil
    --- Sets the size of each palette button.
    --- This is best kept to such a number, where this equation would return a whole number:
    --- `WidthOfColorPalette / ButtonSize= WholeNumber`
    --- If not, there will be ugly whitespace on the right side of the panel.
    --- @param size Sets the new size
    @side(client)
    function SetButtonSize(size: number): nil
    --- Currently does nothing. Intended to "select" the color.
    @side(client)
    function SetColor(clr: Color): nil
    --- Clears the palette and adds new buttons with given colors.
    --- @param tab A number indexed table where each value is a Color
    @side(client)
    function SetColorButtons(tab: { [any]: any }): nil
    --- An `Global.AccessorFunc` that sets the `ConVar` name for the alpha channel of the color.
    --- See also:
    --- * `DColorPalette:SetConVarR` - For the red channel
    --- * `DColorPalette:SetConVarG` - For the green channel
    --- * `DColorPalette:SetConVarB` - For the blue channel
    --- @param convar The ConVar name for the alpha channel of the color
    @side(client)
    function SetConVarA(convar: string): nil
    --- An `Global.AccessorFunc` that sets the `ConVar` name for the blue channel of the color.
    --- See also:
    --- * `DColorPalette:SetConVarR` - For the red channel
    --- * `DColorPalette:SetConVarG` - For the green channel
    --- * `DColorPalette:SetConVarA` - For the alpha channel
    --- @param convar The ConVar name for the blue channel of the color
    @side(client)
    function SetConVarB(convar: string): nil
    --- An `Global.AccessorFunc` that sets the `ConVar` name for the green channel of the color.
    --- See also:
    --- * `DColorPalette:SetConVarR` - For the red channel
    --- * `DColorPalette:SetConVarB` - For the blue channel
    --- * `DColorPalette:SetConVarA` - For the alpha channel
    --- @param convar The ConVar name for the green channel of the color
    @side(client)
    function SetConVarG(convar: string): nil
    --- An `Global.AccessorFunc` that sets the `ConVar` name for the red channel of the color.
    --- See also:
    --- * `DColorPalette:SetConVarG` - For the green channel
    --- * `DColorPalette:SetConVarB` - For the blue channel
    --- * `DColorPalette:SetConVarA` - For the alpha channel
    --- @param convar The ConVar name for the red channel of the color
    @side(client)
    function SetConVarR(convar: string): nil
    --- Roughly sets the number of colors that can be picked by the user. If the DColorPalette is exactly 6 rows tall, this function will set the number of colors shown per row in the palette. This is an `Global.AccessorFunc`
    --- **NOTE**: `DColorPalette:Reset` or `DColorPalette:ResetSavedColors` must be called after this function to apply changes.
    --- @param rows Scale for the range of colors that the user can pick. Default is 8.
    @side(client)
    function SetNumRows(rows: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Internal helper function for `DColorPalette:UpdateConVars`.
    --- @param name The name of the console variable to set
    --- @param key The key of the 3rd argument to set the convar to Possible values: "r", "g", "b", "a"
    --- @param clr The Color to retrieve the info from.
    @side(client)
    function UpdateConVar(name: string, key: string, clr: Color): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Updates all the console variables set by `DColorPalette:SetConVarR` and so on with given color.
    --- Called internally when a palette color is clicked.
    --- @param clr A Color
    @side(client)
    function UpdateConVars(clr: Color): nil
end

--- Similar to `DPropertySheet`, but with tabs on the left.
declare class DColumnSheet extends Panel
    --- Adds a new column/tab.
    --- @param name Name of the column/tab
    --- @param pnl Panel to be used as contents of the tab. This normally would be a DPanel
    --- @param icon Icon for the tab. This will ideally be a Silkicons, but any material name can be used.
    --- @return { [any]: any } A table containing the following keys: * DButton / DImageButton Button - The created tab button that will switch to the given panel. * Panel Panel - The given panel to switch to when the button is pressed.
    @side(client)
    function AddSheet(name: string, pnl: Panel, icon: string | nil): { [any]: any }
    --- An `Global.AccessorFunc` that returns the active button of this `DColumnSheet`.
    --- @return Panel The active button
    @side(client)
    function GetActiveButton(): Panel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- An `Global.AccessorFunc` that makes a button an active button for this `DColumnSheet`.
    --- @param active The button to make active button
    @side(client)
    function SetActiveButton(active: Panel): nil
    --- Makes the tabs/buttons show only the image and no text.
    @side(client)
    function UseButtonOnlyStyle(): nil
end

--- A grid for editing the properties of something using names and values. Properties can be categorized and strongly typed.
--- ##  Associated controls
--- * `DProperty_VectorColor`
--- * `DProperty_Boolean`
--- * `DProperty_Generic`
--- * `DProperty_Combo`
--- * `DProperty_Float`
--- * `DProperty_Int`
declare class DProperties extends Panel
    --- Creates a row in the properties panel.
    --- @param category The category to list this row under
    --- @param name The label of this row
    --- @return Panel An internal Row panel. It has 2 methods of interest: * `Setup`( string type, table vars ) * Call to set up the panel as one of the `DProperty_` panels. `vars` parameter is directly fed into the created `DProperty_` panels' `Setup` function. * `SetValue`( `any` value ) * Call to set the value on the created `DProperty_` panel.
    @side(client)
    function CreateRow(category: string, name: string): Panel
    --- Returns the `DScrollPanel` all the properties panels are attached to.
    --- @return DScrollPanel A DScrollPanel canvas
    @side(client)
    function GetCanvas(): DScrollPanel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Returns (or creates) a category of properties.
    --- See `DProperties:CreateRow` for adding actual properties.
    --- @param name Name of the category
    --- @param create Create a new category if it doesn't exist.
    --- @return Panel An internal panel.
    @side(client)
    function GetCategory(name: string, create: boolean | nil): Panel
end

--- **INTERNAL**: Unless you know what you are doing and you benefit from this panel, you should be using the `DProperties` instead.
--- A panel used by the `Editable Entities` system.
declare class DEntityProperties extends DProperties
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called internally by `DEntityProperties:RebuildControls`.
    @side(client)
    function EditVariable(varname: string, editdata: { [any]: any }): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called internally when an entity being edited became invalid.
    --- You should use `DEntityProperties:OnEntityLost` instead.
    @side(client)
    function EntityLost(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called internally by `DEntityProperties:SetEntity` to rebuild the controls.
    @side(client)
    function RebuildControls(): nil
    --- Sets the entity to be edited by this panel. The entity must support the `Editable Entities` system or nothing will happen.
    --- @param ent The entity to edit
    @side(client)
    function SetEntity(ent: Entity): nil
end

--- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
--- The little "+" button used by `DProperties` and `DTree_Node`.
declare class DExpandButton extends DButton
    --- Returns whether this DExpandButton is expanded or not.
    --- @return boolean True if expanded, false otherwise
    @side(client)
    function GetExpanded(): boolean
    --- Sets whether this DExpandButton should be expanded or not. Only changes appearance.
    --- @param expanded True to expand ( visually will show a "-" )
    @side(client)
    function SetExpanded(expanded: boolean): nil
end

--- A tree and list-based file browser.
--- It allows filtering by folder (directory) name and file extension, and can display models as `SpawnIcon`s.
declare class DFileBrowser extends DPanel
    --- Clears the file tree and list, and resets all values.
    @side(client)
    override function Clear(): nil
    --- An `Global.AccessorFunc` that returns the root directory/folder of the file tree.
    --- @return string The path to the root folder.
    @side(client)
    function GetBaseFolder(): string
    --- An `Global.AccessorFunc` that returns the current directory/folder being displayed.
    --- @return string The directory the file list is currently displaying.
    @side(client)
    function GetCurrentFolder(): string
    --- An `Global.AccessorFunc` that returns the current file type filter on the file list.
    --- @return string The current filter applied to the file list.
    @side(client)
    function GetFileTypes(): string
    --- Returns the `DTree Node` that the file tree stems from.
    --- This is a child of the root node of the `DTree`.
    --- @return DTree_Node The DTree_Node used for the tree.
    @side(client)
    function GetFolderNode(): DTree_Node
    --- An `Global.AccessorFunc` that returns whether or not the model viewer mode is enabled. In this mode, files are displayed as `SpawnIcon`s instead of a list.
    --- @return boolean Whether or not files will be displayed using SpawnIcons.
    @side(client)
    function GetModels(): boolean
    --- An `Global.AccessorFunc` that returns the name being used for the file tree.
    --- @return string The name used for the root of the file tree.
    @side(client)
    override function GetName(): string
    --- An `Global.AccessorFunc` that returns whether or not the file tree is open.
    --- @return boolean Whether or not the file tree is open.
    @side(client)
    function GetOpen(): boolean
    --- An `Global.AccessorFunc` that returns the access path of the file tree. This is `GAME` unless changed with `DFileBrowser:SetPath`.
    --- See `file.Read` for how paths work.
    --- @return string The current access path i.e. "GAME", "LUA", "DATA" etc.
    @side(client)
    function GetPath(): string
    --- An `Global.AccessorFunc` that returns the current search filter on the file tree.
    --- @return string The filter in use on the file tree.
    @side(client)
    function GetSearch(): string
    --- An `Global.AccessorFunc` that sets the root directory/folder of the file tree.
    --- This needs to be set for the file tree to be displayed.
    --- @param baseDir The path to the folder to use as the root.
    @side(client)
    function SetBaseFolder(baseDir: string): nil
    --- An `Global.AccessorFunc` that sets the directory/folder from which to display the file list.
    --- @param currentDir The directory to display files from.
    @side(client)
    function SetCurrentFolder(currentDir: string): nil
    --- An `Global.AccessorFunc` that sets the file type filter for the file list.
    --- This accepts the same file extension wildcards as `file.Find`.
    --- @param fileTypes A list of file types to display, separated by spaces e.g. ``` "*.lua *.txt *.mdl" ```
    @side(client)
    function SetFileTypes(fileTypes: string | nil): nil
    --- Enables or disables the model viewer mode. In this mode, files are displayed as `SpawnIcon`s instead of a list.
    --- **NOTE**: This should only be used for `.mdl` files; the spawn icons will display error models for others. See `DFileBrowser:SetFileTypes`
    --- @param showModels Whether or not to display files using SpawnIcons.
    @side(client)
    function SetModels(showModels: boolean | nil): nil
    --- An `Global.AccessorFunc` that sets the name to use for the file tree.
    --- @param treeName The name for the root of the file tree. Passing no value causes this to be the base folder name. See DFileBrowser:SetBaseFolder.
    @side(client)
    override function SetName(treeName: string | nil): nil
    --- An `Global.AccessorFunc` that opens or closes the file tree.
    --- @param open `true` to open the tree, `false` to close it.
    --- @param useAnim If `true`, the DTree's open/close animation is used.
    @side(client)
    function SetOpen(open: boolean | nil, useAnim: boolean | nil): nil
    --- An `Global.AccessorFunc` that sets the access path for the file tree. This is set to `GAME` by default.
    --- See `file.Read` for how paths work.
    --- @param path The access path i.e. "GAME", "LUA", "DATA" etc.
    @side(client)
    function SetPath(path: string): nil
    --- An `Global.AccessorFunc` that sets the search filter for the file tree.
    --- This accepts the same wildcards as `file.Find`.
    --- @param filter The filter to use on the file tree.
    @side(client)
    function SetSearch(filter: string | nil): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called to set up the `DTree` and file viewer when a base path has been set.
    --- Calls `DFileBrowser:SetupTree` and `DFileBrowser:SetupFiles`.
    --- @return boolean Whether or not the variables needed to set up have been defined.
    @side(client)
    function Setup(): boolean
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called to set up the `DListView` or `DIconBrowser` by `DFileBrowser:Setup`.
    --- The icon browser is used when in models mode. See `DFileBrowser:SetModels`.
    --- @return boolean Whether or not the files pane was set up successfully.
    @side(client)
    function SetupFiles(): boolean
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called to set up the `DTree` by `DFileBrowser:Setup`.
    --- @return boolean Whether or not the tree was set up successfully.
    @side(client)
    function SetupTree(): boolean
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Builds the file or icon list for the current directory.
    --- You should use `DFileBrowser:SetCurrentFolder` to change the directory.
    --- @param currentDir The directory to populate the list from.
    @side(client)
    function ShowFolder(currentDir: string): nil
    --- Sorts the file list.
    --- **NOTE**: This is only functional when not using the model viewer. See `DFileBrowser:SetModels`
    --- @param descending The sort order. `true` for descending (z-a), `false` for ascending (a-z).
    @side(client)
    function SortFiles(descending: boolean | nil): nil
end

--- Base panel used by `DFrame`, this panel is needed so that elements such as the `TextEntry` can obtain focus.
declare class EditablePanel extends Panel
end

--- The DFrame is the moma of basically all VGUI elements. 98% of the time you will parent your element to this.
declare class DFrame extends EditablePanel
    --- Centers the frame relative to the whole screen and invalidates its layout. This overrides `Panel:Center`.
    @side(client)
    override function Center(): nil
    --- Hides or removes the DFrame, and calls `DFrame:OnClose`.
    --- To set whether the frame is hidden or removed, use `DFrame:SetDeleteOnClose`.
    @side(client)
    function Close(): nil
    --- Gets whether the background behind the frame is being blurred.
    --- @return boolean Whether or not background blur is enabled.
    @side(client)
    function GetBackgroundBlur(): boolean
    --- Determines whether or not the DFrame will be removed when it is closed. This is set with `DFrame:SetDeleteOnClose`.
    --- @return boolean Whether or not the frame will be removed on close.
    @side(client)
    function GetDeleteOnClose(): boolean
    --- Gets whether or not the frame is draggable by the user.
    --- @return boolean Whether the frame is draggable or not.
    @side(client)
    function GetDraggable(): boolean
    --- Gets whether or not the frame is part of a derma menu. This is set with `DFrame:SetIsMenu`.
    --- @return boolean Whether or not this frame is a menu component.
    @side(client)
    function GetIsMenu(): boolean
    --- Gets the minimum height the DFrame can be resized to by the user.
    --- You must call `DFrame:SetSizable` before the user can resize the frame.
    --- @return number The minimum height the user can resize the frame to.
    @side(client)
    function GetMinHeight(): number
    --- Gets the minimum width the DFrame can be resized to by the user.
    --- You must call `DFrame:SetSizable` before the user can resize the frame.
    --- @return number The minimum width the user can resize the frame to.
    @side(client)
    function GetMinWidth(): number
    --- Gets whether or not the shadow effect bordering the DFrame is being drawn.
    --- @return boolean Whether or not the shadow is being drawn.
    @side(client)
    function GetPaintShadow(): boolean
    --- Gets whether or not the DFrame is restricted to the boundaries of the screen resolution.
    --- @return boolean Whether or not the frame is restricted.
    @side(client)
    function GetScreenLock(): boolean
    --- Gets whether or not the DFrame can be resized by the user.
    --- This is achieved by clicking and dragging in the bottom right corner of the frame.
    --- @return boolean Whether the frame can be resized or not.
    @side(client)
    function GetSizable(): boolean
    --- Returns the title of the frame.
    --- @return string Title of the frame.
    @side(client)
    function GetTitle(): string
    --- Determines if the frame or one of its children has the screen focus.
    --- @return boolean Whether or not the frame has focus.
    @side(client)
    function IsActive(): boolean
    --- Indicate that the background elements won't be usable.
    --- @param blur Whether or not to block mouse on background panels or not.
    @side(client)
    function SetBackgroundBlur(blur: boolean): nil
    --- Determines whether or not the DFrame is removed when it is closed with `DFrame:Close`.
    --- @param shouldDelete Whether or not to delete the frame on close. This is `true` by default.
    @side(client)
    function SetDeleteOnClose(shouldDelete: boolean): nil
    --- Sets whether the frame should be draggable by the user. The DFrame can only be dragged from its title bar.
    --- @param draggable Whether to be draggable or not.
    @side(client)
    function SetDraggable(draggable: boolean): nil
    --- Adds or removes an icon on the left of the `DFrame`'s title.
    --- @param path Set to empty string ("") to remove the icon. Otherwise, set to file path to create the icon.
    @side(client)
    function SetIcon(path: string): nil
    --- Sets whether the frame is part of a derma menu or not.
    --- If this is set to `true`, `Global.CloseDermaMenus` will not be called when the frame is clicked, and thus any open menus will remain open.
    --- @param isMenu Whether or not this frame is a menu component.
    @side(client)
    function SetIsMenu(isMenu: boolean): nil
    --- Sets the minimum height the DFrame can be resized to by the user.
    --- This only applies to users attempting to resize the frame; `Panel:SetTall` and similar methods will not be affected. You must call `DFrame:SetSizable` before the user can resize the frame.
    --- @param minH The minimum height the user can resize the frame to.
    @side(client)
    function SetMinHeight(minH: number): nil
    --- Sets the minimum width the DFrame can be resized to by the user.
    --- This only applies to users attempting to resize the frame; `Panel:SetWide` and similar methods will not be affected. You must call `DFrame:SetSizable` before the user can resize the frame.
    --- @param minW The minimum width the user can resize the frame to.
    @side(client)
    function SetMinWidth(minW: number): nil
    --- Sets whether or not the shadow effect bordering the DFrame should be drawn.
    --- @param shouldPaint Whether or not to draw the shadow. This is `true` by default.
    @side(client)
    function SetPaintShadow(shouldPaint: boolean): nil
    --- Sets whether the DFrame is restricted to the boundaries of the screen resolution.
    --- @param lock If `true`, the frame cannot be dragged outside of the screen bounds
    @side(client)
    function SetScreenLock(lock: boolean): nil
    --- Sets whether or not the `DFrame` can be resized by the user.
    --- This is achieved by clicking and dragging in the bottom right corner of the frame.
    --- You can set the minimum size using `DFrame:SetMinWidth` and `DFrame:SetMinHeight`.
    --- @param sizeable Whether the frame should be resizeable or not.
    @side(client)
    function SetSizable(sizeable: boolean): nil
    --- Sets the title of the frame.
    --- @param title New title of the frame.
    @side(client)
    function SetTitle(title: string): nil
    --- Determines whether the DFrame's control box (close, minimise and maximise buttons) is displayed.
    --- @param show `false` hides the control box; this is `true` by default.
    @side(client)
    function ShowCloseButton(show: boolean): nil
end

--- A really simple grid layout panel.
--- **NOTE**: This panel will set its size automatically based on set column count.
--- This makes it play badly with `Panel:Dock` and cause a `PANEL:PerformLayout` call every frame.
declare class DGrid extends Panel
    --- Adds a new item to the grid.
    --- @param item The item to add. It will be forced visible and parented to the DGrid.
    @side(client)
    function AddItem(item: Panel): nil
    --- Returns the number of columns of this `DGrid`. Set by `DGrid:SetCols`.
    --- @return number The number of columns of this DGrid
    @side(client)
    function GetCols(): number
    --- Returns the width of each column of the `DGrid`, which is set by `DGrid:SetColWide`.
    --- @return number The width of each column
    @side(client)
    function GetColWide(): number
    --- Returns a list of panels in the grid.
    --- @return { [any]: any } A list of Panels.
    @side(client)
    function GetItems(): { [any]: any }
    --- Returns the height of each row of the `DGrid`, which is set by `DGrid:SetRowHeight`.
    --- @return number The height of each row
    @side(client)
    function GetRowHeight(): number
    --- Removes given panel from the `DGrid:GetItems`.
    --- @param item Item to remove from the grid
    --- @param bDontDelete If set to true, the actual panel will not be removed via Panel:Remove.
    @side(client)
    function RemoveItem(item: Panel, bDontDelete: boolean | nil): nil
    --- Sets the number of columns this panel should have.
    --- The `DGrid` will resize its width to match this value.
    --- @param cols The desired number of columns
    @side(client)
    function SetCols(cols: number): nil
    --- Sets the width of each column.
    --- The cell panels (grid items) will not be resized or centered.
    --- @param colWidth The width of each column.
    @side(client)
    function SetColWide(colWidth: number): nil
    --- Sets the height of each row.
    --- The cell panels (grid items) will not be resized or centered.
    --- @param rowHeight The height of each row
    @side(client)
    function SetRowHeight(rowHeight: number): nil
    --- Sorts the items in the grid. Does not visually update the grid, use `Panel:InvalidateLayout` for that.
    --- @param key A key in the panel from DGrid:GetItems. The key's value must be numeric.
    --- @param desc True for descending order, false for ascending.
    @side(client)
    function SortByMember(key: string, desc: boolean | nil): nil
end

--- Creates an invisible vertical divider between two GUI elements.
declare class DHorizontalDivider extends DPanel
    --- Returns the width of the horizontal divider bar, set by `DHorizontalDivider:SetDividerWidth`.
    --- @return number The width of the horizontal divider bar
    @side(client)
    function GetDividerWidth(): number
    --- Returns whether or not the player is currently dragging the middle divider bar.
    --- @return boolean Whether or not the player is currently dragging the middle divider bar.
    @side(client)
    function GetDragging(): boolean
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Returns the local X coordinate of where the player started dragging the thing
    @side(client)
    function GetHoldPos(): number
    --- Returns the left side content of the `DHorizontalDivider`
    --- @return Panel The content on the left side
    @side(client)
    function GetLeft(): Panel
    --- Returns the minimum width of the left side, set by `DHorizontalDivider:SetLeftMin`.
    --- @return number The minimum width of the left side
    @side(client)
    function GetLeftMin(): number
    --- Returns the current width of the left side, set by `DHorizontalDivider:SetLeftWidth` or by the user.
    --- @return number The current width of the left side
    @side(client)
    function GetLeftWidth(): number
    --- Returns the middle content, set by `DHorizontalDivider:SetMiddle`.
    --- @return Panel The middle content
    @side(client)
    function GetMiddle(): Panel
    --- Returns the right side content
    --- @return Panel The right side content
    @side(client)
    function GetRight(): Panel
    --- Returns the minimum width of the right side, set by `DHorizontalDivider:SetRightMin`.
    --- @return number The minimum width of the right side
    @side(client)
    function GetRightMin(): number
    --- Sets the width of the horizontal divider bar.
    --- @param width The width of the horizontal divider bar.
    @side(client)
    function SetDividerWidth(width: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets whether the player is dragging the divider or not
    @side(client)
    function SetDragging(dragonot: boolean): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the local X coordinate of where the player started dragging the thing
    @side(client)
    function SetHoldPos(x: number): nil
    --- Sets the left side content of the `DHorizontalDivider`.
    --- @param pnl The panel to set as the left side
    @side(client)
    function SetLeft(pnl: Panel): nil
    --- Sets the minimum width of the left side
    --- @param minWidth The minimum width of the left side
    @side(client)
    function SetLeftMin(minWidth: number): nil
    --- Sets the current/starting width of the left side.
    --- The width of the right side is automatically calculated by subtracting this from the total width of the `DHorizontalDivider`.
    --- @param width The current/starting width of the left side
    @side(client)
    function SetLeftWidth(width: number): nil
    --- Sets the middle content, over the draggable divider bar panel.
    --- @param middle The middle content
    @side(client)
    function SetMiddle(middle: Panel): nil
    --- Sets the right side content
    --- @param pnl The right side content
    @side(client)
    function SetRight(pnl: Panel): nil
    --- Sets the minimum width of the right side
    --- @param minWidth The minimum width of the right side
    @side(client)
    function SetRightMin(minWidth: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- TODO Document me
    @side(client)
    function StartGrab(): nil
end

--- A very basic horizontal scrollable panel, similar to `DScrollPanel`.
--- Used internally in `DPropertySheet`.
declare class DHorizontalScroller extends Panel
    --- Adds a panel to the `DHorizontalScroller`.
    --- @param pnl The panel to add. It will be automatically parented.
    @side(client)
    function AddPanel(pnl: Panel): nil
    --- Returns the internal canvas panel where the content of `DHorizontalScroller` are placed on.
    --- @return DDragBase The DDragBase panel.
    @side(client)
    function GetCanvas(): DDragBase
    --- Returns the overlap set by `DHorizontalScroller:SetOverlap`.
    --- @return number The overlap.
    @side(client)
    function GetOverlap(): number
    --- Returns whether this panel should show drop targets.
    @side(client)
    function GetShowDropTargets(): boolean
    --- Same as `DDragBase:MakeDroppable`.
    --- TODO: Transclude or whatever to here?
    @side(client)
    function MakeDroppable(name: string): nil
    --- Scrolls the `DHorizontalScroller` to given child panel.
    --- @param target The target child panel. Must be a child of DHorizontalScroller:GetCanvas
    @side(client)
    function ScrollToChild(target: Panel): nil
    --- Controls the spacing between elements of the horizontal scroller.
    --- @param overlap Overlap in pixels. Positive numbers will make elements `overlap` each other, negative will add spacing.
    @side(client)
    function SetOverlap(overlap: number): nil
    --- Sets the scroll amount, automatically clamping the value.
    --- @param scroll The new scroll amount
    @side(client)
    function SetScroll(scroll: number): nil
    --- Sets whether this panel should show drop targets.
    @side(client)
    function SetShowDropTargets(newState: boolean): nil
    --- Same as `DDragBase:SetUseLiveDrag`
    @side(client)
    function SetUseLiveDrag(newState: boolean): nil
end

--- A generic horizontal scrollbar. See the vertical alternative `here`.
--- The scrollbar notably contains `DHScrollBar.btnLeft`, `DHScrollBar.btnRight`, and `DHScrollBar.btnGrip` which are the left button, right button, and grip respectively. Editing the paint functions of these allows custom scrollbar styling, although it is a better idea to use `Derma Skins`.
declare class DHScrollBar extends Panel
    --- Adds specified amount of scroll in pixels.
    --- @param add How much to scroll rightwards. Can be negative for leftwards scroll
    --- @return boolean True if the scroll level was changed (i.e. if we did or did not scroll)
    @side(client)
    function AddScroll(add: number): boolean
    --- Smoothly scrolls to given level.
    --- @param scroll The scroll level to animate to. In pixels from the left ( from 0 )
    --- @param length Length of the animation in seconds
    --- @param delay Delay of the animation in seconds
    --- @param ease See Panel:NewAnimation for explanation.
    @side(client)
    function AnimateTo(scroll: number, length: number, delay: number | nil, ease: number | nil): nil
    --- Returns the scale of the scroll bar based on the difference in size between the visible "window" into the canvas that is being scrolled. Should be used after `DHScrollBar:SetUp`.
    --- @return number The scale of the scrollbar.
    @side(client)
    function BarScale(): number
    --- Returns whether or not the manual left/right scroll buttons are visible or not. Set by `DHScrollBar:SetHideButtons`.
    --- @return boolean Whether or not the manual left/right scroll buttons are visible or not.
    @side(client)
    function GetHideButtons(): boolean
    --- Returns the negative of `DHScrollBar:GetScroll`.
    --- @return number The scroll offset.
    @side(client)
    function GetOffset(): number
    --- Returns the amount of scroll level from the left in pixels.
    --- @return number The amount of scroll level from the left edge.
    @side(client)
    function GetScroll(): number
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Called from within `DScrollBarGrip`
    @side(client)
    function Grip(): nil
    --- Allows hiding the left and right buttons for better visual stylisation.
    --- @param hide True to hide
    @side(client)
    function SetHideButtons(hide: boolean): nil
    --- Sets the scroll level in pixels.
    --- @param scroll The new scroll value.
    @side(client)
    function SetScroll(scroll: number): nil
    --- Sets up the scrollbar for use.
    --- The scrollbar will automatically disable itself if the total width of the canvas is lower than the width of the panel that holds the canvas during this function call.
    --- @param barSize The size of the panel that holds the canvas, basically size of "1 page".
    --- @param canvasSize The total size of the canvas, this typically is the bigger number.
    @side(client)
    function SetUp(barSize: number, canvasSize: number): nil
end

--- **NOTE**: For more information on Garry's Mod's web rendering, you can consult the following page: `HTML_Web_Engine`
--- The HTML control can be used to display web pages just like an internet browser.
--- `DHTML` has additional functionality for interfacing with the page, such as sending and receiving data.
--- ## Blocked URL Extentions
--- This means your url cannot end in any of these extensions, e.g.: (http://yourdomain.com/garry.exe)
--- * .exe
--- * .bat
--- * .dll
--- * .zip
--- * .mp3
--- * .swf
declare class HTML extends Panel
end

--- The DHTML control wraps the internal web engine, supports calling Javascript functions from Lua,
--- as well as running Lua from within the HTML. Running Lua code is disabled by default.
declare class DHTML extends HTML
    --- Defines a Javascript function that when called will call a Lua callback.
    --- **NOTE**: Must be called after the HTML document has fully loaded.
    --- @param library Library name of the JS function you are defining.
    --- @param name Name of the JS function you are defining.
    --- @param callback Function called when the JS function is called. Arguments passed to the JS function will be passed here.
    @side(client)
    function AddFunction(library: string, name: string, callback: function): nil
    --- Runs/Executes a string as JavaScript code in a panel.
    --- **NOTE**: This function does **NOT** evaluate expression (i.e. allow you to pass variables from JavaScript (JS) to Lua context).Because a return value is nil/no value (a.k.a. void).If you wish to pass/return values from JS to Lua, you may want to use `DHTML:AddFunction` function to accomplish that job.
    --- **NOTE**: This function is an alias of `DHTML:QueueJavascript` ([source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dhtml.lua#L62)).
    --- @param js Specify JavaScript code to be executed.
    @side(client)
    function Call(js: string): nil
    --- Returns if the loaded page can run Lua code, set by `DHTML:SetAllowLua`
    --- @return boolean Whether or not Lua code can be called from the loaded page.
    @side(client)
    function GetAllowLua(): boolean
    --- Returns the value set by `DHTML:SetScrollbars`.
    --- @return boolean True if scrollbars should be visible.
    --- @deprecated Broken. Use the CSS `overflow` rule instead.
    @side(client)
    function GetScrollbars(): boolean
    --- Runs/Executes a string as JavaScript code in a panel.
    --- **NOTE**: This function does **NOT** evaluate expression (i.e. allow you to pass variables from JavaScript (JS) to Lua context).Because a return value is nil/no value (a.k.a. void).If you wish to pass/return values from JS to Lua, you may want to use `DHTML:AddFunction` function to accomplish that job.
    --- **NOTE**: If `Panel:IsVisible` is `false`, `PANEL:Think` will **NOT** run, meaning the Javascript Queue will not be processed.Consider overriding `PANEL:Paint` to stop the panel from drawing instead.
    --- @param js Specify JavaScript code to be executed.
    @side(client)
    function QueueJavascript(js: string): nil
    --- Determines whether the loaded page can run Lua code or not. See `DHTML` for how to run Lua from a DHTML window.
    --- @param allow Whether or not to allow Lua.
    @side(client)
    function SetAllowLua(allow: boolean | nil): nil
    --- Sets if the loaded window should display scrollbars when the webpage is larger than the viewing window. This is similar to the CSS `overflow` rule.
    --- @param show True if scrollbars should be visible.
    --- @deprecated Broken. Use the CSS `overflow` rule instead.
    @side(client)
    function SetScrollbars(show: boolean): nil
end

--- An element providing navigation controls for a `DHTML` window.
declare class DHTMLControls extends Panel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    @side(client)
    function FinishedLoading(): nil
    --- Sets the color of the navigation buttons.
    --- @param clr A Color
    @side(client)
    function SetButtonColor(clr: Color): nil
    --- Sets the `DHTML` element to control with these `DHTMLControls`.
    --- @param dhtml The HTML panel
    @side(client)
    override function SetHTML(dhtml: Panel): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    @side(client)
    function StartedLoading(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Basically adds an URL to the history.
    @side(client)
    function UpdateHistory(url: string): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    @side(client)
    function UpdateNavButtonStatus(): nil
end

--- Simply a `DIconLayout` which automatically displays all of the `Silkicons`.
--- Used as a way to get the user to select an icon.
declare class DIconBrowser extends DScrollPanel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Automatically called to fill the browser with icons. Will not work if `DIconBrowser:SetManual` is set to true.
    @side(client)
    function Fill(): nil
    --- A simple unused search feature, hides all icons that do not contain given text in their file path.
    --- @param text The text to search for
    @side(client)
    function FilterByText(text: string): nil
    --- Returns whether or not the browser should fill itself with icons.
    @side(client)
    function GetManual(): boolean
    --- Returns the currently selected icon's file path.
    --- @return string The currently selected icon's file path.
    @side(client)
    function GetSelectedIcon(): string
    --- Called when the selected icon was changed. Use `DIconBrowser:GetSelectedIcon` to get the selected icon's filepath.
    @side(client)
    function OnChange(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Use `DIconBrowser:OnChange` instead
    @side(client)
    function OnChangeInternal(): nil
    --- Scrolls the browser to the selected icon
    @side(client)
    function ScrollToSelected(): nil
    --- Selects an icon from file path
    --- @param icon The file path of the icon to select. Do not include the "materials/" part.
    @side(client)
    function SelectIcon(icon: string): nil
    --- Sets whether or not the browser should automatically fill itself with icons.
    @side(client)
    function SetManual(manual: boolean): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Set the currently selected file path. Do not use. Use `DIconBrowser:SelectIcon` instead.
    @side(client)
    function SetSelectedIcon(str: string): nil
end

--- `DImage` is an advanced, more robust version of the `Material` panel.
--- See `DImageButton` for a click-able version of this panel.
declare class DImage extends DPanel
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Actually loads the `IMaterial` to render it. Called from `DImage:LoadMaterial`.
    @side(client)
    function DoLoadMaterial(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- "Fixes" the current material of the `DImage` if it has VertexLit shader by creating a new one with the same name and a prefix of "_DImage" and automatically calling `DImage:SetMaterial` with the new material.
    --- This fixes the problem where using materials using shaders that expect lighting information causing "weird" flickering when displayed in 2D/Unlit environment.
    @side(client)
    function FixVertexLitMaterial(): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Returns the texture path set by `DImage:SetFailsafeMatName`.
    @side(client)
    function GetFailsafeMatName(): string
    --- Returns the image loaded in the image panel.
    --- @return string The path to the image that is loaded.
    @side(client)
    function GetImage(): string
    --- Returns the color override of the image panel.
    --- @return Color The color override of the image. Uses Color.
    @side(client)
    function GetImageColor(): Color
    --- Returns whether the `DImage` should keep the aspect ratio of its image when being resized.
    --- See `DImage:SetKeepAspect` for more info on how it works.
    --- @return boolean Whether the DImage should keep the aspect ratio of its image when being resized.
    @side(client)
    function GetKeepAspect(): boolean
    --- Returns the current `Global.Material` of the `DImage`.
    @side(client)
    function GetMaterial(): IMaterial
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Returns the texture path set by `DImage:SetMatName`.
    @side(client)
    function GetMatName(): string
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Initializes the loading process of the material to render if it is not loaded yet.
    --- You do not need to call this function. It is done for you automatically.
    @side(client)
    function LoadMaterial(): nil
    --- Paints a ghost copy of the DImage panel at the given position and dimensions. This function overrides `Panel:PaintAt`.
    --- @param posX The x coordinate to draw the panel from.
    --- @param posY The y coordinate to draw the panel from.
    --- @param width The width of the panel image to be drawn.
    --- @param height The height of the panel image to be drawn.
    @side(client)
    override function PaintAt(posX: number, posY: number, width: number, height: number): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the backup material to be loaded when the image is first rendered. Used by `DImage:SetOnViewMaterial`.
    @side(client)
    function SetFailsafeMatName(backupMat: string): nil
    --- Sets the image to load into the frame. If the first image can't be loaded and `strBackup` is set, that image will be loaded instead.
    --- This eventually calls `DImage:SetMaterial`.
    --- @param strImage The path of the image to load, relative to the `materials/` folder. When no file extension is supplied the `.vmt` file extension is assumed.
    --- @param strBackup The path of the backup image.
    @side(client)
    function SetImage(strImage: string, strBackup: string | nil): nil
    --- Sets the image's color override.
    --- @param col The color override of the image. Uses Color.
    @side(client)
    function SetImageColor(col: Color): nil
    --- Sets whether the `DImage` should keep the aspect ratio of its image when being resized.
    --- Note that this will not try to fit the image inside the button, but instead it will fill the button with the image.
    --- @param keep true to keep the aspect ratio, false not to
    @side(client)
    function SetKeepAspect(keep: boolean): nil
    --- Sets a `Global.Material` directly as an image.
    --- @param mat The material to set
    @side(client)
    function SetMaterial(mat: IMaterial): nil
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Sets the material to be loaded when the image is first rendered. Used by `DImage:SetOnViewMaterial`.
    @side(client)
    function SetMatName(mat: string): nil
    --- Similar to `DImage:SetImage`, but will only do the expensive part of actually loading the textures/material if the material is about to be rendered/viewed.
    --- Useful for cases like `DIconBrowser`, where there are hundreds of small icons in 1 panel in a list that do not need all to be loaded at the same time.
    @side(client)
    function SetOnViewMaterial(mat: string, backupMat: string): nil
    --- Returns true if the image is **not** yet loaded.
    @side(client)
    function Unloaded(): boolean
end

--- An image button.
--- This panel inherits all methods of `DButton`, such as `DLabel:DoClick`.
declare class DImageButton extends DButton
    --- **INTERNAL**: This is used internally - although you're able to use it you probably shouldn't.
    --- Used internally to briefly scale the image when clicked.
    @side(client)
    function DepressImage(): nil
    --- Returns whether `DImageButton:DepressImage` is functional or not.
    --- @return boolean `true` to enable image depressing when clicked.
    @side(client)
    function GetDepressImage(): boolean
    --- Returns the "image" of the `DImageButton`. Equivalent of `DImage:GetImage`.
    --- @return string The path to the image that is loaded.
    @side(client)
    function GetImage(): string
    --- Returns whether the image inside the button should be stretched to fit it or not
    --- See `DImageButton:SetStretchToFit`
    @side(client)
    function GetStretchToFit(): boolean
    --- Sets the color of the image. Equivalent of `DImage:SetImageColor`
    --- @param color The Color to set
    @side(client)
    override function SetColor(color: Color): nil
    --- Controls whether `DImageButton:DepressImage` is functional or not.
    --- @param enable `true` to enable image depressing when clicked.
    @side(client)
    function SetDepressImage(enable: boolean): nil
    --- Alias of `DImageButton:SetImage`.
    @side(client)
    override function SetIcon(strImage: string, strBackup: string | nil): nil
    --- Sets the "image" of the `DImageButton`. Equivalent of `DImage:SetImage`.
    --- @param strImage The path of the image to load, relative to the `materials/` folder. When no file extension is supplied the `.vmt` file extension is assumed.
    --- @param strBackup The path of the backup image.
    @side(client)
    override function SetImage(strImage: string, strBackup: string | nil): nil
    --- Hides or shows the image of the image button. Internally this calls `Panel:SetVisible` on the internal `DImage`.
    --- @param visible Set true to make it visible ( default ), or false to hide the image
    @side(client)
    function SetImageVisible(visible: boolean): nil
    --- Sets whether the `DImageButton` should keep the aspect ratio of its image. Equivalent of `DImage:SetKeepAspect`.
    --- Note that this will not try to fit the image inside the button, but instead it will fill the button with the image.
    --- @param keep true to keep the aspect ratio, false not to
    @side(client)
    function SetKeepAspect(keep: boolean): nil
    --- Sets a `Global.Material` directly as an image. Equivalent of `DImage:SetMaterial`.
    --- @param mat The material to set
    @side(client)
    override function SetMaterial(mat: IMaterial): nil
    --- See `DImage:SetOnViewMaterial`
    @side(client)
    function SetOnViewMaterial(mat: string, backup: string): nil
    --- Sets whether the image inside the `DImageButton` should be stretched to fill the entire size of the button, without preserving aspect ratio.
    --- If set to false, the image will not be resized at all.
    --- @param stretch True to stretch, false to not to stretch
    @side(client)
    function SetStretchToFit(stretch: boolean): nil
end

--- Uses the `killicon` to persistently draw a killicon.
declare class DKillIcon extends Panel
