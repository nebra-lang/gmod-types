--- HL2 -  Unused
declare CLASS_CITIZEN_REBEL: number
--- HL2 - **Combine Troops** - `npc_combine` - `npc_advisor` - `apc_missile` - `npc_apcdriver` - `npc_turret_floor` ( Hostile ) - `npc_rollermine` ( Hostile ) - `npc_turret_ground` ( Active ) - `npc_turret_ceiling` ( Active ) - `npc_strider` ( Active - Not being carried by the gunship )
declare CLASS_COMBINE: number
--- HL2 - **Combine Aircrafts** - `npc_combinegunship` - `npc_combinedropship` - `npc_helicopter`
declare CLASS_COMBINE_GUNSHIP: number
--- HL2 -  Unused
declare CLASS_CONSCRIPT: number
--- HL2 - **Headcrabs** - `npc_headcrab` ( Visible )
declare CLASS_HEADCRAB: number
--- HL2 - **Manhacks** - `npc_manhack` ( Hostile - Not held by the gravity gun )
declare CLASS_MANHACK: number
--- HL2 - **Metro Police** - `npc_metropolice` - `npc_vehicledriver`
declare CLASS_METROPOLICE: number
--- HL2 - **Combine Military Objects** - `func_guntarget` - `npc_spotlight` - `npc_combine_camera` ( Active )
declare CLASS_MILITARY: number
--- HL2 - **Combine Scanners** - `npc_cscanner` - `npc_clawscanner`
declare CLASS_SCANNER: number
--- HL2 - **Stalkers** - `npc_stalker`
declare CLASS_STALKER: number
--- HL2 - **Vortigaunts** - `npc_vortigaunt` before the end of EP2 ( Controlled by `MakeGameEndAlly` input )
declare CLASS_VORTIGAUNT: number
--- HL2 - **Zombies** - `npc_zombie` ( Unslumped ) - `npc_poisonzombie` - `npc_fastzombie` - `npc_fastzombie_torso` - `npc_zombine`
declare CLASS_ZOMBIE: number
--- HL2 - **Snipers** - `npc_sniper` - `proto_sniper`
declare CLASS_PROTOSNIPER: number
