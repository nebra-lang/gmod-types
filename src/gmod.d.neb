declare CLASS_HUMAN_PASSIVE: number
--- HL:S - **Human Military** - `monster_human_grunt` - `monster_apache`
declare CLASS_HUMAN_MILITARY: number
--- HL:S - **Alien Military** - `monster_alien_controller` - `monster_vortigaunt` - `monster_alien_grunt` - `monster_nihilanth` - `monster_snark` if it has an enemy of class  `CLASS_PLAYER` , `CLASS_HUMAN_PASSIVE` or `CLASS_HUMAN_MILITARY`
declare CLASS_ALIEN_MILITARY: number
--- HL:S - **Monsters** - `monster_tentacle` - `monster_barnacle` - `monster_zombie` - `monster_gargantua` - `monster_houndeye` - `monster_ichthyosaur` - `monster_bigmomma`
declare CLASS_ALIEN_MONSTER: number
--- HL:S - **Headcrabs** - `monster_headcrab`
declare CLASS_ALIEN_PREY: number
--- HL:S - **Alien Predators** - `monster_bullsquid` - `xen_tree` - `xen_hull`
declare CLASS_ALIEN_PREDATOR: number
--- HL:S - **Insects** - `montser_roach` - `monster_leech`
declare CLASS_INSECT: number
--- HL:S - **Player Bioweapons** - `hornet` fired by a player
declare CLASS_PLAYER_BIOWEAPON: number
--- HL:S - **Enemy Bioweapons** - `hornet` fired by anyone but a player - `monster_snark` with no enemy or an enemy without the class  `CLASS_PLAYER` , `CLASS_HUMAN_PASSIVE` or `CLASS_HUMAN_MILITARY`
declare CLASS_ALIEN_BIOWEAPON: number
--- Portal - **Portal rocket and normal turrets, and the camera** * `npc_portal_turret_floor` * `npc_rocket_turret` * `npc_security_camera`
declare CLASS_PORTAL_TURRET: number
--- Normal
declare COLLISION_GROUP_NONE: number
--- Collides with nothing but world and static stuff
declare COLLISION_GROUP_DEBRIS: number
--- Same as debris, but hits triggers. Useful for an item that can be shot, but doesn't collide.
declare COLLISION_GROUP_DEBRIS_TRIGGER: number
--- Collides with everything except other interactive debris or debris
declare COLLISION_GROUP_INTERACTIVE_DEBRIS: number
--- Collides with everything except interactive debris or debris
declare COLLISION_GROUP_INTERACTIVE: number
--- Used by players, but NOT for movement collision. Does not collide with COLLISION_GROUP_PASSABLE_DOOR and COLLISION_GROUP_PUSHAWAY
declare COLLISION_GROUP_PLAYER: number
--- NPCs can see straight through an Entity with this applied.
declare COLLISION_GROUP_BREAKABLE_GLASS: number
--- Used by driveable vehicles. Always collides against COLLISION_GROUP_VEHICLE_CLIP
declare COLLISION_GROUP_VEHICLE: number
--- For HL2, same as Collision_Group_Player, for TF2, this filters out other players and CBaseObjects
declare COLLISION_GROUP_PLAYER_MOVEMENT: number
--- Generic NPC group
declare COLLISION_GROUP_NPC: number
--- Doesn't collide with anything, no traces
declare COLLISION_GROUP_IN_VEHICLE: number
--- Doesn't collide with players and vehicles
declare COLLISION_GROUP_WEAPON: number
--- Only collides with vehicles
declare COLLISION_GROUP_VEHICLE_CLIP: number
--- Set on projectiles. Does not collide with other projectiles.
declare COLLISION_GROUP_PROJECTILE: number
--- Blocks entities not permitted to get near moving doors
declare COLLISION_GROUP_DOOR_BLOCKER: number
--- Lets the Player through, nothing else.
declare COLLISION_GROUP_PASSABLE_DOOR: number
--- Things that are dissolving are in this group
declare COLLISION_GROUP_DISSOLVING: number
--- Nonsolid on client and server, pushaway in player code
declare COLLISION_GROUP_PUSHAWAY: number
--- Used so NPCs in scripts ignore the player
declare COLLISION_GROUP_NPC_ACTOR: number
--- Used for NPCs in scripts that should not collide with each other
declare COLLISION_GROUP_NPC_SCRIPTED: number
--- Doesn't collide with players/props
declare COLLISION_GROUP_WORLD: number
--- Amount of COLLISION_GROUP_ enumerations
declare LAST_SHARED_COLLISION_GROUP: number
--- Half-Life 2 exclusive collision group, acts similarly to `COLLISION_GROUP_PROJECTILE` but is also ignored by player movement.
declare COLLISION_GROUP_HL2_SPIT: number
--- Bottom-left
declare BOTTOM_LEFT: number
--- Bottom-center
declare BOTTOM_CENTER: number
--- Bottom-right
declare BOTTOM_RIGHT: number
--- Middle-left
declare MIDDLE_LEFT: number
--- Center
declare CENTER: number
--- Middle-right
declare MIDDLE_RIGHT: number
--- Top-left
declare TOP_LEFT: number
--- Top-center
declare TOP_CENTER: number
--- Top-right
declare TOP_RIGHT: number
